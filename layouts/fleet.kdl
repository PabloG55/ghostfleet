// claude-fleet layout — ONE zellij session, one pane, the whole control plane.
//
// claude-fleet opens the Projects picker; pick a project → Master Claude or the
// session grid → your sessions. Each project has its own hidden tmux server.
// No more per-project zellij sessions — just this one.
//
//     zellij --layout fleet attach -c fleet
//
// If zellij can't find `claude-fleet`, use the absolute path
// (e.g. command="/Users/you/.local/bin/claude-fleet").

layout {
    // Free Ctrl-s and Ctrl-p inside the fleet session so those keystrokes reach the
    // app instead of zellij: the nested tmux binds them to "jump to the sessions grid"
    // and "jump up to Projects" (see tmux/cf.tmux.conf), and the Node screens read the
    // same two keys (^S sessions / ^P projects). Zellij's defaults for these — scroll
    // mode and pane mode — are scoped away HERE only: still reachable with the mouse /
    // PageUp / Ctrl-t, and unchanged in your other zellij sessions.
    keybinds {
        normal {
            unbind "Ctrl s"
            unbind "Ctrl p"
        }
    }
    tab name="fleet" {
        pane command="claude-fleet"
    }
}
