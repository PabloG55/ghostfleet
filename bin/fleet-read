#!/usr/bin/env bash
# fleet-read [-s SOCKET] <session> [n]
# fleet-read [-s SOCKET] --json <session> [--limit N] [--before TS]
#
# Print the last n (default 1) assistant messages from a sibling session's
# transcript — so a lead session can check a worker's progress/output.
#
# --json emits the same messages as DATA — {ts, role, text} per message, with a cursor, plus
# two event roles the phone draws as cards: `compacted`, and `tools` (a folded run of calls) —
# for bin/fleet-serve's /api/session (docs/mobile.md §11.3). It is additive for the same
# reason fleet-grid.mjs --json is: the phone needs a timestamp and a role per message,
# and the alternative was a second reader of the transcript. There is already exactly one
# piece of code that knows how to FIND a session's transcript on a given fleet (the block
# below, and every line of it is a bug that was fixed once), so a second one would
# eventually disagree with this one about which conversation a recycled worktree is
# holding — which is the failure that block exists to prevent.
#
# The default output is unchanged, byte for byte: the MCP fleet_read tool and the grid
# both parse it.
set -uo pipefail

SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer $TMUX (the live server this session runs in) over the env var — it's
# drift-proof; a long-running --resume/--fork Claude can hold a stale
# CLAUDE_FLEET_SOCK. Only when it names a cf-* fleet server; -s still overrides.
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac
# Flags in any position, and named positionals. fleet-stop's header explains why: a flag
# silently dropped because it came after the session name stops the worker and leaves the
# worktree, with nothing to say so.
JSON=0; LIMIT=20; BEFORE=""; SESSION=""; N=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s)       SOCK="${2:-}"; shift 2 ;;
    --json)   JSON=1; shift ;;
    --limit)  LIMIT="${2:-20}"; shift 2 ;;
    --before) BEFORE="${2:-}"; shift 2 ;;
    -*)       echo "fleet-read: unknown option $1" >&2; exit 1 ;;
    *)        if [ -z "$SESSION" ]; then SESSION="$1"; elif [ -z "$N" ]; then N="$1"
              else echo "fleet-read: unexpected arg $1" >&2; exit 1; fi; shift ;;
  esac
done
N="${N:-1}"
case "$LIMIT" in ''|*[!0-9]*) echo "fleet-read: --limit must be a number" >&2; exit 1 ;; esac
[ "$LIMIT" -ge 1 ] 2>/dev/null || LIMIT=1
[ -n "$SESSION" ] || { echo "fleet-read: usage: fleet-read [-s socket] [--json] <session> [n]" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "fleet-read: jq required" >&2; exit 1; }

CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
FLEET_DIR="${CLAUDE_FLEET_DIR:-$CFG/fleet}"

# Locate the session's transcript via its status file — newest entry for that slot ON
# THIS FLEET. Scoping by sock is essential: every fleet has a session named `master`,
# so matching by slot alone returns whichever project's master wrote most recently
# (i.e. some other repo's conversation). Entries predating the sock field are only
# trusted when nothing better exists, and never for the ambiguous `master` name.
row="$(for f in "$FLEET_DIR"/*.json; do
  jq -r --arg s "$SESSION" --arg k "$SOCK" \
    'select(.slot==$s and ((.sock // "") == $k))|[(.ts//0),(.transcript//""),(.session_id//"")]|@tsv' "$f" 2>/dev/null
done | sort -rn | head -1)"
if [ -z "$row" ] && [ "$SESSION" != master ]; then          # legacy files (no sock)
  row="$(for f in "$FLEET_DIR"/*.json; do
    jq -r --arg s "$SESSION" 'select(.slot==$s and ((.sock // "") == ""))|[(.ts//0),(.transcript//""),(.session_id//"")]|@tsv' "$f" 2>/dev/null
  done | sort -rn | head -1)"
fi
# ── NO RECORD UNDER THIS NAME: ASK THE PANE WHO IS IN IT ─────────────────────
# A record is written under the name the hook saw, and until the hook learned to ask tmux
# for the pane's CURRENT name that was the name the agent was LAUNCHED with. So a renamed
# session kept a record under its old name, and this printed "live but has no transcript
# yet" — to the CLI, and to the phone, which reads through here — for a session with a
# whole conversation behind it. Measured live on exactly that shape.
#   Recognised by evidence only, never by "the newest transcript in its folder" (see
# below): a record carrying this pane's id, which the hook writes and a rename does not
# change; or the agent's own <config>/sessions/<pid>.json, for the pane's process or the
# agent under it. The session heals for good on its next turn, when the hook rewrites the
# record under the live name; this is what makes it readable until then.
if [ -z "$row" ] && [ "$SESSION" != master ] && [ -n "$SOCK" ]; then
  IFS=$'\t' read -r _pane _ppid < <(tmux -L "$SOCK" list-panes -t "$SESSION" \
      -F '#{pane_id}@#{pid}'$'\t''#{pane_pid}' 2>/dev/null | head -1)
  if [ -n "${_pane:-}" ]; then
    row="$(for f in "$FLEET_DIR"/*.json; do
      jq -r --arg p "$_pane" --arg k "$SOCK" \
        'select((.pane // "") == $p and ((.sock // "") == $k))|[(.ts//0),(.transcript//""),(.session_id//"")]|@tsv' "$f" 2>/dev/null
    done | sort -rn | head -1)"
  fi
  if [ -z "$row" ] && [ -n "${_ppid:-}" ]; then
    for _p in "$_ppid" $(pgrep -P "$_ppid" 2>/dev/null); do
      _note="$CFG/sessions/$_p.json"; [ -f "$_note" ] || continue
      _sid="$(jq -r '.sessionId // empty' "$_note" 2>/dev/null)"
      case "$_sid" in [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-*) ;; *) continue ;; esac
      # A record on ANOTHER fleet is not this pane's, whatever id it carries.
      row="$(jq -r --arg k "$SOCK" 'select((.sock // "") == "" or .sock == $k)|[(.ts//0),(.transcript//""),(.session_id//"")]|@tsv' \
        "$FLEET_DIR/$_sid.json" 2>/dev/null)"
      if [ -z "$row" ]; then
        _ncwd="$(jq -r '.cwd // empty' "$_note" 2>/dev/null)"
        _tr=""; [ -n "$_ncwd" ] && _tr="$CFG/projects/$(printf '%s' "$_ncwd" | sed 's/[^A-Za-z0-9]/-/g')/$_sid.jsonl"
        row="0	$_tr	$_sid"
      fi
      break
    done
  fi
fi
tr="$(printf '%s' "$row" | cut -f2)"
sid="$(printf '%s' "$row" | cut -f3)"

# The status file records the path Claude *will* write, but the file only appears once
# the session has taken a turn. If it's missing, rebuild the path from the recorded
# session_id + the session's live pane cwd. Deliberately NOT "newest .jsonl in that
# dir": several sessions can share a checkout (master + a companion + a reopened
# conversation), so newest-wins would print a DIFFERENT session's output — worse than
# saying nothing.
if { [ -z "$tr" ] || [ ! -f "$tr" ]; } && [ -n "$sid" ]; then
  cwd="$(tmux -L "$SOCK" display-message -t "$SESSION" -p '#{pane_current_path}' 2>/dev/null)"
  if [ -n "$cwd" ]; then
    enc="$(printf '%s' "$cwd" | sed 's#[/.]#-#g')"
    cand="$CFG/projects/$enc/$sid.jsonl"
    [ -f "$cand" ] && tr="$cand"
  fi
fi

# ── A CONVERSATION SENT TO THE BACKGROUND GOES ON UNDER ANOTHER ID ───────────
# Claude Code's /background (or ← into its agent view) ends the conversation in this
# transcript with a `continued-in` line and goes on in a new one beside it, run by another
# process; the pane keeps showing it. A record written before the hand-off still points
# here, so this printed the last thing said before the hand-off for as long as the new
# conversation went on, frozen. The line names its successor, so it is followed —
# EVIDENCE, the same as the rest of this lookup, and the reason it is not "newest in the
# folder". Bounded, for a chain of hand-offs; the tail only, for a 100MB transcript.
for _ in 1 2 3 4 5; do
  [ -n "$tr" ] && [ -f "$tr" ] || break
  _next="$(tail -c 65536 "$tr" 2>/dev/null | grep -o '"continuedInSessionId":"[0-9a-fA-F-]*"' | tail -1 | cut -d'"' -f4)"
  [ -n "$_next" ] && [ "$_next" != "$sid" ] && [ -f "$(dirname "$tr")/$_next.jsonl" ] || break
  sid="$_next"; tr="$(dirname "$tr")/$_next.jsonl"
done

if [ -z "$tr" ] || [ ! -f "$tr" ]; then
  msg=""
  if tmux -L "$SOCK" has-session -t "$SESSION" 2>/dev/null; then
    msg="fleet-read: '$SESSION' is live but has no transcript yet — it hasn't taken a turn. Send it work: fleet-send${SOCK:+ -s $SOCK} $SESSION \"<prompt>\""
  else
    msg="fleet-read: no transcript for '$SESSION' (no such session on ${SOCK:-<no socket>} — try fleet-list)"
  fi
  # A session that exists but has not spoken is a STATE, not a failure, and a JSON caller
  # has to be able to render it as one. "no messages" and "no transcript yet" are
  # different facts; an empty array for both would erase the difference.
  if [ "$JSON" = 1 ]; then
    jq -n --arg s "$SESSION" --arg note "$msg" \
      '{session:$s, total:0, messages:[], next_before:null, note:$note}'
    exit 0
  fi
  echo "$msg" >&2
  exit 1
fi

# ── A CODEX CONVERSATION IS A ROLLOUT, NOT A TRANSCRIPT ──────────────────────
# lib/codex-rollout.mjs records a codex pane's rollout in the same `transcript` field, so
# the lookup above finds it unchanged — and then the claude filter below read it as an
# empty conversation, because a rollout has no `type:"user"` / `type:"assistant"` lines.
# Its messages are `response_item`s with a role, and its user turns include what codex
# itself injects (the environment block, AGENTS.md, an aborted-turn marker), which is the
# machine talking and is dropped the way claude's isMeta lines are. Recognised by its first
# line, which is always session_meta — not by the path, which a CODEX_HOME can move.
# Both readers produce the same {ts, role, text}, so pagination and the phone are shared.
if head -c 400 "$tr" 2>/dev/null | grep -q '"type":"session_meta"'; then
  MSGS='select(.type=="response_item" and (.payload.type // "")=="message"
               and (.payload.role=="user" or .payload.role=="assistant"))
        | { ts: ((.timestamp // "") | if . == "" then 0
                 else (sub("\\.[0-9]+Z$";"Z") | fromdateiso8601? // 0) end),
            role: .payload.role,
            text: ((.payload.content // [])
                   | if type == "string" then .
                     else (map(select(.type == "input_text" or .type == "output_text" or .type == "text") | .text) | join("\n")) end) }
        | select((.text | type) == "string" and (.text | test("[^[:space:]]")))
        | select((.role == "user" and (.text | test("^\\s*(<(environment_context|user_instructions|permissions instructions|turn_aborted|user_shell_command|collaboration_mode)[ >]|# AGENTS\\.md instructions)"))) | not)'
else
  # NOT EVERY `type:"user"` LINE IS THE OWNER. Claude files a good deal of its own traffic
  # as user turns, and each of these reached the phone as a right-hand bubble he never wrote.
  # The ones that are EVENTS keep their place in the conversation, as a role of their own the
  # phone draws as a small muted card — never as his:
  #   - the compaction summary (`isCompactSummary`): a several-screen "This session is being
  #     continued…" block becomes role `compacted`, its summary kept (capped) as the card's
  #     folded-away detail rather than as a message;
  #   - a background task finishing (`origin.kind` "task-notification", a `<task-notification>`
  #     body) — by far the most common — becomes a `tool` row named `task`, carrying its
  #     <summary> line;
  #   - and the agent's own tool calls, which this reader used to skip entirely, are `tool`
  #     rows too: the tool's name and one line of what it was asked (a command, a path).
  # The rest is the machine talking to itself and is dropped: a slash command's wrappers and
  # its local output (`<command-name>`, `<local-command-…>`, the "Caveat: The messages
  # below…" preamble), shell-mode echoes (`<bash-…>`), a prompt hook's injection, and the
  # "[Request interrupted by user…]" marker. Matched on the LEADING tag, never anywhere in
  # the text: a pasted message that quotes one is still his. A fleet delivery (`origin.kind`
  # "plugin") is a real prompt — a lead's or the phone's — so it is kept. tool_result blocks
  # never get this far: a result is the pane's to show, and it is most of the file.
  MSGS='select(.type=="assistant" or .type=="user")
        | select((.isSidechain // false) | not)
        | select((.isMeta // false) | not)
        | ((.timestamp // "") | if . == "" then 0
             else (sub("\\.[0-9]+Z$";"Z") | fromdateiso8601? // 0) end) as $ts
        | ((.message.content // []) | if type == "string" then .
             else (map(select(.type == "text") | .text) | join("\n")) end) as $text
        | if (.isCompactSummary // false) then
            { ts: $ts, role: "compacted", text: "conversation compacted",
              detail: (($text // "") | tostring | sub("^\\s*This session is being continued[^\n]*\n*"; "") | .[0:1200]) }
          elif ((.origin.kind // "") == "task-notification")
               or (.type == "user" and ($text | type) == "string" and ($text | test("^\\s*<task-notification>"))) then
            { ts: $ts, role: "tool", text: "task",
              # `(capture(…)? | .s)`, never `capture(…)?.s`: the suffix form is jq 1.8 syntax,
              # and jq 1.7 (Ubuntu 24.04 apt) rejects the WHOLE program, so every message
              # vanished there while this read fine on a Mac.
              detail: (($text | (capture("<summary>(?<s>[^<]*)</summary>")? | .s))
                       // ($text | (capture("<status>(?<s>[^<]*)</status>")? | .s)) // "finished") }
          elif .type == "assistant" then
            ({ ts: $ts, role: (.message.role // .type), text: $text }),
            ((.message.content // []) | if type == "array" then .[] else empty end
             | select(.type == "tool_use")
             | { ts: $ts, role: "tool", text: (.name // "tool"),
                 detail: ((.input // {}) | (.description // .command // .file_path // .path // .pattern
                          // .url // .query // .skill // .prompt // .subject // "")
                          | tostring | gsub("\\s+"; " ") | .[0:160]) })
          else { ts: $ts, role: (.message.role // .type), text: $text } end
        | select(.role == "tool" or ((.text | type) == "string" and (.text | test("[^[:space:]]"))))
        | select((.role == "user" and (.text | test("^\\s*(<(command-name|command-message|command-args|local-command-stdout|local-command-stderr|local-command-caveat|bash-input|bash-stdout|bash-stderr|user-prompt-submit-hook|system-reminder)>|Caveat: The messages below were generated|\\[Request interrupted by user)"))) | not)'
fi

# The WINDOW. 600 lines is what the default path has always read, and --json keeps a
# bound of its own kind for the same reason: the largest transcript measured here is
# 46 MB, and a phone asking for twenty messages must not make anybody read all of it.
# `total` is the count INSIDE this window, and `window_truncated` says when the window
# was the limit — a count presented as "the whole conversation" when it is not would be
# the one thing a message list must not get wrong.
TAIL_LINES=2000
if [ "$JSON" = 1 ]; then
  lines="$(wc -l < "$tr" 2>/dev/null | tr -d ' ')"
  trunc=false; [ "${lines:-0}" -gt "$TAIL_LINES" ] && trunc=true
  # role + timestamp per message, both halves of the conversation, tool results excluded:
  # a screen of tool_result blocks is not a conversation, and `content` is a plain string
  # on some user turns and an array on the rest.
  tail -n "$TAIL_LINES" "$tr" \
    | jq -c "$MSGS" 2>/dev/null \
    | jq -s --argjson limit "$LIMIT" --arg before "$BEFORE" --arg s "$SESSION" --argjson trunc "$trunc" '
        # A RUN OF TOOL CALLS IS ONE ITEM. One assistant turn can make forty calls, and a page
        # is twenty items: unfolded, a busy turn would fill the phone with cards and push the
        # conversation out of the page. Folded here, before paging, so a page still counts
        # things a person reads. The item keeps the first call ts as its own, which is the
        # cursor a later page asks for.
        reduce .[] as $m ([];
          if $m.role != "tool" then . + [$m]
          elif (length > 0 and .[-1].role == "tools") then .[-1].tools += [{ name: $m.text, detail: $m.detail, ts: $m.ts }]
          else . + [{ ts: $m.ts, role: "tools", tools: [{ name: $m.text, detail: $m.detail, ts: $m.ts }] }] end)
        | map(if .role == "tools" then .text = ((.tools | length | tostring) + (if (.tools | length) == 1 then " tool call" else " tool calls" end)) else . end)
        | . as $all
        | ($all | length) as $total
        | (if $before == "" then $total
           else ([ $all | to_entries[] | select((.value.ts | tostring) == $before) | .key ] | first // $total)
           end) as $end
        | (if $end - $limit < 0 then 0 else $end - $limit end) as $start
        | { session: $s, total: $total, window_truncated: $trunc,
            messages: $all[$start:$end],
            next_before: (if $start > 0 then ($all[$start].ts | tostring) else null end) }'
  exit 0
fi

# The plain view keeps claude's own filter byte for byte; a rollout goes through its reader.
PLAIN='select(.type=="assistant") | (.message.content // []) | map(select(.type=="text")|.text) | join(" ")'
case "$MSGS" in *response_item*) PLAIN="$MSGS"' | select(.role == "assistant") | .text' ;; esac
tail -n 600 "$tr" \
  | jq -r "$PLAIN" 2>/dev/null \
  | grep -v '^[[:space:]]*$' | tail -n "$N"
