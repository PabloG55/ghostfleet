#!/usr/bin/env bash
# claude-here — launch Claude Code *resuming* the conversation that belongs to
# this zellij slot / checkout, instead of a blank `claude`.
#
# Run by ghostfleet as the command for each session, so re-opening a session
# (or rebuilding after a full exit) brings its conversation back in the right
# checkout instead of a blank prompt.
#
# Usage:  claude-here [slot] [-- extra claude args...]
#   slot  a stable per-tab label (e.g. "claude 2") recorded by the hook so the
#         exact session can be matched back. Optional; falls back to cwd.

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"
PROJECTS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"

slot=""
if [ $# -gt 0 ] && [ "$1" != "--" ]; then
  slot="$1"; shift
fi
[ "${1:-}" = "--" ] && shift
[ -n "$slot" ] && export CLAUDE_FLEET_SLOT="$slot"

# Start sessions in bypass ("yolo") mode by default so they don't stop for
# permission prompts — matches how the fleet is meant to run. Opt out with
# CLAUDE_FLEET_YOLO=0.
YOLO=()
case "${CLAUDE_FLEET_YOLO:-1}" in
  0|false|no|off) ;;
  *) YOLO=(--dangerously-skip-permissions) ;;
esac

# Model override (fleet-spawn --model, or a fleet default) so spawned workers
# don't fall back to the account's default model.
MODEL=()
[ -n "${CLAUDE_FLEET_MODEL:-}" ] && MODEL=(--model "$CLAUDE_FLEET_MODEL")

# --- this session's PEER NAME ------------------------------------------------
# Claude Code registers every session under a name that other sessions can address
# directly (SendMessage / ListAgents, ~/.claude/sessions/<pid>.json). Left alone it
# DERIVES that name from the directory — billing-svc-61, acme-api-06 — which no
# fleet command knows and no agent can be told to reply to, so the one reliable way
# an answer could come back was unusable.
#
# Name it what the fleet ALREADY calls this session: <project>/<session>, byte-for-byte
# the address hooks/fleet-event.sh prints in an inbox row and fleet-send computes for
# --reply-to. That makes "answer acme-api/master" an address that resolves instead of a
# label. It also dodges a collision the derived scheme doesn't have to think about:
# every project has a session called `master`, and a bare `master` would make Claude
# Code rename ours out from under the address.
#
# `#cf-` rather than a `cf-*` guard on purpose: fleet-send derives the same name with
# the same expansion, so a socket WITHOUT the prefix yields the same (unstripped) name
# on both sides — one spelling, whatever the socket looks like.
NAME=()
_peer_proj="${CLAUDE_FLEET_SOCK:-}"; _peer_proj="${_peer_proj#cf-}"
_peer_sess="${CLAUDE_FLEET_SLOT:-}"
# An explicit --name is the caller's business, and a second one is an argument error, so
# don't add ours. Both spellings, since only one of them looks like a flag.
for _arg in "$@"; do case "$_arg" in --name|--name=*) _peer_proj="" ;; esac; done
# HALF A NAME IS WORSE THAN NO NAME: "/master" or "acme-api/" is a name nothing can
# address, and passing it would still displace the derived one — so a session with only
# half its identity in the environment goes unnamed and keeps today's behaviour. Same
# for a name that isn't spellable back at us (fleet-send refuses those characters in a
# reply address, and Claude Code renames what it won't accept).
if [ -n "$_peer_proj" ] && [ -n "$_peer_sess" ]; then
  case "$_peer_proj$_peer_sess" in
    *[!A-Za-z0-9._~-]*) ;;
    *) NAME=(--name "$_peer_proj/$_peer_sess") ;;
  esac
fi

# THE OBSERVATION CONTRACT — the one standing instruction every fleet session carries.
#
# MEASURED, over a corpus of real work: of 172 build turns that changed a screen file,
# 154 ran a test, lint or build and FOUR ever opened a browser — on exactly the surfaces
# whose defects came back as photographs. And the toolchain was not buying safety: build
# turns that ran a test drew a correction 39.6% of the time against 26.3% for turns that
# ran nothing. (Confounded by change size, certainly — but it points the wrong way for
# "run the tests and you are covered", which is the belief this contract is aimed at.)
# The human's eyes were the only rendering-layer oracle the work had.
#
# WHY THE SYSTEM PROMPT AND NOT THE BRIEF. A brief is issued once and decays. The same
# corpus holds an agent's own report — "Nobody has opened the UI. I've said this four
# times and it's still true" — from a session where that instruction had already been
# given. A system prompt is re-presented every turn, which is the whole difference
# between a rule that is remembered and a rule that is in force. The subagent guard in
# hooks/fleet-guard.sh is the same argument one step further: in front of the tool.
#
# TWO MORE CLAUSES, each from its own measurement, and each in force every turn.
#
# THE RECEIPT. 60 of 324 corrections are re-reports of a complaint already made. Of the
# 50 whose window is measurable, THIRTY had no source file changed between the two
# statements — median gap 14 minutes, median 13 tool calls, and 26 of the 30 ran
# something. Those are not failed fixes. The agent was still reading the code when the
# same complaint arrived again, because the person who reported it could not see it
# working. So the cost sits on the reporter, and the fix belongs to the agent: say what
# you understood before disappearing. (P(correction | the last turn was one) is 46.6%
# against a 27.1% base rate — the burst is the shape this clause is aimed at.)
#
# THE TWO AXES THE DIVERGENCE CLAUSE KEPT MISSING. Written as "two readings that would
# produce different screens or different stored data", it is product-shaped, and the
# readings that actually go wrong are not. MEASURED IN THIS REPO, on the session that
# produced these commits: a lead was asked to work out what could have been done
# differently, read it as a mandate to BUILD, and shipped a branch and a PR into another
# product before being stopped — then, told to stay out of that product, proposed work in
# it twice more. Two corrections, neither about what to build and both about what the
# deliverable was and where it would land. It is the same shape as the corpus's largest
# late-requirement bucket (19 of 36 "already known to the human and simply not said"):
# the person asking knows which one they meant, so it never gets written down.
# Weaker evidence than the three clauses above — one session plus a category — and worth
# saying so rather than dressing n=1 as a measurement.
#
# THE DIVERGENCE. Asking at the END of a turn is already saturated: the assistant closes
# with a question or an offer in 25.6% of turns and the rework rate is identical either
# way. So "ask more clarifying questions" adds nothing to a channel already full. The one
# published method with a real effect (70.96% -> 80.80% pass@1) does NOT ask from felt
# uncertainty — it generates several solutions and asks only where they BEHAVE
# differently. That distinction is the clause: ask where two implementations would
# visibly differ, not where you feel unsure.
#
# THE EXTRACTION. The largest addressable bucket is 19 of 36 late requirements that were
# "already known to the human and simply not said" — and the first reading of that was
# that nothing could reach them, since a domain rule the asker holds does not look like
# two readings to anyone else. Reading the 23 actual cases says otherwise: they are not
# idiosyncratic, they recur on a few STRUCTURAL axes, and every one is askable without
# knowing the domain. From the data: what the unit is (per line, per document, per
# policy); whether an existing surface this must match, or an existing artifact it should
# reuse instead of recreating; what must be true before the user may advance; whether a
# list handed over is complete or will grow; who is eligible; and how a thing leaves.
#
# Two details decide the shape. First, "is there anything else I should know" is the
# saturated question — it earns "no" and then a correction, which is measured: closing
# with a question changes the rework rate not at all. So the clause requires the
# ASSUMPTION to be stated, not the question asked; a wrong concrete answer gets corrected
# where an open question does not. Second, MEASURED: the late requirement is usually the
# same size as the feature — "host this stepper inside the other surface too" arrived at
# #27 of 40 for a component built for one host — so the axes are cheap against what they
# prevent. One of them was asked at #39 and again at #45 of the same 67-turn run.
#
# RETROACTIVITY, the axis the first six missed. Observed on a live session while these
# commits were being written: a signature-rendering feature, built in the first thirty
# minutes, took its final correction almost three hours later — "and it should backfill
# the already created drafts". A backfill is a migration arriving as a subordinate clause
# at the end of a UI feature, which is the report's "the late requirement is usually the
# same size as the feature" in one line. The same shape appears in the earlier data as
# "a duplicate should leave the queue it was marked a duplicate in". None of the other
# six axes reaches it: it is not the unit, not parity, not reuse, not a gate, not
# completeness, not eligibility. It is whether the change applies to what already exists.
#
# DO NOT HOLD THE TURN OPEN TO WAIT. Measured on that session: between the commit that
# finished the feature and the first word from the human, 233 API calls, 71k output
# tokens and 94M cache reads — 32% of the whole session's calls and 34% of its cache
# reads — spent on 28 sleeps totalling ~16,000 seconds, a dozen until-loops and ten gh
# pr calls. Two records in that window touched anything that could render the artifact
# the feature was about.
#
# The first reading of this was that the agent wasted two hours. It did not: the human
# had left the desk, so the wall-clock was never going to be shorter. THE COST IS
# ELSEWHERE, and it is specific to running inside a fleet. A turn that stays alive never
# ends, and it is the END of a turn that fires the Stop hook, which is what puts `done`
# into fleet-inbox and sends the push. So the one mechanism built to reach someone who
# stepped away was held shut by the very act of waiting for them — they came back to a
# spinning pane and had to interrupt it, rather than finding a done waiting. A session
# that sleeps also reads as WORKING to the governor, which parks sessions and cannot shed
# one that looks busy.
#
# It is already a known correction in this corpus — "dont stay watching a pr" is one of
# twelve process-discipline corrections — which is the argument for putting it somewhere
# it is re-presented rather than re-issued.
#
# THE REFERENCE, and why it is not "write a better brief". The brief that produced that
# three-hour session was a GOOD one: goal, the asset already prepared, three exact
# file:line locations, process instructions. It scores high on every feature the corpus
# measured — length, naming files, naming routes, stating a done-criterion — which is the
# null result made concrete: more of that kind of detail would not have helped. What it
# lacked was three things, and all three became corrections. No size or fill criterion
# ("make the signature bigger"). No fidelity constraint ("dont make it bold keep it the
# same pic"). No retroactivity ("it should backfill the already created drafts").
#
# The sharpest detail is what the first correction pointed AT: an earlier document of the
# same kind that the product had already produced — a reference that existed from the
# start and reached the agent only after two wrong guesses. So
# the axis is not "ask for a better description" — it is: when what you are changing comes
# out as a rendered artifact, ask what it should look like and whether there is an existing
# one to match. The asker almost always has it; nobody thinks to hand it over, because to
# them the answer is obvious.
#
# AND IT NAMES THE TOOL, which the first version did not. fleet-look was built precisely
# to back the observe clause, shipped, tested and put on PATH — and nothing anywhere told a
# worker it existed: not this contract, not the orchestrate skill, not CLAUDE.md. That is
# this document's own thesis inverted. An instruction without a mechanism decays; a
# mechanism nobody is told about is never reached at all, and it looks identical from the
# outside, because in both cases the screen goes unopened.
#
# CLOSING THE LOOP, which is the half the whole exercise started from and the last to
# arrive. The contract already governs ENTRY — say what you understood, ask where two
# builds would visibly differ, name the structural assumptions — and OBSERVATION, which
# asks what you looked at. Nothing joined the two. An agent can truthfully report that it
# observed the rendered screen and still have built the wrong thing, because being asked
# what you observed is not being asked whether it is what was requested.
#
# The target is measured: of 79 corrections that are about the agent rather than the code,
# 23 are "that is not what I asked / you went the wrong way" — the largest of those kinds.
#
# WHY A SELF-CHECK IS WORTH ANYTHING HERE, given the literature says self-verification
# without new information does not work. Two reasons, and the distinction is the whole
# design. First, it is checked against a WRITTEN LIST made before the work began, not
# against the agent's present reasoning — a past commitment is an external artifact, and
# comparing to it is not the same as re-reading your own diff and finding it good. Second,
# it now has an instrument it did not have: fleet-look renders the surface, so "criterion
# met" can cite a picture instead of an opinion.
#
# It is still the cheap version. A separate session, given the brief and the artifact and
# denied the worker's reasoning, is stronger and costs another worker's tokens; this costs
# nothing and runs every time. The row that would justify the expensive one is a criterion
# that is repeatedly marked met and repeatedly corrected anyway.
#
# AND IT MAKES THE TWO HALVES CHECK EACH OTHER. A criterion that was never named at the
# start cannot be closed at the end, so a done-report with nothing to close is a visible
# sign the entry half did not happen — which is otherwise invisible.
#
# Claude-only, deliberately: codex and opencode take no equivalent flag, so their
# sessions keep today's behaviour rather than being handed an argument that is dropped.
# NO APOSTROPHES IN THE CONTRACT TEXT. It is a single-quoted bash string, so one `'`
# ends it: the words after become bare shell tokens, word-split into extra arguments, and
# Claude Code takes the first positional as an INITIAL PROMPT. Measured — a clause that
# quoted a phrase with 'single quotes' truncated the system prompt from 3589 characters to
# 673 and submitted the word "the" as a turn in every new session. Two thirds of the
# contract silently stopped being in force while every test still passed, because the tests
# grepped the whole argv rather than one argument. Use "double quotes" inside; the outer
# single quotes make them literal.
CONTRACT=()
case "${CLAUDE_FLEET_NO_OBSERVE_CONTRACT:-0}" in
  1|true|yes|on) ;;
  *) CONTRACT=(--append-system-prompt 'Before you report work as done, state what you OBSERVED and what you could not check. Running the test suite is not observing the thing you changed. Name what you actually looked at - the rendered screen, the real command output, the stored row - and where you could not look, say which criterion is unchecked rather than letting it read as passed. An unchecked criterion named is worth more than a green that proved nothing. In this fleet you have an instrument for it: fleet-look.mjs <url | file.html | file.pdf | file.png> renders the thing and prints a path to a PNG, and reading that path is you looking at it; add --tree for the accessibility tree, which answers "is the control there and named" better than pixels do. When a correction arrives, say in one line what you understood it to be before you start working - do not disappear into a long stretch of tool calls in silence, because the person who reported it cannot see you working and will restate it. And ask only where two concrete implementations would visibly differ: if a brief supports two readings that would produce different screens or different stored data, name both and ask which, before writing code. Do not ask because you feel uncertain - that question is already asked constantly and changes nothing. Two readings also differ when they differ in WHAT IS DELIVERED - an answer, a report, a change in the working tree, a pushed branch, an open PR, a deployment - or in WHICH repository or checkout the work lands in. Those are the readings least likely to be stated, because the person asking already knows which one they meant. Name them back before you start, not after. And before building anything with structure, state the structural assumptions you are making as concrete answers rather than asking whether anything is missing - an open question earns a yes and then a correction. The axes that recur: what the UNIT is (per line, per document, per policy); whether there is an EXISTING surface this must match or an existing artifact it should reuse instead of recreating; what must be TRUE before the user may advance; whether a list you were handed is COMPLETE or will grow; who is ELIGIBLE; and how a thing LEAVES; and whether the change applies RETROACTIVELY to records that already exist or only to new ones. And when what you are changing comes out as a RENDERED ARTIFACT - a PDF, a screen, an email, an export - ask what it should look like and whether there is an existing one to match, before you build it. The person asking usually has a reference and does not think to hand it over, because to them the answer is obvious; you will otherwise be told after guessing. Answer the ones that apply in one line each and ask which are wrong. Then CLOSE THE LOOP when you report done: restate the surfaces and the done-criteria you named at the start, and mark each one either met - saying how you observed it - or unchecked. Do not mark a criterion met because the code looks right; mark it met because you looked at the thing it is about. If you named no criteria at the start, say that instead of inventing them now, because it is the sign the asking half did not happen. Finally, do not hold the turn open to wait - not for a pipeline, and not for a person. Start it, say you have started it, and END THE TURN. Ending the turn is what notifies: it fires the done event into the inbox and the push, so someone who stepped away is told. Sleeping in a loop tells nobody anything, spends a third of a session on nothing, and reads as working to the governor, which cannot shed a session that looks busy.') ;;
esac

# A parallel session (grid `N`) is a deliberately NEW conversation in this dir —
# never resume, even if the checkout already has one.
case "${CLAUDE_FLEET_FRESH:-0}" in
  1|true|yes|on) echo "claude-here: fresh parallel session in $PWD" >&2; exec claude "${YOLO[@]}" "${MODEL[@]}" "${NAME[@]}" "${CONTRACT[@]}" "$@" ;;
esac

enc="$(printf '%s' "$PWD" | sed 's#[/.]#-#g')"
dir="$PROJECTS/$enc"

# a transcript is only resumable if it has a real turn — an empty/aborted
# session makes `claude --resume/--continue` error out ("No conversation found").
has_turns() { grep -qE '"type":[[:space:]]*"(user|assistant)"' "$1" 2>/dev/null; }

resume_id=""
explicit=0

# 0) EXPLICIT conversation (fleet-open <session-id>): resume exactly this one and
# skip discovery. Deliberately never falls back to "newest in this cwd" — silently
# opening a different conversation than the one asked for is worse than erroring.
if [ -n "${CLAUDE_FLEET_RESUME:-}" ]; then
  resume_id="$CLAUDE_FLEET_RESUME"; explicit=1
  [ -f "$dir/$resume_id.jsonl" ] \
    || echo "claude-here: warning — no transcript $dir/$resume_id.jsonl for this cwd; asking claude anyway" >&2
fi

# 1) exact match: the most recent session for this (zellij session + slot)
if [ "$explicit" != 1 ] && [ -n "$slot" ] && [ -n "${ZELLIJ_SESSION_NAME:-}" ] && command -v jq >/dev/null 2>&1; then
  shopt -s nullglob
  best_ts=0
  for f in "$FLEET_DIR"/*.json; do
    IFS=$'\t' read -r z s id ts < <(
      jq -r '[.zellij, .slot, .session_id, (.ts//0)] | @tsv' "$f" 2>/dev/null)
    [ "$z" = "$ZELLIJ_SESSION_NAME" ] && [ "$s" = "$slot" ] || continue
    if [ "${ts:-0}" -gt "$best_ts" ]; then best_ts="$ts"; resume_id="$id"; fi
  done
fi
# drop the slot match if its transcript is gone or empty (so we don't error out).
# An EXPLICIT id is exempt: we resume what was asked for, or fail loudly.
if [ "$explicit" != 1 ] && [ -n "$resume_id" ] && ! { [ -f "$dir/$resume_id.jsonl" ] && has_turns "$dir/$resume_id.jsonl"; }; then
  resume_id=""
fi

# 2) else the newest REAL conversation in this cwd
if [ "$explicit" != 1 ] && [ -z "$resume_id" ] && [ -d "$dir" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if has_turns "$f"; then resume_id="$(basename "$f" .jsonl)"; break; fi
  done < <(ls -t "$dir"/*.jsonl 2>/dev/null)
fi

# A conversation that's registered as a background agent can't be plain --resume'd:
# Claude refuses with "currently running as a background agent (bg)" and drops to a
# shell — which strands a fleet session (claude-here always resumes). If the target
# is held as a bg agent, branch a copy with --fork-session instead. The fork becomes
# the newest conversation in this dir, so the next open resumes it cleanly (no fork,
# since a fork isn't a bg agent) — self-healing after one fork. If the check isn't
# available it falls through to a plain resume (no worse than before).
is_bg_agent() {
  command -v claude >/dev/null 2>&1 || return 1
  claude agents --json 2>/dev/null | grep -q "$1"
}

# 3) resume if we found a real one; otherwise start FRESH in this dir
if [ -n "$resume_id" ]; then
  FORK=()
  if is_bg_agent "$resume_id"; then
    echo "claude-here: $resume_id is held as a background agent — forking a copy (--fork-session)" >&2
    FORK=(--fork-session)
  fi
  echo "claude-here: resuming $resume_id in $PWD" >&2
  exec claude "${YOLO[@]}" "${MODEL[@]}" "${NAME[@]}" "${CONTRACT[@]}" --resume "$resume_id" "${FORK[@]}" "$@"
fi
echo "claude-here: no resumable conversation in $PWD — starting fresh" >&2
exec claude "${YOLO[@]}" "${MODEL[@]}" "${NAME[@]}" "${CONTRACT[@]}" "$@"
