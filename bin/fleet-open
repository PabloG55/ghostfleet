#!/usr/bin/env bash
# fleet-open <session-id> [--as <name>] [--into <session>] [--list]
#
# Open a SPECIFIC past conversation as a fleet session — the thing `claude --resume
# <id>` (or `codex resume <id>`) does in a bare terminal, but landed on the right
# project's fleet so it shows up as a card you can jump into.
#
#   <session-id>     full id or a unique prefix (e.g. cc7b36af)
#   --as <name>      session/card name (default: resume-<prefix>)
#   --into <session> OVERWRITE an existing session: kill it and reopen that card on
#                    this conversation instead (the old conversation stays on disk —
#                    nothing is deleted, reopen it later with its own id)
#   --force          allow --into master, i.e. make this conversation the fleet's LEAD
#                    (it then owns the inbox + dispatch). Refused from inside that
#                    master — run it from another pane.
#   --list           just print what the id resolves to (transcript, cwd, fleet)
#
# It finds the transcript across every profile (~/.claude, ~/.claude-<profile>),
# reads the conversation's own cwd, routes to the fleet of the project that owns
# that repo, and starts the session there with claude-here (which resumes exactly
# this id — never silently the newest one — and forks it if it's held as a
# background agent).
#
# A CODEX ID IS THE SAME OPERATION. When no claude transcript matches, the id is looked
# up among codex's rollouts ($CODEX_HOME/sessions/YYYY/MM/DD/rollout-*-<id>.jsonl); the
# cwd comes from its session_meta line, and the session starts as codex, which
# codex-here turns into `codex resume <id>`. One command, one routing, one agent branch.
set -uo pipefail

ID=""; AS=""; INTO=""; LIST=0; FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --as)   AS="${2:?}";   shift 2 ;;
    --into) INTO="${2:?}"; shift 2 ;;
    --list) LIST=1; shift ;;
    --force) FORCE=1; shift ;;
    -*) echo "fleet-open: unknown option $1" >&2; exit 1 ;;
    *)  [ -z "$ID" ] && { ID="$1"; shift; } || { echo "fleet-open: unexpected arg $1" >&2; exit 1; } ;;
  esac
done
[ -n "$ID" ] || { echo "fleet-open: usage: fleet-open <session-id> [--as name] [--into session] [--list]" >&2; exit 1; }
command -v tmux >/dev/null 2>&1 || { echo "fleet-open: tmux required" >&2; exit 1; }
command -v jq   >/dev/null 2>&1 || { echo "fleet-open: jq required" >&2; exit 1; }

# --- find the transcript (any profile), by full id or unique prefix -------------
hits=""
for cfg in "$HOME/.claude" "$HOME"/.claude-*; do
  [ -d "$cfg/projects" ] || continue
  while IFS= read -r f; do
    [ -n "$f" ] && hits="$hits$cfg	$f
"
  done < <(find "$cfg/projects" -maxdepth 2 -name "$ID*.jsonl" -type f 2>/dev/null)
done
hits="$(printf '%s' "$hits" | grep -v '^$' || true)"
n="$(printf '%s\n' "$hits" | grep -c . || true)"
AGENT=claude
if [ "${n:-0}" -lt 1 ]; then
  # codex: the profile is the one whose fleet recorded this conversation (codex keeps one
  # store for every profile); with no record, the owning project's profile, decided below.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rcfg="" b="$(basename "$f" .jsonl)"
    for cfg in "$HOME/.claude" "$HOME"/.claude-*; do
      [ -f "$cfg/fleet/${b: -36}.json" ] && { rcfg="$cfg"; break; }   # the id is the uuid tail
    done
    hits="$hits$rcfg	$f
"
  done < <(find "${CODEX_HOME:-$HOME/.codex}/sessions" -name "rollout-*-$ID*.jsonl" -type f 2>/dev/null)
  hits="$(printf '%s' "$hits" | grep -v '^$' || true)"
  n="$(printf '%s\n' "$hits" | grep -c . || true)"
  [ "${n:-0}" -ge 1 ] && AGENT=codex
fi
[ "${n:-0}" -ge 1 ] || { echo "fleet-open: no transcript or codex rollout matching '$ID' in any profile" >&2; exit 1; }
if [ "$n" -gt 1 ]; then
  echo "fleet-open: '$ID' is ambiguous — $n matches:" >&2
  printf '%s\n' "$hits" | while IFS=$'\t' read -r c f; do echo "  $(basename "$f" .jsonl)   ${f/#$HOME/~}" >&2; done
  echo "  pass a longer prefix." >&2; exit 1
fi
CFG_DIR="$(printf '%s' "$hits" | cut -f1)"
TR="$(printf '%s' "$hits" | cut -f2)"
FULL_ID="$(basename "$TR" .jsonl)"

# the conversation's own cwd (authoritative — the encoded dir name is lossy: both
# '/' and '.' become '-', so it can't be decoded back to a path reliably)
if [ "$AGENT" = codex ]; then
  # line 1 of a rollout is session_meta, and it alone carries the id and the cwd
  IFS=$'\x1f' read -r FULL_ID CWD < <(head -1 "$TR" | jq -r 'select(.type=="session_meta") | [.payload.id, .payload.cwd] | join("\u001f")' 2>/dev/null)
else
  CWD="$(jq -r 'select(.cwd != null) | .cwd' "$TR" 2>/dev/null | head -1)"
fi
[ -n "$CWD" ] && [ -d "$CWD" ] || { echo "fleet-open: can't determine a live cwd for $FULL_ID (recorded: ${CWD:-<none>})" >&2; exit 1; }

# --- route to the fleet of the project that owns this repo ---------------------
GITROOT="$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null || echo "$CWD")"
ROOT="$(dirname "$GITROOT")"
SOCK=""; PROJ=""
for cfgf in "$HOME/.config/ghostfleet/projects" "$HOME"/.config/ghostfleet/projects.*; do
  [ -f "$cfgf" ] || continue
# only real profile lists: a suffix like ".bak.1785" is a backup, not a profile — but
# guard ONLY the suffixed ones. On the primary `projects` there is nothing to strip, so
# ## leaves the whole path, whose own '/' and '.' trip the guard: the main list was
# skipped and every work-profile lookup fell through to the ambient fleet instead.
  case "${cfgf##*/}" in
    projects) ;;
    *) case "${cfgf##*/projects.}" in *[!A-Za-z0-9_-]*) continue ;; esac ;;
  esac
  got="$(awk -F'\t' -v r="$ROOT" -v g="$GITROOT" -v home="$HOME" '
    /^[[:space:]]*#/ || NF<2 { next }
    { p=$2; sub(/^~/, home, p); if (p==r || p==g) { print $1 "\t" ($3==""?"work":$3); exit } }' "$cfgf")"
  [ -n "$got" ] && break
done
if [ -n "${got:-}" ]; then
  PROJ="${got%%	*}"; prof="${got##*	}"
  case "$prof" in work|default) SOCK="cf-$PROJ" ;; *) SOCK="cf-$prof-$PROJ" ;; esac
else                                   # unknown repo -> fall back to the ambient fleet
  _t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac
  [ -n "$SOCK" ] || SOCK="${CLAUDE_FLEET_SOCK:-}"
  PROJ="${SOCK#cf-}"
fi
[ -n "$SOCK" ] || { echo "fleet-open: no fleet owns $ROOT and no ambient fleet — run inside a fleet session" >&2; exit 1; }
if [ -z "$CFG_DIR" ]; then             # a codex rollout no fleet has recorded yet
  case "${prof:-work}" in work|default) CFG_DIR="$HOME/.claude" ;; *) CFG_DIR="$HOME/.claude-$prof" ;; esac
fi
FLEET_DIR="$CFG_DIR/fleet"
# THE FLEET'S DIRECTORY, WHATEVER LOGIN THE CONVERSATION RUNS UNDER. CFG_DIR is the profile
# the transcript lives in, which is the only one it resumes under — but the session lands on
# the fleet of the repo's project, and that fleet's readers (the grid, the phone, a
# --reply-to) look in the PROJECT's fleet dir. Deriving it from the transcript's profile put
# a cross-profile reopen's records, owner and park markers where none of them look.
_fsrc="${BASH_SOURCE[0]}"
while [ -L "$_fsrc" ]; do _l="$(readlink "$_fsrc")"; case "$_l" in /*) _fsrc="$_l" ;; *) _fsrc="$(dirname "$_fsrc")/$_l" ;; esac; done
FLEET_ENV="$(cd "$(dirname "$_fsrc")/../lib" 2>/dev/null && pwd)/fleet-env.mjs"
SRV_CFG="$CFG_DIR"
if command -v node >/dev/null 2>&1 && [ -f "$FLEET_ENV" ] \
   && _env="$(node "$FLEET_ENV" of "$SOCK" 2>/dev/null)" && [ -n "$_env" ]; then
  IFS=$'\x1f' read -r _cfg _dir _ <<< "$_env"
  [ -n "$_dir" ] && FLEET_DIR="$_dir"
  [ -n "$_cfg" ] && SRV_CFG="$_cfg"
fi

if [ "$LIST" = 1 ]; then
  echo "id:         $FULL_ID"
  echo "agent:      $AGENT"
  echo "transcript: ${TR/#$HOME/~}"
  echo "cwd:        $CWD"
  echo "profile:    ${CFG_DIR/#$HOME/~}"
  echo "fleet:      $SOCK${PROJ:+  (project $PROJ)}"
  exit 0
fi

# --- one conversation, one pane ------------------------------------------------
# Checked BEFORE --into kills anything: a refusal from the launcher afterwards would leave
# the target's card dead as well. The one holder that is fine is the --into target itself,
# which is about to be killed (re-placing the conversation a slot already runs).
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do _tg="$(readlink "$_src")"; case "$_tg" in /*) _src="$_tg" ;; *) _src="$(dirname "$_src")/$_tg" ;; esac; done
_lib="$(cd "$(dirname "$_src")/../lib" 2>/dev/null && pwd)/slot-claim.mjs"
if [ -f "$_lib" ] && command -v node >/dev/null 2>&1 \
   && holder="$(CLAUDE_CONFIG_DIR="$CFG_DIR" node "$_lib" held --grace 0 --agent "$AGENT" --id "$FULL_ID" --transcript "$TR" 2>/dev/null)"; then
  _ok=0
  if [ -n "$INTO" ] && [ "$holder" != "?" ]; then
    _pp="$(tmux -L "$SOCK" display-message -p -t "$INTO" '#{pane_pid}' 2>/dev/null)" _p="$holder"
    for _ in 1 2 3 4 5 6 7 8; do
      [ -n "$_p" ] && [ "$_p" != 0 ] && [ "$_p" != 1 ] || break
      [ "$_p" = "$_pp" ] && { _ok=1; break; }
      _p="$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ')"
    done
  fi
  [ "$_ok" = 1 ] || { echo "fleet-open: refusing — $FULL_ID is open in live process $holder; a conversation is never resumed into a second pane" >&2; exit 1; }
fi

# --- pick the session name ------------------------------------------------------
if [ -n "$INTO" ]; then
  tmux -L "$SOCK" has-session -t "$INTO" 2>/dev/null \
    || { echo "fleet-open: no session '$INTO' on $SOCK (see: fleet-list)" >&2; exit 1; }
  # Replacing the LEAD is allowed, but only on purpose: master is what drains the
  # inbox, gets the workers' nudges and dispatches them, so whatever conversation
  # lands here inherits those duties. Never run this from inside the master you are
  # replacing — killing it kills the command mid-flight and leaves the fleet leaderless.
  if [ "$INTO" = master ] && [ "$FORCE" != 1 ]; then
    echo "fleet-open: '--into master' replaces the fleet's LEAD — pass --force if that's what you want (or --as <name> to open it as its own card)" >&2
    exit 1
  fi
  if [ "$INTO" = master ]; then
    _me="${TMUX:-}"; case "${_me##*/}" in cf-*) _me="${_me%%,*}"; _me="${_me##*/}" ;; *) _me="" ;; esac
    if [ -n "$_me" ] && [ "$_me" = "$SOCK" ] && [ "${CLAUDE_FLEET_SLOT:-}" = master ]; then
      echo "fleet-open: refusing — you ARE $SOCK's master; this would kill the session running this command. Run it from another pane." >&2
      exit 1
    fi
    echo "fleet-open: replacing $SOCK's LEAD with this conversation — it inherits the inbox/dispatch role" >&2
  fi
  old_cwd="$(tmux -L "$SOCK" display-message -t "$INTO" -p '#{pane_current_path}' 2>/dev/null)"
  [ "$old_cwd" = "$CWD" ] || echo "fleet-open: note — '$INTO' sits in $old_cwd but this conversation belongs to $CWD; opening it in $CWD" >&2
  name="$INTO"
  tmux -L "$SOCK" kill-session -t "$INTO" 2>/dev/null
  echo "fleet-open: replacing '$INTO' (its previous conversation is still on disk)"
else
  base="${AS:-resume-${FULL_ID%%-*}}"
  name="$base"; i=2
  while tmux -L "$SOCK" has-session -t "$name" 2>/dev/null; do name="$base~$i"; i=$((i + 1)); done
fi

# a stale park marker would boot the fresh session "parked" (same guard as fleet-spawn)
rm -f "$FLEET_DIR/$SOCK.$name.parked" "$FLEET_DIR/$name.parked" 2>/dev/null

# The client's env is the FLEET's (a server this starts takes it as its global one); the
# session's own -e is the conversation's login, which outranks it for this session only.
env CLAUDE_CONFIG_DIR="$SRV_CFG" CLAUDE_FLEET_DIR="$FLEET_DIR" \
tmux -L "$SOCK" new-session -d -s "$name" -c "$CWD" \
  -e "CLAUDE_CONFIG_DIR=$CFG_DIR" -e "CLAUDE_FLEET_DIR=$FLEET_DIR" -e "CLAUDE_FLEET_SOCK=$SOCK" \
  -e "CLAUDE_FLEET_RESUME=$FULL_ID" -e "CLAUDE_FLEET_AGENT=$AGENT" -e "CLAUDE_FLEET_FRESH=0" \
  "exec agent-here \"$name\"" \
  || { echo "fleet-open: failed to start the session" >&2; exit 1; }
command -v node >/dev/null 2>&1 && [ -f "$FLEET_ENV" ] \
  && node "$FLEET_ENV" heal "$SOCK" 2>/dev/null | sed 's/^/fleet-open: /' >&2

# A DELIBERATE PLACEMENT, written down. When two records later claim this slot — a crash
# leaves the replaced conversation's record behind — this is what settles it
# (lib/slot-claim.mjs), ahead of name history: the person who put it here decided.
printf '%s\t%s\n' "$FULL_ID" "$(date +%s)" > "$FLEET_DIR/$SOCK.$name.owner" 2>/dev/null || true

echo "fleet-open: opened $FULL_ID as '$name' on $SOCK (cwd $CWD)"
echo "fleet-open: jump in from the grid, or: fleet-send $name \"<message>\""
