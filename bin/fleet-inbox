#!/usr/bin/env bash
# fleet-inbox [-s SOCKET] [--session NAME] [--all] [--clear]
#
# The lead's ATTENTION feed. Workers can't push into a busy lead, and having the
# lead poll every sibling (fleet-read × N) burns the shared budget. So instead,
# events that actually need the lead are collected passively — the event hook
# appends a worker's "need-you" (permission / limit / a real question), its "done", and
# "resumed" for a turn a resume prompt started that produced nothing; the budget
# governor appends "parked"/"resumed" — into <sock>.inbox. Every "resumed" row in view
# is folded into one line (fold_resumed). ONE call here
# drains what's new since you last looked, so you learn who needs you without
# polling anyone.
#
#   (default)  show entries you haven't seen yet, then mark them seen
#   --all      show the whole inbox (doesn't change what's "seen")
#   --clear    empty the inbox
#   --session  read NAME's inbox instead of the caller's (see "WHOSE INBOX" below)
#
# Socket defaults to $CLAUDE_FLEET_SOCK.
set -uo pipefail

SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer $TMUX (the live server this session runs in) over the env var — it's
# drift-proof; a long-running --resume/--fork Claude can hold a stale
# CLAUDE_FLEET_SOCK. Only when it names a cf-* fleet server; -s still overrides.
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac
MODE=new; READER=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s)      SOCK="${2:-}"; shift 2 ;;
    --session) READER="${2:-}"; shift 2 ;;
    --all)   MODE=all;   shift ;;
    --clear) MODE=clear; shift ;;
    *) echo "fleet-inbox: unknown arg $1" >&2; exit 1 ;;
  esac
done
[ -n "$SOCK" ] || { echo "fleet-inbox: no socket (run inside a fleet session, or pass -s <socket>)" >&2; exit 1; }

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"
# WHOSE INBOX. The fleet's inbox is master's: every top-level worker's done and need-you.
# A SUB-LEAD has its own, <sock>.<name>.inbox, because its children report to it and not
# to master (hooks/fleet-event.sh, bin/fleet-spawn) — so the caller is asked who it is,
# the same way fleet-stop asks: its pane first, then the name it was launched with. Only
# a session that HAS children, or has been written to as a parent, reads its own; every
# other caller — master, a plain worker, the phone's server with no session at all — reads
# the fleet's inbox exactly as before.
if [ -z "$READER" ]; then
  case "${TMUX:-}" in *"/$SOCK,"*)
    [ -n "${TMUX_PANE:-}" ] && READER="$(tmux -L "$SOCK" display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)" ;; esac
  [ -n "$READER" ] || READER="${CLAUDE_FLEET_SLOT:-}"
  if [ -n "$READER" ] && [ "$READER" != master ] && [ ! -e "$FLEET_DIR/$SOCK.$READER.inbox" ] \
     && ! grep -qxF -- "$READER" "$FLEET_DIR/$SOCK".*.parent 2>/dev/null; then
    READER=""
  fi
fi
case "$READER" in *[!A-Za-z0-9._~-]*) echo "fleet-inbox: '$READER' is not a session name" >&2; exit 1 ;; esac
if [ -n "$READER" ] && [ "$READER" != master ]; then
  INBOX="$FLEET_DIR/$SOCK.$READER.inbox"
  SEEN="$FLEET_DIR/$SOCK.$READER.inbox.seen"
else
  INBOX="$FLEET_DIR/$SOCK.inbox"
  SEEN="$FLEET_DIR/$SOCK.inbox.seen"
fi

# ── PENDING OR CLEARED ────────────────────────────────────────────────────────
# A need-you row used to be a line like any other: read once, marked seen, and from then on
# indistinguishable from history. Measured on a real incident: a worker stopped on a
# permission dialog at 20:31, the lead drained the inbox at 20:34 and found that row beside
# the same worker's DONE, read it as over, and nobody told the owner. So every need-you row
# says which it is:
#   PENDING  the worker's pane still shows a prompt — asked of the pane, the same detector
#            fleet-answer uses, and only for the LATEST need-you of a worker with nothing
#            after it. A pending one is listed at the TOP of every call, seen or not.
#   CLEARED  when it stopped: the first event the worker sent after it (the hook writes it
#            to <inbox>.cleared), or its next row in the inbox; failing both, the moment this
#            first found the pane clear, which is then written down so the time holds still.
# A decline by Esc fires no event at all, which is why the pane, not the record, decides.
CLEARED="$INBOX.cleared"
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _lnk="$(readlink "$_src")"; case "$_lnk" in /*) _src="$_lnk" ;; *) _src="$(dirname "$_src")/$_lnk" ;; esac
done
DETECT="$(cd "$(dirname "$_src")" 2>/dev/null && pwd)/../lib/permission-dialog.mjs"

hhmm() { date -r "$1" +%H:%M 2>/dev/null || date -d "@$1" +%H:%M 2>/dev/null || echo '--:--'; }

# Is <session>'s need-you still on its pane? 0 yes, 1 no, 2 the session is gone. A row from
# another fleet (Jarvis's inbox names "<project>/<session>") is asked on that fleet's socket.
# No node or no detector: "yes" — a block shown twice costs a look, one hidden is the bug.
still_asking() {                      # $1=session $2=detail
  local sock="$SOCK" slot="$1" lim="" pane
  case "$1" in */*) sock="cf-${1%/*}"; slot="${1##*/}" ;; esac
  case "$sock$slot" in *[!A-Za-z0-9._~-]*) return 1 ;; esac
  tmux -L "$sock" has-session -t "=$slot" 2>/dev/null || return 2
  [ -f "$DETECT" ] && command -v node >/dev/null 2>&1 || return 0
  case "$2" in limit:*|*[Ll]imit*) lim=--limit ;; esac
  pane="$(tmux -L "$sock" capture-pane -p -t "$slot" 2>/dev/null)"
  node "$DETECT" --ask $lim <<< "$pane" >/dev/null 2>&1
  case "$?" in 0|2) return 0 ;; *) return 1 ;; esac
}

# Every row, numbered, with its state: "<n>\x1f<ts>\x1f<session>\x1f<event>\x1f<state>\x1f<detail>"
# — \x1f because the state is empty on every row that is not a need-you, and a tab IFS
# would collapse it (CLAUDE.md). state: pending | cleared:<epoch> | gone:<epoch> | ''.
annotate() {
  local cf="$CLEARED" n ts sess ev st detail c now
  [ -f "$cf" ] || cf=/dev/null
  now="$(date +%s)"
  while IFS=$'\x1f' read -r n ts sess ev st detail; do
    case "$st" in open*)
      c="${st#open:}"
      still_asking "$sess" "$detail"
      case "$?" in
        0) st=pending ;;
        2) st="gone:${c:-$now}" ;;
        *) if [ -z "$c" ]; then c="$now"; printf '%s\t%s\n' "$now" "$sess" >> "$CLEARED" 2>/dev/null; fi
           st="cleared:$c" ;;
      esac ;;
    esac
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$n" "$ts" "$sess" "$ev" "$st" "$detail"
  done < <(awk -F'\t' -v cf="$cf" '
    FILENAME == cf { if ($1 ~ /^[0-9]+$/ && $2 != "") { k = ++nc[$2]; ct[$2, k] = $1 } ; next }
    { n++; ts[n] = $1; ss[n] = $2; ev[n] = $3; dt[n] = $4 }
    END {
      for (i = n; i >= 1; i--) { nx[i] = (ss[i] in after) ? after[ss[i]] : ""; after[ss[i]] = ts[i] }
      for (i = 1; i <= n; i++) {
        st = ""
        if (ev[i] == "need-you") {
          c = ""
          for (k = 1; k <= nc[ss[i]]; k++) { t = ct[ss[i], k]; if (t + 0 >= ts[i] + 0 && (c == "" || t + 0 < c + 0)) c = t }
          if (nx[i] != "") { if (c == "" || nx[i] + 0 < c + 0) c = nx[i]; st = "cleared:" c }
          else st = "open:" c
        }
        printf "%s\037%s\037%s\037%s\037%s\037%s\n", i, ts[i], ss[i], ev[i], st, dt[i]
      }
    }' "$cf" "$INBOX")
}

# annotated rows in -> human-readable out
fmt() {
  local n ts sess ev st detail up
  while IFS=$'\x1f' read -r n ts sess ev st detail; do
    [ -n "$ts" ] || continue
    up="$(printf '%s' "$ev" | tr '[:lower:]' '[:upper:]')"
    case "$st" in
      pending)   up="$up (pending)" ;;
      cleared:*) up="$up (cleared $(hhmm "${st#cleared:}"))" ;;
      gone:*)    up="$up (cleared — session gone)" ;;
    esac
    # 22, not 14: a relayed answer (fleet-send --reply-to) names its sender as
    # "<project>/<session>", because the session answering you is in another fleet and
    # a bare name there is ambiguous — every project has one called `master`. At 14 the
    # project ate the column and every row read as the same responder.
    printf '%s  %-22s %-9s %s\n' "$(hhmm "$ts")" "${sess:0:22}" "$up" "$detail"
  done
}

# ── RESUMES FOLD INTO ONE LINE ─────────────────────────────────────────────────
# A park and its resume are bookkeeping, not results, and a night of budget parks used to
# leave a lead a column of rows to read past: the governor's `resumed` for each un-park, and
# a DONE for every turn a resume prompt started, each opened to find "nothing to pick up".
# The hook now files that turn as `resumed` unless it made something (hooks/fleet-event.sh,
# RESUME_TAG), and here every `resumed` row in view becomes ONE line where the last of them
# was: "4 workers  RESUMED  nothing new — acme-api, toolbox, …". A worker whose DONE comes
# after its last resume is left out of it, because that DONE is its news. Annotated rows
# in, annotated rows out, so fmt draws the line like any other.
fold_resumed() {
  awk -F'' '
    { row[NR] = $0; ev[NR] = $4; ss[NR] = $3 }
    END {
      for (i = 1; i <= NR; i++) {
        if (ev[i] == "resumed") { at[ss[i]] = i; cnt[ss[i]]++; lastr = i }
        else if (ev[i] == "done") delete at[ss[i]]
      }
      k = 0; for (s in at) { k++; one = s }
      for (i = 1; i <= NR; i++) {
        if (ev[i] != "resumed") { print row[i]; continue }
        if (i != lastr || k == 0) continue
        split(row[i], f, "")
        if (k == 1) { who = one; d = "nothing new" (cnt[one] > 1 ? " (resumed " cnt[one] " times)" : "") }
        else {
          who = k " workers"; d = ""
          for (j = 1; j <= NR; j++) if (ev[j] == "resumed" && at[ss[j]] == j) d = d (d == "" ? "" : ", ") ss[j]
          d = "nothing new — " d
        }
        printf "%s\037%s\037%s\037resumed\037\037%s\n", f[1], f[2], who, d
      }
    }'
}

# The pending ones, first thing on every call — and the command that answers each.
pinned() {
  local rows n who
  rows="$(grep -E $'^[^\x1f]*\x1f[^\x1f]*\x1f[^\x1f]*\x1fneed-you\x1fpending\x1f' <<< "$ANN" || true)"
  [ -n "$rows" ] || return 0
  n="$(grep -c . <<< "$rows")"
  echo "NEEDS YOU NOW ($n) — still on the worker's screen; this stays here until it clears:"
  while IFS=$'\x1f' read -r _ ts sess _ _ detail; do
    printf '  %s  %-22s %s\n' "$(hhmm "$ts")" "${sess:0:22}" "${detail:-(no detail — fleet-read $sess)}"
    case "$sess" in */*) who="-s cf-${sess%/*} ${sess##*/}" ;; *) who="$sess" ;; esac
    printf '         → fleet-answer %s, or tell the owner (approving a tool call is theirs)\n' "$who"
  done <<< "$rows"
  echo
}

if [ "$MODE" = clear ]; then
  : > "$INBOX" 2>/dev/null || true
  rm -f "$CLEARED" 2>/dev/null
  printf '0\n' > "$SEEN" 2>/dev/null || true
  echo "inbox: cleared"
  exit 0
fi


# FINISHED WORK DOES NOT ANNOUNCE ITSELF. A worker that merges its PR and goes idle
# leaves a worktree behind, and nothing ever said so — one fleet reached 19 of them, 15
# idle, before anyone counted. The nudge already sends a lead here when a worker
# finishes, so this is the one place the fact reliably gets read.
#   Surfaced, never acted on: the lead decides. And it is a footer on EVERY exit path,
# because "inbox: nothing new" is the most common answer and the one you would otherwise
# never see it under.
reclaimable() {
  local wt out n
  wt="$(dirname "$0")/fleet-worktrees"
  [ -x "$wt" ] || return 0
  out="$("$wt" -s "$SOCK" --done 2>/dev/null)" || return 0
  n="$(printf '%s' "$out" | grep -c . || true)"
  [ "${n:-0}" -gt 0 ] || return 0
  echo
  echo "finished & reclaimable ($n) — PR merged, no session, clean:"
  printf '%s\n' "$out" | while IFS=$'\t' read -r p b; do
    [ -n "$p" ] || continue; echo "  ${p##*/}  ($b)"
  done
  echo "  reclaim: fleet-clean --go"
}

# ...AND A FINISHED WORKER THAT IS STILL RUNNING is the case above one step earlier: its
# task shipped, but its session is live, so the worktree reads as occupied and never
# reaches that list. Leaving it up invites the habit this repo no longer wants — handing
# it the next task, which then gets worked through everything the last one left in its
# context. A new task is a new session, so name the command that retires this one.
#   bin/fleet-shipped decides (the same answer fleet-send refuses on), and an open PR is
# never listed: a worker with a live PR still has follow-ups coming.
finished_live() {
  local sh s why out=""
  sh="$(dirname "$0")/fleet-shipped"
  [ -x "$sh" ] || return 0
  while IFS= read -r s; do
    case "$s" in ''|master|_term-*|_edit-*) continue ;; esac
    why="$("$sh" -s "$SOCK" "$s" 2>/dev/null)" || continue
    out="$out  $s  ($why)  →  fleet-stop --reclaim $s
"
  done < <(tmux -L "$SOCK" list-sessions -F '#{session_name}' 2>/dev/null)
  [ -n "$out" ] || return 0
  echo
  echo "finished workers — task shipped, session still up (a new task is a new session):"
  printf '%s' "$out"
}
# ...AND WHAT A STOPPED WORKER LEFT ITS LEAD, ONCE IT LANDS. fleet-stop carries a worker's
# unfinished ledger items to its lead when its PR is still open, with the branch and PR number
# on each; when that PR merges, the merge is the proof the carried brief was waiting for. Read
# here because this is where the lead already reads merges, from fleet-merged's shared cache:
# no model call, and lib/ledger-landed.mjs asks nothing at all unless the lead holds such an
# item. Measured before it: 23 carried items open in one lead's ledger, many for work merged.
ledger_landed() {
  local lib repo out
  lib="$(cd "$(dirname "$_src")" 2>/dev/null && pwd)/../lib/ledger-landed.mjs"
  [ -f "$lib" ] && command -v node >/dev/null 2>&1 || return 0
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  out="$(node --no-warnings "$lib" "$FLEET_DIR" "$SOCK" "${READER:-master}" "$(dirname "$0")/fleet-merged" "$repo" 2>/dev/null </dev/null)"
  [ -n "$out" ] || return 0
  echo; printf '%s\n' "$out"
}
reclaim_hints() { ledger_landed; finished_live; reclaimable; }

# A PROMPT THE MOD REFUSED, THAT NO SENDER READ. fleet-send reports a failed handoff and
# removes its receipt; one still on disk was read by nobody (fleet-send gave up waiting, or
# it failed after), so it is filed here as a `failed` row before the inbox is read
# (lib/handoff-sweep.mjs). Without node it stays on disk for a reader that has it.
SWEEP="$(cd "$(dirname "$_src")" 2>/dev/null && pwd)/../lib/handoff-sweep.mjs"
[ -f "$SWEEP" ] && command -v node >/dev/null 2>&1 && node "$SWEEP" "$FLEET_DIR" "$SOCK" >/dev/null 2>&1

[ -f "$INBOX" ] && [ -s "$INBOX" ] || { echo "inbox: (empty)"; reclaim_hints; exit 0; }
ANN="$(annotate)"

if [ "$MODE" = all ]; then
  pinned
  n="$(wc -l < "$INBOX" | tr -d ' ')"
  echo "inbox — all ($n):"
  fold_resumed <<< "$ANN" | fmt
  reclaim_hints
  exit 0
fi

# default: only what's new since the stored line-offset, then advance it. The pinned block
# is not part of "new": a pending need-you is shown on every call until it clears.
total="$(wc -l < "$INBOX" | tr -d ' ')"
seen="$(cat "$SEEN" 2>/dev/null || echo 0)"; case "$seen" in ''|*[!0-9]*) seen=0 ;; esac
pinned
if [ "$total" -le "$seen" ]; then
  [ "$seen" -gt "$total" ] && printf '%s\n' "$total" > "$SEEN" 2>/dev/null   # inbox was cleared/rotated
  echo "inbox: nothing new"
  reclaim_hints
  exit 0
fi
echo "inbox — $((total - seen)) new:"
awk -F'\037' -v from="$((seen + 1))" '$1 + 0 >= from' <<< "$ANN" | fold_resumed | fmt
printf '%s\n' "$total" > "$SEEN" 2>/dev/null || true
reclaim_hints
