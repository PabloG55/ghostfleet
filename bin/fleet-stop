#!/usr/bin/env bash
# fleet-stop [-s SOCKET] [--reclaim [--force]] <session>   (flags may go on either side)
#
# Cleanly STOP a fleet worker: kill its tmux session and clear ALL of its fleet
# state — the status file, the park + schedule markers (and the detached schedule
# waiter, which outlives the session), and its manifest entry.
#
# Use it when a worker is done for good, or when it's an ORPHAN: `git worktree
# remove <dir>` deletes the checkout but the worker's tmux session keeps running
# (its cwd just vanishes), so it lingers in `fleet-list` forever. fleet-pause only
# PARKS (keeps the session); this is the actual "stop".
#
# On its own it does NOT touch git — the checkout stays. `--reclaim` finishes the job:
# stop the worker AND remove its worktree, so "this one is done" is one command instead
# of a stop here and a `git worktree remove` somewhere else. A worker cannot do this for
# itself: its cwd IS the worktree, and pulling it out from under a live session is what
# produces "working directory no longer exists".
#   The decision of whether removal is safe is NOT made here. It is delegated to
# `fleet-clean --only <path> --go`, which owns the gates (clean tree, no other session,
# PR merged or fully pushed) — a second copy of those rules is a second thing to be
# wrong, and being wrong here deletes work.
#
# `--force` (only with --reclaim) is the ESCALATION for when those gates decline: the
# gated attempt still runs and still prints its reason, and only a worktree that survived
# it is then removed — by `fleet-clean --only <path> --go --force`, which is where "remove
# anyway" lives. NOT by a `git worktree remove` of our own: the first cut of this did
# exactly that and immediately owned a second copy of which gates may be skipped and
# which may not, in the file whose own header says a second copy is a second thing to be
# wrong. That is the same two-step the grid offers on a free-worktree card — "remove
# worktree 'api-3' (feat/x)?" and then, on git's refusal, "f = remove anyway" — and one
# implementation is what lets the TUI and the phone (bin/fleet-serve) mean the same thing
# by it. It DELETES UNCOMMITTED WORK by design.
#
# Socket defaults to $CLAUDE_FLEET_SOCK.
set -uo pipefail

SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer $TMUX (the live server this session runs in) over the env var — it's
# drift-proof; a long-running --resume/--fork Claude can hold a stale
# CLAUDE_FLEET_SOCK. Only when it names a cf-* fleet server; -s still overrides.
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac
# FLAGS ARE ACCEPTED IN ANY POSITION. The first cut broke out of this loop at the first
# non-flag, so `fleet-stop <session> --reclaim` parsed the session and then SILENTLY
# DROPPED the flag — the session stopped, the worktree stayed, and nothing said why. A
# real agent hit that within a day, having copied the order from this repo's own skill
# table. An option that is ignored without complaint is worse than one that errors.
RECLAIM=0; FORCE=0; SESSION=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s)        SOCK="${2:-}"; shift 2 ;;
    --reclaim) RECLAIM=1; shift ;;
    --force)   FORCE=1;   shift ;;
    -*)        echo "fleet-stop: unknown option $1" >&2; exit 1 ;;
    *)         [ -z "$SESSION" ] && SESSION="$1" || { echo "fleet-stop: unexpected arg $1" >&2; exit 1; }
               shift ;;
  esac
done

# --force without --reclaim would read as a harder stop and do nothing at all: nothing
# on the non-reclaim path touches git. Refuse it rather than accept it silently — the
# same rule the flag-order comment above was written for.
[ "$FORCE" = 1 ] && [ "$RECLAIM" != 1 ] \
  && { echo "fleet-stop: --force only means something with --reclaim (without it nothing touches git)" >&2; exit 1; }
[ -n "$SOCK" ]    || { echo "fleet-stop: no socket (run inside a fleet session, or pass -s <socket>)" >&2; exit 1; }
[ -n "$SESSION" ] || { echo "fleet-stop: usage: fleet-stop [-s socket] <session>" >&2; exit 1; }
[ "$SESSION" = master ] && { echo "fleet-stop: refusing to stop 'master' (the lead)" >&2; exit 1; }
[ -n "${CLAUDE_FLEET_SLOT:-}" ] && [ "$SESSION" = "$CLAUDE_FLEET_SLOT" ] \
  && { echo "fleet-stop: refusing to stop the calling session ('$SESSION')" >&2; exit 1; }

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"

# WHERE THIS WORKER LIVES, asked while it is still alive. Once the session is killed
# tmux cannot answer, and the manifest can be stale for a session that was renamed or
# rebuilt — so read the pane's cwd first and keep it.
WT=""
if [ "$RECLAIM" = 1 ]; then
  WT="$(tmux -L "$SOCK" display-message -p -t "$SESSION" '#{pane_current_path}' 2>/dev/null)"
  # the pane may be deeper in the tree than the checkout root; resolve to the worktree
  [ -n "$WT" ] && WT="$(git -C "$WT" rev-parse --show-toplevel 2>/dev/null || true)"
fi

# 1) kill the schedule waiter first — it's a detached process group that outlives
#    the tmux session, so killing the session alone would leave it to fire later.
sched="$FLEET_DIR/$SOCK.$SESSION.sched"
if [ -f "$sched" ] && command -v jq >/dev/null 2>&1; then
  pid="$(jq -r '.pid // empty' "$sched" 2>/dev/null)"
  [ -n "$pid" ] && { kill -- "-$pid" 2>/dev/null; kill "$pid" 2>/dev/null; }
fi

# 2) kill the tmux session (this is what removes it from fleet-list / the grid)
if tmux -L "$SOCK" has-session -t "$SESSION" 2>/dev/null; then
  tmux -L "$SOCK" kill-session -t "$SESSION" 2>/dev/null \
    && echo "fleet-stop: killed session '$SESSION'"
else
  echo "fleet-stop: no live session '$SESSION' on $SOCK — clearing any leftover state" >&2
fi

# 3) clear its fleet state so nothing stale lingers
rm -f "$FLEET_DIR/$SOCK.$SESSION.parked" "$FLEET_DIR/$SESSION.parked" \
      "$FLEET_DIR/$SOCK.$SESSION.sched"  "$FLEET_DIR/$SESSION.sched"  2>/dev/null
# per-session auto-nudge overrides (grid settings page) — drop them too, so a future
# session that reuses this name doesn't silently inherit a stale explicit on/off.
rm -f "$FLEET_DIR/$SOCK.$SESSION.notify-lead" "$FLEET_DIR/$SOCK.$SESSION.notify-lead-off" 2>/dev/null
# a pending reply address (fleet-send --reply-to): the session that would have answered
# is gone, and a name-reuser must not inherit a stranger's question to answer.
rm -f "$FLEET_DIR/$SOCK.$SESSION.reply-to" "$FLEET_DIR/$SOCK.$SESSION.reply-to.armed" 2>/dev/null
# the display label too, or a session that reuses this name inherits a stranger's title
rm -f "$FLEET_DIR/$SOCK.$SESSION.label" 2>/dev/null

# The dev-stack slot is keyed by WORKTREE PATH, so release it before the manifest row
# (the only thing that still knows which path this session held) is dropped. A slot left
# held by a session that is gone fills the pool up with nothing, and the next spawn is
# refused for a shortage that isn't real.
MANIFEST="$FLEET_DIR/$SOCK.manifest.tsv"
if [ -f "$MANIFEST" ]; then
  wt="$(awk -F'\t' -v s="$SESSION" '$2==s{print $1; exit}' "$MANIFEST" 2>/dev/null)"
  [ -n "$wt" ] && "$(dirname "$0")/fleet-slot" release "$wt" >/dev/null 2>&1
fi

if [ -f "$MANIFEST" ]; then
  mtmp="$MANIFEST.$$.tmp"
  awk -F'\t' -v s="$SESSION" '$2!=s' "$MANIFEST" >"$mtmp" 2>/dev/null \
    && mv -f "$mtmp" "$MANIFEST" 2>/dev/null || rm -f "$mtmp" 2>/dev/null
fi

# per-session status file(s) (keyed by session_id; .slot is the session name) so
# it disappears from fleet-list / the grid immediately
if command -v jq >/dev/null 2>&1; then
  for f in "$FLEET_DIR"/*.json; do
    [ -f "$f" ] || continue
    [ "$(jq -r '.slot // empty' "$f" 2>/dev/null)" = "$SESSION" ] && rm -f "$f" 2>/dev/null
  done
fi

if [ "$RECLAIM" != 1 ]; then
  echo "fleet-stop: cleared '$SESSION' state. If its git worktree dir is stale, run: git worktree prune"
  exit 0
fi

echo "fleet-stop: cleared '$SESSION' state."
if [ -z "$WT" ]; then
  echo "fleet-stop: could not tell which worktree '$SESSION' was in — nothing removed." >&2
  exit 0
fi
# Never the main checkout, whatever the session was called: git-dir == git-common-dir
# only in a repo's own root, and that is somebody's home rather than a task's leftovers.
if [ "$(git -C "$WT" rev-parse --git-dir 2>/dev/null)" = "$(git -C "$WT" rev-parse --git-common-dir 2>/dev/null)" ]; then
  echo "fleet-stop: '$WT' is a main checkout, not a worktree — left alone." >&2
  exit 0
fi
MAIN_CO="$(git -C "$WT" worktree list 2>/dev/null | head -1 | awk '{print $1}')"
CLEAN="$(dirname "$0")/fleet-clean"
[ -x "$CLEAN" ] || { echo "fleet-stop: fleet-clean not found — worktree left at $WT" >&2; exit 0; }
# Runs FROM the main checkout: fleet-clean resolves its repo from $PWD, and the
# directory it is about to remove is a poor place to be standing.
( cd "$MAIN_CO" 2>/dev/null && "$CLEAN" -s "$SOCK" --only "$WT" --go ) | sed 's/^/  /'
if [ ! -d "$WT" ]; then echo "fleet-stop: reclaimed $WT"; exit 0; fi
if [ "$FORCE" != 1 ]; then
  echo "fleet-stop: kept $WT (see the reason above)"
  echo "fleet-stop: remove it anyway with: fleet-stop -s $SOCK --reclaim --force $SESSION"
  exit 0
fi

# --- remove anyway ----------------------------------------------------------
# Same command, same --only, plus --force: fleet-clean skips the three gates that ask
# whether the WORK is finished and keeps the ones that ask whether removal would break
# something nobody asked about (a live session standing there, the main checkout, Claude's
# own trees). Reported honestly either way, because a force that silently left the
# directory behind is the worst of the three outcomes.
( cd "$MAIN_CO" 2>/dev/null && "$CLEAN" -s "$SOCK" --only "$WT" --go --force ) | sed 's/^/  /'
[ -d "$WT" ] && { echo "fleet-stop: could not remove $WT even with --force (see above)" >&2; exit 1; } \
             || echo "fleet-stop: force-removed $WT (past fleet-clean's gates, on request)"
