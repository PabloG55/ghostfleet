#!/usr/bin/env bash
# ghostfleet — the single control plane for parallel Claude Code sessions.
# Run it as the one pane in your zellij session:
#
#   Projects  →  ⏎  →  Master Claude  →  C-s  →  the session grid
#
# Shortcuts that skip a level:
#   Projects, ^S  ->  that project's session grid directly (no master); leaving the
#                     grid returns to Projects, since master was never asked for
#   grid,     ^P  ->  straight back to Projects (instead of into master)
#   any screen, 1-9  ->  jump to that numbered card (project, or session in the grid)
#   chat/master, C-f <p> <s>    ->  project p, session s      (e.g. C-f 1 1)
#   chat/master, C-f <p> Enter  ->  project p's MASTER        (m also works)
#   chat/master, C-f <p> s      ->  project p's session GRID  (or C-f s <p>)
#
# Each project has its own hidden tmux server (cf-<project>) holding its sessions.
# Node draws the screens; tmux does the PTY work. From master, ` (or C-a g) steps
# back to Projects; from the grid it steps back to master.
#
#   ghostfleet                 project picker (work profile)
#   ghostfleet <profile>       a separate profile — its own projects list
#                                (projects.<profile>) + config dir (~/.claude-<profile>)
#                                an UNKNOWN profile is refused, not created
#   ghostfleet <profile> --new create that profile's (empty) projects list
#   ghostfleet <project>       jump straight into a known work project's Master Claude
#   ghostfleet <project> --plain   one-shot non-interactive list (for scripts)
set -uo pipefail

# Resolve this script through the ~/.local/bin symlink to find the repo root.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  target="$(readlink "$src")"
  case "$target" in /*) src="$target" ;; *) src="$(dirname "$src")/$target" ;; esac
done
BIN_DIR="$(cd "$(dirname "$src")" && pwd)"
REPO="$(cd "$BIN_DIR/.." && pwd)"
GRID="$BIN_DIR/fleet-grid.mjs"
CONF="$REPO/tmux/cf.tmux.conf"

command -v node  >/dev/null 2>&1 || { echo "ghostfleet: node is required"; exit 1; }
command -v tmux  >/dev/null 2>&1 || { echo "ghostfleet: tmux is required (brew install tmux)"; exit 1; }

# Keep the machine awake for as long as the control plane is up (see bin/fleet-awake).
# Workers only earn their keep unattended, and an idle-sleeping box freezes every one
# of them mid-turn and swallows scheduled sends, leaving no trace of why.
#   CLAUDE_FLEET_AWAKE=on       idle sleep off, screen still darkens (default)
#                     =display  also pin the screen on — a dark screen is
#                               indistinguishable from a slept machine, so this is
#                               what to reach for when you need to SEE it's alive
#                     =off      don't inhibit anything
# `fleet-awake --status` answers "is it actually holding?" without the guesswork.
#   The marker is EXPORTED so it survives maybe_reexec: exec keeps both our pid and
#   our environment, so without it every cf-sync upgrade would stack another
#   inhibitor on the same process. It carries the MODE too, so flipping =display
#   and reloading actually re-arms instead of matching the stale marker.
_awake_mode="${CLAUDE_FLEET_AWAKE:-on}"
case "$_awake_mode" in
  0|off|no|false) : ;;
  *) if [ "${CLAUDE_FLEET_AWAKE_PID:-}" != "$$:$_awake_mode" ]; then
       case "$_awake_mode" in
         display|screen) "$BIN_DIR/fleet-awake" --display "$$" 2>/dev/null ;;
         *)              "$BIN_DIR/fleet-awake" "$$" 2>/dev/null ;;
       esac
       export CLAUDE_FLEET_AWAKE_PID="$$:$_awake_mode"
     fi ;;
esac

US=$'\x1f'
PROJECTS_CFG="$HOME/.config/ghostfleet/projects"
# The control plane is a long-lived bash loop, so a `cf-sync` upgrade would otherwise
# not take effect until you quit and relaunch — and a NEW screen (node) talking to an
# OLD loop silently drops any new action it prints. Remember our own mtime and re-exec
# when it changes, but only at the Projects screen (nothing is attached there).
# portable file mtime: BSD/macOS `stat -f`, GNU/Linux `stat -c`
_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
SELF_MTIME="$(_mtime "$src")"
shopt -s execfail 2>/dev/null || true      # a failed exec must NOT kill the control plane
maybe_reexec() {
  local now="" target=""
  # Can't stat ourselves? The script was moved/renamed/deleted under us (a rename, an
  # uninstall). Do NOT treat that as "upgraded" — the old code in memory still works,
  # whereas exec'ing a path that no longer exists would kill the whole control plane.
  now="$(_mtime "$src")"; [ "$now" = 0 ] && return 0
  [ -n "$now" ] || return 0
  [ "$now" = "$SELF_MTIME" ] && return 0
  # Prefer our own path; fall back to whatever is on PATH now (survives a rename).
  target="$src"
  [ -x "$target" ] || target="$(command -v ghostfleet 2>/dev/null)"
  if [ -z "$target" ] || [ ! -x "$target" ]; then SELF_MTIME="$now"; return 0; fi
  _clear; echo "ghostfleet: upgraded — reloading…" >&2
  # REEXEC tells the new copy this profile was already validated, so a list that
  # vanished under a running control plane can't make the reload refuse and exit.
  CLAUDE_FLEET_REEXEC=1 exec "$target" ${PROFILE:+"$PROFILE"}
  SELF_MTIME="$now"                        # exec failed (execfail) — carry on with what we have
  echo "ghostfleet: reload failed, continuing on the running copy" >&2
}
# wipe the main screen + scrollback so tmux's "[detached …]" lines / stray frames
# don't pile up between screens
# Clear the screen AND turn focus reporting off (\033[?1004l). tmux/Claude enable it
# per-app; during a transition nothing is in a state to consume a focus report, so the
# terminal's "focus gained" arrives as literal ^[[I in the corner of a blank screen.
# Whatever we hand over to re-enables it for itself.
_clear() { printf '\033[?1004l\033[2J\033[3J\033[H' >/dev/tty 2>/dev/null || true; }
# Attaching a session or booting a screen isn't instant — Claude has to redraw, which
# can take a beat on a big conversation. Say what's happening instead of showing a
# blank screen (the thing that made a stray escape look like a glitch).
_loading() { _clear; printf '\033[38;5;245m  %s…\033[0m\r' "$1" >/dev/tty 2>/dev/null || true; }
TM() { tmux -L "$SOCK" -f "$CONF" "$@"; }
# Re-source the bindings on a LIVE server (a cf-sync only reaches a running fleet
# this way) and hand it our absolute bin dir. The ⇧←/⇧→ bindings shell out to
# fleet-cycle, and a tmux server inherits whatever PATH it was born with — which,
# for a server started by an app rather than a login shell, need not include
# ~/.local/bin. Baking the path in is the difference between the keys working and
# failing silently inside run-shell.
tm_wire() {
  TM source-file "$CONF" 2>/dev/null || true
  TM set-option -g @cf_bin "$BIN_DIR" 2>/dev/null || true
}

profile_dir() { case "$1" in work|default|"") echo "$HOME/.claude" ;; *) echo "$HOME/.claude-$1" ;; esac; }
# Nth project (1-based) in the list, matching the numbers the cards show. Used by the
# insta-jump chord: C-f <digit> from master/a chat (see tmux/cf.tmux.conf).
proj_nth() { awk -F'\t' -v n="$1" '/^[[:space:]]*#/ || NF<2 { next } { i++; if (i==n) { print $1; exit } }' "$PROJECTS_CFG" 2>/dev/null; }
proj_field() { awk -F'\t' -v n="$1" -v f="$2" '$1==n{print $f; exit}' "$PROJECTS_CFG" 2>/dev/null; }

ensure_projects() {
  [ -f "$PROJECTS_CFG" ] && return 0
  mkdir -p "$(dirname "$PROJECTS_CFG")" 2>/dev/null
  cat > "$PROJECTS_CFG" <<'EOF'
# ghostfleet projects — one per line:  name<TAB>path<TAB>profile
# profile: work (~/.claude) or personal (~/.claude-personal).
# Add from the picker ("+ add project"), or edit here, e.g.:
#   myapp<TAB>~/code/myapp<TAB>work
EOF
}

# select a project: export everything the grid/hooks/sessions key off
set_project() {
  PROJECT="$1"
  PROJECT_ROOT="$(proj_field "$PROJECT" 2)"; PROJECT_ROOT="${PROJECT_ROOT/#\~/$HOME}"
  local prof; prof="$(proj_field "$PROJECT" 3)"; [ -n "$prof" ] || prof="${PROFILE:-work}"
  CFG_DIR="$(profile_dir "$prof")"
  # work keeps the bare cf-<project> socket (back-compat); other profiles are
  # namespaced so a same-named project in another profile can't collide.
  case "$prof" in work|default) SOCK="cf-$PROJECT" ;; *) SOCK="cf-$prof-$PROJECT" ;; esac
  export CLAUDE_CONFIG_DIR="$CFG_DIR" CLAUDE_FLEET_DIR="$CFG_DIR/fleet" \
         CLAUDE_FLEET_PROFILE="$prof" CLAUDE_FLEET_SCOPE="$PROJECT" \
         CLAUDE_FLEET_ROOT="$PROJECT_ROOT" CLAUDE_FLEET_SOCK="$SOCK"
  mkdir -p "$CFG_DIR/fleet" 2>/dev/null
}

# Keep a budget governor alive for this project's fleet — a DUMB non-Claude loop
# that parks workers as the shared account nears its usage ceiling (see
# bin/fleet-governor). It must NOT be the master: the lead is on the same account
# and stalls at the same time, so metering has to run outside Claude. Singleton per
# project; opt out with CLAUDE_FLEET_GOVERNOR=off, watch-only with =dry.
ensure_governor() {
  local mode="${CLAUDE_FLEET_GOVERNOR:-on}"
  case "$mode" in 0|off|no|false) return 0 ;; esac
  local fdir="$CFG_DIR/fleet"
  local pidf="$fdir/$PROJECT.governor.pid" verf="$fdir/$PROJECT.governor.ver" logf="$fdir/$PROJECT.governor.log"
  local ver; ver="$(_mtime "$BIN_DIR/fleet-governor")"
  # already running for this project WITH the current governor code? keep it.
  if [ -f "$pidf" ] && kill -0 "$(cat "$pidf" 2>/dev/null)" 2>/dev/null; then
    [ "$(cat "$verf" 2>/dev/null)" = "$ver" ] && return 0
    # a governor is a long-lived daemon, so a running one keeps OLD behavior after an
    # upgrade (e.g. it wouldn't emit the new inbox park/resume events). Restart it.
    kill "$(cat "$pidf" 2>/dev/null)" 2>/dev/null
  fi
  local dry=""; [ "$mode" = "dry" ] && dry="--dry-run"
  CLAUDE_FLEET_DIR="$fdir" nohup "$BIN_DIR/fleet-governor" -s "$SOCK" $dry >>"$logf" 2>&1 &
  echo $! > "$pidf"
  printf '%s\n' "$ver" > "$verf"
}

# the "master" lead session runs in the project's main checkout. From inside it,
# `C-s` (or C-a s) writes a "<socket>.goto" marker (see tmux/cf.tmux.conf) then detaches;
# we read that marker here to decide where to go next: the grid, or (on a plain
# `/C-a g detach) back to Projects. Sets MASTER_GOTO for the caller.
enter_master() {
  local main="$PROJECT_ROOT/$PROJECT"
  [ -d "$main/.git" ] || main="$(find "$PROJECT_ROOT" -maxdepth 1 -type d -exec test -e '{}/.git' ';' -print 2>/dev/null | head -1)"
  [ -n "$main" ] && [ -d "$main" ] || main="$PROJECT_ROOT"
  TM has-session -t master 2>/dev/null || \
    TM new-session -d -s master -c "$main" -e "CLAUDE_CONFIG_DIR=$CFG_DIR" -e "CLAUDE_FLEET_SOCK=$SOCK" "exec claude-here master"
  tm_wire                                               # refresh bindings/status on the live server
  ensure_governor                                       # budget backpressure for this fleet (non-Claude, singleton)
  # master's status-left names the project it leads + its live worker count
  # (project/socket baked in as literals; #() runs the helper on the status interval)
  TM set-option -t master status-left \
    "#[bg=colour148,fg=colour16,bold] ● master · #($BIN_DIR/fleet-statusbar '$PROJECT' '$SOCK') #[bg=colour236,fg=colour148,nobold]▏" 2>/dev/null || true
  local sp marker curf cur
  sp="$(TM display-message -t master -p '#{socket_path}' 2>/dev/null)"
  marker="$sp.goto"; curf="$sp.cur"
  rm -f "$marker" "$curf" 2>/dev/null                  # clear any stale signal
  _loading "opening $PROJECT · master"
  TM attach -t master 2>/dev/null || true; _clear
  MASTER_GOTO="$(cat "$marker" 2>/dev/null)"; rm -f "$marker" 2>/dev/null
  # ⇧←/⇧→ walks the CLIENT to another session (bin/fleet-cycle) without ever
  # waking this loop, so "we attached master" stops meaning "you're on master".
  # If you stepped off onto a worker, back = the grid: an empty marker would
  # otherwise read as "done with this project" and eject you all the way to
  # Projects, throwing away the project you're plainly still inside.
  cur="$(cat "$curf" 2>/dev/null)"; rm -f "$curf" 2>/dev/null
  [ -z "$MASTER_GOTO" ] && [ -n "$cur" ] && [ "$cur" != master ] && MASTER_GOTO=grid
  return 0
}

# An insta-jump goto marker (see tmux/cf.tmux.conf) retargets us at the Nth project:
#   jumpm:<n>  C-f <digit>    -> its MASTER   (GOTO empty: the loop enters master)
#   jump:<n>   C-f s <digit>  -> its session GRID
# Returns 0 when it retargeted us, so callers can bail out of their own loop.
take_jump() {
  local nth="" name="" rest=""
  case "$1" in
    jumpm:[1-9]) nth="${1#jumpm:}"; name="$(proj_nth "$nth")"
      if [ -n "$name" ]; then set_project "$name"; GOTO=""; JUMP_SESS=""; return 0; fi ;;
    jump:[1-9])  nth="${1#jump:}";  name="$(proj_nth "$nth")"
      if [ -n "$name" ]; then set_project "$name"; GOTO=grid; JUMP_SESS=""; return 0; fi ;;
    jumps:[1-9]:[1-9])                       # project + session, e.g. C-f 1 1
      rest="${1#jumps:}"; nth="${rest%%:*}"; name="$(proj_nth "$nth")"
      if [ -n "$name" ]; then set_project "$name"; GOTO=grid; JUMP_SESS="${rest#*:}"; return 0; fi ;;
  esac
  return 1
}

# the session grid ⇄ attach loop for the current project; returns on back/quit
grid_loop() {
  # GRID_EXIT=projects means the grid asked to go straight to the Projects screen
  # (^P) instead of back to this project's master.
  GRID_EXIT=""
  local choice name cwd base i last="" gsp="" gmark="" gcur="" gv="" gc="" pending=""
  # C-f <p> <s>: attach the Nth session (grid order, master excluded) without drawing
  # the grid first. Feeding it through `pending` reuses the normal attach path below.
  if [ -n "$JUMP_SESS" ]; then
    name="$(tmux -L "$SOCK" list-sessions -F '#{session_name}' 2>/dev/null | grep -v '^master$' | sed -n "${JUMP_SESS}p")"
    [ -n "$name" ] && pending="attach${US}${name}"
    JUMP_SESS=""
  fi
  while true; do
    _clear
    if [ -n "$pending" ]; then choice="$pending"; pending=""
    else choice="$(node "$GRID" "$SOCK" "$CONF" --select "$last" </dev/tty)" || true; fi
    tmux -L "$SOCK" has-session 2>/dev/null && tm_wire
    case "$choice" in
      ""|back) return ;;
      projects) GRID_EXIT=projects; return ;;      # ^P in the grid
      jump*) if take_jump "$choice"; then GRID_EXIT=jump; return; fi ;;   # ^F chord in the grid
      attach${US}*)
        name="${choice#attach${US}}"; last="$name"; _loading "opening $name"
        # C-p inside a session drops a "projects" marker then detaches (see
        # tmux/cf.tmux.conf), so leaving a chat can jump straight up to Projects.
        gsp="$(TM display-message -p '#{socket_path}' 2>/dev/null)"
        gmark="$gsp.goto"; gcur="$gsp.cur"; rm -f "$gmark" "$gcur" 2>/dev/null
        TM attach -t "$name" 2>/dev/null || true; _clear
        gv="$(cat "$gmark" 2>/dev/null)"; rm -f "$gmark" 2>/dev/null
        # ⇧←/⇧→ may have moved the client on; put the grid's cursor where you
        # ACTUALLY ended up, not on the card we happened to attach three sessions ago.
        gc="$(cat "$gcur" 2>/dev/null)"; rm -f "$gcur" 2>/dev/null
        [ -n "$gc" ] && [ "$gc" != master ] && last="$gc"
        if [ "$gv" = projects ]; then GRID_EXIT=projects; return; fi
        if take_jump "$gv"; then GRID_EXIT=jump; return; fi ;;
      new${US}*)
        cwd="${choice#new${US}}"; base="$(basename "$cwd")"; name="$base"; i=2
        while TM has-session -t "$name" 2>/dev/null; do name="$base-$i"; i=$((i + 1)); done
        TM new-session -d -s "$name" -c "$cwd" -e "CLAUDE_CONFIG_DIR=$CFG_DIR" -e "CLAUDE_FLEET_SOCK=$SOCK" "exec claude-here \"$name\""
        tm_wire     # this may be the call that CREATED the server — @cf_bin isn't set yet
        last="$name"; _loading "starting $name"; TM attach -t "$name" 2>/dev/null || true; _clear ;;
      newfresh${US}*)
        cwd="${choice#newfresh${US}}"; base="$(basename "$cwd")"; name="$base~2"; i=2
        while TM has-session -t "$name" 2>/dev/null; do i=$((i + 1)); name="$base~$i"; done
        TM new-session -d -s "$name" -c "$cwd" -e "CLAUDE_CONFIG_DIR=$CFG_DIR" -e "CLAUDE_FLEET_SOCK=$SOCK" -e "CLAUDE_FLEET_FRESH=1" "exec claude-here \"$name\""
        tm_wire     # ditto — a fresh server has no @cf_bin until we hand it one
        last="$name"; _loading "starting $name"; TM attach -t "$name" 2>/dev/null || true; _clear ;;
    esac
  done
}

# --- profile scope --------------------------------------------------------------
# `ghostfleet [profile]` gives each profile its own projects list
# (~/.config/ghostfleet/projects.<profile>) AND its own Claude config dir
# (~/.claude-<profile>). A bare arg that names a known WORK project still jumps
# straight into it (back-compat).
WORK_CFG="$HOME/.config/ghostfleet/projects"
CFG_HOME="$(dirname "$WORK_CFG")"
PROFILE="work"; JUMP=""; NEW_PROFILE=0
for _a in "$@"; do [ "$_a" = "--new" ] && NEW_PROFILE=1; done

# Every profile that actually HAS a list, work first. A ".bak.1785" suffix is a
# backup, not a profile — the charset test rejects it because a backup name still
# contains a dot.
known_profiles() {
  local f n
  [ -f "$WORK_CFG" ] && printf 'work\n'
  for f in "$CFG_HOME"/projects.*; do
    [ -f "$f" ] || continue
    n="${f##*/projects.}"
    case "$n" in *[!A-Za-z0-9_-]*) continue ;; esac
    printf '%s\n' "$n"
  done
}
# Which profile's list holds a project by this name (first match wins). Used only
# to explain a miss — "sideproj" isn't a profile, it's a project over in personal.
profile_holding() {
  local f n
  for f in "$WORK_CFG" "$CFG_HOME"/projects.*; do
    [ -f "$f" ] || continue
    case "${f##*/}" in
      projects) n=work ;;
      *) n="${f##*/projects.}"; case "$n" in *[!A-Za-z0-9_-]*) continue ;; esac ;;
    esac
    awk -F'\t' -v p="$1" '$1==p{f=1} END{exit !f}' "$f" 2>/dev/null && { printf '%s\n' "$n"; return 0; }
  done
  return 1
}

if [ -n "${1:-}" ] && [ "${1#--}" = "$1" ]; then
  if awk -F'\t' -v n="$1" '$1==n{f=1} END{exit !f}' "$WORK_CFG" 2>/dev/null; then
    JUMP="$1"                          # known work project -> jump into it
  else
    PROFILE="$1"                       # otherwise the arg selects a profile
  fi
fi
case "$PROFILE" in
  work|default) PROJECTS_CFG="$WORK_CFG" ;;
  *)            PROJECTS_CFG="$CFG_HOME/projects.$PROFILE" ;;
esac

# An unknown profile used to be indistinguishable from a new one: ensure_projects
# would conjure an empty list and drop you at a blank picker. A typo and a PERSONAL
# project's name both land here (the jump test above only searches the WORK list),
# so the one thing the blank screen never told you was which mistake you'd made.
# Refuse, and say where the name actually lives. --new is the deliberate opt-in.
#   The re-exec path is exempt: maybe_reexec re-runs us with the profile we already
#   validated, and a control plane that killed itself mid-upgrade because someone
#   moved a config file is a far worse failure than a stale list.
if [ "$NEW_PROFILE" = 0 ] && [ "${CLAUDE_FLEET_REEXEC:-0}" != 1 ] \
   && [ "$PROFILE" != work ] && [ "$PROFILE" != default ] && [ ! -f "$PROJECTS_CFG" ]; then
  {
    echo "ghostfleet: no profile \"$PROFILE\""
    echo "  (looked for $PROJECTS_CFG)"
    if owner="$(profile_holding "$PROFILE")"; then
      echo
      echo "  \"$PROFILE\" is a PROJECT in the \"$owner\" profile, not a profile."
      echo "  Open it from that profile's screen:  ghostfleet $owner"
    fi
    echo
    _known="$(known_profiles | paste -sd' ' -)"
    # On a brand-new machine there isn't even a work list yet, and a bare
    # "known profiles:" with nothing after it reads like the lookup broke.
    echo "  known profiles:  ${_known:-(none yet — plain \`ghostfleet\` starts the work profile)}"
    echo "  new profile:     ghostfleet $PROFILE --new"
  } >&2
  exit 1
fi

export CLAUDE_FLEET_PROJECTS="$PROJECTS_CFG" CLAUDE_FLEET_PROFILE="$PROFILE"

ensure_projects

# jump straight into a project (ghostfleet <project> [--plain])
PROJECT=""
if [ -n "$JUMP" ]; then
  set_project "$JUMP"
  [ "${2:-}" = "--plain" ] && exec node "$GRID" "$SOCK" "$CONF" --plain
fi

_clear
LAST_PROJECT=""    # the project we last stepped out of — Projects re-selects it
GOTO=""            # "grid" -> skip master, open the sessions grid (^S from Projects)
GRID_EXIT=""       # "projects" -> the grid asked to go up to Projects (^P)
JUMP_SESS=""       # session index pending from a C-f <p> <s> jump
while true; do
  # LEVEL 0 — pick a project
  if [ -z "$PROJECT" ]; then
    maybe_reexec                 # pick up a cf-sync upgrade before drawing Projects
    sel="$(node "$GRID" - --screen projects --select "$LAST_PROJECT" </dev/tty)" || true; _clear
    case "$sel" in
      "") break ;;                                   # quit
      addproject)
        p="$(node "$GRID" - --screen addproject </dev/tty)" || true; _clear
        p="${p#newproject${US}}"
        if [ -n "$p" ] && [ "$p" != "newproject" ] && [ -d "$p" ]; then
          nm="$(basename "$p")"
          awk -F'\t' -v n="$nm" '$1==n{f=1} END{exit !f}' "$PROJECTS_CFG" 2>/dev/null \
            || printf '%s\t%s\t%s\n' "$nm" "$p" "$PROFILE" >> "$PROJECTS_CFG"
          set_project "$nm"
        fi ;;
      project${US}*) set_project "${sel#project${US}}" ;;
      sessions${US}*) set_project "${sel#sessions${US}}"; GOTO=grid ;;   # ^S: straight to the grid
      jump*) take_jump "$sel" || true ;;               # ^F chord from the Projects screen

    esac
    [ -z "$PROJECT" ] && continue
  fi

  # LEVEL 1 — Master Claude (⏎ on a project lands straight here). From master:
  #   C-s        -> the sessions grid; leaving the grid returns here to master
  #   ` / C-a g  -> back to the Projects picker
  # ^S from Projects: open the sessions grid WITHOUT starting/attaching master.
  # Leaving the grid then returns to Projects — master was never asked for.
  if [ "$GOTO" = "grid" ]; then
    GOTO=""
    ensure_governor              # normally done by enter_master, which we skipped
    grid_loop
    [ "$GRID_EXIT" = "jump" ] && continue     # jumped to another project's grid
    LAST_PROJECT="$PROJECT"; PROJECT=""
    continue
  fi

  MASTER_GOTO=""
  enter_master
  if take_jump "$MASTER_GOTO"; then continue          # C-f <digit> from master
  elif [ "$MASTER_GOTO" = "grid" ]; then
    grid_loop
    # ^P in the grid -> up to Projects instead of back into master
    if [ "$GRID_EXIT" = "projects" ]; then LAST_PROJECT="$PROJECT"; PROJECT=""; fi
    [ "$GRID_EXIT" = "jump" ] && continue             # C-f <digit> from a chat
  else
    LAST_PROJECT="$PROJECT"   # remember it so the Projects picker re-selects it
    PROJECT=""
  fi
done
