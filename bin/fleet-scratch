#!/usr/bin/env bash
# fleet-scratch [name]
#
# Spin up a DISPOSABLE scratch worktree + session for ad-hoc / separate work
# (questions, exploration) — off the latest origin/main, isolated from whatever the
# workers are doing in parallel. Throwaway: no PR expected; `fleet-clean` sweeps
# scratch/* worktrees automatically.
#
# Thin wrapper over fleet-spawn: a fresh worktree on a scratch/<name> branch off
# origin/main, in the background. Jump into it from the grid (C-a s) or fleet-send.
set -uo pipefail

name="${1:-q$(date +%H%M%S)}"
# safe dir/branch component: keep [A-Za-z0-9._-], collapse runs, no leading/trailing
# punctuation and never a '..' (it becomes part of a worktree path).
name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-' \
  | sed 's/\.\{2,\}/./g; s/--*/-/g; s/^[.-]*//; s/[.-]*$//')"
[ -n "$name" ] || name="q$(date +%H%M%S)"

# resolve sibling fleet-spawn (works via the ~/.local/bin symlink or a direct path)
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do t="$(readlink "$src")"; case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac; done
BIN_DIR="$(cd "$(dirname "$src")" && pwd)"

# freshen origin/main so the scratch base is current (best-effort)
root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] && git -C "$root" fetch --quiet origin main 2>/dev/null || true

"$BIN_DIR/fleet-spawn" "scratch-$name" --branch "scratch/$name" --from origin/main --new
echo "fleet-scratch: jump in via the grid (C-a s → 'scratch-$name'), or ask it directly: fleet-send scratch-$name \"<question>\""
