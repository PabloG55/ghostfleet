#!/usr/bin/env bash
# fleet-jarvis — make, inspect and look after Jarvis, the master of masters (docs/jarvis.md).
#
#   fleet-jarvis init            create and register Jarvis's home (ghostfleet jarvis runs this)
#   fleet-jarvis status          where it lives, whether it runs, what waits on the owner's yes
#   fleet-jarvis voice --install the optional local speech-to-text (whisper.cpp + a model)
#   fleet-jarvis --help          everything else
#
# A launcher, exactly like bin/fleet-digest is for fleet-digest.mjs: the logic is node, and
# this is what puts `fleet-jarvis` on PATH with a readable error when node is missing.
set -uo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  t="$(readlink "$src")"
  case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac
done
BIN_DIR="$(cd "$(dirname "$src")" && pwd)"

command -v node >/dev/null 2>&1 || { echo "fleet-jarvis: node is required (>=18)" >&2; exit 1; }
exec node "$BIN_DIR/fleet-jarvis.mjs" "$@"
