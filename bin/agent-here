#!/usr/bin/env bash
# agent-here — start THIS session's agent in this pane.
#
# The single entry point every fleet session launches through. It picks the agent
# for the session and hands off to that agent's <agent>-here launcher, which owns
# the resume semantics for its CLI.
#
# Usage:  agent-here [slot] [-- extra args for the agent...]
#   (same contract as claude-here, which this replaced as the launch target)
#
# Agent selection, most specific first:
#   CLAUDE_FLEET_AGENT=<name>   set per session by fleet-spawn --agent / the grid
#   the recorded marker         <sock>.<slot>.agent, so a REBUILT session keeps its
#                               agent instead of silently reverting to claude
#   claude                      the default
#
# THE DEFAULT PATH IS UNTOUCHED ON PURPOSE. With no agent selected this execs
# claude-here with the argv it was given, in the same process — so claude sessions
# invoke exactly the command they always did, and nothing here can regress them.
set -uo pipefail

# THE BINARY MUST NOT CHANGE UNDER A RUNNING FLEET. Claude Code's background-service
# supervisor watches its own executable's mtime and self-restarts when it moves — but
# the updater is still WRITING that file at that moment, and it is ~300MB, so the exec
# lands on a file that exists, already has a new mtime, and is not executable yet:
#
#   [supervisor] binary at …/claude.exe changed (mtime changed) — self-restarting
#   [supervisor] upgrade self-respawn failed to spawn: EACCES: permission denied,
#                posix_spawn '…/claude.exe' — bg workers may be orphaned
#
# The session then drops into the agents view carrying that error. Measured on one
# machine: 32 of these between Aug 6 and Aug 13. It self-heals in about two seconds,
# which is why it survives as a recurring annoyance rather than getting fixed.
#   A FLEET TURNS A RARE RACE INTO A ROUTINE ONE. One update swaps the binary under
# every live session at once, so they all lose it together — the reason it shows up in
# several panes in the same instant rather than once in a while.
#
# So fleet sessions do not auto-update; you update deliberately, with the fleet idle:
#     npm i -g @anthropic-ai/claude-code      (or however you installed it)
# The cost is real and worth naming: a long-lived fleet WILL drift behind the released
# version until you do. Opt back in with CLAUDE_FLEET_AUTOUPDATE=1.
#   Set here rather than in each `new-session -e` because this is the one entry point
# every launch path already goes through — the grid, fleet-spawn, fleet-open and
# claude-here all exec it — so there is no route that can quietly miss it.
[ "${CLAUDE_FLEET_AUTOUPDATE:-0}" = 1 ] || export DISABLE_AUTOUPDATER=1

# ── THE CARD OUTLIVES THE AGENT ───────────────────────────────────────────────
# "i use parallel session and if i type exit the session is completely remove it and
# i cant reopen it easily."
#
# Typing `exit` ends the agent. The pane's command ends with it, tmux takes the
# session down (`remain-on-exit off`, set globally in tmux/cf.tmux.conf), and the
# CARD goes with the session — so the conversation is still on disk with nothing on
# screen pointing at it.
#
# WHY THIS IS HERE AND NOT AT THE EIGHT `new-session` SITES. Every one of them
# launches the same string, `exec agent-here "<name>"` — this file is documented
# above as the one entry point every launch path goes through. Putting the behaviour
# in the launcher means fleet-spawn, fleet-open, fleet-project, fleet-companion,
# fleet-tab, fleet-stack and the grid's two all get it without being touched, and a
# NINTH site added later gets it for free rather than being the one that forgot.
#
# WHY NOT `remain-on-exit on`. That is a global `set -g` in both tmux configs, so it
# would also apply to tab sessions and the stack, which are editor and terminal panes
# with no conversation behind them — a dead shell would sit there as a pane nobody can
# act on. Holding the pane HERE applies to exactly the sessions that have something to
# resume, and it can say so.
#
# THE COST, NAMED: the agent is no longer `exec`ed, so there is a shell between tmux
# and it. Checked before doing it — nothing in bin/, lib/, tmux/ or hooks/ reads
# `pane_current_command` or `pane_pid`, and every status detector reads the pane's
# CONTENT via capture-pane, which is unchanged.
MARK_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"
SLOT="${1:-}"; case "$SLOT" in --|"") SLOT="${CLAUDE_FLEET_SLOT:-}" ;; esac
MARK=""
[ -n "${CLAUDE_FLEET_SOCK:-}" ] && [ -n "$SLOT" ] && MARK="$MARK_DIR/$CLAUDE_FLEET_SOCK.$SLOT.exited"

# A LEFTOVER MARKER WOULD MAKE A LIVE SESSION READ AS EXITED, which is the same shape
# as the stale park marker fleet-spawn and fleet-open both clear on the way in.
[ -n "$MARK" ] && rm -f "$MARK" 2>/dev/null

# A SESSION THAT NEVER STARTED IS NOT A SESSION THAT EXITED, and telling them apart is
# the whole of this function's care. `exit` typed into a running agent should keep the
# card; an agent binary that cannot run at all must take the pane down exactly as it did
# before, because that is the signal bin/fleet-spawn reads to say "its pane ran
# agent-here and that came straight back — the agent binary could not exec", with the
# `claude --version` hint beside it.
#   CAUGHT BY THE SUITE, not by reading: holding the pane on ANY exit made a
# wrong-platform binary look like a clean start, so fleet-spawn reported success, left a
# manifest row, and lost its diagnostic — six rows, and every one of them a case where
# the failure had become invisible rather than louder.
#   TWO SIGNALS, because neither alone is enough. 126/127 are the shell's own "cannot
# execute" and "not found", which is the wrong-platform case exactly; and an agent that
# fell over in the first few seconds never got as far as a prompt, whatever it returned.
# A person typing `exit` is always on the far side of both.
AGENT_MIN_RUN="${CLAUDE_FLEET_MIN_RUN:-5}"

run_agent() {
  local launcher="$1"; shift
  # No `exec`: this shell has to outlive the agent to write the marker and hold the
  # pane. A tab or stack session never reaches here, so neither does the holding.
  while :; do
    local t0=$SECONDS
    "$launcher" "$@"
    local rc=$? ran=$((SECONDS - t0))
    # NOT HELD WHEN THERE IS NOTHING TO HOLD FOR. Without a socket and a slot there is
    # no card to keep and no marker to key off, so the old behaviour is exactly right.
    [ -n "$MARK" ] || return "$rc"
    # ...and not held when the agent never started. See above.
    if [ "$rc" = 126 ] || [ "$rc" = 127 ] || [ "$ran" -lt "$AGENT_MIN_RUN" ]; then
      return "$rc"
    fi
    : > "$MARK" 2>/dev/null
    printf '
  this session has exited — its conversation is still on disk.
' >&2
    printf '  press Enter to resume it here, or close the pane to leave the card exited.
' >&2
    printf '  from anywhere:  fleet-restart --reopen %s

' "$SLOT" >&2
    # A pane whose command has ended is a pane tmux removes; reading holds it open.
    # EOF (the pane really is being torn down) leaves the marker in place, which is
    # what makes the card render as exited rather than vanishing.
    read -r _ </dev/tty || return "$rc"
    rm -f "$MARK" 2>/dev/null
    printf '  resuming…
' >&2
  done
}

AGENT="${CLAUDE_FLEET_AGENT:-}"

# Recover the agent from the marker when the env doesn't carry it. This is what
# makes re-opening a session (grid rebuild, fleet-open) keep running the agent it
# was created with rather than quietly switching to claude.
if [ -z "$AGENT" ] && [ $# -gt 0 ] && [ "$1" != "--" ]; then
  if command -v fleet-agent >/dev/null 2>&1; then
    AGENT="$(fleet-agent of "$1" 2>/dev/null)"
  fi
fi

case "${AGENT:-claude}" in
  claude|"")
    run_agent claude-here "$@"; exit $? ;;
esac

if ! command -v fleet-agent >/dev/null 2>&1; then
  echo "agent-here: fleet-agent is not installed — cannot resolve agent '$AGENT'; falling back to claude" >&2
  run_agent claude-here "$@"; exit $?
fi

launcher="$(fleet-agent field "$AGENT" launcher 2>/dev/null)"
if [ -z "$launcher" ] || ! command -v "$launcher" >/dev/null 2>&1; then
  echo "agent-here: no launcher for agent '$AGENT' — falling back to claude" >&2
  run_agent claude-here "$@"; exit $?
fi

bin="$(fleet-agent field "$AGENT" bin 2>/dev/null)"
if [ -n "$bin" ] && ! command -v "$bin" >/dev/null 2>&1; then
  # Don't silently start a different agent than the one asked for — that would make
  # a card claim an agent the pane isn't running. Say so and stop.
  echo "agent-here: '$AGENT' selected but '$bin' is not on PATH." >&2
  echo "agent-here: install it, or start this session with --agent claude." >&2
  echo "agent-here: dropping to a shell so the pane isn't lost." >&2
  exec "${SHELL:-/bin/bash}" -l
fi

export CLAUDE_FLEET_AGENT="$AGENT"
run_agent "$launcher" "$@"
