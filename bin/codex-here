#!/usr/bin/env bash
# codex-here — launch Codex in a fleet pane, resuming this checkout's conversation.
#
# Verified against codex-cli 0.146.0 (the notarized cask build). An earlier cut of
# this file declared resume unsupported — but only because the binary could not be
# executed at all then, not because anything had been tried. It can, and it does.
#
# `codex resume --last` is CWD-SCOPED, which is the property a fleet needs: a global
# "most recent session" would hand worker B the conversation belonging to worker A.
# Verified in both directions plus the empty case, via `codex exec` — two repos with a
# codeword planted in each, B's session created LAST:
#
#   in A: resume --last -> "ALPHA"     (not BRAVO — did NOT take the global newest)
#   in B: resume --last -> "BRAVO"
#   in C: resume --last -> "unknown"   (no prior session: starts fresh, steals nothing)
#
# So resume is used below, and needs no "does a session exist here?" probe.
#
# RESUME NOW SURVIVES A KILLED PANE, re-measured on codex-cli 0.160.1. Under 0.146.0
# the TUI persisted its rollout only on a clean exit, so a killed pane left nothing to
# resume and the adapter said resume=no. 0.160.1 writes the rollout AS IT GOES: a
# codeword planted in a scratch pane survived a kill-server between turns, a second
# kill landed MID-TURN and still left that turn's message on disk, and `codex resume
# <id>` reopened the conversation — appending to the same file, under the same id.
#
# AND THE FLEET NOW KNOWS WHICH CONVERSATION THAT IS. codex has no hooks, so nothing
# recorded a codex pane's conversation id, and `resume --last` is "the newest in this
# folder" — --continue by another name, wrong in a checkout with two sessions. The
# watcher started below (lib/codex-rollout.mjs) reads the rollout the codex process
# holds open and writes <fleet-dir>/<id>.json in the shape the claude hook writes, so
# a lost-session reopen (fleet-restart --reopen, fleet_reopen, fleet-open) and the
# phone resume and read it BY ID.
#
# Also still true: codex pushes no need-you/done events (hooks=no), so its blocked_re
# is what reads the trust dialog and the daemon dialog (see --no-daemon below) as need-you.
set -uo pipefail

slot=""
if [ $# -gt 0 ] && [ "$1" != "--" ]; then
  slot="$1"; shift
fi
[ "${1:-}" = "--" ] && shift
[ -n "$slot" ] && export CLAUDE_FLEET_SLOT="$slot"

# Pre-trust this worktree so the pane doesn't dead-end on codex's directory-trust
# dialog. That dialog is NOT covered by --dangerously-bypass-approvals-and-sandbox
# (which is about command approval), so a codex worker in a FRESH worktree — i.e.
# every worker fleet-spawn makes — comes up blocked, and fleet-spawn's initial
# prompt gets typed into the dialog and lost. Answering it by hand writes exactly
# this stanza, so we're pre-recording the answer, not inventing a mechanism.
#
# Only under yolo: bypassing approvals but still hand-confirming trust would be
# incoherent. Opt out with CLAUDE_FLEET_YOLO=0 (then answer the prompt yourself).
# Append-only and idempotent — never rewrites config a human put there.
trust_this_dir() {
  case "${CLAUDE_FLEET_CODEX_TRUST:-1}" in 0|false|no|off) return 0 ;; esac
  # `pwd -P`, not $PWD: codex keys this table by the PHYSICAL path, and on macOS a
  # worktree reached through a symlinked parent (/tmp -> /private/tmp is the one that
  # caught this) has a different logical path. Writing the logical spelling produces a
  # stanza codex never matches — a silent no-op that looks exactly like success.
  local dir cfg key
  dir="$(pwd -P 2>/dev/null)" || dir="$PWD"
  cfg="${CODEX_HOME:-$HOME/.codex}/config.toml"; key="[projects.\"$dir\"]"
  mkdir -p "$(dirname "$cfg")" 2>/dev/null || return 0
  grep -qF -- "$key" "$cfg" 2>/dev/null && return 0
  printf '\n%s\ntrust_level = "trusted"\n' "$key" >> "$cfg" 2>/dev/null || true
}

# Codex's bypass flag. CLAUDE_FLEET_YOLO=0 opts out, same switch as the other agents.
YOLO=()
case "${CLAUDE_FLEET_YOLO:-1}" in
  0|false|no|off) ;;
  *) YOLO=(--dangerously-bypass-approvals-and-sandbox); trust_this_dir ;;
esac

MODEL=()
[ -n "${CLAUDE_FLEET_MODEL:-}" ] && MODEL=(--model "$CLAUDE_FLEET_MODEL")

# Run without codex's shared background server. Since 0.160 a TUI attaches to one
# per-user app-server daemon, and the daemon installs and updates ITSELF under
# ~/.codex/packages — independently of the `codex` on PATH. Measured 2026-10-07: a
# 0.160.1 cask CLI against a self-updated 0.161.0 daemon. 0.161 promoted
# api_key_model_discovery to stable/on while 0.160.1 still defaults it off, so EVERY
# 0.160.1 TUI — a plain `codex` in a clean environment as much as a fleet pane — stops
# on "Background server has incompatible feature settings" before it draws a prompt,
# and a fleet-spawn's first prompt is typed into that dialog.
#   Matching the daemon is not available from here: `--enable`/`-c` overrides force
# embedded mode anyway (codex warns as much), and writing [features] into config.toml
# changes every other client's settings. "Restart with these settings" restarts the
# shared daemon under sessions the fleet does not own. --no-daemon is the dialog's own
# option 1, answered in advance; the daemon is left exactly as it was.
#   Probed, not assumed: 0.146 has no --no-daemon and would refuse to start with it.
# CLAUDE_FLEET_CODEX_DAEMON=1 attaches to the daemon again.
DAEMON=()
case "${CLAUDE_FLEET_CODEX_DAEMON:-0}" in
  1|true|yes|on) ;;
  *) help="$(codex --help 2>/dev/null)"
     grep -q -- '--no-daemon' <<< "$help" && DAEMON=(--no-daemon) ;;
esac

# ${a[@]+"${a[@]}"}, never "${a[@]}" — see opencode-here: bash 3.2 + set -u aborts
# on an empty array, which would kill the pane whenever yolo/model are unset.
OPTS=( ${YOLO[@]+"${YOLO[@]}"} ${MODEL[@]+"${MODEL[@]}"} ${DAEMON[@]+"${DAEMON[@]}"} )

# ── record which conversation this pane is in (lib/codex-rollout.mjs) ────────────
# Only in a fleet pane, and only for the server the pane is really on: $TMUX names it and
# cannot go stale the way an exported CLAUDE_FLEET_SOCK can (hooks/fleet-event.sh, same
# rule). A codex run by hand outside any fleet writes nothing. Started BEFORE the exec
# with this shell's pid, which the exec hands to codex — so the watcher lives exactly as
# long as codex does, and a crash that takes the pane takes it too.
record_conversation() {
  local sock="" t="${TMUX:-}" lib src="${BASH_SOURCE[0]}" tg
  case "${t%%,*}" in */cf-*) sock="${t%%,*}"; sock="${sock##*/}" ;; esac
  [ -n "$sock" ] && [ -n "${TMUX_PANE:-}" ] || return 0
  case "${CLAUDE_FLEET_CODEX_RECORD:-1}" in 0|false|no|off) return 0 ;; esac
  command -v node >/dev/null 2>&1 || return 0
  while [ -L "$src" ]; do tg="$(readlink "$src")"; case "$tg" in /*) src="$tg" ;; *) src="$(dirname "$src")/$tg" ;; esac; done
  lib="$(cd "$(dirname "$src")/../lib" 2>/dev/null && pwd)/codex-rollout.mjs"
  [ -f "$lib" ] || return 0
  local r="${t#*,}"
  node "$lib" watch --pid "$$" --sock "$sock" --slot "${CLAUDE_FLEET_SLOT:-$slot}" \
    --cwd "$(pwd -P 2>/dev/null || printf '%s' "$PWD")" --since "$(( $(date +%s) - 2 ))" \
    --pane-id "$TMUX_PANE" --pane "$TMUX_PANE@${r%%,*}" \
    ${CLAUDE_FLEET_RESUME:+--resume "$CLAUDE_FLEET_RESUME"} </dev/null >/dev/null 2>&1 &
}
record_conversation

# A parallel session (grid `N`, fleet-spawn) is a deliberately NEW conversation in a
# dir that already has one — must never resume, same contract as claude-here.
case "${CLAUDE_FLEET_FRESH:-0}" in
  1|true|yes|on)
    echo "codex-here: fresh session in $PWD" >&2
    exec codex ${OPTS[@]+"${OPTS[@]}"} "$@" ;;
esac

# ONE CONVERSATION, ONE SLOT — the same three rules as claude-here, asked of the same file
# (lib/slot-claim.mjs) so the two agents cannot drift apart on them.
SLOTCLAIM=""
if command -v node >/dev/null 2>&1; then
  _src="${BASH_SOURCE[0]}"
  while [ -L "$_src" ]; do _tg="$(readlink "$_src")"; case "$_tg" in /*) _src="$_tg" ;; *) _src="$(dirname "$_src")/$_tg" ;; esac; done
  _lib="$(cd "$(dirname "$_src")/../lib" 2>/dev/null && pwd)/slot-claim.mjs"
  [ -f "$_lib" ] && SLOTCLAIM="$_lib"
fi
FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"

# fleet-open <id>: resume exactly that conversation, by id — unless a live process already
# has it open, which would put two writers on one rollout.
if [ -n "${CLAUDE_FLEET_RESUME:-}" ]; then
  if [ -n "$SLOTCLAIM" ] && holder="$(node "$SLOTCLAIM" held --agent codex --id "$CLAUDE_FLEET_RESUME" 2>/dev/null)"; then
    echo "codex-here: refusing — conversation $CLAUDE_FLEET_RESUME is open in live process $holder; a conversation is never resumed into a second pane" >&2
    exit 1
  fi
  echo "codex-here: resuming session ${CLAUDE_FLEET_RESUME} in $PWD" >&2
  exec codex resume "$CLAUDE_FLEET_RESUME" ${OPTS[@]+"${OPTS[@]}"} "$@"
fi

# Otherwise this slot's own recorded conversation, then the newest in this checkout that no
# other slot claims and no live process has open. `resume --last` was the second of those
# without either exclusion: "the newest in this folder", which in a folder two cards share
# is the other card's.
rid=""
if [ -n "$SLOTCLAIM" ]; then
  _sock="${CLAUDE_FLEET_SOCK:-}"
  [ -n "$slot" ] && [ -n "$_sock" ] \
    && IFS=$'\x1f' read -r rid _ _ < <(node "$SLOTCLAIM" pick --agent codex --dir "$FLEET_DIR" --sock "$_sock" --slot "$slot")
  _rc=0
  if [ -z "$rid" ]; then
    _out="$(node "$SLOTCLAIM" fallback --agent codex --dir "$FLEET_DIR" \
      --sock "$_sock" --slot "$slot" --cwd "$(pwd -P 2>/dev/null || printf '%s' "$PWD")")"; _rc=$?
    rid="${_out%%$'\x1f'*}"
  fi
  if [ -n "$rid" ]; then
    echo "codex-here: resuming session $rid in $PWD" >&2
    exec codex resume "$rid" ${OPTS[@]+"${OPTS[@]}"} "$@"
  fi
  # 3: this folder's conversations all belong to someone else, so `resume --last` would take
  # one of them. Otherwise there was nothing here to take, and --last is what it always was.
  if [ "$_rc" = 3 ]; then
    echo "codex-here: every conversation in $PWD belongs to another slot or is open elsewhere — starting fresh" >&2
    exec codex ${OPTS[@]+"${OPTS[@]}"} "$@"
  fi
fi

# Continue whatever this checkout was last doing. With no session for this cwd, codex
# starts a fresh one instead of erroring (verified — see the header).
echo "codex-here: resuming this checkout's last session in $PWD" >&2
exec codex resume --last ${OPTS[@]+"${OPTS[@]}"} "$@"
