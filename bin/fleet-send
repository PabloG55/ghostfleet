#!/usr/bin/env bash
# fleet-send [-s SOCKET] [--now] [--reply-to me|<session>|<socket>/<session>] [--reply-dir DIR]
#            [--anyway] <session> <prompt...>
# fleet-send [-s SOCKET] --dequeue <session>        (what the Stop hook runs)
#
# To a session that is mid-turn the prompt is QUEUED and runs as its own turn after that
# one ends (see "the queue" below); --now pastes it into the running turn instead.
#
# Type <prompt> into another fleet session's Claude input and submit it. Meant
# to be called by a "lead" Claude session (via its Bash tool) to dispatch work
# to sibling sessions in the same fleet.
#
# Socket defaults to $CLAUDE_FLEET_SOCK (exported into every fleet session).
# Uses a bracketed paste so multi-line prompts go in as ONE message, then Enter.
#
# --reply-to makes it a CONVERSATION instead of a one-way dispatch. It asks the target to
# answer the asker DIRECTLY, by name, with Claude Code's cross-session messaging
# (SendMessage) — which lands even when the asker is mid-turn — and it records who asked,
# so a turn that never gets there still has its last message relayed into the asker's
# inbox by the event hook. Without it, a send is fire-and-forget — the target's
# Stop only ever reaches ITS OWN fleet's master (hooks/fleet-event.sh), which is why a
# question sent across projects looked like it was ignored. See that hook for the
# routing; --reply-dir is for callers whose env doesn't name the asker's fleet dir.
set -uo pipefail

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"

SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer $TMUX (the live server this session runs in) over the env var — it's
# drift-proof; a long-running --resume/--fork Claude can hold a stale
# CLAUDE_FLEET_SOCK. Only when it names a cf-* fleet server; -s still overrides.
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac

# WHO IS ASKING — resolved from $TMUX only, and BEFORE -s can move SOCK.
# `--reply-to me` must NOT be answered out of CLAUDE_FLEET_SOCK: the MCP server calls
# this with TMUX cleared and CLAUDE_FLEET_SOCK repointed at the TARGET's fleet (see
# run() in mcp/fleet-mcp.mjs), so a guess from env would address the reply to our
# session NAME on the target's SOCKET — a marker that validates perfectly and relays
# to whichever session answers that name over there. So `me` resolves from the live
# server or fails loudly, and callers with no $TMUX pass the address explicitly.
SELF_SOCK=""; SELF_SESS=""
case "${_t##*/}" in cf-*)
  SELF_SOCK="${_t%%,*}"; SELF_SOCK="${SELF_SOCK##*/}"
  # $TMUX is "<socket-path>,<server-pid>,<session-id>" and that last field is the
  # session ID ($7), not its name — look the name up rather than trusting
  # CLAUDE_FLEET_SLOT, which a --resume'd/--fork'd session can hold stale.
  _sid="${_t##*,}"; case "$_sid" in ''|*[!0-9]*) _sid="" ;; esac
  [ -n "$_sid" ] && SELF_SESS="$(tmux -L "$SELF_SOCK" list-sessions \
      -F '#{session_id} #{session_name}' 2>/dev/null | awk -v i="\$$_sid" '$1==i{print $2; exit}')"
  [ -n "$SELF_SESS" ] || SELF_SESS="${CLAUDE_FLEET_SLOT:-}"
;; esac

REPLY_TO=""; REPLY_DIR=""; ANYWAY=0
# Set for real beside the asker's fleet dir; declared here so `set -u` cannot trip on a
# send that has no --reply-to at all.
XPROF=0
# send (the default) queues behind a running turn; --now pastes into it; --dequeue delivers
# the next queued prompt, and is what the Stop hook runs (see "the queue" below).
MODE=send
while [ $# -gt 0 ]; do
  case "$1" in
    -s)          SOCK="${2:-}";      shift 2 ;;
    --reply-to)  REPLY_TO="${2:-}";  shift 2 ;;
    --reply-dir) REPLY_DIR="${2:-}"; shift 2 ;;
    --anyway)    ANYWAY=1;           shift ;;
    --now)       MODE=now;           shift ;;
    --dequeue)   MODE=dequeue;       shift ;;
    *) break ;;
  esac
done
SESSION="${1:-}"; shift || true
MSG="$*"

[ -n "$SOCK" ]    || { echo "fleet-send: no socket (run inside a fleet session, or pass -s <socket>)" >&2; exit 1; }
[ -n "$SESSION" ] || { echo "fleet-send: usage: fleet-send [-s socket] [--now] [--reply-to me|<session>|<socket>/<session>] [--anyway] <session> <prompt>" >&2; exit 1; }
[ -n "$MSG" ] || [ "$MODE" = dequeue ] || { echo "fleet-send: empty prompt" >&2; exit 1; }
tmux -L "$SOCK" has-session -t "$SESSION" 2>/dev/null \
  || { echo "fleet-send: no session '$SESSION' on $SOCK (try: fleet-list)" >&2; exit 1; }
# A TAB IS NOT AN AGENT. fleet-tab's _term-*/_edit-* sessions live on this same socket
# and run a shell, so a send would type the prompt at a shell prompt and press Enter —
# the fleet would execute it, and the "answer" would never come because nothing here
# is waiting for a Stop. Refuse by name; there is no pane signal that could tell a
# shell from an agent reliably enough to catch this later.
case "$SESSION" in
  _term-*|_edit-*) echo "fleet-send: '$SESSION' is a tab (a shell), not an agent — it cannot be prompted" >&2; exit 1 ;;
esac

# A NEW TASK IS A NEW SESSION. A worker whose task has shipped still holds all of that
# task in its context, and the next brief gets worked through it — the files it already
# read, the approach it settled on, the half-remembered dead end. So a send to a worker
# that finished and shipped is refused, pointing at fleet-spawn (which may reuse the
# FOLDER: --reuse starts a new conversation there). bin/fleet-shipped owns the definition
# and keeps it narrow: an open PR is never "shipped", so a red CI row or a review note on
# the same PR always goes through, and so does a session that has not finished a turn.
#   A --reply-to QUESTION is exempt: asking a finished worker why it did something wants
# exactly the context it has. --anyway is for the follow-up this cannot recognise.
#   So is the queue's DRAIN (--dequeue, and the --anyway delivery it runs): this check
# already ran when the prompt was queued, against a worker that was mid-turn on the task
# the prompt was sent about. That turn may well ship before it ends — refusing the queued
# follow-up then would drop it, popped and undelivered, for having waited its turn.
if [ "$ANYWAY" != 1 ] && [ "$MODE" != dequeue ] && [ -z "$REPLY_TO" ] \
   && why="$("$(dirname "$0")/fleet-shipped" -s "$SOCK" "$SESSION" 2>/dev/null)"; then
  echo "fleet-send: '$SESSION' already finished a task that shipped ($why) — a new task is a new session: fleet-stop --reclaim $SESSION, then fleet-spawn <name> --prompt … (--reuse <worktree> keeps the folder). A follow-up on that same work: add --anyway" >&2
  exit 1
fi

# WHICH AGENT runs the target, resolved BEFORE the reply preamble is built and reused by
# the busy detector further down. It decides what the target can be TOLD to do: SendMessage
# is a Claude Code tool, and telling codex/opencode to call it would replace a hint they
# can act on with one they can't. Unknown (no fleet-agent installed) counts as claude —
# the same default the rest of this script has always taken.
_a=""
if command -v fleet-agent >/dev/null 2>&1; then
  _a="$(fleet-agent of "$SESSION" -s "$SOCK" 2>/dev/null)"
fi

# Is the target mid-turn right now? Read the LIVE pane (the agent's working spinner),
# not the status file — the file can be stale, and a wrong guess here is harmless
# but a wrong "queued" note is confusing.
#
# The pattern comes from the target's AGENT: claude says "esc to interrupt", opencode
# says "esc interrupt", and one regex cannot serve both. Resolved once here rather
# than per call, because submitted() polls this in a loop. Falls back to claude's
# literal pattern — byte-identical to what this script used before the adapter — so a
# missing/renamed fleet-agent degrades to today's behaviour instead of breaking send.
BUSY_RE='(…|\.\.\.) ?\([0-9]+[ms]|↓ ?[0-9.,]+ ?[km]? ?tokens|esc to interrupt'
if [ -n "$_a" ] && [ "$_a" != claude ]; then
  BUSY_RE="$(fleet-agent field "$_a" busy_re 2>/dev/null)"
fi
# An EMPTY pattern means the agent has no validated detector. It must never reach
# grep: `grep -qE ""` matches every line, which would report the session as
# permanently busy and make fleet-send queue every prompt behind a phantom turn.
busy() {
  [ -n "$BUSY_RE" ] || return 1
  # A here-string, not a pipe: under pipefail a `grep -q` that MATCHES can hand its
  # writer a SIGPIPE and read as a miss (CLAUDE.md) — and the queue below now decides
  # where a prompt goes on this answer.
  grep -qE "$BUSY_RE" <<< "$(tmux -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null)"
}

# --- the queue -----------------------------------------------------------------
# A PROMPT SENT TO A BUSY SESSION IS FOLDED INTO THE TURN THAT IS RUNNING, NOT QUEUED
# AFTER IT. This script used to paste into the input box of a working session and say
# "your prompt will queue after this turn"; Claude Code instead hands a message submitted
# mid-turn to the turn in progress, and the agent reads it as a change of direction. Task
# A was dropped for task B with nothing anywhere saying so — reported as "I'm treating it
# as a queue and the agents are not finishing both". Measured on 2.1.280: two prompts, one
# UserPromptSubmit each, ONE Stop between them.
#   So a send to a working Claude session is written here instead, and hooks/fleet-event.sh
# delivers the head of it (`fleet-send --dequeue`) after that session's Stop, as a turn of
# its own. --now keeps the old paste for the send that MEANS to interrupt.
#   ONE RECORD PER LINE, \x1f between fields (an empty reply field must not collapse):
# queued-at, reply socket, reply session, reply dir, and the prompt BASE64'D, because a
# prompt is multi-line and a line is the record. The reply address is stored RESOLVED and
# NOT written as a marker yet: a marker written now would be armed by whichever
# UserPromptSubmit comes next, which is not necessarily this prompt's.
#   Claude only. The drain is the Claude Stop hook; a codex/opencode target has nothing
# that would ever deliver a queued prompt, so it keeps the paste.
QUEUE="$FLEET_DIR/$SOCK.$SESSION.queue"
QUEUEABLE=0; { [ -z "$_a" ] || [ "$_a" = claude ]; } && QUEUEABLE=1
SELF="${BASH_SOURCE[0]}"

# mkdir is the lock because it is atomic everywhere this runs (flock is not on macOS).
# The holder's pid goes inside, so one that died holding it is taken over rather than
# waited on forever; a lock with no pid yet is only a race lost to a live holder.
_qlock() {
  local i=0 p
  mkdir -p "$FLEET_DIR" 2>/dev/null
  while ! mkdir "$QUEUE.lock" 2>/dev/null; do
    p="$(cat "$QUEUE.lock/pid" 2>/dev/null)"
    if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$QUEUE.lock"; continue; fi
    i=$((i + 1)); [ "$i" -ge 200 ] && return 1          # ~20s: a delivery holds it ~8s
    sleep 0.1
  done
  echo $$ > "$QUEUE.lock/pid"
  trap 'rm -rf "$QUEUE.lock" 2>/dev/null' EXIT
}
_qunlock() { rm -rf "$QUEUE.lock" 2>/dev/null; trap - EXIT; }
_b64()   { printf '%s' "$1" | base64 | tr -d '\n'; }
_unb64() { printf '%s' "$1" | base64 -d 2>/dev/null || printf '%s' "$1" | base64 -D 2>/dev/null; }

# --dequeue: deliver the NEXT queued prompt, if the session can take it. Exit 3 means
# "still busy, try again" — the Stop hook runs while the turn is technically still
# finishing, so its first look often lands on the spinner.
if [ "$MODE" = dequeue ]; then
  _qlock || { echo "fleet-send: queue for '$SESSION' is locked" >&2; exit 1; }
  [ -s "$QUEUE" ] || { rm -f "$QUEUE"; exit 0; }
  busy && exit 3
  IFS= read -r _line < "$QUEUE"
  _qt="$QUEUE.$$.tmp"
  tail -n +2 "$QUEUE" > "$_qt" 2>/dev/null && mv -f "$_qt" "$QUEUE"
  [ -s "$QUEUE" ] || rm -f "$QUEUE"
  IFS=$'\x1f' read -r _q_at _q_rs _q_rss _q_rd _q_msg _q_extra <<< "$_line"
  _body="$(_unb64 "${_q_msg:-}")"
  [ -n "$_body" ] && [ -z "${_q_extra:-}" ] \
    || { echo "fleet-send: dropped an unreadable queue record for '$SESSION'" >&2; exit 1; }
  _args=(--now --anyway -s "$SOCK")
  [ -n "$_q_rs" ] && [ -n "$_q_rss" ] && _args+=(--reply-to "$_q_rs/$_q_rss" ${_q_rd:+--reply-dir "$_q_rd"})
  # Delivered UNDER the lock: a second drainer must not see the box empty in the gap
  # between this paste and the spinner, and fold the next prompt into this one.
  "$SELF" "${_args[@]}" "$SESSION" "$_body"
  exit $?
fi

# --- the reply address ---------------------------------------------------------
# WHY A MARKER RATHER THAN JUST TELLING THE TARGET TO ANSWER: you CAN put a return
# address in the prompt — "reply with fleet-send -s cf-x master …" — and it works, but
# only while the target remembers to, and it pastes into the asker's input box whether
# or not a human is mid-sentence in it. The marker moves the reply into the machinery
# that already solved both problems: the Stop hook relays it (so simply ENDING the turn
# answers), and it reuses that hook's empty-input guard and debounce.
#
# The marker belongs to the TARGET (its hook reads its own $FLEET_DIR on Stop), so the
# asker's fleet dir has to travel INSIDE it: under a different profile the asker's inbox
# is a different directory entirely, and the target's hook has no way to know which.
RSOCK=""; RSESS=""
if [ -n "$REPLY_TO" ]; then
  case "$REPLY_TO" in
    me)  RSOCK="$SELF_SOCK"; RSESS="$SELF_SESS"
         [ -n "$RSOCK" ] && [ -n "$RSESS" ] || {
           echo "fleet-send: --reply-to me needs a live fleet session (\$TMUX names none) — pass --reply-to <socket>/<session>" >&2; exit 1; } ;;
    */*) RSOCK="${REPLY_TO%%/*}"; RSESS="${REPLY_TO#*/}" ;;
    *)   RSOCK="$SELF_SOCK"; RSESS="$REPLY_TO"
         [ -n "$RSOCK" ] || {
           echo "fleet-send: --reply-to '$REPLY_TO' has no socket and \$TMUX names none — pass --reply-to <socket>/<session>" >&2; exit 1; } ;;
  esac
  # Both fields come back out of a file and get interpolated into a tmux command line,
  # so refuse anything that could close a quote HERE instead of quoting around it later
  # (same rule, and the same charset, as fleet-stack's valid_line). This also catches a
  # three-part "a/b/c", whose leftover lands inside RSESS as "b/c".
  case "$RSOCK$RSESS" in *[!A-Za-z0-9._~-]*)
    echo "fleet-send: bad --reply-to '$REPLY_TO' (expected me, <session>, or <socket>/<session>)" >&2; exit 1 ;;
  esac
  # A session pointed at ITSELF would relay its own Stop into its own input, and that
  # reply is a prompt — one that Stops, and relays again. Refuse the cycle.
  if [ "$RSOCK" = "$SOCK" ] && [ "$RSESS" = "$SESSION" ]; then
    echo "fleet-send: --reply-to names the target itself ($RSOCK/$RSESS) — its answer would loop back into its own input" >&2; exit 1
  fi

  rdir="$REPLY_DIR"
  if [ -z "$rdir" ]; then                       # ask the asker's own session env
    rdir="$(tmux -L "$RSOCK" show-environment -t "$RSESS" CLAUDE_FLEET_DIR 2>/dev/null)"
    rdir="${rdir#CLAUDE_FLEET_DIR=}"; case "$rdir" in /*) ;; *) rdir="" ;; esac
  fi
  if [ -z "$rdir" ]; then                       # ...then its profile, the usual case
    _c="$(tmux -L "$RSOCK" show-environment -t "$RSESS" CLAUDE_CONFIG_DIR 2>/dev/null)"
    _c="${_c#CLAUDE_CONFIG_DIR=}"; case "$_c" in /*) rdir="$_c/fleet" ;; esac
  fi
  [ -n "$rdir" ] || rdir="$FLEET_DIR"           # ...then same-profile, which it usually is
fi

# The gate. Decided UNDER the lock, so a drain delivering the head right now either
# finishes first (and this sees its turn running) or has not started (and this sees the
# queue non-empty). Either way it goes behind, and order holds.
if [ "$MODE" = send ] && [ "$QUEUEABLE" = 1 ]; then
  _qlock || { echo "fleet-send: queue for '$SESSION' is locked — not sent (retry, or --now)" >&2; exit 1; }
  if busy || [ -s "$QUEUE" ]; then
    _rec="$(printf '%s\x1f%s\x1f%s\x1f%s' "${RSOCK:-}" "${RSESS:-}" "${rdir:-}" "$(_b64 "$MSG")")"
    # The same prompt already waiting is not a second task: the automated nudges (a
    # worker finished, an answer relayed) repeat word for word and would stack one turn
    # each behind a long lead turn.
    if grep -qxF -- "$_rec" <<< "$(cut -d$'\x1f' -f2- "$QUEUE" 2>/dev/null)"; then
      echo "fleet-send: → $SESSION (already queued; not added twice)"; exit 0
    fi
    printf '%s\x1f%s\n' "$(date +%s)" "$_rec" >> "$QUEUE"
    _n="$(wc -l < "$QUEUE" | tr -d ' ')"
    if busy; then
      echo "fleet-send: → $SESSION (queued #$_n — it is mid-turn; this runs as its own turn after that one ends. --now folds it in instead)"
      [ -n "${RSESS:-}" ] && echo "fleet-send: the answer to it comes back to $RSOCK/$RSESS when that queued turn ends"
      exit 0
    fi
    # Idle with a backlog (a drain that gave up, a human who was typing): deliver the
    # head now — which is not necessarily this prompt, and that is the point.
    _qunlock
    exec "$SELF" --dequeue -s "$SOCK" "$SESSION"
  fi
  _qunlock
fi

if [ -n "$RSESS" ]; then

  # CAN THE DIRECT REPLY EVEN ARRIVE? Claude Code's peer registry lives under the CONFIG
  # dir (<config>/sessions), so two profiles are two registries and neither can see the
  # other: SendMessage to a peer on another profile fails with "No agent named … is
  # reachable", every time, by design. The asker's fleet dir is the profile, and it is
  # already computed above — so the one comparison that answers this costs nothing.
  #   IT MATTERS BECAUSE THE CALLER PLANS AROUND IT. Reported by an agent that asked
  # across profiles, was told its answer would arrive directly, said so to its human, and
  # then sat idle for an hour while the answer waited in an inbox it had been told it did
  # not need to drain. The ANSWERED row was correct the whole time; only the sentence
  # promising the other path was wrong. A promise that cannot be checked is worse than no
  # promise, which is the same rule this file already applies to the busy detector.
  #   THE SIGNAL IS THE CONFIG DIR, NOT THE FLEET DIR, and the difference is not academic.
  # A fleet dir can differ for reasons that have nothing to do with profiles — a caller that
  # passes --reply-dir explicitly, a test fixture that isolates two fleets in two temp
  # directories — and treating those as "another profile" warns about a direct reply that
  # would have worked perfectly. The peer registry is keyed on <CLAUDE_CONFIG_DIR>/sessions,
  # so the config dir is the thing that actually decides whether the name can resolve.
  #   POSITIVE EVIDENCE ONLY. The warning fires when both config dirs are KNOWN and DIFFER,
  # never on a failure to read one. An unreadable env is "I could not tell", and the old
  # behaviour — ask for the direct reply, keep the relay as the fallback — is the right
  # answer to that: the ask costs one tool call if it turns out to be unreachable, while a
  # wrong warning would send a caller to poll an inbox when a message was already coming.
  XPROF=0
  _ourcfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  _askcfg="$(tmux -L "$RSOCK" show-environment -t "$RSESS" CLAUDE_CONFIG_DIR 2>/dev/null)"
  _askcfg="${_askcfg#CLAUDE_CONFIG_DIR=}"
  case "$_askcfg" in /*) [ "$_askcfg" = "$_ourcfg" ] || XPROF=1 ;; esac
  mkdir -p "$FLEET_DIR" 2>/dev/null
  # Three MANDATORY fields on one line. \x1f, not a tab: a tab is IFS-whitespace, so a
  # `read` over it collapses an empty field and shifts every later one left — and the
  # last field here is a PATH, which is exactly the field you least want to receive
  # something else's value. The hook re-validates all three anyway.
  printf '%s\x1f%s\x1f%s\n' "$RSOCK" "$RSESS" "$rdir" \
    > "$FLEET_DIR/$SOCK.$SESSION.reply-to" 2>/dev/null
  # Clear any arming left by an earlier request, or this brand-new address would look
  # armed to the turn that is running RIGHT NOW and answer it with that turn's work.
  rm -f "$FLEET_DIR/$SOCK.$SESSION.reply-to.armed" 2>/dev/null

  # THE ASKER'S PEER NAME — what Claude Code's cross-session messaging can address, and
  # the reason bin/claude-here now passes --name: it is the SAME string the hook prints in
  # an inbox row, so `${RSOCK#cf-}/$RSESS` is one derivation used on both sides rather than
  # two that have to be kept in step.
  RPEER="${RSOCK#cf-}/$RSESS"

  # Tell the target what it's in, PREPENDED. Not appended: the paste-landed probe below
  # is the last 24 chars of the message, and a fixed boilerplate tail would be the same
  # 24 chars on every relayed send — the probe would match a PREVIOUS one still on the
  # pane. Keeping the caller's own words last keeps the probe unique per send.
  #
  # ASK FOR A SendMessage FIRST, and keep the turn-ending relay as the second half of the
  # same instruction. The relay is a nine-link chain and every link drops the answer in
  # silence: the turn has to END (a usage limit, an interrupt or a killed session means no
  # answer ever), the row has to be drained, and the wake that tells the asker to drain it
  # is skipped outright when the asker is BUSY — the exact moment a lead is most likely to
  # be waiting on one. A SendMessage has none of those: it is delivered to the asker's
  # session and shows up there mid-turn.
  #   Belt AND braces on purpose. The direct path needs the asker to be an addressable
  # peer, which a session started before this change (or renamed since) is not, and a turn
  # that dies takes the tool call with it — so the answer has to be in the last message too,
  # or the fallback relays "(no text)". The hook suppresses its row when it can PROVE the
  # SendMessage landed, so saying it twice does not answer twice.
  if { [ -z "$_a" ] || [ "$_a" = claude ]; } && [ "$XPROF" = 0 ]; then
    MSG="[fleet] This request comes from another agent ($RPEER), not a human, and it is
waiting on the answer. Answer it BOTH ways, in this order:
  1. call SendMessage with to: \"$RPEER\" and the full answer as the message — that
     reaches them directly, even while they are working (it may need ToolSearch
     \"select:SendMessage\" first; ListAgents shows whether that name is live);
  2. then end your turn with that same answer as your final message — if the name isn't
     reachable, ending the turn is what gets relayed back instead.
Self-contained either way: they don't share your context.

$MSG"
  elif [ -z "$_a" ] || [ "$_a" = claude ]; then
    # CROSS-PROFILE: do not send it looking for a door that is not there. Asking anyway
    # costs the target two tool calls and a retry before it works out that the name is
    # unreachable — measured, that is exactly what happened — and worse, it invites it to
    # report "I messaged them" when nothing was delivered.
    MSG="[fleet] This request comes from another agent ($RPEER) on a DIFFERENT profile, not
a human, and it is waiting on the answer. SendMessage cannot reach them from here — the two
profiles keep separate peer registries, so the name will not resolve; do not spend a call on
it. End your turn with the full answer as your final message: that is relayed back to them
and is the only path. Self-contained: they don't share your context.

$MSG"
  else
    # Not a Claude session: SendMessage doesn't exist there, and neither does the Stop hook
    # that relays (fleet-send warns the caller about that a few lines below). Today's
    # wording, so a codex/opencode target is told the one thing it can act on.
    MSG="[fleet] This request comes from another agent ($RSOCK/$RSESS), not a human. When
your turn ends, its last message is relayed back automatically — so finish with the
ANSWER, self-contained (it doesn't share your context). No need to fleet-send a reply.

$MSG"
  fi
fi
# NOTE what a plain send deliberately does NOT do: clear an existing address. "The newest
# send wins" reads tidy and is a trap — the address is keyed by the TARGET, so every
# automated plain send would cancel a question someone else had asked that session. The
# master nudge in hooks/fleet-event.sh is exactly that (a plain fleet-send at `master`),
# so any worker finishing would silently drop a pending question to its project's master.
# Staleness is bounded from the other end instead: the hook only relays an ARMED address,
# and an unconfirmed submit below takes its own marker back.

pre_busy=no; busy && pre_busy=yes
# Only --now (or a non-Claude target, which has no queue) gets here while a turn runs.
# The one-shot marker tells the UserPromptSubmit hook this interruption was deliberate,
# so it does not label the prompt "queued behind the task in hand" (hooks/fleet-event.sh).
[ "$pre_busy" = yes ] && [ "$MODE" = now ] && : > "$FLEET_DIR/$SOCK.$SESSION.now" 2>/dev/null
[ "$pre_busy" = yes ] && echo "fleet-send: note — '$SESSION' is working; this is pasted INTO the running turn, not after it." >&2

# The relay lives in the CLAUDE event hook (hooks/fleet-event.sh), so a target running a
# different agent will never answer. Say that HERE: the whole point of --reply-to is not
# waiting on an answer that isn't coming, and a silent no-reply is the bug it fixes.
if [ -n "$RSESS" ] && [ -n "${_a:-}" ] && [ "$_a" != claude ]; then
  echo "fleet-send: note — '$SESSION' runs $_a, and the reply relay is wired into the Claude hook only; its answer won't come back on its own (read it with fleet-read${SOCK:+ -s $SOCK} $SESSION)." >&2
fi

# Bracketed paste keeps a multi-line prompt as ONE message; then submit. The race
# (why a naive send sometimes silently fails): an Enter sent before the bracketed
# paste has finished rendering is swallowed as a newline instead of submitting. So
# wait for the paste to land, submit, then VERIFY the turn actually started (the
# pane flips to the spinner) and re-Enter if it didn't.
# WHAT WAS ACTUALLY SENT, recorded before it is sent.
#
# Seen twice, on two profiles, hours apart: a session's FIRST turn was the single word
# "the" and its real brief never arrived. From the receiving side that is indistinguishable
# from a worker that ignored its instructions — and from the sending side there was nothing
# at all, because nothing recorded what went into the buffer. Three separate theories were
# investigated and disproved (the grid leaking keystrokes; ghostfleet typing a prompt at
# creation; this paste being unquoted) and every one of them cost an hour, because the only
# evidence was the transcript of the thing that received it.
#
# So the dispatch leaves a trace: target, byte length, digest. NOT the message, and not an
# excerpt of it either — a copy of every brief on disk is a second place for client material
# to live, and this repo has spent a day removing the first.
#
# The first draft logged the opening and closing forty characters, and its own test caught
# that for anything under eighty bytes those two windows OVERLAP and reconstruct the whole
# brief verbatim: a 44-byte message came back complete, and short messages are exactly the
# ones a lead dashes off without thinking. There is no window size that fixes this, because
# the excerpt was never what answered the question. Length plus digest is: a 3-byte dispatch
# is the bug on sight, and re-hashing the brief you MEANT to send settles "is what arrived
# what was sent" exactly, which is the only thing that was ever unanswerable.
#
# The digest is written through whichever of the two usual tools this host has, and never
# left blank: an empty field would look like a logged dispatch while answering nothing.
_sent_log="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}/$SOCK.sent"
_sent_digest() {                   # shasum on macOS, sha256sum on most Linux, else say so
  local h
  h="$(printf '%s' "$1" | shasum -a 256 2>/dev/null)" || h=""
  [ -n "$h" ] || h="$(printf '%s' "$1" | sha256sum 2>/dev/null)" || h=""
  h="${h%% *}"
  printf '%s' "${h:0:12}"
  [ -n "$h" ] || printf 'no-digest-tool'
}
{ printf '%s\t%s\t%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$SESSION" \
    "$(printf '%s' "$MSG" | wc -c | tr -d ' ')" "$(_sent_digest "$MSG")"
} >> "$_sent_log" 2>/dev/null || true

tmux -L "$SOCK" set-buffer -b _fleet -- "$MSG"
tmux -L "$SOCK" paste-buffer -p -d -b _fleet -t "$SESSION"

# wait for the paste to appear in the pane before pressing Enter (fall back ~2s)
probe="$(printf '%s' "$MSG" | tr '\n\r\t' '   ' | sed 's/  */ /g')"; probe="${probe: -24}"
for _ in $(seq 1 20); do
  tmux -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null | grep -qF -- "$probe" && break
  sleep 0.1
done

# Confirm the turn actually started. The RELIABLE signal is our pasted probe
# LEAVING Claude's input box: that catches a turn that finishes before any spinner
# renders (a fast reply) AND a turn that thinks a while before one appears (Opus
# extended thinking); a live spinner counts too. Watching only the spinner over a
# short window is what produced false "no turn started" warnings and a flurry of
# stray Enters fired into an already-running turn.
#
# in_input: 0 = probe still sitting in the input box; 1 = box present, probe gone
# (submitted); 2 = no box found (unknown → fall back to the spinner).
#
# BOTH COMPOSER STYLES, and the second one is why this exists. Claude used to draw the
# input box with rounded corners (╭ … ╰) and now draws it as two plain horizontal rules.
# Looking only for ╰ made this blind on every current pane: it returned 2 (unknown)
# forever, so `submitted` never confirmed and EVERY send ended in "could not confirm
# submit — verify it landed".
#   That warning was the harmless half. The re-nudge that recovers a swallowed Enter
# only fires when in_input says 0 — probe STILL in the box — which a blind detector can
# never say. So the one case it exists for, the paste/Enter race, stopped being
# recoverable: the prompt sat in the composer unsent, indefinitely, and from the outside
# the worker looked like it was ignoring you. Found on a live fleet where a lead's
# "continue where you left off" was still sitting in the box, unsent, while the session
# answered a fresh probe perfectly.
#   A boundary is a line made of nothing but box-drawing rule characters and spaces —
# true of ╭──╮/╰──╯ and of a bare ───── alike. The composer is between the LAST TWO,
# because below it there is only the status bar, which carries text.
in_input() {
  local pane; pane="$(tmux -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null)"
  printf '%s\n' "$pane" | awk -v p="$probe" '
    { l[NR]=$0; if ($0 ~ /^[[:space:]]*[─╭╰╮╯][─╭╰╮╯[:space:]]*$/) b[++n]=NR }
    END { if (n < 2) exit 2
          o = b[n-1]; c = b[n]
          for (i = o; i <= c; i++) if (index(l[i], p)) exit 0
          exit 1 }'
}
submitted() { busy && return 0; in_input; [ "$?" = 1 ]; }

if [ "$pre_busy" = yes ]; then
  # already mid-turn: the submit hands it to the running turn; one Enter is enough
  sleep "${CLAUDE_FLEET_SUBMIT_DELAY:-0.4}"
  tmux -L "$SOCK" send-keys -t "$SESSION" Enter
  echo "fleet-send: → $SESSION (into the running turn)"
else
  tmux -L "$SOCK" send-keys -t "$SESSION" Enter
  ok=no; renudged=no
  for i in $(seq 1 40); do                      # up to ~8s, but breaks as soon as confirmed
    submitted && { ok=yes; break; }
    # a swallowed Enter (the paste/Enter race) leaves the probe in the box — nudge
    # exactly ONCE more after ~1.6s; never spam Enter into a live turn
    if [ "$i" = 8 ] && [ "$renudged" = no ]; then
      in_input; [ "$?" = 0 ] && { tmux -L "$SOCK" send-keys -t "$SESSION" Enter; renudged=yes; }
    fi
    sleep 0.2
  done
  if [ "$ok" = yes ]; then
    echo "fleet-send: → $SESSION"
  else
    echo "fleet-send: → $SESSION (warning: could not confirm submit — verify it landed)" >&2
    # Take the reply address back. Unconfirmed means no turn is known to have started,
    # and a marker left behind would attach our question to whatever that session does
    # NEXT — answering a stranger's turn to a session that stopped waiting. The hook
    # only relays an ARMED address, so this only matters when nothing ever armed it.
    [ -n "$RSESS" ] && [ ! -f "$FLEET_DIR/$SOCK.$SESSION.reply-to.armed" ] \
      && rm -f "$FLEET_DIR/$SOCK.$SESSION.reply-to" 2>/dev/null
  fi
fi

# A plain `[ -n … ] && echo` here would leave a FALSE exit status behind when there is no
# reply address, and callers read fleet-send's status as "did the send work" (the MCP
# server turns any nonzero into an error string).
if [ -n "$RSESS" ]; then
  if [ -z "$_a" ] || [ "$_a" = claude ]; then
    # Name BOTH paths: the caller is about to wait, and "watch your inbox" alone would be
    # wrong now — the usual delivery is a message that arrives in this session directly.
    if [ "$XPROF" = 1 ]; then
      # The caller is about to decide whether to wait or to drain. Say which.
      echo "fleet-send: $RSOCK/$RSESS is on another profile — NO direct reply is possible (separate peer registries)."
      echo "fleet-send: its answer arrives as an ANSWERED row in your fleet-inbox; drain it rather than waiting for a message."
    else
      echo "fleet-send: it was asked to answer ${RPEER:-$RSOCK/$RSESS} directly (SendMessage), and its turn-end message is relayed to $RSOCK/$RSESS as the fallback"
    fi
  else
    echo "fleet-send: its answer will be relayed to $RSOCK/$RSESS when its turn ends"
  fi
fi

# CF-6: record the dispatched task in the manifest so fleet-worktrees' TASK column
# reflects fleet-send work too (not just fleet-spawn --prompt). Keyed by the target's
# worktree path, matching fleet-spawn. Best-effort; never affects the send result.
MANIFEST="$FLEET_DIR/$SOCK.manifest.tsv"
cwd="$(tmux -L "$SOCK" display-message -p -t "$SESSION" '#{pane_current_path}' 2>/dev/null)"
if [ -n "$cwd" ]; then
  subject="$(printf '%s' "$MSG" | tr '\n\r\t' '   ' | sed 's/^ *//' | cut -c1-200)"
  br="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
  mtmp="$MANIFEST.$$.tmp"; mkdir -p "$FLEET_DIR" 2>/dev/null
  { [ -f "$MANIFEST" ] && awk -F'\t' -v w="$cwd" '$1!=w' "$MANIFEST"
    printf '%s\t%s\t%s\t%s\n' "$cwd" "$SESSION" "$br" "$subject"; } >"$mtmp" 2>/dev/null \
    && mv -f "$mtmp" "$MANIFEST" 2>/dev/null || rm -f "$mtmp" 2>/dev/null
fi
