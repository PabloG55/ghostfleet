#!/usr/bin/env bash
# fleet-send [-s SOCKET] [--after-turn | --now] [--reply-to me|<session>|<socket>/<session>]
#            [--reply-dir DIR] [--anyway] <session> <prompt...>
# fleet-send [-s SOCKET] --dequeue <session>        (what the Stop hook runs)
# fleet-send [-s SOCKET] --would-queue <session>    (what a plain send would meet right now:
#                                                   working | need-you | backlog | idle)
# fleet-send [-s SOCKET] --stranded | --requeue <session> <id> | --discard <session> <id>
#                                                   (a prompt a dead drain left out of the queue)
#
# --nudge marks the prompt as the fleet's own wake-up (hooks/fleet-event.sh's "a worker
# finished, run fleet-inbox"), not something anyone asked of the session: the mod's ledger
# records no item for it. It rides the handoff entry and the queue record as a marker, so the
# ledger never has to recognise a nudge by its wording. A nudge that falls back to the paste
# arrives as typed text and carries nothing; that path records it as the person's.
#
# --owner marks the prompt as THE OWNER'S OWN WORDS, and is passed only by a sender that
# authenticated the owner: the phone's server, whose request carried a passkey-minted token
# (mcp/fleet-dispatch.mjs asOwner adds it for that door alone; the MCP tool has no field for
# it) — and bin/fleet-telegram, which delivers a message only from the one chat id the
# owner's secret command names, and drops every other chat before anything is sent. The
# mod's ledger then records it as the person's message, judged like one typed at the
# prompt, instead of as a lead's brief that is done only with proof. A worker or a lead
# dispatching work never passes it. It rides the handoff and the queue record like --nudge.
#
# --why "<one line>" says what the work is FOR. It is appended to the prompt the session
# receives, and the fleet's memory keeps it beside the worker's task, where the lead's briefing
# reads it back. A brief to a worker that carries no why prints one line that says so: never a
# refusal, and never for what is not a brief — a nudge, the owner's own words, an explain
# request, a question sent with --reply-to, a send to master, a slash command, the fleet's own
# `[fleet]` messages, or words that already carry a `Why:` line.
#
# To a session that is mid-turn the prompt goes INTO THE RUNNING TURN, and the agent reads it
# at its next step, labelled as queued work: finish the task in hand, then do this one, unless
# the message itself says stop, instead or first do (hooks/fleet-event.sh). See "the queue"
# below for the cases that still wait, and why.
#   --after-turn holds it instead, until that turn ends, and it runs as a turn of its own.
#   --now is the explicit INTERRUPT: pasted into the turn with no label at all. Only the
# fleet's own need-you nudge uses it (hooks/fleet-event.sh _wake). No default send writes its
# mark, from the phone, the web client, the MCP tool, Telegram or this command.
#
# Type <prompt> into another fleet session's Claude input and submit it. Meant
# to be called by a "lead" Claude session (via its Bash tool) to dispatch work
# to sibling sessions in the same fleet.
#
# Socket defaults to $CLAUDE_FLEET_SOCK (exported into every fleet session).
# Uses a bracketed paste so multi-line prompts go in as ONE message, then Enter.
#
# --reply-to makes it a CONVERSATION instead of a one-way dispatch. It asks the target to
# answer the asker DIRECTLY, by name, with Claude Code's cross-session messaging
# (SendMessage) — which lands even when the asker is mid-turn — and it records who asked,
# so a turn that never gets there still has its last message relayed into the asker's
# inbox by the event hook. Without it, a send is fire-and-forget — the target's
# Stop only ever reaches ITS OWN fleet's master (hooks/fleet-event.sh), which is why a
# question sent across projects looked like it was ignored. See that hook for the
# routing; --reply-dir is for callers whose env doesn't name the asker's fleet dir.
set -uo pipefail

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"

SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer $TMUX (the live server this session runs in) over the env var — it's
# drift-proof; a long-running --resume/--fork Claude can hold a stale
# CLAUDE_FLEET_SOCK. Only when it names a cf-* fleet server; -s still overrides.
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac

# WHO IS ASKING — resolved from $TMUX only, and BEFORE -s can move SOCK.
# `--reply-to me` must NOT be answered out of CLAUDE_FLEET_SOCK: the MCP server calls
# this with TMUX cleared and CLAUDE_FLEET_SOCK repointed at the TARGET's fleet (see
# run() in mcp/fleet-mcp.mjs), so a guess from env would address the reply to our
# session NAME on the target's SOCKET — a marker that validates perfectly and relays
# to whichever session answers that name over there. So `me` resolves from the live
# server or fails loudly, and callers with no $TMUX pass the address explicitly.
SELF_SOCK=""; SELF_SESS=""
case "${_t##*/}" in cf-*)
  SELF_SOCK="${_t%%,*}"; SELF_SOCK="${SELF_SOCK##*/}"
  # $TMUX is "<socket-path>,<server-pid>,<session-id>" and that last field is the
  # session ID ($7), not its name — look the name up rather than trusting
  # CLAUDE_FLEET_SLOT, which a --resume'd/--fork'd session can hold stale.
  _sid="${_t##*,}"; case "$_sid" in ''|*[!0-9]*) _sid="" ;; esac
  [ -n "$_sid" ] && SELF_SESS="$(tmux -u -L "$SELF_SOCK" list-sessions \
      -F '#{session_id} #{session_name}' 2>/dev/null | awk -v i="\$$_sid" '$1==i{print $2; exit}')"
  [ -n "$SELF_SESS" ] || SELF_SESS="${CLAUDE_FLEET_SLOT:-}"
;; esac

REPLY_TO=""; REPLY_DIR=""; ANYWAY=0; WHY=""
# Set for real beside the asker's fleet dir; declared here so `set -u` cannot trip on a
# send that has no --reply-to at all.
XPROF=0
# send (the default) goes into a running turn, labelled; --after-turn queues behind it; --now
# pastes into it unlabelled; --dequeue delivers the next queued prompt, and is what the Stop
# hook runs (see "the queue" below).
MODE=send
KIND=""
AFTER=0
while [ $# -gt 0 ]; do
  case "$1" in
    -s)          SOCK="${2:-}";      shift 2 ;;
    --reply-to)  REPLY_TO="${2:-}";  shift 2 ;;
    --reply-dir) REPLY_DIR="${2:-}"; shift 2 ;;
    --anyway)    ANYWAY=1;           shift ;;
    # One line, whatever arrives: a pasted paragraph is folded onto one.
    --why)       WHY="$(printf '%s' "${2:-}" | tr '\t\r\n' '   ' | sed 's/^ *//; s/ *$//')"; shift 2 ;;
    --now)       MODE=now;           shift ;;
    # Held until the running turn ends, as a turn of its own: the sender's explicit choice
    # (the client's "send after this turn", bin/fleet-telegram for a message it holds).
    --after-turn) AFTER=1;           shift ;;
    --nudge)     KIND=nudge;         shift ;;
    --owner)     KIND=owner;         shift ;;
    # A request to explain one of the session's own ledger items to the person (fleet-ledger
    # explain): it waits for its turn like any send, and its ledger makes no item of it.
    --explain)   KIND=explain;       shift ;;
    --dequeue)   MODE=dequeue;       shift ;;
    # Sends nothing: says what a plain send would meet (see "what a send would meet" below).
    --would-queue) MODE=probe;       shift ;;
    # What the phone reads and edits: the prompts still WAITING in the queue, and taking one
    # back out before it is delivered (see "reading and editing the queue" below).
    --list-queue) MODE=list;         shift ;;
    --unqueue)   MODE=unqueue;       shift ;;
    # Internal: the queue's own delivery (what --dequeue runs). Past the gate like --now,
    # but a turn of its own rather than a paste into one, so it may go through the mod.
    --queued)    MODE=queued;        shift ;;
    # A prompt a dead drain left OUTSIDE the queue (see "a prompt the drain stranded"):
    # list them, put one back at the head of its queue, or throw it away. The owner's call.
    --stranded)  MODE=stranded;      shift ;;
    --requeue)   MODE=requeue;       shift ;;
    --discard)   MODE=discard;       shift ;;
    # The end of the flags: what follows is the session and the prompt, whatever they spell.
    # mcp/fleet-dispatch.mjs always passes it, so no session or prompt a caller hands the MCP
    # tool can be read as --owner (or any other flag).
    --)          shift; break ;;
    *) break ;;
  esac
done
SESSION="${1:-}"; shift || true
MSG="$*"
# Under the words, where the worker reads it after what it is asked to do: the head of a brief
# is what a session reads first and what the manifest shows as its task.
[ -n "$WHY" ] && [ -n "$MSG" ] && MSG="$MSG

Why: $WHY"

[ -n "$SOCK" ]    || { echo "fleet-send: no socket (run inside a fleet session, or pass -s <socket>)" >&2; exit 1; }
# The drain's delivery records its own pid in the journal first thing, so a drain that took
# over a dead one's lock can tell a delivery that is still running from one that died.
[ "$MODE" = queued ] && [ -n "${CLAUDE_FLEET_QUEUE_JOURNAL:-}" ] \
  && printf 'child %s\n' $$ >> "$CLAUDE_FLEET_QUEUE_JOURNAL" 2>/dev/null
[ -n "$SESSION" ] || [ "$MODE" = stranded ] || { echo "fleet-send: usage: fleet-send [-s socket] [--after-turn | --now] [--reply-to me|<session>|<socket>/<session>] [--anyway] <session> <prompt>
  (to a working session the prompt goes into the running turn, labelled as queued work;
   --after-turn holds it until that turn ends; --now interrupts with no label)" >&2; exit 1; }
[ "$AFTER" = 1 ] && [ "$MODE" = now ] && { echo "fleet-send: --after-turn and --now ask for opposite things; pass one" >&2; exit 1; }
[ -n "$MSG" ] || [ "$MODE" = dequeue ] || [ "$MODE" = list ] || [ "$MODE" = stranded ] || [ "$MODE" = probe ] || { echo "fleet-send: empty prompt" >&2; exit 1; }
# A TAB IS NOT AN AGENT. fleet-tab's _term-*/_edit-* sessions live on this same socket
# and run a shell, so a send would type the prompt at a shell prompt and press Enter —
# the fleet would execute it, and the "answer" would never come because nothing here
# is waiting for a Stop. Refuse by name; there is no pane signal that could tell a
# shell from an agent reliably enough to catch this later.
case "$SESSION" in
  _term-*|_edit-*) echo "fleet-send: '$SESSION' is a tab (a shell), not an agent — it cannot be prompted" >&2; exit 1 ;;
esac

# --- the queue -----------------------------------------------------------------
# A PROMPT SENT TO A BUSY SESSION WAS FOLDED INTO THE TURN THAT IS RUNNING, AND READ AS A
# CHANGE OF DIRECTION. This script used to paste into the input box of a working session
# and say "your prompt will queue after this turn"; Claude Code instead hands a message
# submitted mid-turn to the turn in progress. Task A was dropped for task B with nothing
# anywhere saying so — reported as "I'm treating it as a queue and the agents are not
# finishing both". Measured on 2.1.280: two prompts, one UserPromptSubmit each, ONE Stop
# between them. So every send to a working session was written here instead, and delivered
# after that session's Stop.
#   THAT CURE COST THE THING A MID-TURN MESSAGE IS FOR. A correction ("stop using that
# file", "also check the phone") reached the agent only after the work it was meant to
# change was finished. And the fold has had its own guard since: the UserPromptSubmit hook
# labels a prompt that arrives mid-turn as QUEUED WORK, finish the task in hand and then do
# this one, unless it says stop, instead or first do. With the label, delivering at once and
# keeping both tasks do not conflict, so a send to a working Claude session now goes INTO
# the turn, at its next step.
#   What still waits here, each for a reason the sender is told in its own line:
#     --after-turn, the sender's explicit choice;
#     a session stopped on a question (need-you): a paste would answer the question;
#     a box someone is typing in, or one this cannot read: the paste would be submitted
#       together with their half-written words;
#     the fleet's own nudges and explain requests, which are about the next turn, not this one;
#     a question whose answer the running turn already owes somebody else: one Stop can
#       relay one answer;
#     a Telegram message into a turn that did not come from Telegram: the tool guard would
#       take the shell away from the desk task in hand for the rest of its turn.
#   The queue's drain is the Stop hook (`fleet-send --dequeue`), which delivers the head
# after that session's Stop, as a turn of its own.
#   ONE RECORD PER LINE, \x1f between fields (an empty reply field must not collapse):
# queued-at, reply socket, reply session, reply dir, and the prompt BASE64'D, because a
# prompt is multi-line and a line is the record. The reply address is stored RESOLVED and
# NOT written as a marker yet: a marker written now would be armed by whichever
# UserPromptSubmit comes next, which is not necessarily this prompt's.
#   Claude here. codex keeps a queue of its own, which --after-turn uses (see CODEX_Q below);
# opencode has nothing that would ever deliver a queued prompt, so it keeps the paste.
# ── THE TARGET'S FILES GO IN THE TARGET FLEET'S DIRECTORY ─────────────────────
# Everything below that is keyed by $SOCK — the queue, the reply-to marker the target's Stop
# hook reads, the --now mark, the manifest, the sent log — belongs to the TARGET, and was
# written under the CALLER's fleet dir. A send from a default-profile pane to a fleet on
# another profile left its reply-to request in the default dir while the target's hook
# looked in its own, so the question was worked on and never answered: from the asking
# side, indistinguishable from being ignored. The fleet's dir comes from its project
# (lib/fleet-env.mjs); a socket no project owns keeps the caller's, as before.
CALLER_FLEET_DIR="$FLEET_DIR"
_fsrc="${BASH_SOURCE[0]}"
while [ -L "$_fsrc" ]; do _l="$(readlink "$_fsrc")"; case "$_l" in /*) _fsrc="$_l" ;; *) _fsrc="$(dirname "$_fsrc")/$_l" ;; esac; done
FLEET_ENV="$(cd "$(dirname "$_fsrc")/../lib" 2>/dev/null && pwd)/fleet-env.mjs"
if command -v node >/dev/null 2>&1 && [ -f "$FLEET_ENV" ] \
   && _env="$(node "$FLEET_ENV" of "$SOCK" 2>/dev/null)" && [ -n "$_env" ]; then
  IFS=$'\x1f' read -r _ _dir _ <<< "$_env"
  [ -n "$_dir" ] && FLEET_DIR="$_dir"
fi
QUEUE="$FLEET_DIR/$SOCK.$SESSION.queue"

# ── A SESSION THE FLEET PUT TO SLEEP ─────────────────────────────────────────
# Has no process (bin/fleet-hibernate), so it fails the check below — and a send to it used
# to stop there, "no session", which to anyone looking at its card it plainly was not. It is
# woken further down, once the checks that could refuse the send have run (see "a sleeping
# session is woken first"); here it is only told apart from a session that does not exist.
#   THE MARKER IS IN THE TARGET FLEET'S DIRECTORY, resolved just above; the caller's would
# answer for a different profile. EXISTENCE BY `=`: a bare target matches by prefix, so a
# sleeping `billing` would have been "found" as a live `billing-svc`, and typed into.
#   What only reads does not wake: --would-queue says `asleep`, and --list-queue, --unqueue
# and --requeue touch the queue file alone (a requeue's delivery is a --dequeue, which does).
# A stranded prompt outlives its session often enough: listing and discarding need none.
ASLEEP=0
if [ "$MODE" != stranded ] && [ "$MODE" != discard ] \
   && ! tmux -L "$SOCK" has-session -t "=$SESSION" 2>/dev/null && [ -f "$FLEET_DIR/$SOCK.$SESSION.asleep" ]; then
  case "$MODE" in
    probe) echo asleep; exit 0 ;;
    list|unqueue|requeue) ;;
    *) ASLEEP=1 ;;
  esac
elif [ "$MODE" != stranded ] && [ "$MODE" != discard ]; then
  tmux -L "$SOCK" has-session -t "$SESSION" 2>/dev/null \
    || { echo "fleet-send: no session '$SESSION' on $SOCK (try: fleet-list)" >&2; exit 1; }
fi

# WHAT BECAME OF A DISPATCH, on its row of <sock>.sent (see "what was actually sent"). The
# row used to be written before delivery was even attempted, so it meant "attempted" and
# nothing more: three wakes into one lead were logged at their second, none of them reached
# it, and the log read exactly like a night on which all three had landed. So the row is
# written as this process EXITS, with the attempt's own time, and a sixth field says what
# happened: delivered, ran (a slash command with no turn of its own), queued (handed back to
# the queue: it runs after the turn in progress), claimed (the mod holds it and had not
# started it when this stopped waiting), unconfirmed (pasted, and no turn was seen to
# start), failed. An exit nothing below named reads `attempted` on a zero status and
# `failed` otherwise, and a HUP/INT/TERM still writes its row. Only a SIGKILL loses one.
# Every earlier field is where it was, so a reader of the first five reads them unchanged.
# Defined up here because the queue's lock shares the one EXIT trap.
SENT_AT=""; SENT_OUT=""; SENT_LEN=""; SENT_DIG=""; SENT_BY=""
_sent_log="$FLEET_DIR/$SOCK.sent"
_sent_flush() {                    # $1 = the exit status, taken before anything resets it
  local rc="${1:-0}" out
  [ -n "$SENT_AT" ] || return 0
  out="$SENT_OUT"; [ -n "$out" ] || { [ "$rc" = 0 ] && out=attempted || out=failed; }
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$SENT_AT" "$SESSION" "$SENT_LEN" "$SENT_DIG" "$SENT_BY" "$out" \
    >> "$_sent_log" 2>/dev/null || true
  SENT_AT=""
}

# mkdir is the lock because it is atomic everywhere this runs (flock is not on macOS).
# The holder's pid goes inside, so one that died holding it is taken over rather than
# waited on forever; a lock with no pid yet is only a race lost to a live holder.
_qlock() {
  local i=0 p
  mkdir -p "$FLEET_DIR" 2>/dev/null
  while ! mkdir "$QUEUE.lock" 2>/dev/null; do
    p="$(cat "$QUEUE.lock/pid" 2>/dev/null)"
    if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$QUEUE.lock"; continue; fi
    i=$((i + 1)); [ "$i" -ge 200 ] && return 1          # ~20s: a delivery holds it ~8s
    sleep 0.1
  done
  echo $$ > "$QUEUE.lock/pid"
  trap '_x=$?; rm -rf "$QUEUE.lock" 2>/dev/null; _sent_flush "$_x"' EXIT
}
_qunlock() { rm -rf "$QUEUE.lock" 2>/dev/null; trap '_sent_flush $?' EXIT; }
_b64()   { printf '%s' "$1" | base64 | tr -d '\n'; }
_unb64() { printf '%s' "$1" | base64 -d 2>/dev/null || printf '%s' "$1" | base64 -D 2>/dev/null; }

# --- a prompt the drain stranded -----------------------------------------------
# THREE PROMPTS SAT IN NO QUEUE AT ALL. One fleet's directory held three leftover
# <sock>.<session>.queue.<pid>.tmp files, each one complete record — two to a master, a
# week apart, one to a worker — and none was ever delivered. The drain used to CUT the head
# off the queue before delivering it, and write it back through that tmp when the delivery
# answered busy: a drain killed or failing anywhere in between dropped the prompt, and
# nothing anywhere said so.
#   So the head now STAYS in the queue until its delivery is confirmed, and leaves it only
# then. What a crash can still leave ambiguous is whether it reached the session, and that
# is what the journal answers: <queue>.sending holds the record out for delivery, the
# delivery appends `child <pid>` as it starts and `began` just before it first touches the
# session (the mod's spool, or the paste). A drain that takes over a dead one's lock reads
# it (_qrecover):
#   no `began`     nothing reached the session: the record is still the head, delivered next;
#   `began`        it may have been typed in — AT MOST ONCE wins, so it is not re-sent but
#                  moved aside, to <queue>.<id>.indoubt, for a person to re-queue or discard;
#   live child     the delivery is still running: busy (3), try again.
# A delivery that ANSWERS "not delivered" after it began (the mod refused it) is moved aside
# the same way, as .refused: it left the queue, and its words should not leave with it.
# Every rewrite of the queue goes through a tmp INSIDE the lock dir, so a crash leaves it
# where taking over the lock deletes it, and never a copy that could be mistaken for a lost
# prompt. Only the old code leaves .tmp files beside the queue; --stranded reports those too.
QJ="$QUEUE.sending"
_qdrop_head() {
  tail -n +2 "$QUEUE" > "$QUEUE.lock/q" 2>/dev/null && mv -f "$QUEUE.lock/q" "$QUEUE"
  [ -s "$QUEUE" ] || rm -f "$QUEUE"
}
# Moves the head to a file only a person resolves: written first, then dropped, so a crash
# between leaves it in both places rather than in neither. One drain can strand two in the
# same second (a dead drain's head, then its own), so the name carries more than time and pid.
_qstrand() {
  head -n 1 "$QUEUE" > "$QUEUE.lock/s" 2>/dev/null \
    && mv -f "$QUEUE.lock/s" "$QUEUE.$(date +%s)-$$-$RANDOM.$1" && _qdrop_head
}
# Under the lock. 1 = a delivery from a drain that died is still running.
_qrecover() {
  local rec="" hd="" cp
  [ -f "$QJ" ] || return 0
  { IFS= read -r rec < "$QJ"; } 2>/dev/null
  cp="$(sed -n 's/^child \([0-9][0-9]*\)$/\1/p' "$QJ" 2>/dev/null | tail -n 1)"
  if [ -n "$cp" ] && kill -0 "$cp" 2>/dev/null \
     && grep -q fleet-send <<< "$(ps -o args= -p "$cp" 2>/dev/null)"; then
    return 1
  fi
  { IFS= read -r hd < "$QUEUE"; } 2>/dev/null
  # Not the head any more: its drain had already settled it and died before tidying up.
  if [ -n "$rec" ] && [ "$rec" = "$hd" ] && grep -qx began "$QJ" 2>/dev/null; then
    _qstrand indoubt
  fi
  rm -f "$QJ"
}

# --stranded: one line per stranded RECORD, \x1f between fields:
#   <session> <id> <queued-at> <prompt bytes> <kind> <still queued: 1|0>
# kind is tmp (left by the old drain or take-back), indoubt, refused, or unwoken (sent to a
# sleeping session whose wake failed, by a sender nobody reads). The prompt's LENGTH,
# never its words: this is printed into inboxes and transcripts, and a prompt is the
# owner's. "Still queued" is a copy whose original is waiting anyway — re-queueing skips it.
# --requeue <session> <id>: back to the HEAD of its queue, where it was, skipping a record
#   already waiting; then delivered at once if the session is idle. --discard <session> <id>.
_stranded_id() {
  case "$1" in *[!A-Za-z0-9.-]*|.*|*..*) return 1 ;; esac
  case "$1" in *.tmp|*.indoubt|*.refused|*.unwoken) return 0 ;; esac
  return 1
}
if [ "$MODE" = stranded ]; then
  for _f in "$FLEET_DIR/$SOCK".*.queue.*.tmp "$FLEET_DIR/$SOCK".*.queue.*.indoubt "$FLEET_DIR/$SOCK".*.queue.*.refused "$FLEET_DIR/$SOCK".*.queue.*.unwoken; do
    [ -f "$_f" ] || continue
    _n="${_f##*/}"; _n="${_n#"$SOCK".}"; _s="${_n%.queue.*}"; _id="${_n##*.queue.}"
    _stranded_id "$_id" || continue
    _live="$FLEET_DIR/$SOCK.$_s.queue"
    while IFS= read -r _line; do
      IFS=$'\x1f' read -r _q_at _q_rs _q_rss _q_rd _q_msg _q_kind _q_extra <<< "$_line"
      [ -n "${_q_msg:-}" ] && [ -z "${_q_extra:-}" ] || continue
      _len="$(_unb64 "$_q_msg" | wc -c | tr -d ' ')"
      _in=0; [ -f "$_live" ] && grep -qxF -- "$_line" "$_live" && _in=1
      case "$_q_at" in ''|*[!0-9]*) _q_at=0 ;; esac
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$_s" "$_id" "$_q_at" "$_len" "${_id##*.}" "$_in"
    done < "$_f"
  done
  exit 0
fi
if [ "$MODE" = requeue ] || [ "$MODE" = discard ]; then
  case "$SESSION" in *[!A-Za-z0-9._~-]*) echo "fleet-send: '$SESSION' is not a session name" >&2; exit 1 ;; esac
  _stranded_id "$MSG" || { echo "fleet-send: '$MSG' is not a stranded prompt's id (see fleet-inbox)" >&2; exit 1; }
  _f="$QUEUE.$MSG"
  [ -f "$_f" ] || { echo "fleet-send: no stranded prompt $MSG for '$SESSION' (already resolved?)" >&2; exit 4; }
  if [ "$MODE" = discard ]; then
    rm -f "${_f:?}"; echo "fleet-send: discarded $SESSION's stranded prompt $MSG — it will not be delivered"; exit 0
  fi
  _qlock || { echo "fleet-send: queue for '$SESSION' is locked — try again in a moment" >&2; exit 1; }
  _qrecover || { echo "fleet-send: '$SESSION' is being delivered to — try again in a moment" >&2; exit 1; }
  _k=0
  { while IFS= read -r _line; do
      [ -n "$_line" ] || continue
      [ -f "$QUEUE" ] && grep -qxF -- "$_line" "$QUEUE" && continue
      printf '%s\n' "$_line"; _k=$((_k + 1))
    done < "$_f"
    [ -f "$QUEUE" ] && cat "$QUEUE"
    :
  } > "$QUEUE.lock/q" && mv -f "$QUEUE.lock/q" "$QUEUE" && rm -f "${_f:?}" \
    || { _qunlock; echo "fleet-send: could not put $MSG back into $SESSION's queue — it is still stranded" >&2; exit 1; }
  [ -s "$QUEUE" ] || rm -f "$QUEUE"
  _qunlock
  case "$MSG" in *.indoubt) echo "fleet-send: note — its drain died mid-delivery, so it may already have been typed in once" >&2 ;; esac
  echo "fleet-send: put $SESSION's stranded prompt back at the head of its queue ($_k record(s))"
  # Idle now: deliver it now, as a send to an idle session with a backlog does. Busy: the
  # turn's Stop drains it.
  exec "${BASH_SOURCE[0]}" --dequeue -s "$SOCK" "$SESSION"
fi

# --- reading and editing the queue ---------------------------------------------
# A QUEUED PROMPT WAS INVISIBLE FROM THE PHONE. The send answered "queued #2" and the chat
# drew one dim bubble that the next send replaced, so the owner lost sight of everything
# still waiting behind a long turn — and could not take one back to fix a typo, because
# nothing could read this file but the drain. Both live HERE because this script owns the
# record format; a second reader in fleet-serve would drift the first time a field moved.
#
# --list-queue: one line per WAITING prompt, `<queued-at>\t<prompt base64>\t<kind>`.
#   Base64 because a prompt is multi-line and the line is the record. The kind is LAST
# because it is usually empty, and an empty field between two tabs vanishes under a shell
# `read` (tab is IFS-whitespace) — the suite's own reader hit exactly that with it in the
# middle, and every later column moved left.
# --unqueue <session> <prompt>: take the FIRST waiting record that is exactly this prompt
#   back out, under the lock the drain takes. Matched on the stored base64 of the caller's
#   own words, byte for byte, so no decoding can make two prompts look equal. Exit 4 when
#   it is not there: the drain has already delivered it (it was typed into the session),
#   which is the one case where "edit it" has to become "too late".
#   A nudge is never taken back — it is the fleet's own wake, not anything the owner wrote.
if [ "$MODE" = list ]; then
  [ -s "$QUEUE" ] || exit 0
  while IFS=$'\x1f' read -r _q_at _q_rs _q_rss _q_rd _q_msg _q_kind _q_extra; do
    [ -n "${_q_msg:-}" ] && [ -z "${_q_extra:-}" ] || continue
    printf '%s\t%s\t%s\n' "$_q_at" "$_q_msg" "${_q_kind:-}"
  done < "$QUEUE"
  exit 0
fi
if [ "$MODE" = unqueue ]; then
  _qlock || { echo "fleet-send: queue for '$SESSION' is locked — try again in a moment" >&2; exit 1; }
  # A head left in doubt by a dead drain is not "never delivered": settle it first.
  _qrecover || { echo "fleet-send: '$SESSION' is being delivered to — try again in a moment" >&2; exit 1; }
  # Inside the lock dir, like every rewrite (see "a prompt the drain stranded").
  _want="$(_b64 "$MSG")"; _hit=0; _qt="$QUEUE.lock/q"
  : > "$_qt"
  if [ -s "$QUEUE" ]; then
    while IFS= read -r _line; do
      IFS=$'\x1f' read -r _q_at _q_rs _q_rss _q_rd _q_msg _q_kind _q_extra <<< "$_line"
      if [ "$_hit" = 0 ] && [ "${_q_msg:-}" = "$_want" ] && [ "${_q_kind:-}" != nudge ]; then
        _hit=1; continue
      fi
      printf '%s\n' "$_line" >> "$_qt"
    done < "$QUEUE"
  fi
  if [ "$_hit" = 1 ]; then
    if [ -s "$_qt" ]; then mv -f "$_qt" "$QUEUE"; else rm -f "${_qt:?}" "${QUEUE:?}"; fi
    echo "fleet-send: took it back out of $SESSION's queue — it was never delivered"
    exit 0
  fi
  rm -f "${_qt:?}"
  echo "fleet-send: not in $SESSION's queue any more — it has already been typed into the session" >&2
  exit 4
fi

# A NEW TASK IS A NEW SESSION. A worker whose task has shipped still holds all of that
# task in its context, and the next brief gets worked through it — the files it already
# read, the approach it settled on, the half-remembered dead end. So a send to a worker
# that finished and shipped is refused, pointing at fleet-spawn (which may reuse the
# FOLDER: --reuse starts a new conversation there). bin/fleet-shipped owns the definition
# and keeps it narrow: an open PR is never "shipped", so a red CI row or a review note on
# the same PR always goes through, and so does a session that has not finished a turn.
#   A --reply-to QUESTION is exempt: asking a finished worker why it did something wants
# exactly the context it has. --anyway is for the follow-up this cannot recognise.
#   So is the queue's DRAIN (--dequeue, and the --anyway delivery it runs): this check
# already ran when the prompt was queued, against a worker that was mid-turn on the task
# the prompt was sent about. That turn may well ship before it ends — refusing the queued
# follow-up then would drop it, popped and undelivered, for having waited its turn.
if [ "$ANYWAY" != 1 ] && [ "$MODE" != dequeue ] && [ "$MODE" != probe ] && [ -z "$REPLY_TO" ] \
   && why="$("$(dirname "$0")/fleet-shipped" -s "$SOCK" "$SESSION" 2>/dev/null)"; then
  echo "fleet-send: '$SESSION' already finished a task that shipped ($why) — a new task is a new session: fleet-stop --reclaim $SESSION, then fleet-spawn <name> --prompt … (--reuse <worktree> keeps the folder). A follow-up on that same work: add --anyway" >&2
  exit 1
fi

# ── A SLEEPING SESSION IS WOKEN FIRST ────────────────────────────────────────
# A send that would DELIVER wakes it with the wake the card uses — a success only once the
# session is still up a few seconds after its first prompt — and then goes on exactly as a
# send to an idle session does. Here, after everything that could refuse the send (a tab, a
# shipped task) and BEFORE the agent, the busy pattern and the mod are read, because each of
# those reads the live session and there is none until this has run.
#   A FAILED WAKE IS AN ERROR TO THE SENDER, never a silence and never a paste into nothing:
# nothing was typed, and it says why. A sender nobody reads (CLAUDE_FLEET_SEND_REPORT, as for
# a delivery the mod could not submit) also has its prompt KEPT — moved aside as a stranded
# prompt that fleet-inbox lists until a person re-queues it (which wakes it again) or discards
# it — and the failure filed with its lead, since its words exist nowhere else. One whose
# output IS read still has them, and a second copy would come back as a duplicate.
#   The wake's own environment is the TARGET fleet's dir and no $TMUX, so it cannot pick the
# caller's fleet for a name that is asleep in more than one.
if [ "$ASLEEP" = 1 ]; then
  echo "fleet-send: '$SESSION' is asleep — waking it first" >&2
  if _wout="$(env -u TMUX CLAUDE_FLEET_DIR="$FLEET_DIR" "$(dirname "$0")/fleet-hibernate" -s "$SOCK" --wake "$SESSION" 2>&1)"; then
    printf '%s\n' "$_wout" | sed 's/^fleet-hibernate: /fleet-send: note — /' >&2
  else
    _why="$(printf '%s' "$_wout" | tr '\n' ' ' | sed 's/fleet-hibernate: //g; s/  */ /g; s/ $//')"
    _kept=""
    if [ -n "${CLAUDE_FLEET_SEND_REPORT:-}" ] && [ -n "$MSG" ]; then
      _kept="$(date +%s)-$$-$RANDOM.unwoken"
      printf '%s\x1f\x1f\x1f\x1f%s\x1f%s\n' "$(date +%s)" "$(_b64 "$MSG")" "$KIND" > "$QUEUE.$_kept" 2>/dev/null || _kept=""
    fi
    if [ -n "$_kept" ]; then
      echo "fleet-send: not delivered — '$SESSION' is asleep and did not wake: ${_why:-no reason given}. Nothing was typed; the prompt is kept as $_kept (fleet-send -s $SOCK --requeue $SESSION $_kept)" >&2
      _ib="$FLEET_DIR/$SOCK.inbox"; _p="$(head -1 "$FLEET_DIR/$SOCK.$SESSION.parent" 2>/dev/null)"
      case "$_p" in ''|master|*[!A-Za-z0-9._~-]*) _p="" ;; esac
      [ -n "$_p" ] && tmux -L "$SOCK" has-session -t "=$_p" 2>/dev/null && _ib="$FLEET_DIR/$SOCK.$_p.inbox"
      printf '%s\t%s\tfailed\t%s\n' "$(date +%s)" "$SESSION" \
        "$(printf '%s' "$CLAUDE_FLEET_SEND_REPORT not delivered — asleep and did not wake; kept as $_kept" | tr '\t\r\n' '   ' | cut -c1-300)" >> "$_ib" 2>/dev/null || true
    else
      echo "fleet-send: not delivered — '$SESSION' is asleep and did not wake: ${_why:-no reason given}. Nothing was typed; send it again once it is awake (fleet-hibernate -s $SOCK --wake $SESSION)" >&2
    fi
    exit 1
  fi
fi

# WHICH AGENT runs the target, resolved BEFORE the reply preamble is built and reused by
# the busy detector further down. It decides what the target can be TOLD to do: SendMessage
# is a Claude Code tool, and telling codex/opencode to call it would replace a hint they
# can act on with one they can't. Unknown (no fleet-agent installed) counts as claude —
# the same default the rest of this script has always taken.
_a=""
if command -v fleet-agent >/dev/null 2>&1; then
  _a="$(fleet-agent of "$SESSION" -s "$SOCK" 2>/dev/null)"
fi

# Is the target mid-turn right now? Read the LIVE pane (the agent's working spinner),
# not the status file — the file can be stale, and a wrong guess here is harmless
# but a wrong "queued" note is confusing.
#
# The pattern comes from the target's AGENT: claude says "esc to interrupt", opencode
# says "esc interrupt", and one regex cannot serve both. Resolved once here rather
# than per call, because submitted() polls this in a loop. Falls back to claude's
# literal pattern — byte-identical to what this script used before the adapter — so a
# missing/renamed fleet-agent degrades to today's behaviour instead of breaking send.
BUSY_RE='(…|\.\.\.) ?\([0-9]+[ms]|↓ ?[0-9.,]+ ?[km]? ?tokens|esc to interrupt'
if [ -n "$_a" ] && [ "$_a" != claude ]; then
  BUSY_RE="$(fleet-agent field "$_a" busy_re 2>/dev/null)"
fi
# An EMPTY pattern means the agent has no validated detector. It must never reach
# grep: `grep -qE ""` matches every line, which would report the session as
# permanently busy and make fleet-send queue every prompt behind a phantom turn.
busy() {
  # A target whose mod is live says what it is doing exactly; the pane is the fallback.
  if [ -n "$MOD_SID" ] && _mod_look; then
    case "$MOD_STATE" in working|need-you) return 0 ;; *) return 1 ;; esac
  fi
  [ -n "$BUSY_RE" ] || return 1
  # A here-string, not a pipe: under pipefail a `grep -q` that MATCHES can hand its
  # writer a SIGPIPE and read as a miss (CLAUDE.md) — and the queue below now decides
  # where a prompt goes on this answer.
  grep -qE "$BUSY_RE" <<< "$(tmux -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null)"
}

# --- the mod (mods/ghostfleet) -------------------------------------------------
# A Claude session running the ghostfleet mod takes its prompts from inside: the mod
# submits each one as a turn of its own once the session is idle, never touching the
# composer, and names the turn it started (register.js, DELIVERY). So for such a target
# this script hands the prompt over instead of pasting it, and reads "is it busy" from
# the mod's record instead of the pane. Everything else here (the queue, the reply
# preamble, the logs, the exit codes) is the same either way.
#   "Such a target" is decided by lib/mod-target.mjs: a believable mod record for this
# socket and slot AND a mod that delivers (its .ready names the same process). Not a
# Claude session, an older Claude, a mod that is off or dead, no node: the paste, as
# before. CLAUDE_FLEET_MOD_DELIVER=off forces the paste for one call.
#   The spool lives in the TARGET's fleet dir, which on another profile is not ours.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _lnk="$(readlink "$_src")"; case "$_lnk" in /*) _src="$_lnk" ;; *) _src="$(dirname "$_src")/$_lnk" ;; esac
done
MOD_TARGET="$(cd "$(dirname "$_src")" 2>/dev/null && pwd)/../lib/mod-target.mjs"

# A SPENT ACCOUNT TAKES NO PROMPT. A session at its usage limit leaves its input box up, so a
# paste lands, is rejected by the agent, and the sender hears nothing: the lead went on sending
# work to codex workers that could not take it. Two signals read off the pane (the agent's
# sentence AND its own figure, lib/pane-limit.mjs), so a pane that merely quotes the sentence
# still takes the send. --anyway is the way past it for a prompt meant to wait for the reset.
# CODEX ONLY, on purpose: a send to a limited Claude session is what wakes it after fleet-accounts
# moves it onto another login, so refusing there would fight the failover.
if [ "$MODE" = send ] && [ "$ANYWAY" != 1 ] && [ -z "$REPLY_TO" ] && [ "${_a:-claude}" = codex ]; then
  _pl="$(cd "$(dirname "$_src")" 2>/dev/null && pwd)/../lib/pane-limit.mjs"
  if [ -f "$_pl" ] && command -v node >/dev/null 2>&1; then
    _pla="$_a"
    if _plat="$(node "$_pl" "$_pla" <<< "$(tmux -u -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null)" 2>/dev/null)"; then
      echo "fleet-send: '$SESSION' is at its usage limit (resets $_plat) and would reject this prompt — nothing was sent. Give the work to another session, or add --anyway to paste it for when the limit lifts" >&2
      exit 1
    fi
  fi
fi

MOD_SID=""; MOD_STATE=""; MOD_NOW=""; MOD_DIR=""
# THE SERVER THIS SEND ADDRESSES, so a record of the same name on another one is not taken
# for it (lib/mod-target.mjs). Empty when tmux cannot say, which refuses every record that
# names a server: the paste, on the server that was named.
MOD_SRV="$(tmux -u -L "$SOCK" display-message -p -t "$SESSION" '#{pid}' 2>/dev/null)"
_mod_look() {
  local out
  out="$(node "$MOD_TARGET" "$MOD_DIR" "$SOCK" "$SESSION" "$MOD_SRV" 2>/dev/null)" || { MOD_SID=""; return 1; }
  IFS=$'\t' read -r MOD_SID MOD_STATE MOD_NOW <<< "$out"
  [ -n "$MOD_SID" ]
}
if { [ -z "$_a" ] || [ "$_a" = claude ]; } \
   && [ "${CLAUDE_FLEET_MOD_DELIVER:-on}" != off ] && [ -f "$MOD_TARGET" ] && command -v node >/dev/null 2>&1; then
  MOD_DIR="$(tmux -u -L "$SOCK" show-environment -t "$SESSION" CLAUDE_FLEET_DIR 2>/dev/null)"
  MOD_DIR="${MOD_DIR#CLAUDE_FLEET_DIR=}"; case "$MOD_DIR" in /*) ;; *) MOD_DIR="" ;; esac
  if [ -z "$MOD_DIR" ]; then
    _c="$(tmux -u -L "$SOCK" show-environment -t "$SESSION" CLAUDE_CONFIG_DIR 2>/dev/null)"
    _c="${_c#CLAUDE_CONFIG_DIR=}"; case "$_c" in /*) MOD_DIR="$_c/fleet" ;; esac
  fi
  [ -n "$MOD_DIR" ] || MOD_DIR="$FLEET_DIR"
  MOD_SID=pending; _mod_look || true
fi
# Prompts handed to the mod and not yet started are a backlog like the queue's: a send
# arriving behind one must wait behind it, not be handed over beside it. Waiting (.json),
# claimed (.taken) and submitted with no turn seen yet (.sent) alike.
_mod_backlog() {
  [ -n "$MOD_SID" ] || return 1
  local f
  for f in "$MOD_DIR/$MOD_SID.handoff/"*.json "$MOD_DIR/$MOD_SID.handoff/"*.taken "$MOD_DIR/$MOD_SID.handoff/"*.sent; do
    [ -e "$f" ] && return 0
  done
  return 1
}

QUEUEABLE=0; { [ -z "$_a" ] || [ "$_a" = claude ]; } && QUEUEABLE=1
SELF="${BASH_SOURCE[0]}"

# ── A BUSY CODEX QUEUES IN CODEX ──────────────────────────────────────────────────
# A send to a working codex was pasted into its input box, and Enter there hands the words to
# the turn that is running: the same fold the Claude queue above exists to prevent. codex-cli
# 0.166.0 has the fix built in. `codex queue --thread <id> --message <text>` writes the prompt
# to $CODEX_HOME/queue_1.sqlite, and the TUI that has the thread open runs it as a turn of
# its own after the current one, without anything here having to wait for it. Measured
# 2026-11-10 in a scratch fleet: queued to an idle pane it started a turn at once; queued to a
# busy one it ran next, as its own turn.
#   The thread id and the CODEX_HOME both come from the pane's own conversation
# (lib/codex-rollout.mjs thread), never from this caller's environment: a queue written to
# another home is a file nobody reads, and the send would report "queued" for a prompt that
# never runs. Anything that cannot be resolved keeps the paste, and says so.
#   No reply marker is written for it. codex has no hook that would arm one, and a marker
# left waiting would be armed by whatever turn starts next, which is the rule the Claude queue
# keeps by carrying the address in its record.
_cx_thread() {
  local pp
  command -v codex >/dev/null 2>&1 || return 1
  pp="$(tmux -u -L "$SOCK" display-message -p -t "$SESSION" '#{pane_pid}' 2>/dev/null)"
  node "${FLEET_ENV%/*}/codex-rollout.mjs" thread --pid "${pp:-0}" --sock "$SOCK" --slot "$SESSION" --fleet-dir "$FLEET_DIR" 2>/dev/null
}
# Where the prompt stands in that queue, for the same "queued #N" every reader keys on
# (fleet-serve, fleet-telegram, the wake hook). sqlite3 is not on every host, and the number
# is only shown to people; reaching no answer reads as 1, never as a missing line.
_cx_queued() {
  local n=""
  case "$2" in ''|*[!0-9A-Za-z-]*) ;; *)
    command -v sqlite3 >/dev/null 2>&1 && [ -f "$1/queue_1.sqlite" ] \
      && n="$(sqlite3 -readonly -cmd '.timeout 1000' "$1/queue_1.sqlite" "SELECT count(*) FROM queued_items WHERE thread_id = '$2';" 2>/dev/null)" ;;
  esac
  case "$n" in ''|0|*[!0-9]*) n=1 ;; esac
  printf '%s' "$n"
}

# --- what a send would meet -------------------------------------------------------
# --would-queue <session>: one word, and nothing sent. `working` (a turn is running),
# `need-you` (it is stopped on a question or a permission prompt), `backlog` (idle, but
# prompts are waiting ahead of anything new) or `idle`. bin/fleet-telegram asks before it
# delivers, to decide whether a message joins the turn that is running or waits behind it,
# and to tell the owner which. The answer is the same three tests the queue gate below
# applies, so the two cannot disagree; a session that is not Claude has no queue and says idle.
if [ "$MODE" = probe ]; then
  if { [ "$QUEUEABLE" = 1 ] || [ "$_a" = codex ]; } && busy; then
    if [ "$MOD_STATE" = need-you ]; then echo need-you; else echo working; fi
  elif [ "$QUEUEABLE" = 1 ] && { [ -s "$QUEUE" ] || _mod_backlog; }; then echo backlog
  else echo idle
  fi
  exit 0
fi

# --dequeue: deliver the NEXT queued prompt, if the session can take it. Exit 3 means
# "still busy, try again" — the Stop hook runs while the turn is technically still
# finishing, so its first look often lands on the spinner.
if [ "$MODE" = dequeue ]; then
  _qlock || { echo "fleet-send: queue for '$SESSION' is locked" >&2; exit 1; }
  _qrecover || exit 3
  [ -s "$QUEUE" ] || { rm -f "$QUEUE"; exit 0; }
  busy && exit 3
  IFS= read -r _line < "$QUEUE"
  IFS=$'\x1f' read -r _q_at _q_rs _q_rss _q_rd _q_msg _q_kind _q_extra <<< "$_line"
  _body="$(_unb64 "${_q_msg:-}")"
  if [ -z "$_body" ] || [ -n "${_q_extra:-}" ]; then
    _qdrop_head; echo "fleet-send: dropped an unreadable queue record for '$SESSION'" >&2; exit 1
  fi
  _args=(--queued --anyway -s "$SOCK")
  [ "${_q_kind:-}" = nudge ] && _args+=(--nudge)
  [ "${_q_kind:-}" = owner ] && _args+=(--owner)
  [ "${_q_kind:-}" = explain ] && _args+=(--explain)
  [ -n "$_q_rs" ] && [ -n "$_q_rss" ] && _args+=(--reply-to "$_q_rs/$_q_rss" ${_q_rd:+--reply-dir "$_q_rd"})
  # Delivered UNDER the lock: a second drainer must not see the box empty in the gap
  # between this paste and the spinner, and fold the next prompt into this one. The head
  # stays in the queue meanwhile; the journal says it is out for delivery.
  printf '%s\n' "$_line" > "$QJ"
  CLAUDE_FLEET_QUEUE_JOURNAL="$QJ" "$SELF" "${_args[@]}" "$SESSION" "$_body"
  _rc=$?
  case "$_rc" in
    0) _qdrop_head ;;
    # 3 is a turn that started in the gap (the mod did not take the prompt because the
    # session went busy): it is still the head, and nothing needs writing back.
    3) ;;
    # Answered "not delivered" once it had reached the session: aside, not lost. Refused
    # before it got that far (the session is gone): still the head, for whoever drains next.
    *) grep -qx began "$QJ" 2>/dev/null && _qstrand refused ;;
  esac
  rm -f "$QJ"
  exit "$_rc"
fi

# --- the reply address ---------------------------------------------------------
# WHY A MARKER RATHER THAN JUST TELLING THE TARGET TO ANSWER: you CAN put a return
# address in the prompt — "reply with fleet-send -s cf-x master …" — and it works, but
# only while the target remembers to, and it pastes into the asker's input box whether
# or not a human is mid-sentence in it. The marker moves the reply into the machinery
# that already solved both problems: the Stop hook relays it (so simply ENDING the turn
# answers), and it reuses that hook's empty-input guard and debounce.
#
# The marker belongs to the TARGET (its hook reads its own $FLEET_DIR on Stop), so the
# asker's fleet dir has to travel INSIDE it: under a different profile the asker's inbox
# is a different directory entirely, and the target's hook has no way to know which.
RSOCK=""; RSESS=""
if [ -n "$REPLY_TO" ]; then
  case "$REPLY_TO" in
    me)  RSOCK="$SELF_SOCK"; RSESS="$SELF_SESS"
         [ -n "$RSOCK" ] && [ -n "$RSESS" ] || {
           echo "fleet-send: --reply-to me needs a live fleet session (\$TMUX names none) — pass --reply-to <socket>/<session>" >&2; exit 1; } ;;
    */*) RSOCK="${REPLY_TO%%/*}"; RSESS="${REPLY_TO#*/}" ;;
    *)   RSOCK="$SELF_SOCK"; RSESS="$REPLY_TO"
         [ -n "$RSOCK" ] || {
           echo "fleet-send: --reply-to '$REPLY_TO' has no socket and \$TMUX names none — pass --reply-to <socket>/<session>" >&2; exit 1; } ;;
  esac
  # Both fields come back out of a file and get interpolated into a tmux command line,
  # so refuse anything that could close a quote HERE instead of quoting around it later
  # (same rule, and the same charset, as fleet-stack's valid_line). This also catches a
  # three-part "a/b/c", whose leftover lands inside RSESS as "b/c".
  case "$RSOCK$RSESS" in *[!A-Za-z0-9._~-]*)
    echo "fleet-send: bad --reply-to '$REPLY_TO' (expected me, <session>, or <socket>/<session>)" >&2; exit 1 ;;
  esac
  # A session pointed at ITSELF would relay its own Stop into its own input, and that
  # reply is a prompt — one that Stops, and relays again. Refuse the cycle.
  if [ "$RSOCK" = "$SOCK" ] && [ "$RSESS" = "$SESSION" ]; then
    echo "fleet-send: --reply-to names the target itself ($RSOCK/$RSESS) — its answer would loop back into its own input" >&2; exit 1
  fi

  rdir="$REPLY_DIR"
  if [ -z "$rdir" ]; then                       # ask the asker's own session env
    rdir="$(tmux -u -L "$RSOCK" show-environment -t "$RSESS" CLAUDE_FLEET_DIR 2>/dev/null)"
    rdir="${rdir#CLAUDE_FLEET_DIR=}"; case "$rdir" in /*) ;; *) rdir="" ;; esac
  fi
  if [ -z "$rdir" ]; then                       # ...then its profile, the usual case
    _c="$(tmux -u -L "$RSOCK" show-environment -t "$RSESS" CLAUDE_CONFIG_DIR 2>/dev/null)"
    _c="${_c#CLAUDE_CONFIG_DIR=}"; case "$_c" in /*) rdir="$_c/fleet" ;; esac
  fi
  if [ -z "$rdir" ] && command -v node >/dev/null 2>&1 && [ -f "$FLEET_ENV" ] \
     && _env="$(node "$FLEET_ENV" of "$RSOCK" 2>/dev/null)" && [ -n "$_env" ]; then
    IFS=$'\x1f' read -r _ rdir _ <<< "$_env"   # ...then the asker fleet's own project
  fi
  [ -n "$rdir" ] || rdir="$CALLER_FLEET_DIR"    # ...then same-profile, which it usually is
fi

# Appends this prompt (the caller's words, before any preamble: the delivery adds that)
# to the queue, under the lock the caller holds; sets _n to its place.
_enqueue() {
  # A sixth field only for a nudge, the owner's words or an explain request, so every other
  # record is the five fields it always was.
  _rec="$(printf '%s\x1f%s\x1f%s\x1f%s' "${RSOCK:-}" "${RSESS:-}" "${rdir:-}" "$(_b64 "$RAW_MSG")")${KIND:+$'\x1f'$KIND}"
  # The same prompt already waiting is not a second task: the automated nudges (a
  # worker finished, an answer relayed) repeat word for word and would stack one turn
  # each behind a long lead turn.
  if grep -qxF -- "$_rec" <<< "$(cut -d$'\x1f' -f2- "$QUEUE" 2>/dev/null)"; then
    echo "fleet-send: → $SESSION (already queued; not added twice)"; exit 0
  fi
  printf '%s\x1f%s\n' "$(date +%s)" "$_rec" >> "$QUEUE"
  _n="$(wc -l < "$QUEUE" | tr -d ' ')"
}
# ── A BRIEF AND ITS WHY ────────────────────────────────────────────────────────────
# Past every refusal and before the queue, so a send that is queued records its why as surely
# as one delivered now (the drain that delivers it later is handed the words, not the flag).
# The why goes to the memory against the worker's branch, as the newest statement of what its
# work is for (lib/know.mjs, `purpose`); the writer never fails, and nor can this.
# Not a brief, so nothing to warn about: the fleet's own sends (fleet-resume's `[fleet] resume:`,
# fleet-model's `/model`, a `<…>` frame), the same prefixes the memory's recall reads as the
# fleet speaking (lib/know-recall.mjs), and a brief that already carries its why on a line of
# its own, as fleet-spawn's dispatched prompt does.
_why_exempt() {
  case "$1" in '[fleet]'*|'<'*|'/'*) return 0 ;; esac
  grep -q '^Why: ' <<< "$1"
}
if [ "$MODE" = send ] || [ "$MODE" = now ]; then
  if [ -n "$WHY" ]; then
    _wcwd="$(tmux -u -L "$SOCK" display-message -p -t "$SESSION" '#{pane_current_path}' 2>/dev/null)"
    [ -n "$_wcwd" ] && "$(dirname "$0")/fleet-know-event" purpose "fleet=$FLEET_DIR" "sock=$SOCK" "cwd=$_wcwd" \
      "worker=$SESSION" "branch=$(git -C "$_wcwd" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')" "why=$WHY" \
      </dev/null >/dev/null 2>&1
  elif [ -z "$KIND" ] && [ -z "${RSESS:-}" ] && [ "$SESSION" != master ] \
       && ! _why_exempt "$MSG"; then
    # On stdout, the stream the MCP tool returns, as fleet-spawn's brief-check is.
    echo "fleet-send: no --why — '$SESSION' is told what to do but not what it is for. Add one line (--why \"<reason>\", or why on fleet_send): it rides under the brief and beside the task in your briefing."
  fi
fi
RAW_MSG="$MSG"

# ── INTO THE RUNNING TURN, OR HELD: WHICH, AND WHY ────────────────────────────
# A send to a working session goes into the turn that is running (see "the queue" above),
# unless one of the reasons below holds it. _hold_why prints the reason, as the clause that
# completes "queued #N — it is mid-turn; …", and prints nothing when the send may go in.
# Every reason is said to the sender, because a hold nobody mentions reads as a send that
# went in and was ignored.
#
# THE BOX IS READ THE WAY THE WAKE GUARD READS IT (hooks/fleet-event.sh _input_state): the
# composer is between the last two rules, a rule may carry a label, the prompt glyph's padding
# is a no-break space, and a dim run is a suggestion, not typing (lib/undim.awk). A paste
# into a box someone is typing in would submit their half-written words with this message,
# and a box that cannot be found may be a permission dialog that a paste would answer.
UNDIM="$(cd "$(dirname "$_src")" 2>/dev/null && pwd)/../lib/undim.awk"
_box_state() {                         # 0 empty / 1 typed / 2 no box found
  { if [ -r "$UNDIM" ]; then
      tmux -L "$SOCK" capture-pane -e -p -t "$SESSION" 2>/dev/null | LC_ALL=C awk -f "$UNDIM"
    else
      tmux -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null
    fi; } | LC_ALL=C awk '
    function isrule(s) { return s ~ /^[ \t]*(─|│|╭|╮|╰|╯)/ && s ~ /────────/ }
    { l[NR]=$0; if (isrule($0)) b[++n]=NR }
    END { if (n < 2) exit 2
          found = 0; rest = ""
          for (i = b[n-1] + 1; i < b[n]; i++) {
            line = l[i]
            if (!found) { p = index(line, "❯")
                          if (p) { found = 1; line = substr(line, p + length("❯")) } }
            rest = rest line
          }
          if (!found) exit 2
          gsub(/─|│|╭|╮|╰|╯|\||[ \t]|\302\240|\342\200[\200-\213\257]|\343\200\200/, "", rest)
          exit (rest == "" ? 0 : 1) }' 2>/dev/null
}
_hold_why() {
  local cur="" rs=""
  [ "$AFTER" = 1 ] && { echo "held, as asked, to run as its own turn after that one ends"; return; }
  [ "$MOD_STATE" = need-you ] && { echo "need-you"; return; }
  case "$KIND" in nudge|explain)
    echo "the fleet's own $KIND runs as its own turn after that one ends"; return ;;
  esac
  # TELEGRAM JOINS ONLY A TELEGRAM TURN. A [telegram] prompt marks the turn it lands in, and
  # hooks/fleet-telegram-guard.sh then holds that turn to the channel's allowlist: folded into
  # a turn somebody started at the desk, it would take the shell away from that task for the
  # rest of the turn, and the owner would see half-done desk work. bin/fleet-telegram tells
  # the owner what it waits behind; this is the same rule, kept here as well so no caller
  # can get it wrong.
  if [ "${RSOCK:-}" = telegram ] || case "$RAW_MSG" in "[telegram] "*) true ;; *) false ;; esac; then
    [ -f "$FLEET_DIR/$SOCK.$SESSION.telegram" ] \
      || { echo "that turn did not come from Telegram, so this runs as its own turn after it ends"; return; }
  fi
  # ONE STOP RELAYS ONE ANSWER. An armed address is an answer the running turn already owes
  # somebody; a question joined to it would take the address over, and the first asker would
  # get nothing. A Telegram message into a Telegram turn is the exception, because that pair
  # has the fold (`.reply-to.fold`, below), which keeps both.
  if [ -n "${RSESS:-}" ] && [ -f "$FLEET_DIR/$SOCK.$SESSION.reply-to.armed" ] \
     && IFS=$'\x1f' read -r rs cur _ < "$FLEET_DIR/$SOCK.$SESSION.reply-to" 2>/dev/null \
     && ! { [ "$RSOCK" = telegram ] && [ "$rs" = telegram ]; }; then
    echo "that turn already owes ${rs:-someone}/${cur:-?} an answer, so this question runs as its own turn after it ends"
    return
  fi
  # codex draws no rules around its box, so there is nothing to read it by: it takes the
  # paste as --now always has (see CODEX_Q below).
  [ "$_a" = codex ] && return
  _box_state
  case $? in
    0) ;;
    1) echo "someone is typing in its box, and a paste would send their words with this, so it runs as its own turn after that one ends" ;;
    *) echo "its input box could not be read, so this runs as its own turn after that one ends rather than being typed in blind" ;;
  esac
}
_say_queued() {                        # $1 = the reason from _hold_why
  # NEED-YOU IS NOT MID-TURN. A session stopped on a permission dialog or a question picker
  # reads as busy too, and the prompt waits for the same Stop — which will not come until
  # someone answers the prompt in its pane. Said in words a phone can show, because "queued …
  # mid-turn" read as "sent" and the owner waited on a session that was waiting on him.
  # fleet-serve keys on "behind a question", and every reader on "queued #N".
  if [ "$1" = need-you ]; then
    echo "fleet-send: → $SESSION (queued #$_n behind a question — it is waiting on an answer in its pane, and this runs as its own turn only once that is answered and the turn ends)"
  else
    echo "fleet-send: → $SESSION (queued #$_n — it is mid-turn; $1)"
  fi
  [ -n "${RSESS:-}" ] && echo "fleet-send: the answer to it comes back to $RSOCK/$RSESS when that queued turn ends"
  return 0
}

# The gate. Decided UNDER the lock, so a drain delivering the head right now either
# finishes first (and this sees its turn running) or has not started (and this sees the
# queue non-empty).
#   A send that may go in goes in even with prompts queued: those were held for after the
# turn, and this one is for the turn.
JOIN=0
if [ "$MODE" = send ] && [ "$QUEUEABLE" = 1 ]; then
  _qlock || { echo "fleet-send: queue for '$SESSION' is locked — not sent (retry, or --now)" >&2; exit 1; }
  if busy || [ -s "$QUEUE" ] || _mod_backlog; then
    _why=""
    if busy; then _why="$(_hold_why)"; [ -n "$_why" ] || JOIN=1; fi
    if [ "$JOIN" = 0 ]; then
      _enqueue
      if busy || _mod_backlog; then
        _say_queued "${_why:-it was busy when this arrived, so this runs as its own turn after that one ends}"
        exit 0
      fi
      # Idle with a backlog (a drain that gave up, a human who was typing): deliver the
      # head now — which is not necessarily this prompt, and that is the point.
      _qunlock
      exec "$SELF" --dequeue -s "$SOCK" "$SESSION"
    fi
  fi
  _qunlock
fi
# A BUSY CODEX TAKES THE MESSAGE INTO ITS TURN. codex-cli steers a running turn with what is
# submitted during it: the `steer` feature graduated and is always on in 0.170.0, and Enter
# in a busy pane hands the words to the turn in progress (measured on 0.166.0 by the codex
# queue's own first change). So the default is the same paste, labelled in the prompt itself:
# codex runs fleet-event.sh's UserPromptSubmit, but the label there measures the turn by
# Claude's note about itself, which codex does not write. --after-turn, a nudge, an explain
# request, and anything _hold_why holds, go to codex's own queue, a turn of their own.
CODEX_Q=""
if [ "$MODE" = send ] && [ "$_a" = codex ] && busy; then
  _why="$(_hold_why)"
  if [ -z "$_why" ]; then
    JOIN=1
  else
    CODEX_Q="$(_cx_thread)" \
      || { CODEX_Q=""; echo "fleet-send: note — could not tell which codex thread '$SESSION' is in, so it cannot be queued there" >&2; }
  fi
fi
if [ "$JOIN" = 1 ] && [ "$_a" = codex ]; then
  _lbl="[fleet] This message arrived while you were still working on your current task. It is QUEUED WORK, not a replacement: add it to your task list, finish the task in hand, then do this one — unless this message itself says to stop or switch (stop, instead, drop that, first do). Your closing report lists every task you received this turn with its state."
  # [telegram] stays first: it is what marks the turn as the owner's (hooks/fleet-event.sh).
  case "$MSG" in
    "[telegram] "*) MSG="[telegram] $_lbl

${MSG#\[telegram\] }" ;;
    *) MSG="$_lbl

$MSG" ;;
  esac
fi

# Through the mod or by paste: decided here, before the reply marker below is written.
# Past the gate a Claude target is idle, or busy with this send joining its turn. The mod
# submits only into an idle session, so a send for the running turn is a paste.
USE_MOD=0
[ -n "$MOD_SID" ] && [ "$MODE" != now ] && [ "$JOIN" = 0 ] && USE_MOD=1

if [ -n "$RSESS" ]; then

  # CAN THE DIRECT REPLY EVEN ARRIVE? Claude Code's peer registry lives under the CONFIG
  # dir (<config>/sessions), so two profiles are two registries and neither can see the
  # other: SendMessage to a peer on another profile fails with "No agent named … is
  # reachable", every time, by design. The asker's fleet dir is the profile, and it is
  # already computed above — so the one comparison that answers this costs nothing.
  #   IT MATTERS BECAUSE THE CALLER PLANS AROUND IT. Reported by an agent that asked
  # across profiles, was told its answer would arrive directly, said so to its human, and
  # then sat idle for an hour while the answer waited in an inbox it had been told it did
  # not need to drain. The ANSWERED row was correct the whole time; only the sentence
  # promising the other path was wrong. A promise that cannot be checked is worse than no
  # promise, which is the same rule this file already applies to the busy detector.
  #   THE SIGNAL IS THE CONFIG DIR, NOT THE FLEET DIR, and the difference is not academic.
  # A fleet dir can differ for reasons that have nothing to do with profiles — a caller that
  # passes --reply-dir explicitly, a test fixture that isolates two fleets in two temp
  # directories — and treating those as "another profile" warns about a direct reply that
  # would have worked perfectly. The peer registry is keyed on <CLAUDE_CONFIG_DIR>/sessions,
  # so the config dir is the thing that actually decides whether the name can resolve.
  #   POSITIVE EVIDENCE ONLY. The warning fires when both config dirs are KNOWN and DIFFER,
  # never on a failure to read one. An unreadable env is "I could not tell", and the old
  # behaviour — ask for the direct reply, keep the relay as the fallback — is the right
  # answer to that: the ask costs one tool call if it turns out to be unreachable, while a
  # wrong warning would send a caller to poll an inbox when a message was already coming.
  XPROF=0
  _ourcfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  _askcfg="$(tmux -u -L "$RSOCK" show-environment -t "$RSESS" CLAUDE_CONFIG_DIR 2>/dev/null)"
  _askcfg="${_askcfg#CLAUDE_CONFIG_DIR=}"
  case "$_askcfg" in /*) [ "$_askcfg" = "$_ourcfg" ] || XPROF=1 ;; esac
  mkdir -p "$FLEET_DIR" 2>/dev/null
  # Three MANDATORY fields on one line. \x1f, not a tab: a tab is IFS-whitespace, so a
  # `read` over it collapses an empty field and shifts every later one left — and the
  # last field here is a PATH, which is exactly the field you least want to receive
  # something else's value. The hook re-validates all three anyway.
  #   NOT for a prompt the mod delivers: that address rides in the handoff and the mod
  # writes and arms it at the turn.start of THIS prompt's turn, so nothing here can be
  # armed by somebody else's. A handoff that falls back to the paste writes it then.
  #   A TELEGRAM MESSAGE FOLDED INTO A TELEGRAM TURN does not take the address over. The
  # running turn already owes the phone an answer, and the folded prompt may never surface
  # in it: a prompt typed mid-turn is read at the turn's next step, and one that is still
  # waiting when the turn ends runs as a turn of its own, with no UserPromptSubmit to arm
  # it. Overwriting the address answered the running turn to the NEW message (quoting the
  # wrong one, and leaving the first with no answer) and left the turn after it with no
  # address and no Telegram mark — unanswered, and outside the tool guard. So the new
  # address and its prompt are appended to `.reply-to.fold`, the running turn keeps its own,
  # and the Stop hook decides by the transcript which of them its answer is: the newest one
  # the turn took in, or the first if it took in none — with what is left handed on to the
  # turn that runs next. The prompt is base64, because it can hold any byte, \x1f included.
  _paste_reply_marker() {
    local rt="$FLEET_DIR/$SOCK.$SESSION.reply-to" cur=""
    if { [ "$MODE" = now ] || [ "$JOIN" = 1 ]; } && [ "$RSOCK" = telegram ] && [ -f "$rt.armed" ] \
       && IFS= read -r cur < "$rt" 2>/dev/null && [ "${cur%%$'\x1f'*}" = telegram ] && busy; then
      printf '%s\x1f%s\x1f%s\x1f%s\n' "$RSOCK" "$RSESS" "$rdir" "$(_b64 "$MSG")" >> "$rt.fold" 2>/dev/null
      return 0
    fi
    printf '%s\x1f%s\x1f%s\n' "$RSOCK" "$RSESS" "$rdir" \
      > "$rt" 2>/dev/null
    # Clear any arming left by an earlier request, or this brand-new address would look
    # armed to the turn that is running RIGHT NOW and answer it with that turn's work.
    rm -f "$FLEET_DIR/$SOCK.$SESSION.reply-to.armed" 2>/dev/null
  }
  [ "$USE_MOD" = 1 ] || [ -n "$CODEX_Q" ] || _paste_reply_marker

  # THE ASKER'S PEER NAME — what Claude Code's cross-session messaging can address, and
  # the reason bin/claude-here now passes --name: it is the SAME string the hook prints in
  # an inbox row, so `${RSOCK#cf-}/$RSESS` is one derivation used on both sides rather than
  # two that have to be kept in step.
  RPEER="${RSOCK#cf-}/$RSESS"

  # Tell the target what it's in, PREPENDED. Not appended: the paste-landed probe below
  # is the last 24 chars of the message, and a fixed boilerplate tail would be the same
  # 24 chars on every relayed send — the probe would match a PREVIOUS one still on the
  # pane. Keeping the caller's own words last keeps the probe unique per send.
  #
  # ASK FOR A SendMessage FIRST, and keep the turn-ending relay as the second half of the
  # same instruction. The relay is a nine-link chain and every link drops the answer in
  # silence: the turn has to END (a usage limit, an interrupt or a killed session means no
  # answer ever), the row has to be drained, and the wake that tells the asker to drain it
  # is skipped outright when the asker is BUSY — the exact moment a lead is most likely to
  # be waiting on one. A SendMessage has none of those: it is delivered to the asker's
  # session and shows up there mid-turn.
  #   Belt AND braces on purpose. The direct path needs the asker to be an addressable
  # peer, which a session started before this change (or renamed since) is not, and a turn
  # that dies takes the tool call with it — so the answer has to be in the last message too,
  # or the fallback relays "(no text)". The hook suppresses its row when it can PROVE the
  # SendMessage landed, so saying it twice does not answer twice.
  if [ "$RSOCK" = telegram ]; then
    # THE OWNER, NOT AN AGENT. `telegram/<message>` is the address bin/fleet-telegram gives
    # a message it delivers, so the answer rides this queue, the mod's handoff and the
    # Stop relay unchanged, and hooks/fleet-event.sh sends it back to Telegram. Nothing is
    # prepended: every preamble below tells the target it is talking to another AGENT and
    # starts with [fleet], which is the prefix Jarvis's ledger drops as machine traffic —
    # so the owner's yes, typed on his phone, would never be recorded as his.
    :
  elif { [ -z "$_a" ] || [ "$_a" = claude ]; } && [ "$XPROF" = 0 ]; then
    MSG="[fleet] This request comes from another agent ($RPEER), not a human, and it is
waiting on the answer. Answer it BOTH ways, in this order:
  1. call SendMessage with to: \"$RPEER\" and the full answer as the message — that
     reaches them directly, even while they are working (it may need ToolSearch
     \"select:SendMessage\" first; ListAgents shows whether that name is live);
  2. then end your turn with that same answer as your final message — if the name isn't
     reachable, ending the turn is what gets relayed back instead.
Self-contained either way: they don't share your context.

$MSG"
  elif [ -z "$_a" ] || [ "$_a" = claude ]; then
    # CROSS-PROFILE: do not send it looking for a door that is not there. Asking anyway
    # costs the target two tool calls and a retry before it works out that the name is
    # unreachable — measured, that is exactly what happened — and worse, it invites it to
    # report "I messaged them" when nothing was delivered.
    MSG="[fleet] This request comes from another agent ($RPEER) on a DIFFERENT profile, not
a human, and it is waiting on the answer. SendMessage cannot reach them from here — the two
profiles keep separate peer registries, so the name will not resolve; do not spend a call on
it. End your turn with the full answer as your final message: that is relayed back to them
and is the only path. Self-contained: they don't share your context.

$MSG"
  else
    # Not a Claude session: SendMessage doesn't exist there, and neither does the Stop hook
    # that relays (fleet-send warns the caller about that a few lines below). Today's
    # wording, so a codex/opencode target is told the one thing it can act on.
    MSG="[fleet] This request comes from another agent ($RSOCK/$RSESS), not a human. When
your turn ends, its last message is relayed back automatically — so finish with the
ANSWER, self-contained (it doesn't share your context). No need to fleet-send a reply.

$MSG"
  fi
fi
# NOTE what a plain send deliberately does NOT do: clear an existing address. "The newest
# send wins" reads tidy and is a trap — the address is keyed by the TARGET, so every
# automated plain send would cancel a question someone else had asked that session. The
# master nudge in hooks/fleet-event.sh is exactly that (a plain fleet-send at `master`),
# so any worker finishing would silently drop a pending question to its project's master.
# Staleness is bounded from the other end instead: the hook only relays an ARMED address,
# and an unconfirmed submit below takes its own marker back.

pre_busy=no; busy && pre_busy=yes
# A send joining the turn, --now, or a target with no queue at all gets here while a turn runs.
#   THE --now MARK NAMES ITS PROMPT. It tells the UserPromptSubmit hook that this one
# interruption was deliberate, so the hook does not label it queued work behind the task in
# hand (hooks/fleet-event.sh). It used to be an empty file, spent by whichever prompt came
# next: a --now whose prompt never arrived left it lying there, and the next send into that
# turn lost its label, the one thing that keeps the task in hand from being dropped. So it
# carries the prompt's checksum, every blank removed first (the agent may trim what it was
# pasted), and the hook skips only the prompt it names. cksum, because it is POSIX and on
# every host. A send that joins the turn writes no mark: its label is the point.
_now_sum() { printf '%s' "$1" | LC_ALL=C tr -d ' \t\r\n' | cksum | awk '{ print $1 "-" $2 }'; }
[ "$pre_busy" = yes ] && [ "$MODE" = now ] \
  && printf '%s\x1f%s\n' "$(date +%s)" "$(_now_sum "$MSG")" > "$FLEET_DIR/$SOCK.$SESSION.now" 2>/dev/null
if [ "$pre_busy" = yes ] && [ -z "$CODEX_Q" ]; then
  if [ "$MODE" = now ]; then
    echo "fleet-send: note — '$SESSION' is working; --now pastes this INTO the running turn as an interrupt, with no queued-work label." >&2
  elif [ "$JOIN" = 1 ]; then
    echo "fleet-send: note — '$SESSION' is working; this goes into the running turn, read at its next step as queued work after the task in hand (--after-turn holds it for a turn of its own)." >&2
  else
    echo "fleet-send: note — '$SESSION' is working; this is pasted INTO the running turn, not after it." >&2
  fi
fi

# The relay lives in the CLAUDE event hook (hooks/fleet-event.sh), so a target running a
# different agent will never answer. Say that HERE: the whole point of --reply-to is not
# waiting on an answer that isn't coming, and a silent no-reply is the bug it fixes.
if [ -n "$RSESS" ] && [ -n "${_a:-}" ] && [ "$_a" != claude ]; then
  echo "fleet-send: note — '$SESSION' runs $_a, and the reply relay is wired into the Claude hook only; its answer won't come back on its own (read it with fleet-read${SOCK:+ -s $SOCK} $SESSION)." >&2
fi

# Bracketed paste keeps a multi-line prompt as ONE message; then submit. The race
# (why a naive send sometimes silently fails): an Enter sent before the bracketed
# paste has finished rendering is swallowed as a newline instead of submitting. So
# wait for the paste to land, submit, then VERIFY the turn actually started (the
# pane flips to the spinner) and re-Enter if it didn't.
# WHAT WAS ACTUALLY SENT, recorded before it is sent.
#
# Seen twice, on two profiles, hours apart: a session's FIRST turn was the single word
# "the" and its real brief never arrived. From the receiving side that is indistinguishable
# from a worker that ignored its instructions — and from the sending side there was nothing
# at all, because nothing recorded what went into the buffer. Three separate theories were
# investigated and disproved (the grid leaking keystrokes; ghostfleet typing a prompt at
# creation; this paste being unquoted) and every one of them cost an hour, because the only
# evidence was the transcript of the thing that received it.
#
# So the dispatch leaves a trace: target, byte length, digest. NOT the message, and not an
# excerpt of it either — a copy of every brief on disk is a second place for client material
# to live, and this repo has spent a day removing the first.
#
# The first draft logged the opening and closing forty characters, and its own test caught
# that for anything under eighty bytes those two windows OVERLAP and reconstruct the whole
# brief verbatim: a 44-byte message came back complete, and short messages are exactly the
# ones a lead dashes off without thinking. There is no window size that fixes this, because
# the excerpt was never what answered the question. Length plus digest is: a 3-byte dispatch
# is the bug on sight, and re-hashing the brief you MEANT to send settles "is what arrived
# what was sent" exactly, which is the only thing that was ever unanswerable.
#
# The digest is written through whichever of the two usual tools this host has, and never
# left blank: an empty field would look like a logged dispatch while answering nothing.
_sent_digest() {                   # shasum on macOS, sha256sum on most Linux, else say so
  local h
  h="$(printf '%s' "$1" | shasum -a 256 2>/dev/null)" || h=""
  [ -n "$h" ] || h="$(printf '%s' "$1" | sha256sum 2>/dev/null)" || h=""
  h="${h%% *}"
  printf '%s' "${h:0:12}"
  [ -n "$h" ] || printf 'no-digest-tool'
}
#
# AND WHO SENT IT. A row that says what arrived but not from where answered "is this what
# was sent" and nothing else: two-byte prompts into another fleet's master, a hundred of
# them over two weeks, with every sender's transcript searched and none of them guilty —
# because the sender was no session at all, but a test run. The fifth field names the
# sending fleet session when there is one, the directory it ran in, and the process that
# ran it, which is what would have pointed at that run on the first row.
# The session comes from $TMUX where there is one (SELF_*, above); the environment's is
# marked `env:`, because the MCP server repoints CLAUDE_FLEET_SOCK at the TARGET's fleet.
_sent_by() {                       # "from=<sock>/<slot>|env:<sock>/<slot>|- cwd=<dir> by=<parent>"
  local by from="-"
  if [ -n "$SELF_SOCK" ]; then from="$SELF_SOCK/${SELF_SESS:-?}"
  elif [ -n "${CLAUDE_FLEET_SOCK:-}" ]; then from="env:$CLAUDE_FLEET_SOCK/${CLAUDE_FLEET_SLOT:-?}"
  fi
  by="$(ps -o args= -p "$PPID" 2>/dev/null | tr '\t\n\r' '   ')"
  printf 'from=%s cwd=%s by=%s' "$from" "$(pwd -P 2>/dev/null | tr '\t\n' '  ')" "${by:0:160}"
}
# Taken now, written at exit with its outcome (_sent_flush, above).
SENT_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
SENT_LEN="$(printf '%s' "$MSG" | wc -c | tr -d ' ')"
SENT_DIG="$(_sent_digest "$MSG")"
SENT_BY="$(_sent_by)"
trap '_sent_flush $?' EXIT
trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM

# INTO JARVIS'S MASTER, SAY SO FIRST. Jarvis's confirm-list counts a yes only from the owner,
# and the hook that records what was submitted cannot tell a paste from typing — so every
# prompt this command PASTES there leaves a line (time + digest, never the text) where the
# ledger checks (lib/jarvis.mjs consumeDelivery). Profile-independent on purpose: a worker
# on another profile sends from another fleet dir, and Jarvis's marker is the one place both
# can see. Called at the paste, because a queued prompt is delivered later by --dequeue.
#   A prompt the MOD delivers is recorded by the mod (register.js, DELIVERY), not here:
# this line lands in the SENDER's home, and a sender whose HOME is not Jarvis's — a test
# run that redirected it — wrote its line into a directory Jarvis never reads, so every
# such prompt counted as the owner's own word. The mod runs inside the session that
# receives, under the HOME its hook checks. Writing both would leave a second line that
# swallowed the owner's next real yes.
_jarvis_delivered() {
  local _jm="$HOME/.config/ghostfleet/jarvis" _jd
  if [ "$SESSION" = master ] && [ -f "$_jm" ] && ! grep -qsx off "$_jm.enabled" \
     && [ "$SOCK" = "$(grep -m1 '^sock=' "$_jm" 2>/dev/null | cut -d= -f2-)" ]; then
    _jd="$(printf '%s' "$MSG" | shasum -a 256 2>/dev/null || printf '%s' "$MSG" | sha256sum 2>/dev/null)"
    printf '%s\t%s\n' "$(date +%s)" "${_jd:0:12}" >> "$HOME/.config/ghostfleet/jarvis.delivered" 2>/dev/null || true
  fi
}
# A PASTED PROMPT IS THE FLEET'S, AND THE SESSION IS TOLD SO. Pasted, a send reaches the
# target's prompt box and is submitted as if typed: the mod's ledger read it as the PERSON's
# words, so a lead's brief that fell back to the paste became an owner's ask, listed under
# WAITING ON THE OWNER with the questions its answer put to that lead. The mod is told by a
# line written here, just before the paste: `<epoch ms>\t<kind>\t<reply>\t<length>` in
# <sock>.<session>.pasted (kind as on the handoff: '' for a brief, nudge, owner, explain;
# reply 1 when the answer goes back to an asker). Its prompt.submit takes the oldest line under
# a minute old whose length is the submit's, near enough, as the account of that submit
# (register.js pastedBy). By time and size, not by the words: the mod cannot hash to compare,
# and a paste whose Enter was swallowed must not claim the next thing the person types. A
# paste the mod never sees (no mod, or none loaded) leaves a line that ages out unread.
_paste_marker() {
  local _pm="$FLEET_DIR/$SOCK.$SESSION.pasted"
  printf '%s\t%s\t%s\t%s\n' "$(($(date +%s) * 1000))" "$KIND" "$([ -n "${RSESS:-}" ] && echo 1 || echo 0)" "${#MSG}" >> "$_pm" 2>/dev/null || true
}
# WHOSE WORDS THESE ARE, for the recall a lead's prompt starts (lib/know-recall.mjs whoSent). A
# lead is searched the fleet's memory for each message from the OWNER, and nothing on the
# receiving side can tell a paste or a mod's submit from typing. So every delivery leaves a mark
# first, in <sock>.<session>.from/: `<epoch ms>.<digest>.<kind>`, kind as on the handoff (brief
# for none) and `owner` only for --owner. The hook takes the mark whose digest is the prompt's,
# so a delivery queued for minutes still matches; a prompt that matches none was typed. The
# digest is of the words with whitespace folded and one space off each end, which is what the
# reader folds too: a paste whose line endings changed on the way in still matches. Once per
# send, whichever path delivers it — a mod handoff that falls back to the paste is ONE delivery.
#   Only for a session that can be a LEAD, because only a lead's prompt reads and prunes them (the
# hook's _recall_lead stops before a worker's): master, or a session some <sock>.<child>.parent
# names, the same test. A worker's marks would sit unread for as long as the fleet dir lives. The
# test is made at delivery, so a queued send to a worker that has since spawned a child is marked.
_FROM_MARKED=0
_from_lead() {
  [ "$SESSION" = master ] && return 0
  local _pt _l
  for _pt in "$FLEET_DIR/$SOCK".*.parent; do
    [ -f "$_pt" ] || continue
    _l=""; IFS= read -r _l < "$_pt" 2>/dev/null
    [ "$_l" = "$SESSION" ] && return 0
  done
  return 1
}
_from_mark() {
  [ "$_FROM_MARKED" = 0 ] || return 0
  _FROM_MARKED=1
  _from_lead || return 0
  local _fd="$FLEET_DIR/$SOCK.$SESSION.from" _n
  _n="$(printf '%s' "$MSG" | tr -s ' \t\r\n' ' ')"; _n="${_n# }"; _n="${_n% }"
  mkdir -p "$_fd" 2>/dev/null \
    && : > "$_fd/$(($(date +%s) * 1000 + RANDOM % 1000)).$(_sent_digest "$_n").${KIND:-brief}" 2>/dev/null || true
}
# A FAILED DELIVERY NOBODY WOULD SEE. Filed as a `failed` row in the inbox of the worker's
# lead, chosen as hooks/fleet-event.sh chooses it: a live parent named in <sock>.<slot>.parent,
# else master. Only for a sender that set CLAUDE_FLEET_SEND_REPORT, because one whose output
# is read (a lead's own Bash call) has already been told, and a second copy in the inbox
# would read as a second failure.
_report_failed() {
  local _p _ib="$FLEET_DIR/$SOCK.inbox"
  _p="$(head -1 "$FLEET_DIR/$SOCK.$SESSION.parent" 2>/dev/null)"
  case "$_p" in ''|master|*[!A-Za-z0-9._~-]*) _p="" ;; esac
  [ -n "$_p" ] && tmux -L "$SOCK" has-session -t "=$_p" 2>/dev/null && _ib="$FLEET_DIR/$SOCK.$_p.inbox"
  printf '%s\t%s\tfailed\t%s\n' "$(date +%s)" "$SESSION" "$(printf '%s' "$1" | tr '\t\r\n' '   ' | cut -c1-300)" >> "$_ib" 2>/dev/null || true
}
# THROUGH THE MOD. Handed over, then three outcomes, each told apart by a rename (the mod's
# DELIVERY section has the protocol):
#   claimed and its turn started: the receipt names the turn, and that is "→ <session>";
#   not claimed within the window, and the session has gone busy (a turn started in the
#     gap): taken back and queued, exactly as if it had been busy at the gate;
#   not claimed and still idle (a mod that is stuck, or died a moment ago): taken back and
#     pasted below, as if there were no mod at all.
# A prompt the mod claimed is never pasted: the rename that would take it back fails.
# The queue's drain marks the point after which this prompt may have reached the session
# (see "a prompt the drain stranded"): a drain that dies past here must not re-send it.
[ "$MODE" = queued ] && [ -n "${CLAUDE_FLEET_QUEUE_JOURNAL:-}" ] \
  && printf 'began\n' >> "$CLAUDE_FLEET_QUEUE_JOURNAL" 2>/dev/null
# Taken back from the mod while the session is busy: queued, as if it had been busy at the
# gate. The drain's own delivery is handed back to --dequeue instead, which keeps it the head.
# A plain send that may join the turn returns instead, and its caller pastes it into that turn.
_mod_requeue() {
  local why
  [ "$MODE" = queued ] && { SENT_OUT=queued; exit 3; }
  if [ "$MODE" = send ]; then
    why="$(_hold_why)"
    [ -n "$why" ] || { JOIN=1; return 0; }
  fi
  SENT_OUT=queued
  _qlock || { SENT_OUT=failed; echo "fleet-send: queue for '$SESSION' is locked — not sent (retry, or --now)" >&2; exit 1; }
  _enqueue; _qunlock
  _say_queued "${why:-it went busy before the mod took this, so this runs as its own turn after that one ends}"
  exit 0
}
if [ -n "$CODEX_Q" ]; then
  IFS=$'\x1f' read -r _cx_id _cx_home _cx_how <<< "$CODEX_Q"
  # `=` joins each value to its flag, so a prompt that starts with "-" is not read as one.
  _from_mark
  if _cx_out="$(CODEX_HOME="$_cx_home" codex queue --thread="$_cx_id" --message="$MSG" 2>&1)"; then
    SENT_OUT=queued
    _jarvis_delivered
    echo "fleet-send: → $SESSION (queued #$(_cx_queued "$_cx_home" "$_cx_id") — it is mid-turn; ${_why:-held}, in codex's own queue)"
    exit 0
  fi
  echo "fleet-send: note — codex would not queue it ($(printf '%s' "$_cx_out" | tr '\n' ' ' | cut -c1-160)); pasting INTO the running turn instead" >&2
  CODEX_Q=""
  [ -n "$RSESS" ] && _paste_reply_marker
fi

if [ "$USE_MOD" = 1 ]; then
  _spool="$MOD_DIR/$MOD_SID.handoff"
  _hid="${MOD_NOW:-$(date +%s)000}-$$"
  _rargs=(); [ -n "$RSESS" ] && _rargs=("$RSOCK" "$RSESS" "$rdir")
  _from_mark
  if printf '%s' "$MSG" | CLAUDE_FLEET_HANDOFF_KIND="$KIND" node "$MOD_TARGET" --handoff "$_spool" "$_hid" ${_rargs[@]+"${_rargs[@]}"}; then
    _claimed=no
    _w="${CLAUDE_FLEET_MOD_CLAIM:-3}"; case "$_w" in ''|*[!0-9]*) _w=3 ;; esac
    for _ in $(seq 1 $(( _w * 10 ))); do
      [ -e "$_spool/$_hid.json" ] || { _claimed=yes; break; }
      sleep 0.1
    done
    if [ "$_claimed" = no ] && ! mv "$_spool/$_hid.json" "$_spool/$_hid.revoked" 2>/dev/null; then
      _claimed=yes                                  # it went in the instant we gave up
    fi
    if [ "$_claimed" = no ]; then
      rm -f "$_spool/$_hid.revoked" 2>/dev/null
      if busy; then
        _mod_requeue
      fi
      echo "fleet-send: note — the mod in '$SESSION' did not take the prompt within ${_w}s; pasting it instead" >&2
      USE_MOD=0
    else
      _rcpt=""
      _s="${CLAUDE_FLEET_MOD_START:-20}"; case "$_s" in ''|*[!0-9]*) _s=20 ;; esac
      for _ in $(seq 1 $(( _s * 10 ))); do
        [ -s "$_spool/$_hid.done" ] && { _rcpt="$(cat "$_spool/$_hid.done" 2>/dev/null)"; break; }
        sleep 0.1
      done
      _turn="$(sed -n 's/.*"turnId":"\([^"]*\)".*/\1/p' <<< "$_rcpt")"
      _ran="$(sed -n 's/.*"ran":"\([^"]*\)".*/\1/p' <<< "$_rcpt")"
      _why="$(sed -nE 's/.*"(dropped|error)":"((\\.|[^"\\])*)".*/\2/p' <<< "$_rcpt" | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g')"
      if [ -n "$_turn" ]; then
        SENT_OUT=delivered
        echo "fleet-send: → $SESSION"
      elif [ -n "$_ran" ]; then
        # A slash command that ran without a turn of its own (a panel, a local command).
        SENT_OUT=ran
        echo "fleet-send: → $SESSION (ran $_ran; it started no turn)"
      elif [ -n "$_rcpt" ] && [[ "$_why" == *"a text beginning with / would run a command"* ]]; then
        # A MOD OLDER THAN THE FLEET THAT SENDS TO IT. Slash text is run by the mod as the
        # command it is only since the delivery learned `$.command.run`; a session that loaded
        # its mod before that, and never reloaded, still hands every prompt to
        # `$.prompt.submit`, which the host refuses for a leading "/" in exactly these words.
        # That refusal comes before anything ran, so the prompt is whole and unsent, and this
        # was reported as "the mod could not submit it" and given up on: a `/reload-plugins`
        # sent to bring such a session up to date was refused BY the staleness it was sent to
        # cure. The pane takes slash text as typed, so that is where it goes, with the fix said
        # once for whoever reads this.
        rm -f "$_spool/$_hid.done" 2>/dev/null
        echo "fleet-send: note — the mod in '$SESSION' is older than slash-command delivery and refused this as text; pasting it instead (/reload-plugins in that session, or fleet-mod reload --apply, brings it up to date)" >&2
        busy && _mod_requeue
        USE_MOD=0
      elif [ -n "$_rcpt" ]; then
        SENT_OUT=failed
        echo "fleet-send: → $SESSION (not delivered: the mod could not submit it — ${_why:-no reason given})" >&2
        # Read, so it is ours to report: a receipt left behind is one fleet-inbox reports as
        # read by nobody (lib/handoff-sweep.mjs). A sender whose output goes nowhere (the
        # queue's drain, fleet-spawn's deferred brief) says so, and the failure is filed
        # where the worker's lead will read it.
        rm -f "$_spool/$_hid.done" 2>/dev/null
        [ -n "${CLAUDE_FLEET_SEND_REPORT:-}" ] && _report_failed "$CLAUDE_FLEET_SEND_REPORT not delivered — ${_why:-no reason given}"
        exit 1
      elif [ "$KIND" = nudge ] && { mv "$_spool/$_hid.taken" "$_spool/$_hid.revoked" 2>/dev/null \
                                    || mv "$_spool/$_hid.sent" "$_spool/$_hid.revoked" 2>/dev/null; }; then
        # A WAKE THE MOD CLAIMED AND NEVER STARTED IS TAKEN BACK. For any other prompt the
        # wait below is right: the mod holds it and submits it once the session is idle, and
        # taking it back could deliver it twice. For the fleet's own wake that trade is the
        # other way round. A mod that claims and never submits used to hold every wake for as
        # long as it stayed that way, each one exiting 0 here with a warning nobody read —
        # the lead looked woken and was not. A second copy of a nudge costs a glance; a lost
        # one is a lead idle for hours. So it is taken back by the same rename a claim races
        # (one that started at this instant wrote its receipt first and is left alone), and
        # goes the way an unclaimed prompt goes: queued if a turn is running, else pasted.
        # Claimed (.taken) or already submitted (.sent): for a wake, either is taken back.
        rm -f "$_spool/$_hid.revoked" 2>/dev/null
        if [ -s "$_spool/$_hid.done" ]; then
          SENT_OUT=delivered; echo "fleet-send: → $SESSION"
        else
          echo "fleet-send: note — the mod in '$SESSION' claimed this wake and had not started it after ${_s}s; taking it back" >&2
          busy && _mod_requeue
          USE_MOD=0
        fi
      else
        # Claimed and not started yet. The mod still holds it and will submit it once the
        # session is idle; its reply address is armed by that turn, so nothing to take back.
        SENT_OUT=claimed
        echo "fleet-send: → $SESSION (warning: could not confirm submit — verify it landed)" >&2
      fi
    fi
  else
    echo "fleet-send: note — could not hand the prompt to the mod in '$SESSION'; pasting it instead" >&2
    USE_MOD=0
  fi
  # Fell back: the paste path below needs its reply marker, which was held for the mod.
  [ "$USE_MOD" = 0 ] && [ -n "$RSESS" ] && _paste_reply_marker
fi

if [ "$USE_MOD" = 0 ]; then
_jarvis_delivered
_paste_marker
_from_mark
tmux -L "$SOCK" set-buffer -b _fleet -- "$MSG"
tmux -L "$SOCK" paste-buffer -p -d -b _fleet -t "$SESSION"

# A pane shows a prompt in rows, and a prompt is not in rows. Where a row ends depends only on
# how long the text before it is, so the same last characters sit on one row or on two according
# to, say, how long a temp path in the prompt happens to be. Compared a row at a time, a tail on
# two rows is not there. Enter then waits out the fallback below, and in_input answers "box
# present, probe gone", so a swallowed Enter is never pressed again and the send reports success
# with the prompt still in the box. Measured with a last line in a 220-column pane: 221 to 243
# characters and no other length, the same on tmux 3.4 and 3.7b. A last line shorter than the
# probe crossed a row break the same way.
#   So both sides are compared with every blank and row break gone. capture-pane -J would not
# do it: it joins only what tmux wrapped, and a composer breaks and indents its own rows. The
# bar is for the older composer, which draws one at each end of a row.
squeeze() {
  LC_ALL=C tr -d ' \t\r\n' | LC_ALL=C sed 's/│//g'
}
# Not ${s: -24} alone. bash answers a negative offset past the start of a string with nothing at
# all, so a prompt shorter than the probe had no probe. An empty pattern matches every pane, so
# Enter stopped waiting for the paste and every box read as still holding it, and a turn too quick
# for the spinner to be caught got a second Enter, which is an empty turn. Short prompts are the
# common ones.
paste_probe() {
  local s; s="$(printf '%s' "$1" | squeeze)"
  [ "${#s}" -gt 24 ] && s="${s: -24}"
  printf '%s' "$s"
}

# wait for the paste to appear in the pane before pressing Enter (fall back ~2s)
probe="$(paste_probe "$MSG")"
for _ in $(seq 1 20); do
  grep -qF -- "$probe" <<< "$(tmux -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null | squeeze)" && break
  sleep 0.1
done

# Confirm the turn actually started. The RELIABLE signal is our pasted probe
# LEAVING Claude's input box: that catches a turn that finishes before any spinner
# renders (a fast reply) AND a turn that thinks a while before one appears (Opus
# extended thinking); a live spinner counts too. Watching only the spinner over a
# short window is what produced false "no turn started" warnings and a flurry of
# stray Enters fired into an already-running turn.
#
# in_input: 0 = probe still sitting in the input box; 1 = box present, probe gone
# (submitted); 2 = no box found (unknown → fall back to the spinner).
#
# BOTH COMPOSER STYLES, and the second one is why this exists. Claude used to draw the
# input box with rounded corners (╭ … ╰) and now draws it as two plain horizontal rules.
# Looking only for ╰ made this blind on every current pane: it returned 2 (unknown)
# forever, so `submitted` never confirmed and EVERY send ended in "could not confirm
# submit — verify it landed".
#   That warning was the harmless half. The re-nudge that recovers a swallowed Enter
# only fires when in_input says 0 — probe STILL in the box — which a blind detector can
# never say. So the one case it exists for, the paste/Enter race, stopped being
# recoverable: the prompt sat in the composer unsent, indefinitely, and from the outside
# the worker looked like it was ignoring you. Found on a live fleet where a lead's
# "continue where you left off" was still sitting in the box, unsent, while the session
# answered a fresh probe perfectly.
#   A boundary is a line made of nothing but box-drawing rule characters and spaces —
# true of ╭──╮/╰──╯ and of a bare ───── alike. The composer is between the LAST TWO,
# because below it there is only the status bar, which carries text.
#   LC_ALL=C and an alternation, for the reasons _input_state in hooks/fleet-event.sh gives, and
# one more seen here: macOS's awk in a UTF-8 locale matched the bracket this used to be, [─╭╰╮╯],
# against an EMPTY row, so a blank line in a prompt ended the box at that line. Elsewhere that
# bracket is a set of bytes, which matched a row of em dashes as a rule instead.
in_input() {
  [ -n "$probe" ] || return 2           # nothing but blanks: nothing to look for, so never pressed again
  local pane box; pane="$(tmux -L "$SOCK" capture-pane -p -t "$SESSION" 2>/dev/null)"
  box="$(printf '%s\n' "$pane" | LC_ALL=C awk '
    { l[NR]=$0; if ($0 ~ /^[[:space:]]*(─|╭|╰|╮|╯)(─|╭|╰|╮|╯|[[:space:]])*$/) b[++n]=NR }
    END { if (n < 2) exit 2
          for (i = b[n-1] + 1; i < b[n]; i++) print l[i] }')" || return 2
  grep -qF -- "$probe" <<< "$(printf '%s' "$box" | squeeze)" && return 0
  return 1
}
submitted() { busy && return 0; in_input; [ "$?" = 1 ]; }

if [ "$pre_busy" = yes ]; then
  # already mid-turn: the submit hands it to the running turn; one Enter is enough
  sleep "${CLAUDE_FLEET_SUBMIT_DELAY:-0.4}"
  tmux -L "$SOCK" send-keys -t "$SESSION" Enter
  SENT_OUT=delivered
  if [ "$MODE" = now ]; then
    echo "fleet-send: → $SESSION (into the running turn, as an interrupt)"
  else
    echo "fleet-send: → $SESSION (into the running turn; it reads this at its next step)"
  fi
else
  tmux -L "$SOCK" send-keys -t "$SESSION" Enter
  ok=no; renudged=no
  for i in $(seq 1 40); do                      # up to ~8s, but breaks as soon as confirmed
    submitted && { ok=yes; break; }
    # a swallowed Enter (the paste/Enter race) leaves the probe in the box — nudge
    # exactly ONCE more after ~1.6s; never spam Enter into a live turn
    if [ "$i" = 8 ] && [ "$renudged" = no ]; then
      in_input; [ "$?" = 0 ] && { tmux -L "$SOCK" send-keys -t "$SESSION" Enter; renudged=yes; }
    fi
    sleep 0.2
  done
  if [ "$ok" = yes ]; then
    SENT_OUT=delivered
    echo "fleet-send: → $SESSION"
  else
    SENT_OUT=unconfirmed
    echo "fleet-send: → $SESSION (warning: could not confirm submit — verify it landed)" >&2
    # Take the reply address back. Unconfirmed means no turn is known to have started,
    # and a marker left behind would attach our question to whatever that session does
    # NEXT — answering a stranger's turn to a session that stopped waiting. The hook
    # only relays an ARMED address, so this only matters when nothing ever armed it.
    [ -n "$RSESS" ] && [ ! -f "$FLEET_DIR/$SOCK.$SESSION.reply-to.armed" ] \
      && rm -f "$FLEET_DIR/$SOCK.$SESSION.reply-to" 2>/dev/null
  fi
fi
fi   # the paste

# A plain `[ -n … ] && echo` here would leave a FALSE exit status behind when there is no
# reply address, and callers read fleet-send's status as "did the send work" (the MCP
# server turns any nonzero into an error string).
if [ -n "$RSESS" ] && [ "$RSOCK" = telegram ]; then
  echo "fleet-send: its answer goes back to Telegram when the turn ends"
elif [ -n "$RSESS" ]; then
  if [ -z "$_a" ] || [ "$_a" = claude ]; then
    # Name BOTH paths: the caller is about to wait, and "watch your inbox" alone would be
    # wrong now — the usual delivery is a message that arrives in this session directly.
    if [ "$XPROF" = 1 ]; then
      # The caller is about to decide whether to wait or to drain. Say which.
      echo "fleet-send: $RSOCK/$RSESS is on another profile — NO direct reply is possible (separate peer registries)."
      echo "fleet-send: its answer arrives as an ANSWERED row in your fleet-inbox; drain it rather than waiting for a message."
    else
      echo "fleet-send: it was asked to answer ${RPEER:-$RSOCK/$RSESS} directly (SendMessage), and its turn-end message is relayed to $RSOCK/$RSESS as the fallback"
    fi
  else
    echo "fleet-send: its answer will be relayed to $RSOCK/$RSESS when its turn ends"
  fi
fi

# CF-6: record the dispatched task in the manifest so fleet-worktrees' TASK column
# reflects fleet-send work too (not just fleet-spawn --prompt). Keyed by the target's
# worktree path, matching fleet-spawn. Best-effort; never affects the send result.
MANIFEST="$FLEET_DIR/$SOCK.manifest.tsv"
cwd="$(tmux -u -L "$SOCK" display-message -p -t "$SESSION" '#{pane_current_path}' 2>/dev/null)"
if [ -n "$cwd" ]; then
  subject="$(printf '%s' "$MSG" | tr '\n\r\t' '   ' | sed 's/^ *//' | cut -c1-200)"
  br="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
  mtmp="$MANIFEST.$$.tmp"; mkdir -p "$FLEET_DIR" 2>/dev/null
  { [ -f "$MANIFEST" ] && awk -F'\t' -v w="$cwd" '$1!=w' "$MANIFEST"
    printf '%s\t%s\t%s\t%s\n' "$cwd" "$SESSION" "$br" "$subject"; } >"$mtmp" 2>/dev/null \
    && mv -f "$mtmp" "$MANIFEST" 2>/dev/null || rm -f "$mtmp" 2>/dev/null
fi
