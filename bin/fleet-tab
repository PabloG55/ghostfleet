#!/usr/bin/env bash
# fleet-tab term|edit <socket-path> <cwd> [from-session]
#
# Open a plain TAB — a terminal, or the editor — on a session's own folder. Bound to
# C-t / C-n inside a session (tmux/cf.tmux.conf). You are attached to a worker, you
# want a shell in ITS worktree — not master's, not wherever the last terminal happened
# to be — and you want it one keystroke away.
#
# Takes the socket PATH and drives `tmux -S`, like fleet-cycle: run-shell cannot see
# the fleet's env, so anything that trusts $CLAUDE_FLEET_SOCK here would be reading a
# variable the tmux server never had.
#
# WHY A SESSION AND NOT A WINDOW. A tmux window is the obvious "tab", and it is the
# wrong answer here: every status reader in this repo captures with
# `capture-pane -t "$SESSION"`, which resolves to the session's CURRENT window. Open a
# shell window and the whole fleet starts reading it instead of the agent — the grid
# calls a working session idle, the governor parks it, and `fleet-send` PASTES YOUR
# PROMPT INTO THE SHELL. Nothing errors; the prompt is simply gone. A separate session
# is addressed by name, so none of that can happen — and it costs nothing, because the
# tabs then land in the cycle ring and on the grid, which is how you get back out.
#
# THE _ PREFIX IS LOAD-BEARING. It is what tells the agent machinery these are not
# workers (is_tab, in fleet-governor and fleet-send). Worker names track worktree
# basenames — fleet-rename exists to keep "worktree basename == session name" true —
# so a real worker cannot collide with one.
#   It was `+` first, and `+` is a TMUX TARGET METACHARACTER: a leading + means "the
# next session". `has-session -t '=+term-api-2'` still said yes, and switch-client still
# went there, so it looked correct — but `display-message -t '+term-api-2'` answered for
# a completely DIFFERENT session, and capture-pane with it read that other session's
# pane. Every status reader in this repo targets a bare `-t "$name"`, so the fleet would
# have been quietly reading the wrong pane. Measured both ways; `_` resolves to itself.
set -uo pipefail

KIND="${1:-}"; SOCK="${2:-}"; CWD="${3:-}"; FROM="${4:-}"
case "$KIND" in term|edit|back) ;; *) echo "fleet-tab: usage: fleet-tab term|edit <socket-path> <cwd> [from]  |  fleet-tab back <socket-path> <session> <client-tty>" >&2; exit 1 ;; esac
[ -n "$SOCK" ] || { echo "fleet-tab: no socket" >&2; exit 1; }
# A PATH or a NAME. tmux keybindings hand over #{socket_path} (absolute), while the grid
# and anyone on the command line have only the `cf-<project>` name that -L takes. Telling
# them apart by the slash beats making callers care which flag this wants.
case "$SOCK" in /*) T() { tmux -S "$SOCK" "$@"; } ;; *) T() { tmux -L "$SOCK" "$@"; } ;; esac

# `back` — the other half of a tab. Bound to ` (and C-a g) via if-shell, which only
# routes here when @cf_tab_from is set, i.e. only from inside a tab.
#   Falls back to detaching whenever the origin cannot be reached: closing the session
# you opened the tab from is ordinary (finish the work, kill the worker, terminal still
# open), and a switch-client at a dead name would leave the key doing nothing at all —
# looking exactly like the binding is broken.
if [ "$KIND" = back ]; then
  SESS="${3:-}"; TTY="${4:-}"
  from="$(T show-options -qv -t "$SESS" @cf_tab_from 2>/dev/null)"
  if [ -n "$from" ] && T has-session -t "=$from" 2>/dev/null; then
    # Same breadcrumb fleet-cycle leaves, for the same reason: the control plane
    # attached you to ONE session and cannot see that you walked off it. Without this,
    # backing out later restores the grid's cursor to the tab you attached through —
    # which has no card — instead of the session you actually ended up in.
    case "$SOCK" in /*) printf '%s' "$from" > "$SOCK.cur" 2>/dev/null ;; esac
    T switch-client ${TTY:+-c "$TTY"} -t "=$from" 2>/dev/null && exit 0
  fi
  T detach-client ${TTY:+-t "$TTY"} 2>/dev/null
  exit 0
fi

# Fall back to the caller's own cwd rather than refusing: a tab on the wrong-but-real
# folder is still useful, a silent no-op from a keybinding is not.
[ -d "${CWD:-}" ] || CWD="$PWD"
[ -n "$FROM" ] || FROM="$(T display-message -p '#{session_name}' 2>/dev/null)"

# One tab per kind per origin session, REUSED. Pressing C-t twice should put you back in
# the terminal you already have, not deal you a second one — the same "reuse before
# proliferate" rule the worktrees follow, for the same reason: a pile of near-identical
# tabs is indistinguishable from a mess.
#   tmux forbids . and : in a session name, so the origin is sanitised rather than
# trusted; a worker called `api.2` would otherwise fail to create with a parse error.
safe="$(printf '%s' "${FROM:-tab}" | tr '.:' '__')"
[ "$KIND" = term ] && NAME="_term-$safe" || NAME="_edit-$safe"

if ! T has-session -t "=$NAME" 2>/dev/null; then
  if [ "$KIND" = edit ]; then
    ED="${CLAUDE_FLEET_EDITOR:-${EDITOR:-nvim}}"
    command -v "${ED%% *}" >/dev/null 2>&1 || {
      T display-message "fleet-tab: '${ED%% *}' not found — set CLAUDE_FLEET_EDITOR" 2>/dev/null
      exit 1; }
    # `.` so it opens ON the folder (a file browser), not an empty buffer that gives no
    # clue which worktree you landed in.
    CMD="$ED ."
  else
    # A login shell, so it is the prompt you actually configured, not a bare sh.
    CMD="${SHELL:-/bin/sh} -l"
  fi
  # No `exec agent-here`, and no CLAUDE_* env: a tab is NOT an agent. The event hook
  # never fires for it, so it never registers as something that can be sent to, nudged,
  # waited on, or counted as busy.
  T new-session -d -s "$NAME" -c "$CWD" "$CMD" 2>/dev/null || {
    T display-message "fleet-tab: could not open $NAME" 2>/dev/null; exit 1; }

  # WHERE THIS TAB CAME FROM, recorded on the session itself. Two things read it:
  # the status bar below, and the back key (tmux/cf.tmux.conf) — a tab goes back to the
  # session it was opened from, not up to the grid.
  #   Stored rather than derived from the name, because the name was SANITISED: a tab
  # off `api.2` is `_term-api_2`, and stripping the prefix would send you back to a
  # session called `api_2` that does not exist.
  T set-option -t "$NAME" @cf_tab_from "$FROM" 2>/dev/null
  T set-option -t "$NAME" @cf_tab_kind "$KIND" 2>/dev/null

  # KEEP THE CONTEXT. Left to the global status-left a tab renders as a bare
  # `● _term-master`, which is the one thing you already know and none of what you
  # need — you cannot tell which project's fleet you are in, and there are several.
  # Name the origin and the project instead, the way master's own bar does (see
  # enter_master in bin/ghostfleet).
  PROJ="${SOCK##*/}"; PROJ="${PROJ#cf-}"
  [ "$KIND" = term ] && GLYPH="⌨" || GLYPH="✎"
  T set-option -t "$NAME" status-left \
    "#[bg=colour148,fg=colour16,bold] ● $GLYPH ${FROM:-tab} · $PROJ #[bg=colour236,fg=colour148,nobold]▏" 2>/dev/null
  T set-option -t "$NAME" status-right \
    "#[fg=colour252]#[bold]\`#[fg=colour246]#[nobold] back to #[fg=colour148]#[bold]${FROM:-the session}#[fg=colour246]#[nobold]  ·  #[fg=colour252]#[bold]⇧←→#[fg=colour246]#[nobold] cycle  ·  #[fg=colour252]#[bold]Ctrl-s#[fg=colour246]#[nobold] sessions " 2>/dev/null
fi

# Same server, so this is a direct switch — instant, no detach, control plane never
# involved, exactly how fleet-cycle moves between sessions. With no client attached
# (called from a script rather than a keybinding) there is nothing to move, so say what
# was made instead of failing.
T switch-client -t "=$NAME" 2>/dev/null || echo "$NAME"
