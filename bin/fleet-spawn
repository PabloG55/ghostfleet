#!/usr/bin/env bash
# fleet-spawn <name> [--branch <b>] [--from <ref>] [--prompt "<task>"] [--reuse <wt>|--new]
#
# Create a git worktree off the current repo and start a FRESH parallel fleet
# session in it, in the background (no attach). Optionally hand it an initial
# prompt. Lets a "lead" session spin up workers on new branches/worktrees.
#
# REUSE BEFORE PROLIFERATE: if free worktrees already exist (idle, no session,
# clean), creating yet another one is almost never what you want. So spawn will
# STOP and list them rather than silently make a new one — reuse one with
# --reuse, or say --new if you really want a fresh worktree. (See fleet-worktrees.)
#
#   name    session + worktree dir name (worktree = <repo-parent>/<name>)
#   --branch  branch to use (default: <name>); created if it doesn't exist
#   --from    base ref for a new branch. Respects LOCAL commits: bases off your
#             local ref (use HEAD for the current one) and only falls back to the
#             remote tip when local is strictly BEHIND its upstream (warns if ahead).
#   --prompt  initial task to send once the session boots (~7s later). A brief with no
#             done-criterion, or one that reads as several deliverables, draws a WARNING
#             that names what is missing and why — it never refuses, the exit status is
#             unchanged, and the spawn proceeds. Every prompted spawn is counted in
#             <fleet dir>/<socket>.brief.tsv (verdict, length, digest — never the body)
#             so the bypass rate can be measured before anything is promoted to a gate.
#             Every dispatch also prints `brief-check: ok|warn …` at the head of a line on
#             STDOUT, and that same line is appended to what the worker receives — the
#             objection happens in the lead and the outcome happens in the worker, and
#             nothing else joins those two transcripts.
#   --model   model for the new session (e.g. opus); default = account default
#   --agent   which coding CLI runs the session (claude | opencode | codex).
#             Default claude. See bin/fleet-agent for what each one can actually
#             report back — a non-claude worker is not metered by the governor, and
#             an unverified agent's card shows "unknown" rather than a status it
#             hasn't earned.
#   --reuse   start the session in an EXISTING free worktree (name or path). Alone,
#             it keeps the worktree's current branch; add --branch/--from to CLEAN
#             it (reset --hard) and rebranch in one step — how leads recycle.
#   --new     force-create a new worktree even if free ones exist
#   -s, --socket  the fleet to put the worker on, OVERRIDING $TMUX. See "WHICH
#             FLEET" below — this is the only way to insist, and it also pins the
#             socket against owner-routing.
#
# A fresh worktree gets the main checkout's node_modules symlinked in (so workers
# can run lint/typecheck/tests); opt out with CLAUDE_FLEET_LINK_NM=0.
#
# WHICH FLEET THE WORKER LANDS ON — two directions, and both exist for a reason.
#
#   $TMUX beats $CLAUDE_FLEET_SOCK. The env var can go STALE: a long-running
#   --resume/--fork Claude carries whatever socket its earlier context exported,
#   while the tmux server it is actually sitting in cannot be out of date. So for
#   the ordinary case — a lead session running this by hand — the live server wins.
#
#   -s/--socket (or $CLAUDE_FLEET_SOCK_FORCE) beats $TMUX. $TMUX is INHERITED by
#   anything a fleet session launches, and a program launched that way is not "in"
#   that fleet in any meaningful sense. Measured: vhs, started from a fleet session
#   to record `ghostfleet demo`, handed the recorded shell the recorder's socket, so
#   the grid on screen created a worktree and the worker went onto the RECORDER's
#   fleet. Nothing errored — the grid drew the new worktree as "· FREE — no session
#   yet", because the session was real and simply on a socket that grid never reads.
#   An explicit socket also pins against route_to_owner below: a caller that names
#   the fleet has said the last word, and a silent re-route is the same class of bug.
set -uo pipefail

NAME=""; BRANCH=""; BRANCH_SET=0; FROM=""; PROMPT=""; MODEL=""; REUSE=""; NEW=0
SOCK_FORCE="${CLAUDE_FLEET_SOCK_FORCE:-}"
AGENT="${CLAUDE_FLEET_AGENT:-claude}"
while [ $# -gt 0 ]; do
  case "$1" in
    --branch) BRANCH="${2:?}"; BRANCH_SET=1; shift 2 ;;
    --from)   FROM="${2:?}";   shift 2 ;;
    --prompt) PROMPT="${2:?}"; shift 2 ;;
    --model)  MODEL="${2:?}";  shift 2 ;;
    --agent)  AGENT="${2:?}";  shift 2 ;;
    --reuse)  REUSE="${2:?}";  shift 2 ;;
    --new)    NEW=1;           shift ;;
    -s|--socket) SOCK_FORCE="${2:?}"; shift 2 ;;
    -*) echo "fleet-spawn: unknown option $1" >&2; exit 1 ;;
    *)  [ -z "$NAME" ] && { NAME="$1"; shift; } || { echo "fleet-spawn: unexpected arg $1" >&2; exit 1; } ;;
  esac
done
[ -n "$NAME" ] || { echo "fleet-spawn: usage: fleet-spawn <name> [--branch b] [--from ref] [--prompt \"...\"]" >&2; exit 1; }

SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer $TMUX (the live tmux server this session actually runs in) over the env
# var: it's drift-proof, whereas a long-running --resume/--fork Claude can hold a
# STALE CLAUDE_FLEET_SOCK from an earlier context. Only trust it when it names a
# cf-* (fleet) server. (route_to_owner below still refines this by repo owner.)
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac
# ...and an EXPLICIT socket beats both, because $TMUX is inherited by anything a
# fleet session launches (see "WHICH FLEET" in the header). PINNED, so route_to_owner
# leaves it alone as well: a caller that named the fleet gets the fleet it named.
if [ -n "$SOCK_FORCE" ]; then
  case "$SOCK_FORCE" in
    *[!A-Za-z0-9._-]*) echo "fleet-spawn: -s '$SOCK_FORCE' is not a tmux socket name" >&2; exit 1 ;;
  esac
  SOCK="$SOCK_FORCE"
fi
[ -n "$SOCK" ] || { echo "fleet-spawn: no fleet socket (run inside a fleet session, or export CLAUDE_FLEET_SOCK, or pass -s <socket>)" >&2; exit 1; }
command -v git  >/dev/null 2>&1 || { echo "fleet-spawn: git required"  >&2; exit 1; }
command -v tmux >/dev/null 2>&1 || { echo "fleet-spawn: tmux required" >&2; exit 1; }

# Validate the agent HERE, before a worktree gets created: refusing early beats
# leaving a half-built worker whose pane dropped to a shell because its CLI is
# missing. An unknown name is a hard error rather than a silent fall back to claude —
# spawning a different agent than the one asked for is exactly the kind of quiet
# substitution that makes a card lie about what it's running.
if [ "$AGENT" != claude ]; then
  command -v fleet-agent >/dev/null 2>&1 \
    || { echo "fleet-spawn: --agent needs fleet-agent on PATH (run ./install.sh)" >&2; exit 1; }
  fleet-agent field "$AGENT" bin >/dev/null 2>&1 \
    || { echo "fleet-spawn: unknown agent '$AGENT' (known: $(fleet-agent list | tr '\n' ' '))" >&2; exit 1; }
  abin="$(fleet-agent field "$AGENT" bin)"
  command -v "$abin" >/dev/null 2>&1 \
    || { echo "fleet-spawn: agent '$AGENT' needs '$abin' on PATH — not found" >&2; exit 1; }
  [ "$(fleet-agent field "$AGENT" verified)" = yes ] \
    || echo "fleet-spawn: note — the '$AGENT' adapter is UNVERIFIED; its pane signals are unknown, so the grid will show this worker's state as 'unknown' rather than guessing" >&2
  [ "$(fleet-agent field "$AGENT" resume)" = yes ] \
    || echo "fleet-spawn: note — '$AGENT' cannot resume a conversation for a cwd; re-opening this session starts fresh" >&2
fi

GITROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" \
  || { echo "fleet-spawn: not inside a git repo" >&2; exit 1; }
# A WORKER MUST NOT SPAWN WORKERS. Run from inside a linked worktree, this would add
# another worktree beside the one you are already sitting in — which is what happens
# when a session finishes a PR, is told "branch off fresh staging", and reaches for the
# orchestrate skill instead of just re-branching where it stands. The fleet's shape is
# master in the main checkout and workers as leaves; nesting is never what was meant.
#   A linked worktree has its own git-dir under the shared common dir; the main
# checkout's two are the same path. That is exact, unlike guessing from the folder name.
if [ "${CLAUDE_FLEET_ALLOW_NESTED:-0}" != 1 ] \
   && [ "$(git -C "$PWD" rev-parse --git-dir 2>/dev/null)" != "$(git -C "$PWD" rev-parse --git-common-dir 2>/dev/null)" ]; then
  _main="$(git -C "$PWD" worktree list 2>/dev/null | head -1 | awk '{print $1}')"
  _br="$(git -C "$PWD" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  { echo "fleet-spawn: this session is ALREADY in a worktree ($GITROOT, branch $_br)."
    echo "  Spawning here would add another one beside it, which is almost never what was meant."
    echo
    echo "  Starting fresh work in THIS worktree — no new worktree, no new session:"
    echo "      git fetch origin && git checkout -B <new-branch> origin/staging"
    echo
    echo "  Really want another worker? Run it from the main checkout:"
    echo "      (cd ${_main:-<main checkout>} && fleet-spawn $NAME …)"
    echo "  or from a lead, fleet_spawn with project: \"<name>\" — it runs there for you."
    echo "  Override deliberately with CLAUDE_FLEET_ALLOW_NESTED=1."; } >&2
  exit 1
fi

# ── IS THIS BRIEF ONE THING, AND DOES IT SAY WHAT DONE LOOKS LIKE? ───────────
#
# A WARNING, NEVER A REFUSAL, and that distinction is the whole design. The obvious
# version of this is a gate, and a gate here would be built on a null result: of six
# brief features measured across this corpus — length, naming a file, naming a route,
# STATING A DONE-CRITERION, carrying a reference image, human-vs-lead authorship — all
# six sit in a 20-30% correction band with fully overlapping intervals. Gating on one of
# them is gating on nothing. Worse, its failure mode is this repo's dominant one:
# "Done when: implemented" passes any parser, the worker echoes it back, every visible
# field looks disciplined, and the decision the human never made is still unmade. A
# signal that reports a state other than the one it is in is what 41% of this repo's PRs
# exist to fix, and a gate here would have manufactured a new one. So: say what is thin,
# COUNT it (below, beside the manifest), and let a later evaluation against a baseline
# decide whether any of it ever earns a refusal. Exit status is untouched.
#
# ONE WARNING PER BRIEF, not one per missing field. A wall of warnings is read as
# decoration, which is the same failure arriving by a different route.
#
# THE DELIVERABLE COUNT IS NOT A LIST COUNT, deliberately. A numbered list is
# presentation: it can be one change's acceptance criteria, a research method, or a set
# of named UI states, and counting its items would call all three "three asks". What is
# counted is a BUILD VERB in a STARTING position — line start, after a bullet or a
# number, after a sentence end, or after "then"/"also". read/run/check/verify are left
# out on purpose: those are method steps, and counting them turns "investigate the
# flake, read the suite, run it twice" into three deliverables. It undercounts prose
# that bundles without a conjunction ("fix the parser and add a test" reads as one), and
# undercounting is the right direction to miss in for something that must not become
# noise.
BRIEF_VERBS='add|build|implement|create|write|fix|update|refactor|remove|delete|rename|migrate|port|wire|ship|document|redesign|replace|extract|split|introduce|expose|support'
BRIEF_START='(^[[:space:]]*((-|\*|•)[[:space:]]+)?([0-9]+[.)][[:space:]]+)?|^[[:space:]]*(and[[:space:]]+then|then|also)[[:space:]]+|[.;!?][[:space:]]+|[[:space:]]+(and[[:space:]]+then|then|also)[[:space:]]+)'
BRIEF_DONE=yes; BRIEF_ITEMS=0
# A HERE-STRING AND NOT A PIPE INTO grep -q. `grep -q` closes its input on the first
# match, the writer takes SIGPIPE, and `set -o pipefail` promotes that 141 to the
# pipeline status — so a MATCH would read as a no-match, and only on the runs where the
# kernel handed out a small pipe buffer. That is a live bug in this repo's own suite; do
# not reintroduce its shape here.
if [ -n "$PROMPT" ]; then
  grep -qiE 'done when|acceptance criteri|definition of done|success criteri|^[[:space:]]*done[[:space:]]*:' <<<"$PROMPT" || BRIEF_DONE=no
  BRIEF_ITEMS="$(grep -oiE "$BRIEF_START($BRIEF_VERBS)([[:space:]]|\$)" <<<"$PROMPT" | wc -l | tr -d ' ')"
fi
# THE VERDICT, as one machine-readable line, and the reason it has no `fleet-spawn:`
# prefix like every other line this command prints. It is a MARKER: the item #5 evaluator
# identifies which sessions were treated by this machinery by finding it at the HEAD of a
# line, and it has to, because the string alone is not evidence — the evaluator's first
# run classified the session that was WRITING this file as treated, and the treated arm
# would have filled with the treatment's own construction work. A marker is a position,
# not a substring.
#
# ONE STRING, printed to the lead AND appended to what the worker receives. The objection
# happens in the lead and the outcome happens in the worker, and nothing else joins those
# two transcripts: a verdict left behind on the lead makes a false refusal unmeasurable
# from either end. Identical bytes in both places is what makes them joinable.
BRIEF_VERDICT=ok
if [ "$BRIEF_DONE" = no ] || [ "${BRIEF_ITEMS:-0}" -gt 1 ]; then BRIEF_VERDICT=warn; fi
BRIEF_MARK="brief-check: $BRIEF_VERDICT done-criterion=$BRIEF_DONE deliverables=${BRIEF_ITEMS:-0}"
[ "$BRIEF_VERDICT" = warn ] && BRIEF_MARK="$BRIEF_MARK — warning only, nothing was blocked; if a decision you need is missing, ask before you build"

# Short, one-way, and computed here so the body never leaves this process — the same
# boundary the dispatch log keeps. Enough to tell one brief from another and to spot a
# re-send of the same one; none of what was said.
brief_digest() {
  if   command -v shasum   >/dev/null 2>&1; then shasum -a 256
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum
  else cksum; fi | awk '{print substr($1,1,12)}'
}

# WARN EARLY, COUNT LATE. The warning is advice about the brief and is worth having
# before the reuse-before-proliferate stop below, so a lead re-running the command can fix
# both in one go. The COUNT goes next to the manifest write, after the session is
# confirmed — a row is a claim that a dispatch happened, and one written for a spawn that
# died on a missing agent binary would corrupt the denominator that makes the bypass rate
# mean anything.
#
# STDOUT, NOT STDERR, and this is measured rather than stylistic. mcp/fleet-dispatch.mjs
# returns `execFileSync(...)` — stdout alone — on the SUCCESS path, and only merges stderr
# in when the command fails. A lead dispatching through the fleet_spawn MCP tool, which
# the orchestrate skill tells it to prefer, would therefore see none of this on the one
# path where everything worked. A warning delivered only when the spawn breaks is not a
# warning about the brief.
if [ -n "$PROMPT" ]; then
  echo "$BRIEF_MARK"
  if [ "$BRIEF_VERDICT" = warn ]; then
    echo "fleet-spawn: the brief is thin — dispatching anyway, and nothing below blocks it."
    if [ "$BRIEF_DONE" = no ]; then
      echo "  NO DONE-CRITERION: nothing in it says how the worker knows it is finished. Every"
      echo "    session carries a contract that CLOSES on the criteria named at the start, so a"
      echo "    brief naming none leaves it nothing to close — and the honest done-report is then"
      echo "    that none were named, which lands back on you later as a question."
    fi
    if [ "${BRIEF_ITEMS:-0}" -gt 1 ]; then
      echo "  READS AS $BRIEF_ITEMS DELIVERABLES (build verbs in a starting position). One worker"
      echo "    reporting done after the first is indistinguishable from one that did them all."
    fi
    echo
    echo "  ADDING A DONE LINE IS NOT THE FIX, and would not show up in any measurement: it is"
    echo "  one of six brief features measured at NO effect here. What IS measured is the other"
    echo "  half — 36 of 163 screen-attributed corrections were requirements stated for the"
    echo "  first time mid-flight, and 19 of those were already known to the human and simply"
    echo "  not said. So before you re-send, run the ask against the eight axes and put the"
    echo "  unanswered MATERIAL ones back to the human as a NUMBERED LIST:"
    echo "      UNIT (per line, per document, per policy) · PARITY with an existing surface ·"
    echo "      REUSE rather than recreate · the GATE before advancing · COMPLETENESS of a list ·"
    echo "      ELIGIBILITY and how a thing LEAVES · RETROACTIVITY to records that already exist ·"
    echo "      and for a rendered artifact, whether there is an existing one to match."
    echo "  Then put the ANSWERS in the brief. The worker records which of them it is working"
    echo "  from with fleet-ack, and fleet-worktrees shows ASKED beside UNDERSTOOD — so a worker"
    echo "  building from a decision nobody made is visible now instead of at turn 30."
    echo
    echo "  Counted — verdict, length and a digest, never the body — in <fleet dir>/$SOCK.brief.tsv"
  fi
fi

# WHAT THE WORKER ACTUALLY RECEIVES. The marker rides along as a trailing line rather than
# a leading one: the head of the brief is what the worker reads first and what the manifest
# shows in ASKED, and putting machinery in front of the human ask degrades both. $PROMPT
# itself is left alone, so the manifest and the brief counter keep measuring the ASK rather
# than the ask plus our own footer — fleet-send has its own log for what was really sent.
DISPATCH_PROMPT="$PROMPT"
[ -n "$PROMPT" ] && DISPATCH_PROMPT="$PROMPT

$BRIEF_MARK"

PARENT="$(dirname "$GITROOT")"

# WHERE A WORKTREE GOES IS THE REPO'S CALL, NOT OURS.
#
# A sibling was the only layout for a long time and is still the default. But a repo
# that runs its own worktree doctrine puts them somewhere specific, and ours fought it:
# one repo here has a PreToolUse guard that denies any edit whose PATH does not contain
# `.worktrees/` — it never asks git whether the path IS a worktree. So a sibling (a real,
# isolated worktree on its own branch) was refused as "the shared main checkout", the
# agent dutifully obeyed the instructions in the refusal, and created a SECOND worktree
# nested inside the first:
#
#     ~/proj/cache-keys                        <- ours, where the session sits
#     ~/proj/cache-keys/.worktrees/cache-keys  <- the guard's, where edits land
#
# Two worktrees and a full dependency install per task, with the session attached to the
# one that wasn't being edited. Nineteen worktrees across four clones, fifteen of them
# idle, came out of that.
#
# Resolution, most explicit first:
#   CLAUDE_FLEET_WORKTREE_DIR  a directory — relative goes under the repo, absolute is
#                              taken as-is; `sibling` forces the classic layout
#   $GITROOT/.worktrees exists the convention is demonstrably already in use here
#   git ignores .worktrees/    the repo DECLARES the convention before the first one
#                              exists. Asked of git rather than grepped out of
#                              .gitignore, so nested files, info/exclude and the global
#                              ignore all count — and a repo that merely has a stray
#                              directory isn't mistaken for one that opted in.
#   otherwise                  sibling, byte-for-byte the previous behaviour
worktree_parent() {
  local v="${CLAUDE_FLEET_WORKTREE_DIR:-}"
  case "$v" in
    sibling|-) printf '%s' "$PARENT"; return ;;
    /*)        printf '%s' "$v"; return ;;
    ?*)        printf '%s/%s' "$GITROOT" "${v#./}"; return ;;
  esac
  [ -d "$GITROOT/.worktrees" ] && { printf '%s/.worktrees' "$GITROOT"; return; }
  # A path INSIDE it, not the bare name: `.worktrees/` is a directory-only pattern, and
  # check-ignore will not match one against a name that has no trailing slash and no
  # directory on disk — which is precisely the first-worktree-in-a-fresh-clone case this
  # branch exists to serve. Probing a child matches whether or not anything exists yet.
  git -C "$GITROOT" check-ignore -q .worktrees/.probe 2>/dev/null \
    && { printf '%s/.worktrees' "$GITROOT"; return; }
  printf '%s' "$PARENT"
}
WT_PARENT="$(worktree_parent)"
WT="$WT_PARENT/$NAME"
CFG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# ROUTE BY OWNING PROJECT — the worker MUST land on the fleet of the project this
# repo belongs to, NOT whatever socket we happened to be called with. Otherwise
# orchestrating several projects from one session (or a stale CLAUDE_FLEET_SOCK in
# the env) spawns e.g. another project's workers onto the ghostfleet fleet, so
# their status/nudges report to the wrong project. A worktree's project ROOT is the
# parent of its repo (siblings live under it); match that against the projects
# configs and switch to the owner's socket + config dir. No match → keep ambient.
project_at() {                     # <path> -> "<name>\t<profile>" of the project registered there
  local root="$1" cfg="" got=""
  [ -n "$root" ] || return 0
  for cfg in "$HOME/.config/ghostfleet/projects" "$HOME"/.config/ghostfleet/projects.*; do
    [ -f "$cfg" ] || continue
    # only real profile lists: a suffix like ".bak.1785" is a backup, not a profile.
    # The bare default file has NO ".profile" suffix to check — stripping "*/projects."
    # from it is a no-op, so it's left with its full path (slashes and all), which then
    # (wrongly) fails this same charset check and got skipped every time, meaning a repo
    # registered under the default 'work' profile could never be matched here at all.
    if [ "$cfg" != "$HOME/.config/ghostfleet/projects" ]; then
      case "${cfg##*/projects.}" in *[!A-Za-z0-9_-]*) continue ;; esac
    fi
    got="$(awk -F'\t' -v r="$root" -v home="$HOME" '
      /^[[:space:]]*#/ || NF<2 { next }
      { p=$2; sub(/^~/, home, p); if (p==r) { print $1 "\t" ($3==""?"work":$3); exit } }' "$cfg")"
    [ -n "$got" ] && { printf '%s\n' "$got"; return 0; }
  done
  return 0
}
# TWO PATHS TRIED, PARENT FIRST, because a project is registered either way and the two
# conventions used to contradict each other (docs/OPERATIONS.md, "Two ways to register a
# project"):
#   <repo>'s PARENT  the registered path is a CONTAINER of checkouts — the only
#                    convention this understood
#   <repo> itself    the registered path IS the repo, which fleet-grid.mjs mainRepo()
#                    wants. That matched nothing here, so pointing the path at the repo
#                    silently kept the ambient socket: one convention's fix was the
#                    other's bug, and you could not satisfy both.
# Parent first keeps every existing routing decision byte-for-byte — the repo-itself
# probe only ever answers where there was NO answer before. A repo registered as its own
# project INSIDE a registered container still routes to the container, which is the
# pre-existing behaviour and not something to change under anyone by accident.
route_to_owner() {
  local got="" name="" prof="" osock="" ocfg=""
  # -s said which fleet. Re-routing it would make "I mean it" advice.
  [ -z "$SOCK_FORCE" ] || return 0
  got="$(project_at "$(dirname "$GITROOT")")"                 # the container convention
  [ -n "$got" ] || got="$(project_at "$GITROOT")"             # ...else the repo-itself one
  [ -n "$got" ] || return 0                                   # unknown repo → keep ambient (safe)
  name="${got%%	*}"; prof="${got##*	}"
  case "$prof" in work|default) osock="cf-$name"; ocfg="$HOME/.claude" ;; *) osock="cf-$prof-$name"; ocfg="$HOME/.claude-$prof" ;; esac
  if [ "$osock" != "$SOCK" ]; then
    echo "fleet-spawn: this repo belongs to '$name' (fleet $osock) — routing the worker there, not the ambient $SOCK" >&2
    SOCK="$osock"; CFG_DIR="$ocfg"
  fi
}
route_to_owner

# who's live where — so we can tell free worktrees from occupied ones (same test
# as fleet-worktrees: a worktree is FREE = no live session on it + clean tree).
panes="$(tmux -L "$SOCK" list-panes -a -F '#{pane_current_path}	#{session_name}' 2>/dev/null)"
sess_for() {
  local wt="$1" p="" s=""
  while IFS=$'\t' read -r p s; do
    [ -n "$p" ] || continue
    case "$p" in "$wt"|"$wt"/*) echo "$s"; return ;; esac
  done <<EOF
$panes
EOF
}
free_worktrees() {                     # "<label> (<branch>, clean)" per free worktree
  # ASK fleet-worktrees, which looks across every clone under the project root. That is
  # the whole reason this guard was toothless here: a project can be several independent
  # clones (one project here is four), each owning its own worktrees, and this function only ever
  # walked the one clone it was standing in — 2 visible, 17 invisible. So it found nothing
  # free and dutifully created another, nineteen times over.
  #   Sharing the enumerator also keeps "free" meaning one thing: two definitions of it
  # drift, and the one that drifts is the one nobody reads.
  local fw
  fw="$(dirname "$0")/fleet-worktrees"
  if [ -x "$fw" ]; then
    "$fw" -s "$SOCK" --free 2>/dev/null | while IFS=$'\t' read -r p b; do
      [ -n "$p" ] || continue
      case "$p" in "$PARENT"/*) printf '%s (%s, clean)\n' "${p#"$PARENT"/}" "$b" ;;
                   *)           printf '%s (%s, clean)\n' "${p##*/}" "$b" ;; esac
    done
    return
  fi
  free_worktrees_local
}
free_worktrees_local() {               # fallback: this repo only, the pre-cross-clone logic
  local first=1
  git -C "$GITROOT" worktree list --porcelain 2>/dev/null | awk '
    /^worktree /{ if(wt!=""&&!skip)print wt"\t"br; wt=substr($0,10); br="(detached)"; skip=0 }
    /^branch / { b=$2; sub("refs/heads/","",b); br=b }
    /^bare$/   { skip=1 }
    /^$/       { if(wt!=""&&!skip){print wt"\t"br; wt=""} }
    END        { if(wt!=""&&!skip)print wt"\t"br }
  ' | while IFS=$'\t' read -r wt br; do
        [ -n "$wt" ] || continue
        [ "$first" = 1 ] && { first=0; continue; }                          # skip main checkout
        # NOT OURS TO REUSE: Claude Code's own trees (the Agent tool's isolation:worktree,
        # and EnterWorktree's <repo>/.claude/worktrees/<name>) are git worktrees like any
        # other, so they land here looking clean and sessionless — i.e. "free". A stale one
        # then shadows spawn completely: it offers a tree you cannot sensibly reuse AND
        # refuses to create a new one until you pass --new. Claude owns these; skip them.
        case "$wt" in */.claude/worktrees/*) continue ;; esac
        [ -z "$(sess_for "$wt")" ] || continue                              # occupied
        [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ] || continue # dirty -> not free
        printf '%s (%s, clean)\n' "${wt##*/}" "$br"
      done
}

# REFUSE A BRANCH NAME GIT ALREADY READS AS A REF, BEFORE ANYTHING IS CREATED.
#
# git resolves a bare name as $GIT_DIR/<name> BEFORE refs/heads/<name>, and the git dir
# is a shared drawer that tools drop things in — opencode writes $GIT_DIR/opencode. So
# once a worker called `opencode` has run, that name resolves as BOTH the stray file and
# refs/heads/opencode, and `git worktree add <path> -b opencode` dies with
#
#     warning: refname 'opencode' is ambiguous.
#     fatal: invalid reference: opencode
#
# AFTER creating the branch. Half-succeeded, every time, and the leftover branch is
# invisible until someone goes looking: no worktree, no session, and a repo that needs
# hand cleanup before the same name will work again. Slashed names do it too, via
# $GIT_DIR/feat/x.
#
# Only content git can PARSE as a ref makes the name ambiguous, and that is what keeps
# this off git's own files: `config` and `packed-refs` live in the same directory, and a
# branch called `config` is perfectly fine because `[core]` is not a ref. Testing the
# CONTENT rather than mere existence is the difference between a guard and a nuisance.
#   Both git dirs, because a linked worktree has its own ($GIT_DIR/worktrees/<name>) and
# an agent running IN the worktree writes there, not into the common dir.
gitdir_ref_collision() {           # <repo-dir> <branch> -> prints the colliding path
  local dir="$1" br="$2" gd="" p="" first=""
  [ -n "$br" ] || return 1
  for gd in "$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null)" \
            "$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; do
    [ -n "$gd" ] || continue
    p="$gd/$br"
    [ -f "$p" ] || continue
    # `|| true`, NOT `|| first=""`: read returns non-zero on a file with no trailing
    # newline and still assigns what it read, so clearing on failure would let exactly
    # the sloppiest writers through — and a marker file written without a newline is a
    # perfectly ordinary thing for a tool to leave behind.
    IFS= read -r first < "$p" || true
    first="${first%$'\r'}"
    if [[ $first =~ ^ref:[[:space:]] ]] || [[ $first =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
      printf '%s\n' "$p"; return 0
    fi
  done
  return 1
}
#   THE FIXES COME FIRST, the explanation after. fleet-grid.mjs shows the opening lines
# of a refusal in a fixed-height block on the new-worktree form (spawnFailLines), so a
# message that diagnoses for six lines and then advises is a message whose advice the
# form throws away. That is the bug this whole change set is about; not repeating it here.
assert_branch_nameable() {         # <repo-dir> <branch> — refuses, creating nothing
  local dir="$1" br="$2" hit=""
  hit="$(gitdir_ref_collision "$dir" "$br")" || return 0
  { echo "fleet-spawn: '$br' already resolves as a ref — a file in the git dir has that exact name:"
    echo "      ${hit/#$HOME/~}"
    echo "  Use another branch name (the worktree can still be called '$NAME'):"
    echo "      fleet-spawn $NAME --branch ${br}-wt"
    echo "  Or move that file aside, if it is a tool's leftover and not something you need:"
    echo "      mv ${hit/#$HOME/~} ${hit/#$HOME/~}.bak"
    echo
    echo "  git looks a bare name up in the git dir BEFORE refs/heads/, so 'worktree add"
    echo "  … $br' dies on 'invalid reference: $br' AFTER creating the branch. Nothing"
    echo "  was created here. (opencode writes \$GIT_DIR/opencode — which is how a worker"
    echo "  named after its own agent poisons that name for good.)"; } >&2
  exit 1
}

# Resolve --from to a concrete base ref, RESPECTING LOCAL commits. Echoes the ref
# on stdout (warnings on stderr); empty --from -> "" (git uses current HEAD).
#   local behind & not ahead -> the remote tip (don't start stale), warn
#   local ahead (unpushed)   -> your LOCAL ref (has commits the remote lacks), warn
#   HEAD / sha / tag / no upstream / in sync / diverged -> the ref as given, local
resolve_base() {
  local from="$1" ref="" up="" lr="" ahead="" behind=""
  [ -n "$from" ] || return 0
  if [ "$from" != HEAD ] && ! git -C "$GITROOT" show-ref --verify --quiet "refs/heads/$from"; then
    echo "$from"; return 0                               # sha / tag / remote ref -> as-is
  fi
  ref="$from"; [ "$from" = HEAD ] && ref="$(git -C "$GITROOT" symbolic-ref --quiet --short HEAD 2>/dev/null)"
  [ -n "$ref" ] || { echo "$from"; return 0; }           # detached HEAD -> as-is
  up="$(git -C "$GITROOT" rev-parse --abbrev-ref --symbolic-full-name "$ref@{u}" 2>/dev/null)"
  [ -n "$up" ] || { echo "$ref"; return 0; }             # no upstream -> local
  git -C "$GITROOT" fetch --quiet "${up%%/*}" "${up#*/}" 2>/dev/null || true
  lr="$(git -C "$GITROOT" rev-list --count --left-right "$ref...$up" 2>/dev/null)"
  ahead="${lr%%	*}"; behind="${lr##*	}"; ahead="${ahead:-0}"; behind="${behind:-0}"
  if [ "$behind" -gt 0 ] && [ "$ahead" -eq 0 ]; then
    echo "fleet-spawn: local $ref is $behind behind $up — basing on the remote tip ($up); 'git pull' to catch local up" >&2
    echo "$up"
  elif [ "$ahead" -gt 0 ]; then
    echo "fleet-spawn: local $ref is $ahead ahead of $up (unpushed) — basing on your LOCAL $ref, not the remote" >&2
    echo "$ref"
  else
    echo "$ref"
  fi
}

# Symlink the source checkout's node_modules into a fresh worktree so workers can
# run lint/typecheck/tests (a new worktree has none). Opt out: CLAUDE_FLEET_LINK_NM=0.
link_node_modules() {
  local wt="$1"
  case "${CLAUDE_FLEET_LINK_NM:-1}" in 0|off|no|false) return 0 ;; esac
  [ -e "$wt/node_modules" ] && return 0                  # worktree already has its own
  [ -d "$GITROOT/node_modules" ] || return 0             # nothing to link
  # NEVER INTO A WORKSPACE. The convenience is real for a plain repo and actively
  # destructive here, twice over:
  #   - the root node_modules links workspace packages by RELATIVE path
  #     (node_modules/@scope/db -> ../packages/db), and through a symlinked
  #     node_modules that resolves from the symlink's REAL location — the main
  #     checkout. The worktree silently typechecks and tests the source it is not
  #     editing.
  #   - a `pnpm install` in the worktree writes THROUGH the symlink into the main
  #     checkout, rewriting its .pnpm store underneath it. Reported live: "Root
  #     node_modules/vitest is a dangling symlink — the new worktree's install
  #     disturbed the main checkout's links."
  # Opting out was previously the repo's job (a .ghostfleet/post-create, whose mere
  # existence skips this) — but a repo should not have to know that to avoid its shared
  # checkout being corrupted. Detect it here instead.
  if [ -f "$GITROOT/pnpm-workspace.yaml" ] \
     || grep -q '"workspaces"' "$GITROOT/package.json" 2>/dev/null; then
    echo "fleet-spawn: $NAME is a workspace — NOT symlinking node_modules (an install there would rewrite the main checkout's). Run your installer in the worktree." >&2
    return 0
  fi
  ln -s "$GITROOT/node_modules" "$wt/node_modules" 2>/dev/null \
    && echo "fleet-spawn: linked node_modules from the main checkout so tests/lint run (opt out: CLAUDE_FLEET_LINK_NM=0)" >&2
}

# --- resolve the worktree: reuse an existing free one, or create a new one -----
if [ -n "$REUSE" ]; then
  # ACCEPT WHAT fleet-worktrees PRINTS. That list now spans every clone under the project
  # root, and its labels are project-root-relative (`acme-api-1/.worktrees/foo`), so the
  # old "$PARENT/$REUSE" + "is it a worktree of THIS repo" pair rejected most of what a
  # lead had just been told it could reuse. Resolve the label, then ask GIT — in the
  # target — whether it really is a linked worktree; that is exact and does not care which
  # clone owns it.
  case "$REUSE" in
    /*) WT="$REUSE" ;;
    */*) WT="$PARENT/$REUSE" ;;                       # project-root-relative, as printed
    *)  WT="$PARENT/$REUSE"
        # a bare name: accept it when exactly one worktree anywhere under the project
        # root ends in it, so the short form keeps working now that names nest.
        if [ ! -d "$WT" ]; then
          _hits="$(find "$PARENT" -maxdepth 3 -type d -name "$REUSE" 2>/dev/null)"
          _n="$(printf '%s\n' "$_hits" | grep -c . || true)"
          case "$_n" in
            1) WT="$_hits" ;;
            0) ;;
            *) { echo "fleet-spawn: '$REUSE' is ambiguous — several worktrees have that name:"
                 printf '%s\n' "$_hits" | sed "s|^$PARENT/|  |"
                 echo "  pass the path as fleet-worktrees prints it"; } >&2; exit 1 ;;
          esac
        fi ;;
  esac
  [ -d "$WT" ] && [ "$(git -C "$WT" rev-parse --show-toplevel 2>/dev/null)" = "$WT" ] \
    && [ "$(git -C "$WT" rev-parse --git-dir 2>/dev/null)" != "$(git -C "$WT" rev-parse --git-common-dir 2>/dev/null)" ] \
    || { echo "fleet-spawn: '$REUSE' is not a git worktree — see: fleet-worktrees" >&2; exit 1; }
  s="$(sess_for "$WT")"
  [ -z "$s" ] || { echo "fleet-spawn: worktree '$REUSE' is busy (session '$s'); pick a FREE one (fleet-worktrees)" >&2; exit 1; }
  if [ "$BRANCH_SET" = 1 ] || [ -n "$FROM" ]; then       # recycle: clean + rebranch in one step
    [ -n "$BRANCH" ] || BRANCH="$NAME"
    # BEFORE the reset --hard: a recycle throws the tree away, and doing that only to
    # fail on the checkout is the same half-done state the guard exists to prevent.
    assert_branch_nameable "$WT" "$BRANCH"
    base="$(resolve_base "$FROM")"
    git -C "$WT" reset --hard >/dev/null 2>&1
    git -C "$WT" clean -fd   >/dev/null 2>&1
    if git -C "$GITROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git -C "$WT" checkout "$BRANCH" >&2 || exit 1
    else
      git -C "$WT" checkout -b "$BRANCH" ${base:+"$base"} >&2 || exit 1
    fi
    echo "fleet-spawn: recycled $WT onto '$BRANCH'${base:+ (from $base)}" >&2
  else
    BRANCH="$(git -C "$WT" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    echo "fleet-spawn: reusing worktree $WT (branch $BRANCH)" >&2
  fi
elif [ -e "$WT" ]; then
  echo "fleet-spawn: $WT already exists — reusing it" >&2
  BRANCH="$(git -C "$WT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "${BRANCH:-$NAME}")"
else
  [ -n "$BRANCH" ] || BRANCH="$NAME"
  # FIRST, before the free-worktree offer and before any mkdir: a name git already reads
  # as a ref cannot be fixed by reusing or by --new, so hearing about it now saves a
  # round trip through advice that cannot work.
  assert_branch_nameable "$GITROOT" "$BRANCH"
  # about to CREATE a new worktree — reuse a free one first if any exist (unless --new)
  if [ "$NEW" != 1 ]; then
    fw="$(free_worktrees)"
    if [ -n "$fw" ]; then
      { echo "fleet-spawn: free worktree(s) available — reuse one instead of making another:"
        printf '%s\n' "$fw" | sed 's/^/  /'
        echo "  Reuse:    fleet-spawn $NAME --reuse <worktree>"
        echo "  Recycle:  fleet-spawn $NAME --reuse <worktree> --branch <new> --from origin/main"
        echo "  New:      fleet-spawn $NAME --new"; } >&2
      exit 1
    fi
  fi
  # `git worktree add` creates the leaf, not the path above it: with a .worktrees/
  # convention this is the call that has to bring that directory into being, and the
  # FIRST worktree in a fresh clone is exactly when it doesn't exist yet.
  mkdir -p "$WT_PARENT" 2>/dev/null || true
  if git -C "$GITROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$GITROOT" worktree add "$WT" "$BRANCH" >&2 || exit 1
  else
    base="$(resolve_base "$FROM")"
    git -C "$GITROOT" worktree add "$WT" -b "$BRANCH" ${base:+"$base"} >&2 || exit 1
  fi
fi

# A repo that ships .ghostfleet/post-create is telling us it sets its own worktree up,
# so the node_modules symlink must NOT also happen — and not merely because it is
# redundant. In a pnpm WORKSPACE the root node_modules links workspace packages by
# RELATIVE path (node_modules/@scope/db -> ../../packages/db), so a symlinked tree
# resolves every workspace import from the symlink's real location: the MAIN checkout's
# source. Silent cross-tree contamination, far worse than the missing-binary symptom it
# is meant to prevent. Worse still, running `pnpm install` afterwards would install
# THROUGH the symlink into the main checkout. Set CLAUDE_FLEET_LINK_NM=1 to force it.
POST_CREATE="$WT/.ghostfleet/post-create"
if [ -x "$POST_CREATE" ] && [ "${CLAUDE_FLEET_LINK_NM:-}" != 1 ]; then
  echo "fleet-spawn: .ghostfleet/post-create present — skipping the node_modules symlink, the repo sets itself up" >&2
else
  link_node_modules "$WT"
fi

# ONE INTEGER PER CHECKOUT that nothing else in the fleet holds, so the repo can derive
# a local dev stack from it — ports, database name, bucket — instead of a human picking
# free numbers per worktree and nothing checking they agree. ghostfleet allocates the
# NUMBER and deliberately knows nothing about what it becomes: those formulas belong to
# the repo that owns those names. Idempotent, so reusing a worktree keeps its stack (and
# its already-seeded database) rather than paying for a fresh one. Best-effort: a fleet
# whose repo doesn't use slots must still spawn exactly as before.
SLOT="$("$(dirname "$0")/fleet-slot" claim "$WT" 2>/dev/null)" || SLOT=""
case "$SLOT" in ''|*[!0-9]*) SLOT="" ;; esac
[ -n "$SLOT" ] && echo "fleet-spawn: dev-stack slot $SLOT (read it with: fleet-slot of \"$WT\")" >&2

# Run it BEFORE the session starts, so the agent lands in a worktree that already works
# rather than discovering halfway through a task that its toolchain is missing — and
# AFTER the slot is claimed, so a hook that provisions per-slot state (a database, a
# bucket) can read CLAUDE_FLEET_SLOT instead of having to ask for it again. Synchronous
# on purpose: the lead waits, but the alternative is a worker whose first test run fails
# for a reason that has nothing to do with its task. A failure is loud and not fatal — a
# worktree with no dependencies is still worth opening.
if [ -x "$POST_CREATE" ]; then
  echo "fleet-spawn: running .ghostfleet/post-create in $WT${SLOT:+ (slot $SLOT)} …" >&2
  if ( cd "$WT" && CLAUDE_FLEET_SLOT="$SLOT" CLAUDE_FLEET_WORKTREE="$WT" "$POST_CREATE" ) >&2; then
    echo "fleet-spawn: post-create finished" >&2
  else
    echo "fleet-spawn: WARNING — .ghostfleet/post-create failed; starting '$NAME' anyway" >&2
  fi
fi

# unique session name on this fleet's socket
name="$NAME"; i=2
while tmux -L "$SOCK" has-session -t "$name" 2>/dev/null; do name="$NAME~$i"; i=$((i + 1)); done

# CF-3: clear any STALE park marker for this name (namespaced + legacy bare) so the
# fresh session doesn't boot "parked" off a marker left by a killed same-named one.
rm -f "${CLAUDE_FLEET_DIR:-$CFG_DIR/fleet}/$SOCK.$name.parked" \
      "${CLAUDE_FLEET_DIR:-$CFG_DIR/fleet}/$name.parked" 2>/dev/null

# Record the agent BEFORE the session starts, for the same reason the park marker is
# cleared here: a killed same-named worker can leave a stale marker behind, and
# agent-here reads this to recover the agent when a session is rebuilt without the
# env var. Writing it first also means the pane never races a missing marker.
# Claude clears rather than writes — absent means claude, so the default leaves no
# state behind and pre-existing sessions keep behaving exactly as before.
if [ "$AGENT" = claude ]; then
  rm -f "${CLAUDE_FLEET_DIR:-$CFG_DIR/fleet}/$SOCK.$name.agent" 2>/dev/null
else
  # -s is mandatory here, not decoration: route_to_owner may have moved this worker to
  # ANOTHER project's fleet, and fleet-agent would otherwise resolve the socket from
  # the lead's own $TMUX and file the marker under the wrong fleet.
  CLAUDE_FLEET_DIR="${CLAUDE_FLEET_DIR:-$CFG_DIR/fleet}" \
    fleet-agent set -s "$SOCK" "$name" "$AGENT" 2>/dev/null
fi

# SAY "STARTED" ONLY WHEN A SESSION IS ACTUALLY THERE.
#
# This printed the success line unconditionally, one line below a `new-session` whose
# exit status nobody read. tmux's own error was never suppressed — it went to stderr all
# along — but it was immediately contradicted by "started '<name>' in <worktree>", and a
# reader believes the last thing they are told. So every failure mode looked exactly like
# a success: `fleet-spawn cache-keys --reuse cache-keys` printed the whole success block,
# including the promise to dispatch the initial prompt, and no session ever existed.
# Reported twice from one project after three re-runs, because nothing in the output
# distinguished the attempts.
#
# It reaches further than a wrong message. bin/fleet-grid.mjs's createWorktree parses this
# very line — /started '([^']+)'/ — to learn which session to attach to, so a failed
# spawn became a confident attach to nothing and the card drew "· FREE — no session yet".
# That is byte-for-byte the symptom of the socket-routing bug fixed in #64, and telling
# the two apart cost a lead real time.
#
# -P -F '#{session_id}' rather than trusting the exit status alone: it gives us the
# identity of the session that was just made, which is what the check below needs. The id
# never reaches stdout — the grid parses that stream, and a stray line in it is a hazard
# for no benefit.
sid="$(tmux -L "$SOCK" new-session -d -P -F '#{session_id}' -s "$name" -c "$WT" \
  -e "CLAUDE_CONFIG_DIR=$CFG_DIR" -e "CLAUDE_FLEET_SOCK=$SOCK" -e "CLAUDE_FLEET_FRESH=1" \
  -e "CLAUDE_FLEET_MODEL=$MODEL" -e "CLAUDE_FLEET_AGENT=$AGENT" -e "CLAUDE_FLEET_SLOT=$SLOT" \
  "exec agent-here \"$name\"")" || sid=""
sid="${sid%%$'\n'*}"

# ...AND EXIT 0 ONLY THEN. tmux can return 0 and the session still be gone a moment
# later: the pane runs `exec agent-here <name>`, and if that cannot exec — not on PATH
# because ./install.sh was never run, or the staged runtime is half-synced — the pane's
# command exits at once and tmux takes the session down with it (`remain-on-exit off`,
# set in tmux/cf.tmux.conf and tmux's own default). "The pane is the truth" applies to
# whether a session exists at all, not only to what it is doing.
#
# A SETTLE, NOT A RETRY. The thing being looked for is a session that dies on its own, so
# the check has to happen AFTER the death would have happened. Any poll-until-present
# loop would report the doomed session as healthy on its first tick — it would paper over
# precisely the failure this exists to catch. 0.5s is the same order as bin/fleet-answer
# and fleet-pause use for tmux to settle, and it costs a successful spawn half a second
# against a worktree create and a dependency install; a slow spawn is slow because the
# AGENT boots slowly, and the session exists from the first instant either way.
session_live() {                   # is $sid still a session on this fleet?
  # BY SESSION ID, AND WITHOUT `-t`. A session NAME can be tmux TARGET SYNTAX — a leading
  # `+` is the expression "the next session", so `has-session -t '=+foo'` answers yes
  # about a session that is not ours, and WHICH one it answers about is version-dependent
  # (see CLAUDE.md). Every `-t` is a resolution and can therefore lie. Comparing the ids
  # that `list-sessions -F` prints is the only form that cannot: `$N` is assigned by tmux,
  # is unique for the life of the server, and is not an expression. Do not "simplify"
  # this to has-session.
  local s
  while IFS= read -r s; do [ "$s" = "$sid" ] && return 0; done < <(
    tmux -L "$SOCK" list-sessions -F '#{session_id}' 2>/dev/null)
  return 1
}
#   ACTION BEFORE RATIONALE, and short lines. fleet-grid.mjs's new-worktree form shows
# only the OPENING lines of a refusal (spawnFailLines, added in #64) in a fixed-height
# block, so a message that spends six lines explaining itself before it says what to do is
# a message whose advice that form throws away. Headline, cause, what to run, what is on
# disk — then the reasoning, which is the part that can afford to be cut.
spawn_failed() {                   # <headline> <cause> [<hint>] — and NAME what is on disk
  { echo "fleet-spawn: $1"
    echo "  $2"
    [ -n "${3:-}" ] && echo "  $3"
    echo "  Nothing was removed. Re-run against the same tree once that is fixed:"
    echo "      fleet-spawn $NAME --reuse $(basename "$WT")"
    echo "  Still on disk:  worktree  $WT"
    echo "                  branch    $BRANCH${SLOT:+  ·  slot $SLOT}"
    echo
    echo "  Not cleaned up on purpose: .ghostfleet/post-create has already run in there,"
    echo "  and what it provisions (a scoped secret, a seeded database, a per-slot bucket)"
    echo "  is not all inside the repo — removing the tree could destroy state that is not"
    echo "  ours to reclaim, and the slot is claimed per worktree path so a --reuse keeps"
    echo "  it. fleet-clean is the command that decides that, not this one.${SLOT:+
  Give the slot back by hand with: fleet-slot release \"$WT\"}"
    echo "  Other things that make a pane come straight back: agent-here not on PATH"
    echo "  (./install.sh), or a staged runtime caught half-synced (cf-sync)."; } >&2
  exit 1
}
[ -n "$sid" ] || spawn_failed \
  "tmux would not start session '$name' on fleet $SOCK — nothing is running in that worktree." \
  "tmux said why on the line above this one."
sleep 0.5
# THE AGENT BINARY FIRST, because that is what it has actually been. Measured on
# a live fleet: a claude-code package update left bin/ holding only a WINDOWS claude.exe
# for ~20 minutes, so every spawn in that window died on "cannot execute binary file" —
# tmux made the session, the exec failed, the session went. docs/OPERATIONS.md ("Updating
# Claude Code under a fleet") already documents the neighbouring case, an exec landing on
# the ~300MB file while the updater is still writing it. The window is real, it is short,
# and before this check every spawn inside it reported success.
session_live || spawn_failed \
  "session '$name' ($sid) on fleet $SOCK exited the instant it started." \
  "Its pane ran 'agent-here' and that came straight back — the agent binary could not exec." \
  "Check that first: '$( [ "$AGENT" = claude ] && echo claude || echo "$AGENT" ) --version'. A package update mid-install leaves one that cannot run."

echo "fleet-spawn: started '$name' in $WT (branch $BRANCH)${AGENT:+ [agent: $AGENT]}"

# record what this worktree is for, so fleet-worktrees (and a lead that restarted
# and lost its memory) can see intent without guessing. Keyed by worktree path.
#   AFTER the session is confirmed, not before: a manifest row is a claim that this
# worktree is being worked on, and one naming a session that never existed sends the next
# lead looking for a worker that is not there.
MANIFEST="${CLAUDE_FLEET_DIR:-$CFG_DIR/fleet}/$SOCK.manifest.tsv"
mkdir -p "$(dirname "$MANIFEST")" 2>/dev/null
task="${PROMPT:--}"; task="$(printf '%s' "$task" | tr '\n\r\t' '   ' | cut -c1-200)"
mtmp="$MANIFEST.$$.tmp"
{ [ -f "$MANIFEST" ] && awk -F'\t' -v w="$WT" '$1!=w' "$MANIFEST"
  printf '%s\t%s\t%s\t%s\n' "$WT" "$name" "$BRANCH" "$task"; } >"$mtmp" 2>/dev/null \
  && mv -f "$mtmp" "$MANIFEST" 2>/dev/null || rm -f "$mtmp" 2>/dev/null
#
# FOUR COLUMNS, and the fifth and sixth are not ours to write. fleet-ack appends what the
# WORKER understood and which of the decisions it is working from; a row written here
# claims only what was ASKED, and a spawn that has not been acknowledged yet must be
# indistinguishable from one whose worker has not read the brief — because it is. The
# same replacement is why a re-dispatch into a reused worktree clears an older ack rather
# than carrying it forward: an acknowledgement belongs to the ask it acknowledged, and a
# stale one shown beside a new brief is exactly the "looks disciplined, reports the wrong
# state" failure this pair of features exists to make visible.

# ── the brief counter: so the bypass rate is measurable later ────────────────
# Nothing above blocks, so every warning IS a bypass — which makes the warned count
# meaningless on its own. Every prompted spawn gets a row, warned or not, so there is a
# denominator:
#
#     awk -F'\t' '$4=="no"||$5>1{w++}{n++}END{print w"/"n}' ~/.claude/fleet/*.brief.tsv
#
# HERE and not where the warning printed, for the same reason the manifest row is written
# here: a row is a claim that a dispatch happened, and one recorded for a spawn that died
# on a missing agent binary would corrupt that denominator.
#
# NEVER THE BODY — verdict, length and a short digest only, the boundary the dispatch log
# already keeps. The digest tells one brief from another and spots a re-send of the same
# one; it carries none of what was said. Appended rather than rewritten: this file is a
# measurement series, and a rewrite is how a series quietly loses the rows that would
# have contradicted it.
if [ -n "$PROMPT" ]; then
  BRIEFLOG="${CLAUDE_FLEET_DIR:-$CFG_DIR/fleet}/$SOCK.brief.tsv"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%s)" "$WT" "$name" "$BRIEF_DONE" "${BRIEF_ITEMS:-0}" \
    "$(printf '%s' "$PROMPT" | wc -c | tr -d ' ')" \
    "$(printf '%s' "$PROMPT" | brief_digest)" >>"$BRIEFLOG" 2>/dev/null
fi

# optional initial prompt — dispatch once the worker's Claude is actually READY for
# input, NOT after a fixed delay: v2.1 boot can take a minute+, and a prompt sent
# before the input box exists is silently dropped (the worker then just sits idle).
# Poll the pane for the input prompt / status bar, then fleet-send. Background so the
# lead isn't blocked; falls back to sending after ~3min if no marker ever appears.
#
# The "ready" marker is per-agent: claude's input box looks nothing like opencode's,
# so a hardcoded claude pattern would never match a non-claude pane and every worker
# would wait the full fallback before its prompt landed. An agent with NO known ready
# marker (an unverified adapter) skips straight to the timed fallback rather than
# polling for a pattern that can't appear.
if [ -n "$PROMPT" ]; then
  READY_RE='❯|bypass permissions|for shortcuts'
  if [ "$AGENT" != claude ] && command -v fleet-agent >/dev/null 2>&1; then
    READY_RE="$(fleet-agent field "$AGENT" ready_re 2>/dev/null)"
  fi
  nohup bash -c '
    sock="$1"; name="$2"; msg="$3"; re="$4"
    if [ -n "$re" ]; then
      for _ in $(seq 1 90); do
        tmux -L "$sock" capture-pane -p -t "$name" 2>/dev/null | grep -qE "$re" && break
        sleep 2
      done
    else
      sleep 15                      # no ready marker for this agent — best effort
    fi
    sleep 1
    fleet-send -s "$sock" "$name" "$msg"
  ' _ "$SOCK" "$name" "$DISPATCH_PROMPT" "$READY_RE" >/dev/null 2>&1 &
  echo "fleet-spawn: will dispatch the initial prompt once '$name' is ready for input"
fi
