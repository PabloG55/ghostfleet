#!/usr/bin/env bash
# fleet-agent — the AGENT ADAPTER: the one place that knows how each coding CLI
# launches, what its pane looks like while it works, and which fleet signals it
# can actually supply.
#
# An "agent" is a per-session axis orthogonal to the PROFILE axis: profile answers
# *whose account*, agent answers *which CLI*. Default is claude, and every claude
# value below is transcribed VERBATIM from the pre-adapter code so the default path
# is byte-identical — see the regex note above the table.
#
#   fleet-agent list                       every known agent
#   fleet-agent installed                  ...whose binary is actually on PATH
#   fleet-agent field <agent> <field>      one field (see FIELDS)
#   fleet-agent of <session> [-s sock]     the agent a live session is running
#   fleet-agent set <session> <agent>      record it (fleet-spawn does this)
#   fleet-agent forget <session>           drop the marker (session killed)
#   fleet-agent busy <session> [-s sock]   0 = working, 1 = not, 2 = can't tell
#   fleet-agent blocked <session>          0 = waiting on a human
#
# FIELDS
#   bin         executable that must exist on PATH for this agent to be usable
#   launcher    the <agent>-here script that starts/resumes it in a fleet pane
#   busy_re     POSIX ERE (grep -E) matching "generating" in a captured pane.
#               EMPTY means "no validated detector" — callers must report UNKNOWN,
#               never idle, and never feed an empty pattern to grep (it matches
#               every line, which would read as permanently busy).
#   busy_re_js  the same signal as a JavaScript regex source, for fleet-grid.mjs.
#               Two spellings exist because grep ERE and JS regex are different
#               dialects and the pre-adapter code already had both; they must always
#               express the SAME signal.
#   blocked_re  ERE matching "stopped, waiting on a human" in the pane. Empty = none.
#   ready_re    ERE matching "the input box exists, a prompt will land" — fleet-spawn
#               waits for this before dispatching an initial prompt.
#   hooks       yes = pushes need-you/done into the fleet event file by itself
#   mcp         yes = the ghostfleet MCP server is registered for this CLI, so a session
#               can CALL fleet_spawn/fleet_inbox/… as a tool instead of shelling out
#   skill       yes = it also gets skill/ghostfleet-orchestrate, i.e. the INSTRUCTIONS for
#               using those tools. Separate from `mcp` on purpose: since 2026-08-27 codex
#               and opencode have the tools and neither has the skill, so a caveat composed
#               from `mcp` alone would say nothing is missing when something is
#   mcp_self    yes = a tool call with NO `project` argument resolves THIS session's own
#               fleet. That needs the session's CLAUDE_FLEET_SOCK to reach the MCP server,
#               which is the agent's choice and not ours: measured 2026-08-27, opencode
#               passes its environment to the server and codex scrubs it. A third field
#               rather than a footnote on `mcp`, because "can call the tools" and "knows
#               which fleet it is in" are different capabilities and codex has only the
#               first — see the caveat
#   limit_re    ERE matching "this account is spent until the window rolls over".
#               Empty/absent = this agent has no such signal. NEVER sufficient on its
#               own — the caller must also see the session's own usage figure at 100%+,
#               because a pane that merely QUOTES the notice looks identical otherwise.
#   limit_re_js the same signal as a JavaScript regex source, for fleet-grid.mjs.
#   budget      yes = its pane carries the shared-account usage % the governor meters
#   resume      yes = re-opening a session continues that cwd's conversation
#   verified    yes = the values above were checked against a running binary
#
# See docs/multi-agent-sessions.md for the captures these were derived from.
set -uo pipefail

DEFAULT_AGENT=claude

# ── the table ────────────────────────────────────────────────────────────────
# claude: verbatim from bin/claude-here, bin/fleet-{send,worktrees,spawn} and
# fleet-grid.mjs BUSY_RE as they stood before the adapter existed.
#
# opencode: measured 2026-08-01 against OpenCode 1.18.11. Its busy token is
# "esc interrupt" — NOT claude's "esc to interrupt" — so claude's regex matches an
# opencode pane never, which is the silent always-idle failure this table exists to
# prevent. Verified in both directions: present while generating, absent when idle
# AND absent while blocked on a permission prompt (so blocked isn't masked as busy).
# Do NOT add an elapsed-time alternative: opencode prints "· 22.1s" AFTER a turn
# ends, the opposite of claude, where the timer means live.
#
# codex: measured 2026-08-01 against codex-cli 0.146.0, authenticated, in a real
# fleet pane. It was briefly unmeasurable — XProtect quarantined the npm build's
# unnotarized vendored binary — and the fields sat EMPTY rather than guessed for
# exactly as long as that lasted. The one field still short of the others is
# blocked_re, which covers the trust dialog but not command approval; the fleet
# bypasses approvals, so that prompt has never been observed to capture.
agent_field() {
  local a="$1" f="$2"
  case "$a" in
    claude)
      case "$f" in
        bin)        printf 'claude' ;;
        launcher)   printf 'claude-here' ;;
        # The spinner line is COMPOSED TO FIT the pane, and the elapsed-time counter
        # is the first thing dropped. Measured at 56 columns (a stack pane) against a
        # real thinking session: 120 consecutive samples over 60s all read
        #   "✳ Flowing… (almost done thinking with xhigh effort)"
        # — no "(NNs", no "↓ N tokens", no "esc to interrupt". All three of the old
        # alternatives were width-dependent, so a narrow pane read IDLE for a full
        # minute while the agent was thinking. Also seen: "… (still thinking with
        # xhigh effort)" at 50 cols and a bare "… (thinking)" at 30.
        #
        # What survives every width is the SHAPE: a gerund, an ellipsis, an open
        # paren — "Cooking… (", "Gusting… (", "Flowing… (". A finished turn is
        # "✻ Cooked for 6s", with no ellipsis, so the two stay distinguishable.
        # Don't anchor on the spinner glyph: it renders as "·" often enough to matter.
        #
        # The leading [A-Za-z] is DEFENCE IN DEPTH, and deliberately not claimed as a
        # tested behaviour. Narrow panes are full of truncation ellipses, so requiring a
        # letter in front rules out "| w1 | …" and "/…/path". But across 174 real frames
        # at widths 30–240 the ONLY thing an ellipsis was ever followed by "(" in was a
        # gerund, so dropping the letter changes no verdict in the corpus and no fixture
        # can prove it. Kept because the asymmetry is worth it — a false busy strands a
        # worker the lead then won't dispatch to — not because a test covers it.
        #
        # ANCHORED TO THE LINE START, and the ↓-tokens / esc-to-interrupt alternatives
        # are gone. Unanchored, the pattern also matched an agent WRITING ABOUT a
        # spinner — a report, a doc, a pasted capture — and those strings are
        # byte-identical to the real thing, so nothing about the text can separate
        # them. A worker that had just documented this detector sat on the grid as
        # "working" for 17 minutes after it finished. Position is the only signal
        # left: a live spinner OWNS its line, starting at the glyph; prose about one
        # always has something in front ("56  ✳ Flowing… (…)", "+ columns `✻ …`").
        # Scoping to the last N lines was tried first and is wrong — queued messages
        # sit BELOW the spinner and are unbounded, so it re-blinds the narrow pane
        # this regex was widened to fix.
        # The dropped alternatives were redundant: both live inside the parens of the
        # gerund line at wide widths, and both real busy fixtures still fire without
        # them. Verified on every live pane across six fleets: fires on the one
        # genuinely working session, silent on the other eleven.
        # SECOND BRANCH — a running SUBAGENT replaces the one-word spinner with the
        # agent's own description: "+ Adding the operator-key auth provider… (10m 15s ·
        # ↓ 32.8k tokens)". A PHRASE, so `[A-Za-z]+…` could not see it and a session
        # with a 10-minute agent under it sat on the grid as "✓ ready" — the worst
        # possible lie, since ready means "done, come look".
        #   It is a separate branch, not a widening of the first, because a phrase is
        # exactly what prose looks like: allowing spaces before the ellipsis in the
        # ORIGINAL branch re-opens the false positive that anchoring was added to close.
        #   IT ALSO REQUIRES THE LEADING GLYPH, which branch one leaves optional. Every
        # real spinner and subagent line ever captured here carries one (✻ ✽ ✳ ✢ · +);
        # prose starts with a letter. That single character is what separates "Extracting
        # DV's review surface… (7m 32s · …)" from "Some prose that mentions Flowing… (18s)",
        # and no character class can.
        #   AND ITS PARENTHETICAL MUST CLOSE AT END OF LINE. A live spinner's "(12s · ↓ 3k
        # tokens)" is the last thing on its line; prose quoting one keeps talking after the
        # ")". This is the branch's real defence, and it had to become so because the
        # obvious one does not survive a terminal: backticks and quotes are RENDERED as
        # styling and never reach capture-pane, so "`- The spinner reads Flowing… (18s)` —
        # does fire" arrives with its backticks stripped and looked exactly like a spinner.
        # Measured on a live pane: that line matched, the session read "working" for the
        # rest of its life, and it was a message ABOUT this detector — the same way the
        # anchor had to be added in the first place. The class below still excludes ` and "
        # because they cost nothing when they DO survive (a fenced block), but nothing may
        # depend on them.
        #   The class is "anything but ( ` and "" rather than a list of allowed letters.
        # An allow-list was tried and had to be widened twice in a day — first for the
        # hyphen in "Razzle-dazzling", then for the apostrophe in "Extracting DV's review
        # surface" — because these strings are model-written prose and will contain any
        # punctuation at all. The three exclusions are structural, not cosmetic: "(" would
        # let the phrase swallow the very clock this branch requires, and a backtick or
        # quote is how PROSE quotes a spinner, which is the false positive anchoring was
        # added to close (measured: allowing them makes "> quoting `✻ Baking… (2m 1s)`"
        # fire).
        # So this branch pays for its spaces by demanding the elapsed clock right after
        # ("… (10m" / "… (42s"), which prose only carries if it quotes a whole live
        # line verbatim AND starts it at the margin. The first branch keeps its loose
        # "(", because a narrow pane drops the clock and that must still fire.
        busy_re)    printf '%s' '^[[:space:]]*[^[:alnum:][:space:]]?[[:space:]]*[A-Za-z]+(…|\.\.\.) ?\(|^[[:space:]]*[^[:alnum:][:space:]][[:space:]]*[A-Za-z]+[^(`"]*(…|\.\.\.) \([0-9]+[ms][^)]*\)[[:space:]]*$' ;;
        busy_re_js) printf '%s' '^\s*[^A-Za-z0-9\s]?\s*[A-Za-z]+(?:…|\.\.\.)\s?\(|^\s*[^A-Za-z0-9\s]\s*[A-Za-z]+[^(`"]*(?:…|\.\.\.) \(\d+[ms][^)]*\)\s*$' ;;
        blocked_re) printf '' ;;   # need-you arrives via hooks, not the pane
        ready_re)   printf '%s' '❯|bypass permissions|for shortcuts' ;;
        # THE ACCOUNT IS SPENT. Claude prints this and then does nothing until the window
        # rolls over, but the pane still shows an input box — so every ready_re matches
        # and the card says "✓ ready" over a session that cannot take a single prompt.
        # Five of them read as a healthy fleet.
        #   THE TEXT ALONE IS NOT THE SIGNAL. Measured on two real panes: a limited
        # worker carries this line, and so does a session that merely QUOTED it — and the
        # quote arrives with the same "⎿ " tool-result marker, because reading a limited
        # pane with capture-pane renders its output as a tool result. Anchoring on the
        # glyph would have called the reader limited too. The caller pairs this with the
        # session's OWN 5h figure (>=100%), which is machine-painted per session and is
        # the part prose cannot forge: really-limited read 102%, the quoter 15%.
        limit_re)    printf '%s' "You've hit your (session|usage) limit" ;;
        limit_re_js) printf '%s' "You've hit your (?:session|usage) limit" ;;
        # A turn cut short — "Interrupted · What should Claude do instead?" — leaves the
        # session waiting on a human with an ordinary empty input box, so it read as
        # "✓ ready" while doing nothing. A park interrupts a turn, so a governor episode
        # produces these in bulk.
        #   ANCHORED TO THE INDENT, and that is the whole discriminator. Claude renders
        # its own result marker at exactly two columns; the same sentence QUOTED inside a
        # command's output lands deeper (measured: 4-5). Without the anchor, a session
        # that so much as greps for this string marks itself interrupted — verified
        # against the session that was writing this code, which does exactly that.
        #   `.*` spans the gap after ⎿ because it is a NO-BREAK space (U+00A0), not the
        # ordinary one it looks like; a literal " " here matches nothing at all.
        interrupt_re)    printf '%s' '^  ⎿.*Interrupted' ;;
        interrupt_re_js) printf '%s' '^  ⎿.*Interrupted' ;;
        hooks)      printf 'yes' ;;
        # Can this agent CALL the fleet — fleet_spawn, fleet_inbox, fleet_send — rather
        # than only be watched by it? Measured 2026-08-26, not assumed: install.sh's
        # register_mcp() writes ghostfleet into every profile's .claude.json, and
        # `jq .mcpServers.ghostfleet` finds it in ~/.claude and ~/.claude-personal on this
        # machine. All three agents say yes since 2026-08-27; what is still Claude-only is
        # the skill below.
        mcp)        printf 'yes' ;;
        # The orchestrate skill is symlinked into <profile>/skills/ by the same function.
        # A Claude Code feature, and the reason the other two say no even now that they
        # have the tools.
        skill)      printf 'yes' ;;
        mcp_self)   printf 'yes' ;;   # the server is the session's own child and inherits everything
        budget)     printf 'yes' ;;
        resume)     printf 'yes' ;;
        verified)   printf 'yes' ;;
        *) return 1 ;;
      esac ;;
    opencode)
      case "$f" in
        bin)        printf 'opencode' ;;
        launcher)   printf 'opencode-here' ;;
        busy_re)    printf '%s' 'esc interrupt' ;;
        busy_re_js) printf '%s' 'esc interrupt' ;;
        blocked_re) printf '%s' 'Permission required|Allow once' ;;
        ready_re)   printf '%s' 'ctrl\+p commands|OpenCode [0-9]' ;;
        hooks)      printf 'yes' ;;   # permission.asked -> need-you, session.idle -> done
        # YES since 2026-08-27: install.sh writes the server into
        # ~/.config/opencode/opencode.jsonc (with jq, not via `opencode mcp add` — see the
        # comment on register_opencode_mcp for the two ways that CLI writes somewhere
        # else). Measured by calling a tool, not by reading a list.
        #   With hooks=yes as well, opencode is the one non-claude agent at near parity:
        # it both sees the fleet and can drive it. What it still lacks is the skill.
        mcp)        printf 'yes' ;;
        skill)      printf 'no'  ;;   # ghostfleet-orchestrate is a Claude Code skill
        # YES, measured by CALLING it: `opencode run` with CLAUDE_FLEET_SOCK exported
        # answered fleet_list with no arguments, listed the live fleet, and marked the
        # calling session "(you)". So opencode hands the MCP server its own environment and
        # the server resolves the fleet exactly as it does under Claude.
        mcp_self)   printf 'yes' ;;
        budget)     printf 'no'  ;;   # "13.8K (7%)" is CONTEXT, not the 5h account window
        resume)     printf 'yes' ;;   # --continue is cwd-scoped (verified both ways)
        verified)   printf 'yes' ;;
        *) return 1 ;;
      esac ;;
    codex)
      # Measured against codex-cli 0.146.0 (the notarized cask build) on 2026-08-01,
      # authenticated, in a real fleet pane. Previously all-empty because the binary
      # could not be run at all — XProtect had quarantined the npm build's vendored
      # binary, which is unnotarized; the cask's is signed by OpenAI and is not.
      case "$f" in
        bin)        printf 'codex' ;;
        launcher)   printf 'codex-here' ;;
        # "• Working (1s • esc to interrupt)" — the counter ticks, so anchor on the
        # "Working (<n>s" shape rather than the bare interrupt hint, which could also
        # appear in output text. Confirmed absent from the idle pane (0 matches).
        busy_re)    printf '%s' 'Working \([0-9]+[ms][^)]*esc to interrupt' ;;
        busy_re_js) printf '%s' 'Working \(\d+[ms][^)]*esc to interrupt' ;;
        # The directory-trust dialog. This is a PARTIAL detector: it's the blocker a
        # fleet worker actually hits (every fresh worktree), but codex's command
        # approval prompts were not observed, because the fleet runs with approvals
        # bypassed. Do not read a non-match as "definitely not blocked".
        blocked_re) printf '%s' 'Do you trust the contents of this directory' ;;
        # The composer footer ("gpt-5.5 medium · ~/work/repo"). Deliberately NOT the
        # "›" input marker: that also renders on the trust dialog's menu, and a false
        # ready would make fleet-spawn fire its prompt into that dialog and lose it.
        #
        # `[~/]` because codex abbreviates $HOME to "~", so a worktree under $HOME
        # prints "· ~/..." and one outside prints "· /...". This was first written as
        # "· /" and passed its test only because the test worktree sat in /private/tmp;
        # every REAL worktree lives under $HOME, so it never matched in practice and
        # fleet-spawn silently fell back to its timed send.
        ready_re)   printf '%s' '· [~/]' ;;
        hooks)      printf 'no'  ;;
        # YES since 2026-08-27: install.sh runs `codex mcp add ghostfleet -- node <server>`,
        # which writes [mcp_servers.ghostfleet] into ~/.codex/config.toml. Proven by CALLING
        # fleet_list from a real codex session in a scratch fleet, not by reading
        # `codex mcp list` — a registration that lists and cannot be called is a feature
        # that did not ship.
        #   THIS DOES NOT GIVE IT HOOKS, and the two are easy to conflate: MCP is tools,
        # hooks are push events. codex still writes no inbox row and wakes no master, so it
        # remains the most degraded of the three — it can now drive the fleet while the
        # fleet still cannot be told anything by it. See the `caveat` command.
        mcp)        printf 'yes' ;;
        skill)      printf 'no'  ;;   # ghostfleet-orchestrate is a Claude Code skill
        # NO, and this is the half of the wiring that did NOT work — found by calling the
        # tool rather than by reading `codex mcp list`, which says "enabled" either way.
        # codex launches an MCP server with a SCRUBBED environment: a real session with
        # CLAUDE_FLEET_SOCK=cf-mcptest exported called fleet_list, and the server's child
        # answered `fleet-list: no socket (run inside a fleet session, or pass -s <socket>)`.
        # `-c shell_environment_policy.inherit=all` does not change it — that policy governs
        # its shell tool, not its MCP children.
        #   So a codex session must NAME the project: fleet_list(project: "ghostfleet")
        # returned the live fleet in the same test, because fleet-dispatch then builds the
        # child's env from the projects file instead of inheriting one. Everything except
        # "my own fleet" works; fleet_send's reply_to needs a self too, so it stays out.
        mcp_self)   printf 'no'  ;;
        budget)     printf 'no'  ;;
        # NO, and the reason is subtle enough to write down. `codex resume --last` IS
        # cwd-scoped and works — verified both directions plus the empty case, using
        # `codex exec`. But the TUI only persists its rollout on a clean exit: kill the
        # pane (SIGHUP) and nothing reaches ~/.codex/sessions, so there is nothing left
        # to resume. Killing panes is precisely how the fleet recycles a session, so the
        # case resume exists for is the case it doesn't survive. Verified: a codeword
        # planted in a TUI pane, pane killed, session re-opened -> "unknown", and the
        # word appears in no rollout file. Flip this the day the TUI flushes on SIGHUP.
        resume)     printf 'no'  ;;
        verified)   printf 'yes' ;;
        *) return 1 ;;
      esac ;;
    *) return 1 ;;
  esac
}
KNOWN_AGENTS="claude opencode codex"

is_agent() { case " $KNOWN_AGENTS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# ── per-session agent marker ─────────────────────────────────────────────────
# <sock>.<session>.agent, matching the existing .parked/.sched/.notify-lead markers.
# Socket-namespaced for the same reason they are: EVERY project has a session called
# 'master', so a bare name would collide across fleets sharing one profile's dir.
# ABSENT = claude. That's what keeps every pre-existing session, and every session
# created by a path that doesn't know about agents, on the default.
FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"
SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer the LIVE tmux server over the env var, same drift-proofing the rest of the
# fleet uses: a long-running --resume/--fork session can hold a stale
# CLAUDE_FLEET_SOCK from an earlier context.
#
# But `-s` (parsed below, last) must still win, and callers MUST use it when they
# know the target fleet. fleet-spawn routes a worker to its owning project's socket,
# which is frequently NOT the socket the lead is sitting in — resolving from $TMUX
# there would file the marker under the caller's fleet and the worker would come back
# as plain claude. Same failure the repo already documents for status files: a
# session's state has to be scoped by ITS fleet socket, not the observer's.
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac

marker() { printf '%s/%s.%s.agent' "$FLEET_DIR" "$SOCK" "$1"; }

agent_of() {                       # session -> agent name (default claude)
  local a=""
  a="$(cat "$(marker "$1")" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$a" ] && is_agent "$a"; then printf '%s' "$a"; else printf '%s' "$DEFAULT_AGENT"; fi
}

pane() { tmux -L "$SOCK" capture-pane -p -t "$1" 2>/dev/null; }

# 0 = busy, 1 = idle, 2 = UNKNOWN (agent has no validated detector).
# The empty-pattern guard is the whole point: `grep -qE ""` matches every line, so an
# agent with no regex would read as permanently busy instead of honestly unknown.
agent_busy() {
  local s="$1" re=""
  re="$(agent_field "$(agent_of "$s")" busy_re)" || return 2
  [ -n "$re" ] || return 2
  pane "$s" | grep -qE "$re" && return 0 || return 1
}
agent_blocked() {
  local s="$1" re=""
  re="$(agent_field "$(agent_of "$s")" blocked_re)" || return 2
  [ -n "$re" ] || return 2
  pane "$s" | grep -qE "$re" && return 0 || return 1
}

cmd="${1:-}"; shift 2>/dev/null || true
# -s <sock> is accepted ANYWHERE after the subcommand, not just immediately after it.
# Only accepting it in one position is a silent-failure trap: `fleet-agent of <sess>
# -s <sock>` reads naturally, would parse as a positional, and the socket would fall
# back to $TMUX — giving a confidently wrong answer instead of an error.
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -s) SOCK="${2:-}"; shift 2 ;;
    *)  ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

case "$cmd" in
  list)      printf '%s\n' $KNOWN_AGENTS ;;
  installed)
    for a in $KNOWN_AGENTS; do
      command -v "$(agent_field "$a" bin)" >/dev/null 2>&1 && printf '%s\n' "$a"
    done ;;
  # WHAT A UI HAS TO WARN ABOUT, in one place because there are now three UIs that must
  # say the same thing (the phone's add-project sheet, the phone's project settings, and
  # the TUI's `,` page). COMPOSED from the capability fields rather than written out per
  # agent, so a fourth agent gets its warning from declaring `hooks` and `mcp` — the same
  # reason `list` exists instead of every caller spelling the three names.
  #   Empty output = nothing is lost. Callers test for empty, not for a word.
  caveat)
    a="${1:?fleet-agent: usage: fleet-agent caveat <agent>}"
    is_agent "$a" || { echo "fleet-agent: unknown agent '$a'" >&2; exit 1; }
    out=""
    [ "$(agent_field "$a" hooks)" = yes ] || \
      out="no fleet events: status is guessed from its pane, and a question it asks may never reach the inbox"
    # SHRUNK, NOT DELETED, on 2026-08-27. This clause used to read "no fleet_* tools: it
    # cannot spawn or answer siblings from a tool call" for codex and opencode, and that
    # became false the moment install.sh registered the MCP server for both — a warning
    # that is no longer true is worse than none, because the next one is believed less.
    # What survives is the half that is still true: they got the TOOLS, not the
    # INSTRUCTIONS, so nothing tells the session the fleet exists or when to look at it.
    [ "$(agent_field "$a" mcp)" = yes ] || \
      out="${out:+$out. }no fleet_* tools: it cannot spawn or answer siblings from a tool call, only by running fleet-* in its own shell"
    [ "$(agent_field "$a" mcp_self)" = yes ] || \
      out="${out:+$out. }fleet_* tools must name the project: it starts the MCP server without the session's environment, so a call with no project cannot tell which fleet it is in"
    [ "$(agent_field "$a" skill)" = yes ] || \
      out="${out:+$out. }no orchestrate skill: it has the fleet_* tools but not the instructions, so it will not drain the inbox or dispatch siblings unless you tell it to"
    [ "$(agent_field "$a" resume)" = yes ] || \
      out="${out:+$out. }no resume: recycling its pane loses the conversation"
    printf '%s' "$out" ;;
  field)
    a="${1:?fleet-agent: usage: fleet-agent field <agent> <field>}"
    f="${2:?fleet-agent: usage: fleet-agent field <agent> <field>}"
    agent_field "$a" "$f" || { echo "fleet-agent: unknown agent/field: $a/$f" >&2; exit 1; } ;;
  of)        agent_of "${1:?fleet-agent: usage: fleet-agent of <session>}" ;;
  set)
    s="${1:?fleet-agent: usage: fleet-agent set <session> <agent>}"
    a="${2:?fleet-agent: usage: fleet-agent set <session> <agent>}"
    is_agent "$a" || { echo "fleet-agent: unknown agent '$a' (known: $KNOWN_AGENTS)" >&2; exit 1; }
    [ -n "$SOCK" ] || { echo "fleet-agent: no socket — cannot namespace the marker" >&2; exit 1; }
    mkdir -p "$FLEET_DIR" 2>/dev/null
    # claude is the default and the absence of a marker already means claude; writing
    # one anyway keeps `fleet-agent of` honest if the default ever changes.
    printf '%s\n' "$a" > "$(marker "$s")" 2>/dev/null ;;
  forget)    rm -f "$(marker "${1:?fleet-agent: usage: fleet-agent forget <session>}")" 2>/dev/null ;;
  busy)      agent_busy "${1:?fleet-agent: usage: fleet-agent busy <session>}"; exit $? ;;
  blocked)   agent_blocked "${1:?fleet-agent: usage: fleet-agent blocked <session>}"; exit $? ;;
  ""|-h|--help|help)
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "fleet-agent: unknown command '$cmd' (try: fleet-agent --help)" >&2; exit 1 ;;
esac
