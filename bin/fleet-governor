#!/usr/bin/env bash
# fleet-governor [-s SOCKET] [options]
#
# Budget backpressure for a SINGLE-ACCOUNT fleet. Every worker + the lead drink
# from one usage pool, so wide fan-out drains it N x faster and all workers freeze
# at the ceiling together. This governor is a DUMB, non-Claude loop (zero Claude
# budget) ON PURPOSE: the lead runs on the same account and stalls too, so metering
# can't depend on it.
#
# Policy: let every worker run FULL TILT — no early throttling. Only step in at the
# ceiling: at/above --pause-at (default 98%) it NOTIFIES you and parks ALL workers
# at once; when the window recovers below --resume (default 90%) it resumes the ones
# IT parked (never a worker you paused by hand).
#
# TWO CEILINGS, AND THE MACHINE ONE GOES FIRST. Tokens are not the only shared pool a
# wide fan-out drains: every worker runs tests on ONE laptop. On 2026-08-27 a fleet on
# this box put 358 node processes and 269 GB of requested RSS against 64 GB of RAM; the
# OOM killer then fought launchd for 80 minutes, the process table filled to its
# 16,000 cap, fork() began failing system-wide, and the machine had to be power-cycled.
# Running out of budget stalls the fleet; running out of MACHINE takes the box with it,
# so the resource ceiling is checked first and overrides.
#
# It reads the same signals that failed that day, and unlike the budget figure both are
# LIVE KERNEL COUNTERS rather than something scraped off a pane — so there is no fossil
# problem here, no blind-pane problem, and no need to distrust a reading:
#   - kern.memorystatus_vm_pressure_level  1 normal / 2 warning / 4 critical. This is
#     the very signal whose escalation preceded the jetsam cascade.
#   - ps ax vs kern.maxproc                the process table that actually wedged it.
#
#   -s SOCKET      fleet socket (default: $CLAUDE_FLEET_SOCK)
#   --pause-at P   notify + park ALL workers at/above this 5h usage % (default 98)
#   --resume P     resume governor-parked workers below this % (default 90)
#   --interval N   seconds between ticks (default 60)
#   --confirm N    at the ceiling, re-read after N seconds and only park if it HOLDS
#                  (default 20; 0 parks on the first reading). The status bar's figure
#                  is not live — after an account/team switch every pane keeps
#                  reporting the OLD window until Claude next repaints it.
#   --mem-level L  park when kern.memorystatus_vm_pressure_level reaches L
#                  (1 normal, 2 warning, 4 critical; default 2)
#   --proc-pct P   park when the process table is P% of kern.maxproc (default 60)
#   --no-resource  budget ceiling only — do not watch machine resources
#   --once         run one tick and exit (for testing / cron)
#   --dry-run      log decisions, don't actually pause/resume/notify
set -uo pipefail

SOCK="${CLAUDE_FLEET_SOCK:-}"
INTERVAL=60; PAUSE_AT=98; RESUME=90; ONCE=0; DRY=0; CONFIRM=20
MEM_LEVEL=2; PROC_PCT=60; RESOURCE=1
COOLDOWN=900                          # min seconds between macOS "budget" alerts (anti-spam)
while [ $# -gt 0 ]; do
  case "$1" in
    -s)         SOCK="${2:?}"; shift 2 ;;
    --pause-at) PAUSE_AT="${2:?}"; shift 2 ;;
    --resume)   RESUME="${2:?}"; shift 2 ;;
    --interval) INTERVAL="${2:?}"; shift 2 ;;
    --confirm)  CONFIRM="${2:?}";  shift 2 ;;
    --mem-level)  MEM_LEVEL="${2:?}"; shift 2 ;;
    --proc-pct)   PROC_PCT="${2:?}";  shift 2 ;;
    --no-resource) RESOURCE=0; shift ;;
    --once)     ONCE=1; shift ;;
    --dry-run)  DRY=1; shift ;;
    *) echo "fleet-governor: unknown arg $1" >&2; exit 1 ;;
  esac
done
[ -n "$SOCK" ] || { echo "fleet-governor: no socket (run inside a fleet session, or pass -s <socket>)" >&2; exit 1; }

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"      # sibling fleet-pause / fleet-resume
PROJ="${SOCK#cf-}"
log() { echo "[fleet-governor $(date +%H:%M:%S)] $*"; }
INBOX="$FLEET_DIR/$SOCK.inbox"
inbox() { printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$1" "$2" "$3" >> "$INBOX" 2>/dev/null || true; }

LAST_NOTIFY=0
# "let me know" — a debounced macOS notification + the lead's inbox feed
notify() {
  local now msg="$1"; now="$(date +%s)"
  inbox "fleet" budget "$msg"
  [ "$DRY" = 1 ] && return 0
  if [ $(( now - LAST_NOTIFY )) -ge "$COOLDOWN" ]; then
    LAST_NOTIFY="$now"
    # macOS via osascript, Linux via notify-send; silent if neither exists (the event
    # is still in the inbox and the grid, so nothing is lost)
    if command -v osascript >/dev/null 2>&1; then
      ( osascript -e "display notification \"$msg\" with title \"🔔 ghostfleet — $PROJ\" sound name \"Ping\"" >/dev/null 2>&1 & )
    elif command -v notify-send >/dev/null 2>&1; then
      ( notify-send "ghostfleet — $PROJ" "$msg" >/dev/null 2>&1 & )
    elif grep -qi microsoft /proc/version 2>/dev/null && command -v powershell.exe >/dev/null 2>&1; then
      # WSL: notify-send usually has no DBus/X, so raise a Windows toast instead
      ( powershell.exe -NoProfile -Command "[void][System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms'); \$n = New-Object System.Windows.Forms.NotifyIcon; \$n.Icon = [System.Drawing.SystemIcons]::Information; \$n.Visible = \$true; \$n.ShowBalloonTip(5000, 'ghostfleet', '$msg', 'Info')" >/dev/null 2>&1 & )
    fi
  fi
}

# Can this session's agent report the shared-account usage figure at all? Only Claude
# panes carry it. A session running another CLI is UNMETERABLE, and that has to be
# explicit in both directions:
#   - its pane must never be READ for a budget number. The "NN%(" pattern is generic
#     enough to hit some unrelated "(" in another agent's UI, and a stray match would
#     drive the whole fleet's park decision off a number that means nothing.
#   - it must never be PARKED for a Claude reading. It isn't spending that account, so
#     freezing it buys no budget back — it just silently stops work.
# Absent adapter -> treated as claude, which is the pre-adapter behaviour.
# A TAB IS NOT A WORKER. fleet-tab opens terminals and editors as sessions on this very
# socket (_term-* / _edit-*) — deliberately, so they can be addressed by name — but they
# run a shell, not an agent. The default below is PERMISSIVE (unknown agent -> assume
# metered), so without this they would be swept in: the governor would scrape a shell
# prompt for a usage %, find none, and report the fleet as blind — then park your
# terminal to reclaim tokens it never spent.
is_tab() { case "$1" in _term-*|_edit-*) return 0 ;; *) return 1 ;; esac; }

meterable() {
  local a=""
  is_tab "$1" && return 1
  command -v fleet-agent >/dev/null 2>&1 || return 0
  a="$(fleet-agent of "$1" -s "$SOCK" 2>/dev/null)"
  [ -n "$a" ] || return 0
  [ "$(fleet-agent field "$a" budget 2>/dev/null)" = yes ]
}

# The 5h usage % from a pane's status bar: the "NN%(" field. Excludes ctx:NN% (no
# paren after) and 7d:NN%( (colon-prefixed) by requiring a non-colon, non-digit char
# right before the number.
#
# NARROW PANES HAVE NO FIGURE TO SCRAPE. Claude TRUNCATES its status line to the pane
# width, it does not wrap: measured on one session resized through the range, the field
# is present at 100 columns and gone at 90, replaced by an ellipsis
#   100:  ... | Opus 5 (1M context) | ctx:5% | 17%(4h 12…
#    90:  ... | Opus 5 (1M context) | ctx:5% |…
#    50:  pablo@example.com | Example Account | w1 | …
# The stack screen makes ~50-column panes routine (a nested client resizes its target),
# so this is now an ordinary state rather than a curiosity — and a session that has NO
# reading is indistinguishable, from here, from an account at 0%.
pct_of() {
  tmux -L "$SOCK" capture-pane -p -t "$1" 2>/dev/null \
    | grep -oE '[^:0-9][0-9]+%\(' | grep -oE '[0-9]+' | tail -1
}

# A PARK CREATES THE FOSSIL THAT JUSTIFIES THE NEXT PARK. Skipping parked panes is not
# enough: a worker RESUMED a moment ago still shows the figure it was painting when it
# was parked, because a Claude pane only repaints when it does something. So the loop
# closes on itself — everything parked, the only live pane is master reading 46%, resume
# all, the just-resumed panes still say 104%, park all, and round again. Measured in a
# real log: 1,024 park/resume events, one cycle every ~90 seconds, each park cutting a
# turn off mid-flight, so three-wide ran slower than one-wide.
#   The fix is to remember what the pane looked like when we parked it and refuse to
# believe it again until it has actually moved. The whole status LINE is the fingerprint,
# not the number: any repaint at all changes it (the elapsed counter alone is enough),
# while a frozen pane stays byte-identical.
stale_f() { printf '%s/%s.%s.stale' "$FLEET_DIR" "$SOCK" "$1"; }
pct_fingerprint() {
  tmux -L "$SOCK" capture-pane -p -t "$1" 2>/dev/null \
    | grep -E '[^:0-9][0-9]+%\(' | tail -1 | cksum
}
# 0 = this session's figure is the one we parked it on and it has not repainted since.
# Self-clearing: the moment the pane moves, the marker goes and the reading counts again.
is_fossil() {
  local f cur; f="$(stale_f "$1")"
  [ -f "$f" ] || return 1
  cur="$(pct_fingerprint "$1")"
  [ "$cur" = "$(cat "$f" 2>/dev/null)" ] && return 0
  rm -f "$f" 2>/dev/null
  return 1
}
# one shared account -> take the highest reading across all live panes that actually
# report one.
#
# Sets BUDGET_PCT and BUDGET_BLIND rather than echoing, and so must NOT be called in a
# command substitution: that is a subshell, and the assignment would be thrown away
# (the same trap release_gov_parked already documents). BUDGET_BLIND names the metered
# sessions whose pane was too narrow to carry the figure, so "no reading" can say WHY
# instead of looking exactly like a healthy idle fleet.
#
# A PARKED PANE IS A STOPPED CLOCK, so it is skipped. Parking freezes the very pane the
# figure is read from: an idle Claude does not repaint its status bar, so a worker
# parked at 98% still SAYS 98% however long the real window has since recovered. Taking
# the max then makes that fossil the fleet's answer, and the trap closes on itself —
# everything is parked, so nothing can refresh, so the reading never falls, so nothing
# is ever resumed. Measured in a real log: three workers held at "98% — all workers
# parked, holding for recovery" for minutes after the account had actually moved to
# ~17%, and the only way out was flipping ignore-limit by hand. master is never parked,
# so a live reading is always available.
BUDGET_PCT=0
BUDGET_BLIND=""
BUDGET_FROZEN=""
budget() {
  local p="" s="" w=""
  BUDGET_PCT=0; BUDGET_BLIND=""; BUDGET_FROZEN=""
  for s in $(tmux -L "$SOCK" list-sessions -F '#{session_name}' 2>/dev/null); do
    meterable "$s" || continue
    if is_parked "$s"; then BUDGET_FROZEN="$BUDGET_FROZEN $s"; continue; fi
    # ...and a session we resumed that has not repainted yet is the same stopped clock,
    # still showing the number we parked it on. Believing it re-parks it immediately.
    if is_fossil "$s"; then BUDGET_FROZEN="$BUDGET_FROZEN $s(unchanged)"; continue; fi
    p="$(pct_of "$s")"
    if [ -n "$p" ]; then
      [ "$p" -gt "$BUDGET_PCT" ] && BUDGET_PCT="$p"
    else
      w="$(tmux -L "$SOCK" display-message -p -t "$s" '#{window_width}' 2>/dev/null)"
      BUDGET_BLIND="$BUDGET_BLIND $s(${w:-?}c)"
    fi
  done
}
# workers (never the lead), newest first — and only ones that drink from the metered
# account, so the ceiling never parks a worker it isn't measuring
workers_newest_first() {
  local s=""
  tmux -L "$SOCK" list-sessions -F '#{session_created} #{session_name}' 2>/dev/null \
    | grep -vE ' master$' | sort -rn | awk '{print $2}' \
    | while IFS= read -r s; do meterable "$s" && printf '%s\n' "$s"; done
}
is_parked()  { [ -f "$FLEET_DIR/$SOCK.$1.parked" ]; }
gov_parked() { is_parked "$1" && grep -q '^governor' "$FLEET_DIR/$SOCK.$1.parked" 2>/dev/null; }

# THE TWO CEILINGS MUST NOT UN-PARK EACH OTHER. Both write the same .parked file — they
# have to, or is_parked stops seeing the park and the other ceiling parks the worker a
# second time — so the FIRST TOKEN records which ceiling earned it. Matching bare
# '^governor' would make the budget path resume a worker parked for memory the moment
# the token window recovered, handing the machine straight back the load that was
# crushing it. The trailing space is load-bearing: 'governor ' must not match
# 'governor-resource'.
budget_parked() { is_parked "$1" && grep -q '^governor '          "$FLEET_DIR/$SOCK.$1.parked" 2>/dev/null; }
res_parked()    { is_parked "$1" && grep -q '^governor-resource ' "$FLEET_DIR/$SOCK.$1.parked" 2>/dev/null; }

# Resume every worker THIS governor parked (never a hand-paused one). Reports the
# count in $RELEASED — NOT on stdout, because this function also logs there and a
# command substitution would capture the log lines as the "count".
RELEASED=0
#   $2 caps how many to release this pass (empty = all). RECOVERY RELEASES ONE AT A
# TIME. Letting every worker back at once re-creates the exact condition that tripped
# the ceiling — five sessions resumed together were back over it inside a minute, which
# is half of why the park/resume loop sustained itself. One per tick ramps the load and
# lets the next reading actually mean something. The ignore-limit path passes no cap: a
# human flipping "ignore the budget" is asking for all of them back, now.
release_gov_parked() {
  local w cap="${2:-}"
  RELEASED=0
  for w in $(workers_newest_first); do
    [ -n "$cap" ] && [ "$RELEASED" -ge "$cap" ] && break
    if budget_parked "$w"; then
      log "  resume $w"
      if [ "$DRY" != 1 ]; then
        "$BIN_DIR/fleet-resume" -s "$SOCK" "$w" >/dev/null 2>&1
        inbox "$w" resumed "governor: $1"
      fi
      RELEASED=$((RELEASED + 1))
    fi
  done
}

# ── machine resources ────────────────────────────────────────────────────────
# Both readings are LIVE KERNEL COUNTERS, which is what makes this ceiling simpler than
# the budget one: nothing to fingerprint, nothing to distrust, no pane to be too narrow.
# Sets RES_LEVEL / RES_PROCS / RES_PROC_PCT / RES_WHY rather than echoing, for the same
# subshell reason budget() documents.
#
# Absent counters mean UNKNOWN, NOT ZERO, and unknown must never trip the ceiling — a
# governor that parked the fleet because a sysctl was missing would be worse than one
# that never parked it at all. Linux has no kern.maxproc, so pid_max stands in.
RES_LEVEL=1; RES_PROCS=0; RES_PROC_PCT=0; RES_WHY=""
resources() {
  local maxproc=""
  RES_LEVEL=1; RES_PROCS=0; RES_PROC_PCT=0; RES_WHY=""

  # 1 normal / 2 warning / 4 critical — the kernel's own jetsam signal
  RES_LEVEL="$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null)"
  case "$RES_LEVEL" in ''|*[!0-9]*) RES_LEVEL=1 ;; esac

  RES_PROCS="$(ps ax 2>/dev/null | wc -l | tr -d ' ')"
  case "$RES_PROCS" in ''|*[!0-9]*) RES_PROCS=0 ;; esac
  maxproc="$(sysctl -n kern.maxproc 2>/dev/null || cat /proc/sys/kernel/pid_max 2>/dev/null)"
  case "$maxproc" in ''|*[!0-9]*) maxproc=0 ;; esac
  [ "$maxproc" -gt 0 ] && RES_PROC_PCT=$(( RES_PROCS * 100 / maxproc ))

  [ "$RES_LEVEL" -ge "$MEM_LEVEL" ] && RES_WHY="memory pressure level ${RES_LEVEL}"
  if [ "$RES_PROC_PCT" -ge "$PROC_PCT" ]; then
    RES_WHY="${RES_WHY:+$RES_WHY, }process table ${RES_PROC_PCT}% (${RES_PROCS}/${maxproc})"
  fi
}

# 0 = the machine ceiling is in force and the budget tick must be SKIPPED this pass.
# 1 = nothing doing here, carry on to the budget ceiling.
#
# Resume needs hysteresis the budget path gets for free from its separate --resume knob:
# parking drops the process count below the ceiling almost immediately, so resuming at
# the same number would oscillate. Ten points under, and one worker per tick.
resource_tick() {
  local w="" active=() n=0 fp=""
  [ "$RESOURCE" = 1 ] || return 1

  if [ -f "$FLEET_DIR/$SOCK.resource-off" ]; then
    for w in $(workers_newest_first); do
      if res_parked "$w"; then
        log "resource ceiling ignored -> resume $w"
        if [ "$DRY" != 1 ]; then
          "$BIN_DIR/fleet-resume" -s "$SOCK" "$w" >/dev/null 2>&1
          inbox "$w" resumed "governor: resource ceiling ignored"
        fi
      fi
    done
    return 1
  fi

  resources
  if [ -n "$RES_WHY" ]; then
    active=()
    for w in $(workers_newest_first); do is_parked "$w" || active+=("$w"); done
    n=${#active[@]}
    # Look twice, as the budget path does — but for the opposite reason. The figure is
    # not stale here, it is SPIKY: a turbo build or a test suite starting up crosses
    # both lines for a few seconds by design. Parking on that would fight normal work.
    if [ "$n" -gt 0 ] && [ "$CONFIRM" -gt 0 ]; then
      log "resources: ${RES_WHY} — re-reading in ${CONFIRM}s before parking ${n} worker(s)"
      sleep "$CONFIRM"
      resources
      if [ -z "$RES_WHY" ]; then
        log "  re-read clear — transient spike, not parking"
        return 1
      fi
      active=()
      for w in $(workers_newest_first); do is_parked "$w" || active+=("$w"); done
      n=${#active[@]}
    fi
    if [ "$n" -gt 0 ]; then
      log "resources: ${RES_WHY} -> parking ALL ${n} worker(s)"
      notify "machine under load (${RES_WHY}) — parked ${n} worker(s)"
      for w in "${active[@]}"; do
        log "  park $w"
        fp="$(pct_fingerprint "$w")"
        if [ "$DRY" != 1 ] && "$BIN_DIR/fleet-pause" -s "$SOCK" "$w" >/dev/null 2>&1; then
          printf 'governor-resource %s\n' "$(date +%s)" > "$FLEET_DIR/$SOCK.$w.parked"
          printf '%s' "$fp" > "$(stale_f "$w")" 2>/dev/null
          inbox "$w" parked "governor: ${RES_WHY} — machine ceiling, parked all"
        fi
      done
    else
      log "resources: ${RES_WHY} — all workers parked, holding for recovery"
    fi
    return 0
  fi

  # RECOVERED -> hand back one worker per tick, newest first
  if [ "$RES_LEVEL" -lt "$MEM_LEVEL" ] && [ "$RES_PROC_PCT" -lt $(( PROC_PCT - 10 )) ]; then
    for w in $(workers_newest_first); do
      if res_parked "$w"; then
        log "resources recovered (level ${RES_LEVEL}, procs ${RES_PROC_PCT}%) -> resume $w"
        if [ "$DRY" != 1 ]; then
          "$BIN_DIR/fleet-resume" -s "$SOCK" "$w" >/dev/null 2>&1
          inbox "$w" resumed "governor: machine recovered"
        fi
        return 0
      fi
    done
  fi
  return 1
}

tick() {
  local pct="" w="" active=() resumed=0 n=0
  # PER-PROJECT "ignore limit" override (grid settings page → , , or `touch
  # $FLEET_DIR/$SOCK.governor-off`). Read LIVE every tick, so flipping it takes effect
  # without restarting this loop — and it RELEASES whatever the governor parked, which
  # is the whole point: "I have extra usage, un-park my workers". Hand-paused workers
  # stay paused. Nothing else here can un-stick a park while the budget reads high.
  if [ -f "$FLEET_DIR/$SOCK.governor-off" ]; then
    release_gov_parked "budget ceiling ignored for this project"
    [ "$RELEASED" -gt 0 ] && log "ignore-limit ON -> released ${RELEASED} governor-parked worker(s)" \
                          || log "ignore-limit ON — not enforcing the budget ceiling"
    return
  fi

  budget; pct="$BUDGET_PCT"
  if [ -z "$pct" ] || [ "$pct" -eq 0 ]; then
    # Say WHICH panes couldn't be read and how wide they were. Without this, a fleet
    # whose sessions are all in a stack looks identical to a fleet at 0% usage, and the
    # ceiling silently stops being enforced.
    # Frozen panes are named for the same reason: "every live pane was skipped as a
    # stopped clock" and "the account really is at 0%" must not read the same.
    log "no budget reading this tick${BUDGET_BLIND:+ — no pane carries the 5h figure (too narrow):$BUDGET_BLIND}${BUDGET_FROZEN:+ — skipped as parked (frozen figure):$BUDGET_FROZEN}"
    return
  fi

  # AT/ABOVE the ceiling -> notify + park ALL workers at once (once per episode)
  if [ "$pct" -ge "$PAUSE_AT" ]; then
    active=()
    for w in $(workers_newest_first); do is_parked "$w" || active+=("$w"); done
    n=${#active[@]}
    # LOOK TWICE BEFORE PARKING. The status bar's figure is not live — it is whatever
    # Claude last painted, and it keeps saying the OLD number until the session next
    # updates it. Switch the account/team and every pane goes on reporting the previous
    # window's usage for a while; act on that and the fleet is parked over a number that
    # has already stopped being true, and a worker un-parked by hand is re-parked within
    # the minute by the same fossil. So re-read after a short wait and only park if it
    # still holds. Costs a few seconds of running past the ceiling, which is the cheap
    # side of this trade: the ceiling exists so work doesn't stall, and parking three
    # workers over a stale figure stalls it exactly as hard.
    if [ "$n" -gt 0 ] && [ "$CONFIRM" -gt 0 ]; then
      log "budget ${pct}% >= ${PAUSE_AT}% — re-reading in ${CONFIRM}s before parking ${n} worker(s)"
      sleep "$CONFIRM"
      budget
      if [ "$BUDGET_PCT" -eq 0 ]; then
        log "  re-read got no figure — not parking on the first reading alone"
        return
      fi
      if [ "$BUDGET_PCT" -lt "$PAUSE_AT" ]; then
        log "  re-read ${BUDGET_PCT}% — the ${pct}% had not caught up yet; not parking"
        return
      fi
      pct="$BUDGET_PCT"
      # the wait is long enough for the fleet to have changed under us
      active=()
      for w in $(workers_newest_first); do is_parked "$w" || active+=("$w"); done
      n=${#active[@]}
    fi
    if [ "$n" -gt 0 ]; then
      log "budget ${pct}% >= ${PAUSE_AT}% -> parking ALL ${n} worker(s)"
      notify "budget ${pct}% — parked ${n} worker(s); auto-resume under ${RESUME}%"
      for w in "${active[@]}"; do
        log "  park $w"
        # Fingerprint BEFORE pausing: we want the pane exactly as it read when it earned
        # the park. Taken after, it could catch a repaint from the pause itself and we
        # would be remembering the wrong frame.
        fp="$(pct_fingerprint "$w")"
        if [ "$DRY" != 1 ] && "$BIN_DIR/fleet-pause" -s "$SOCK" "$w" >/dev/null 2>&1; then
          printf 'governor %s\n' "$(date +%s)" > "$FLEET_DIR/$SOCK.$w.parked"
          printf '%s' "$fp" > "$(stale_f "$w")" 2>/dev/null
          inbox "$w" parked "governor: budget ${pct}% — ceiling, parked all"
        fi
      done
    else
      log "budget ${pct}% — all workers parked, holding for recovery"
    fi
    return
  fi

  # RECOVERED -> resume what WE parked (leave hand-paused workers alone)
  if [ "$pct" -lt "$RESUME" ]; then
    # ONE PER TICK, newest first. Releasing every parked worker on the same reading puts
    # the fleet straight back into the state that tripped the ceiling — measured: five
    # resumed together were over it again inside a minute, then parked together, for
    # 1,024 events. Ramping means the next reading is taken with one more worker running,
    # which is the question actually being asked.
    resumed=0
    for w in $(workers_newest_first); do
      if budget_parked "$w"; then
        log "budget ${pct}% < ${RESUME}% -> resume $w"
        if [ "$DRY" != 1 ]; then
          "$BIN_DIR/fleet-resume" -s "$SOCK" "$w" >/dev/null 2>&1
          inbox "$w" resumed "governor: budget ${pct}% — window recovered"
        fi
        resumed=1
        break
      fi
    done
    [ "$resumed" = 0 ] && log "budget ${pct}% (healthy)"
    return
  fi

  # between RESUME and PAUSE_AT -> full throttle, do nothing
  log "budget ${pct}% (running full-throttle; ceiling ${PAUSE_AT}%)"
}

modelabel="ACTIVE (parks all at ceiling)"; [ "$DRY" = 1 ] && modelabel="dry-run (no pausing)"
reslabel="mem-level>=${MEM_LEVEL}, procs>=${PROC_PCT}%"; [ "$RESOURCE" = 1 ] || reslabel="off"
log "started on $SOCK — $modelabel — budget pause-all>=${PAUSE_AT}%, resume<${RESUME}%; resources ${reslabel}; interval ${INTERVAL}s"
# The machine ceiling runs FIRST and short-circuits: with the box itself under threat,
# a token reading is beside the point, and letting the budget path also act on the same
# pass could resume for one ceiling what the other just parked for.
if [ "$ONCE" = 1 ]; then
  resource_tick || tick
else
  while true; do
    tmux -L "$SOCK" list-sessions >/dev/null 2>&1 || { log "fleet $SOCK is gone — governor exiting"; exit 0; }
    resource_tick || tick
    sleep "$INTERVAL"
  done
fi
