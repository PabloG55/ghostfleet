#!/usr/bin/env bash
# cf-sync — copy the ghostfleet RUNTIME out of the git repo into a non-TCC
# location so ClaudeCode.app (and any terminal) can actually execute it.
#
# WHY THIS EXISTS: the git repo lives under ~/Documents, which macOS guards with
# TCC. An app that hasn't been granted "Documents folder" / Full Disk Access gets
# EPERM ("Operation not permitted") trying to EXEC anything there — so the fleet
# CLI, the event hook, and the MCP server all fail. ~/.local is NOT TCC-protected,
# so we run the executables from a copy there and keep the repo purely for dev.
#
# install.sh copies the runtime here and records the source repo in <dest>/.source.
# After you EDIT the repo, run `cf-sync` to push those edits into the live runtime.
#
#   cf-sync                 # sync recorded source repo -> live runtime
#   cf-sync <repo-path>     # sync from an explicit repo (also re-records it)
#
# A successful sync also stamps <dest>/.synced with the commit it copied, which is what
# lets bin/ghostfleet notice a stale runtime. See the block at the bottom.
#
# The recorded pointer is <dest>/.source, and it is the only thing that knows where a
# bare `cf-sync` syncs FROM. install.sh writes it too — except when it is running out of
# an npx cache while .source already names a real clone, where it leaves the clone alone
# (see the staging block there); otherwise `npx ghostfleet-cli` on a machine that has a
# clone would silently redirect every later sync at the cache.
#
# Live runtime dir: $CLAUDE_FLEET_HOME or ~/.local/libexec/ghostfleet
set -uo pipefail

# resolve our own install dir (follow symlinks) = the live runtime root's bin/
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do t="$(readlink "$src")"; case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac; done
DEST="${CLAUDE_FLEET_HOME:-$(cd "$(dirname "$src")/.." && pwd)}"
# If we were invoked as the REPO's own copy (the repo's bin/ ahead of ~/.local/bin on
# PATH), DEST would be the repo itself and the sync would no-op with "same dir" —
# looking like a deploy that happened when nothing moved. Fall back to the canonical
# runtime whenever this copy is the source and a real runtime exists next door.
if [ -z "${CLAUDE_FLEET_HOME:-}" ] && [ -d "$DEST/.git" ]; then
  _rt="$HOME/.local/libexec/ghostfleet"
  [ -d "$_rt" ] && [ "$_rt" != "$DEST" ] && DEST="$_rt"
fi

# figure out the SOURCE repo: arg > recorded .source > give up with guidance
REPO="${1:-}"
[ -n "$REPO" ] || REPO="$(cat "$DEST/.source" 2>/dev/null || true)"
if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
  echo "cf-sync: don't know the source repo. Pass it once: cf-sync /path/to/ghostfleet" >&2
  exit 1
fi
REPO="$(cd "$REPO" && pwd)"

if [ "$REPO" = "$DEST" ]; then
  echo "cf-sync: source and runtime are the same dir ($DEST) — nothing to sync." >&2
  echo "cf-sync: if you meant to deploy, name the runtime: CLAUDE_FLEET_HOME=~/.local/libexec/ghostfleet cf-sync $REPO" >&2
  exit 0
fi

# A source with no .git is worth one line. It is not an error — an unpacked npx cache
# syncs perfectly well — but it is nobody's checkout, so edits made in a clone you create
# LATER go nowhere while this still prints "synced runtime" over the top of them.
# install.sh guards the other order (clone first, then npx); nothing can guess this one.
[ -e "$REPO/.git" ] || echo "cf-sync: note — $REPO is not a git repo (an npx cache unpacks into a dir like that). If the code you edit lives in a CLONE, point this at it once: cf-sync /path/to/ghostfleet" >&2

# --- what this sync will record ---------------------------------------------
# .source says where to sync FROM. Nothing said WHAT was synced, so nothing could answer
# the question CLAUDE.md opens with — "editing a file changes nothing until it's synced" —
# after the fact. Four PRs merged, nobody ran cf-sync, and the runtime served the pre-fix
# grid parser for an hour while the repo was current: invisible on macOS, and on tmux
# <= 3.5 it IS the bug #68 had just fixed. bin/ghostfleet reads this stamp to say so.
#
# THE ABSENCE OF THIS FILE MEANS UNKNOWN, AND NEVER "IN SYNC". Four things produce that
# absence — a runtime older than this feature, one synced by a version that did not stamp,
# one synced from a source with no commits to name (an npx cache), and one left MIXED by a
# partial sync — and every one of them is a REMOVAL rather than a stale value left in
# place. A value here is a claim about which code is in $DEST; a wrong claim is worse than
# no claim, because the whole point of the stamp is that something else trusts it.
STAMP="$DEST/.synced"
# 40 lowercase hex, or it is not a commit. Validated on the way OUT as well as the way in:
# `rev-parse HEAD` in a repo with an unborn HEAD prints "HEAD" and exits non-zero, and a
# stamp reading "HEAD" would compare unequal to everything forever — a warning that can
# never be cleared, which is the same trust problem pointed the other way.
is_sha() { case "$1" in *[!0-9a-f]*) return 1 ;; esac; [ "${#1}" = 40 ]; }

# copy only the runtime dirs (not .git / README / tests); preserve perms so the
# exec bits survive. Mirror each dir so deletions in the repo propagate.
#
# `lib` is in this list because a bin that imports from it is only as installed as its
# imports. fleet-look.mjs was linked onto PATH, passed thirteen assertions IN THE REPO,
# and died on its first real invocation with ERR_MODULE_NOT_FOUND on lib/browser.mjs —
# because the suite runs from the repo, where the import resolves, and the shipped command
# runs from $DEST, where it did not. Green here, broken in the hand: the exact split this
# whole file exists to close, arriving through a directory nobody had needed before.
#
# `web` is in this list because the phone client is a RUNTIME asset: fleet-serve serves
# those static files from $DEST, not from the repo, so a client left out of the sync 404s
# in the browser while every file on disk looks perfectly correct — the same shape of
# confusion as a stale MCP process, and just as invisible from the repo side.
# EVERY COPY IS CHECKED, because the whole deploy model rests on the runtime matching
# the repo and this is the only command that makes that true. It used to run rsync and
# ignore its status — `set -uo pipefail` has no `-e` — and then print "synced runtime"
# unconditionally. Seen live: TCC denied one directory and cf-sync reported success over
# the top of rsync's own error.
#
#     rsync(87193): error: open /Users/pgarces/…/ghostfleet/web/: Operation not permitted
#     cf-sync: synced runtime  /Users/pgarces/…/ghostfleet  ->  /Users/pgarces/.local/…
#
# That is worse than failing: a success line is what you check BEFORE concluding the
# runtime is current, so the one safeguard against the repo-vs-runtime trap at the top of
# CLAUDE.md was the thing asserting the trap had not happened.
mkdir -p "$DEST" || { echo "cf-sync: cannot create $DEST" >&2; exit 1; }
failed=""
for d in bin lib tmux hooks mcp skill layouts web; do
  [ -d "$REPO/$d" ] || continue
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete "$REPO/$d/" "$DEST/$d/"; rc=$?
  else
    rm -rf "$DEST/$d" && mkdir -p "$DEST/$d" && cp -Rp "$REPO/$d/." "$DEST/$d/"; rc=$?
  fi
  # Any non-zero is a failure, including rsync's "partial transfer" warnings. A partial
  # copy of bin/ is exactly the state that runs half-new code, and there is no exit code
  # here that means "the runtime matches the repo, but less so".
  [ "$rc" -eq 0 ] || { failed="$failed $d"; echo "cf-sync: FAILED to sync $d/ (exit $rc)" >&2; }
done

# The pointer is recorded either way: it says where to sync FROM, not that a sync worked,
# and dropping it would leave the retry — the very next thing you do — with no source.
printf '%s\n' "$REPO" > "$DEST/.source"

if [ -n "$failed" ]; then
  # The runtime is now a MIX of old and new, which is not any commit — so no commit may be
  # named. Removing the stamp is not tidiness: leaving the PREVIOUS one would have the
  # control plane report a specific, wrong distance from HEAD for a directory whose actual
  # contents nothing knows, and the retry (the next thing you do) rewrites it anyway.
  rm -f "$STAMP"
  echo "cf-sync: NOT SYNCED —$failed" >&2
  echo "cf-sync: the runtime at $DEST is now a MIX of old and new code. Do not trust it." >&2
  # Name the cause this script exists for. cf-sync is here BECAUSE ~/Documents is TCC
  # guarded, so a permission denial on the source is the likeliest reading of a failure
  # and the least likely to be guessed from an exit code.
  case " $failed " in *' '*) echo "cf-sync: if this says 'Operation not permitted', macOS TCC is denying the source. Grant your terminal Full Disk Access (System Settings > Privacy & Security), then re-run." >&2 ;; esac
  exit 1
fi

# Stamp only what actually happened: every copy above succeeded, so $DEST holds $REPO's
# tree as of this commit. The first line is the bare sha so a reader needs no parser; the
# rest is for a human opening the file, plus the `source` line, which exists because the
# stamp and .source can name different places — install.sh restores a clone's pointer
# after an npx-cache install — and a distance measured between two different sources would
# be a number with no meaning. The reader checks they agree.
sha=""
command -v git >/dev/null 2>&1 && sha="$(git -C "$REPO" rev-parse HEAD 2>/dev/null)"
if is_sha "$sha"; then
  { printf '%s\n' "$sha"
    printf 'source %s\n' "$REPO"
    printf 'ref %s\n'    "$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    printf 'synced %s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)"
    printf 'subject %s\n' "$(git -C "$REPO" log -1 --pretty=%s 2>/dev/null)"
  } > "$STAMP"
else
  # No git, not a checkout, or an unborn HEAD: there is no commit to name, so the honest
  # record is none. Any older stamp is about code that is no longer in $DEST.
  rm -f "$STAMP"
fi

echo "cf-sync: synced runtime  $REPO  ->  $DEST"
echo "  (the ~/.local/bin symlinks + settings hook + MCP already point here; no relink needed)"
