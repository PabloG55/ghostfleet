#!/usr/bin/env bash
# cf-sync — copy the ghostfleet RUNTIME out of the git repo into a non-TCC
# location so ClaudeCode.app (and any terminal) can actually execute it.
#
# WHY THIS EXISTS: the git repo lives under ~/Documents, which macOS guards with
# TCC. An app that hasn't been granted "Documents folder" / Full Disk Access gets
# EPERM ("Operation not permitted") trying to EXEC anything there — so the fleet
# CLI, the event hook, and the MCP server all fail. ~/.local is NOT TCC-protected,
# so we run the executables from a copy there and keep the repo purely for dev.
#
# install.sh copies the runtime here and records the source repo in <dest>/.source.
# After you EDIT the repo, run `cf-sync` to push those edits into the live runtime.
#
#   cf-sync                 # sync recorded source repo -> live runtime
#   cf-sync <repo-path>     # sync from an explicit repo (also re-records it)
#
# Live runtime dir: $CLAUDE_FLEET_HOME or ~/.local/libexec/ghostfleet
set -uo pipefail

# resolve our own install dir (follow symlinks) = the live runtime root's bin/
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do t="$(readlink "$src")"; case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac; done
DEST="${CLAUDE_FLEET_HOME:-$(cd "$(dirname "$src")/.." && pwd)}"
# If we were invoked as the REPO's own copy (the repo's bin/ ahead of ~/.local/bin on
# PATH), DEST would be the repo itself and the sync would no-op with "same dir" —
# looking like a deploy that happened when nothing moved. Fall back to the canonical
# runtime whenever this copy is the source and a real runtime exists next door.
if [ -z "${CLAUDE_FLEET_HOME:-}" ] && [ -d "$DEST/.git" ]; then
  _rt="$HOME/.local/libexec/ghostfleet"
  [ -d "$_rt" ] && [ "$_rt" != "$DEST" ] && DEST="$_rt"
fi

# figure out the SOURCE repo: arg > recorded .source > give up with guidance
REPO="${1:-}"
[ -n "$REPO" ] || REPO="$(cat "$DEST/.source" 2>/dev/null || true)"
if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
  echo "cf-sync: don't know the source repo. Pass it once: cf-sync /path/to/ghostfleet" >&2
  exit 1
fi
REPO="$(cd "$REPO" && pwd)"

if [ "$REPO" = "$DEST" ]; then
  echo "cf-sync: source and runtime are the same dir ($DEST) — nothing to sync." >&2
  echo "cf-sync: if you meant to deploy, name the runtime: CLAUDE_FLEET_HOME=~/.local/libexec/ghostfleet cf-sync $REPO" >&2
  exit 0
fi

# copy only the runtime dirs (not .git / README / tests); preserve perms so the
# exec bits survive. Mirror each dir so deletions in the repo propagate.
#
# `web` is in this list because the phone client is a RUNTIME asset: fleet-serve serves
# those static files from $DEST, not from the repo, so a client left out of the sync 404s
# in the browser while every file on disk looks perfectly correct — the same shape of
# confusion as a stale MCP process, and just as invisible from the repo side.
# EVERY COPY IS CHECKED, because the whole deploy model rests on the runtime matching
# the repo and this is the only command that makes that true. It used to run rsync and
# ignore its status — `set -uo pipefail` has no `-e` — and then print "synced runtime"
# unconditionally. Seen live: TCC denied one directory and cf-sync reported success over
# the top of rsync's own error.
#
#     rsync(87193): error: open /Users/pgarces/…/ghostfleet/web/: Operation not permitted
#     cf-sync: synced runtime  /Users/pgarces/…/ghostfleet  ->  /Users/pgarces/.local/…
#
# That is worse than failing: a success line is what you check BEFORE concluding the
# runtime is current, so the one safeguard against the repo-vs-runtime trap at the top of
# CLAUDE.md was the thing asserting the trap had not happened.
mkdir -p "$DEST" || { echo "cf-sync: cannot create $DEST" >&2; exit 1; }
failed=""
for d in bin tmux hooks mcp skill layouts web; do
  [ -d "$REPO/$d" ] || continue
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete "$REPO/$d/" "$DEST/$d/"; rc=$?
  else
    rm -rf "$DEST/$d" && mkdir -p "$DEST/$d" && cp -Rp "$REPO/$d/." "$DEST/$d/"; rc=$?
  fi
  # Any non-zero is a failure, including rsync's "partial transfer" warnings. A partial
  # copy of bin/ is exactly the state that runs half-new code, and there is no exit code
  # here that means "the runtime matches the repo, but less so".
  [ "$rc" -eq 0 ] || { failed="$failed $d"; echo "cf-sync: FAILED to sync $d/ (exit $rc)" >&2; }
done

# The pointer is recorded either way: it says where to sync FROM, not that a sync worked,
# and dropping it would leave the retry — the very next thing you do — with no source.
printf '%s\n' "$REPO" > "$DEST/.source"

if [ -n "$failed" ]; then
  echo "cf-sync: NOT SYNCED —$failed" >&2
  echo "cf-sync: the runtime at $DEST is now a MIX of old and new code. Do not trust it." >&2
  # Name the cause this script exists for. cf-sync is here BECAUSE ~/Documents is TCC
  # guarded, so a permission denial on the source is the likeliest reading of a failure
  # and the least likely to be guessed from an exit code.
  case " $failed " in *' '*) echo "cf-sync: if this says 'Operation not permitted', macOS TCC is denying the source. Grant your terminal Full Disk Access (System Settings > Privacy & Security), then re-run." >&2 ;; esac
  exit 1
fi

echo "cf-sync: synced runtime  $REPO  ->  $DEST"
echo "  (the ~/.local/bin symlinks + settings hook + MCP already point here; no relink needed)"
