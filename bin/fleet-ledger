#!/usr/bin/env bash
# fleet-ledger [-s SOCKET] [--session ID] [session] [list|all|close <id> [proof]|drop <id> <reason>|add <ask>|clear]
#
# A session's request LEDGER (the mod's LEDGER section, mods/ghostfleet/hooks/register.js):
# every message submitted to it, held open until a final message answers it, and the
# promises it made ("I'll merge when green"). This reads and closes items from outside the
# session; inside one, /ledger does the same without a turn.
#
#   list               (default) what is still open
#   all                every item the file keeps, closed ones too, with how each closed
#   close <id>         close one by hand (the judge will not be asked about it again)
#   close <id> <proof> close one as the agent's ledger_close does: done, with its proof
#   drop <id> <reason> as ledger_drop: not a real ask, or the person cancelled it
#   add <ask>          as ledger_add: an ask the ledger missed, in the latest prompt
#   clear              close every open item by hand; the history stays in the file
#
# The last three are the mod's tools from Bash, for a session older than the tools: the mod
# registers them once, at session start, and /reload-plugins does not register them again.
#
# `session` is a session name on this fleet (its newest record on THIS socket, as
# fleet-read finds it) or a session id; --session ID is a session id. Without one: the
# session this runs in.
set -uo pipefail

SOCK="${CLAUDE_FLEET_SOCK:-}"
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac
SESSION=""; VERB=""; ARG=""; WHY=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s) SOCK="${2:-}"; shift 2 ;;
    --session) SESSION="${2:-}"; [ -n "$SESSION" ] || { echo "fleet-ledger: --session needs a session id" >&2; exit 1; }; shift 2 ;;
    -h|--help) sed -n '2,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "fleet-ledger: unknown option $1" >&2; exit 1 ;;
    list|all|clear) [ -z "$VERB" ] || { echo "fleet-ledger: unexpected arg $1" >&2; exit 1; }; VERB="$1"; shift ;;
    close|drop)
      [ -z "$VERB" ] || { echo "fleet-ledger: unexpected arg $1" >&2; exit 1; }
      VERB="$1"; ARG="${2:-}"; [ -n "$ARG" ] || { echo "fleet-ledger: $1 needs an item id" >&2; exit 1; }
      shift 2; WHY="$*"; set --
      [ "$VERB" = close ] || [ -n "$WHY" ] || { echo "fleet-ledger: drop needs a reason" >&2; exit 1; } ;;
    add)
      [ -z "$VERB" ] || { echo "fleet-ledger: unexpected arg $1" >&2; exit 1; }
      VERB=add; shift; WHY="$*"; set --
      [ -n "$WHY" ] || { echo "fleet-ledger: add needs the ask's text" >&2; exit 1; } ;;
    *) if [ -z "$SESSION" ] && [ -z "$VERB" ]; then SESSION="$1"; shift
       else echo "fleet-ledger: unexpected arg $1" >&2; exit 1; fi ;;
  esac
done
VERB="${VERB:-list}"
command -v node >/dev/null 2>&1 || { echo "fleet-ledger: node required" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "fleet-ledger: jq required" >&2; exit 1; }

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"

# Who: the pane this runs in, then the name it was launched with (as fleet-inbox asks).
if [ -z "$SESSION" ]; then
  case "${TMUX:-}" in *"/$SOCK,"*)
    [ -n "${TMUX_PANE:-}" ] && SESSION="$(tmux -L "$SOCK" display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)" ;; esac
  SESSION="${SESSION:-${CLAUDE_FLEET_SLOT:-}}"
  [ -n "$SESSION" ] || { echo "fleet-ledger: which session? (not run inside one; pass a name)" >&2; exit 1; }
fi
case "$SESSION" in *[!A-Za-z0-9._~-]*) echo "fleet-ledger: '$SESSION' is not a session name" >&2; exit 1 ;; esac

# A session id names its file directly; a name is resolved through its newest record on
# THIS socket (every fleet has a `master`, so a name alone would be another project's).
if [ -f "$FLEET_DIR/$SESSION.ledger" ]; then
  ID="$SESSION"
else
  ID="$(for f in "$FLEET_DIR"/*.json; do
    [ -f "$f" ] || continue
    jq -r --arg s "$SESSION" --arg k "$SOCK" \
      'select(.slot==$s and ((.sock // "") == $k))|[(.ts//0),(.session_id//"")]|@tsv' "$f" 2>/dev/null
  done | sort -rn | head -1 | cut -f2)"
fi
[ -n "$ID" ] || { echo "fleet-ledger: no session '$SESSION' on ${SOCK:-this fleet}" >&2; exit 1; }

# Through the symlink: ~/.local/bin/fleet-ledger points into the staged runtime, and the
# ledger's vocabulary is the mod's own file, beside bin/ there.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  t="$(readlink "$src")"
  case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac
done
LEDGER_JS="$(cd "$(dirname "$src")/.." 2>/dev/null && pwd)/mods/ghostfleet/hooks/ledger.js"
[ -f "$LEDGER_JS" ] || { echo "fleet-ledger: $LEDGER_JS is missing" >&2; exit 1; }

exec node --no-warnings --input-type=module -e '
  const [js, dir, id, name, verb, arg, why] = process.argv.slice(1)
  const L = await import(js)
  const fs = await import("node:fs")
  const file = L.ledgerFile(dir, id)
  let text = null
  try { text = fs.readFileSync(file, "utf8") } catch {}
  if (text === null) {
    const msg = `${name}: no ledger (the mod has recorded nothing for this session)`
    if (verb !== "list" && verb !== "all") { console.error(`fleet-ledger: ${msg}`); process.exit(1) }
    console.log(msg); process.exit(0)
  }
  // CLAUDE_FLEET_NOW_MS pins the clock. Every age printed here is now minus a time another
  // process wrote, rounded to the second, so a reader started half a second late says
  // "1s ago" where the writer meant "0s" — and no sleep makes that gap a known size.
  const now = Number(process.env.CLAUDE_FLEET_NOW_MS) || Date.now()
  if (verb === "list" || verb === "all") { console.log(L.listing(L.parseLedger(text), now, { all: verb === "all" })); process.exit(0) }
  // Each change is made against the file as it is, written beside it and renamed over it as the
  // mod writes it (dot-led, so no glob reads it; named for this process, so two never share
  // one). The mod changes the same file between turns: when the file moved while this one
  // was computing, the change is made again against what is there now, not written over it.
  const change = fn => {
    for (let k = 0; k < 5; k++) {
      const before = fs.readFileSync(file, "utf8")
      const r = fn(L.parseLedger(before))
      if (!r.ledger) return r
      const tmp = `${dir}/.${id}.ledger.cli.${process.pid}.tmp`
      fs.writeFileSync(tmp, JSON.stringify(r.ledger))
      let now2 = null
      try { now2 = fs.readFileSync(file, "utf8") } catch {}
      if (now2 === before) { fs.renameSync(tmp, file); return r }
      fs.rmSync(tmp, { force: true })
    }
    return { ledger: null, said: "ledger: the file kept changing under this write; nothing changed" }
  }
  const ctx = { nowMs: now, turnId: "" }
  const act = {
    close: l => (why
      ? L.closeByAgent(l, arg, why, ctx)
      : (n => ({ ledger: n, said: n ? `closed ${arg}` : `fleet-ledger: no open item ${arg} in ${name}` }))(L.closeByHand(l, arg, now))),
    drop: l => L.dropByAgent(l, arg, why, ctx),
    add: l => L.addByAgent(l, why, ctx),
    clear: l => { const n = L.openItems(l, now).length; return { ledger: L.clearOpen(l, now), said: `closed ${n} open item${n === 1 ? "" : "s"}` } },
  }[verb]
  const r = change(act)
  if (!r.ledger) { console.error(r.said); process.exit(1) }
  console.log(r.said); process.exit(0)
' "$LEDGER_JS" "$FLEET_DIR" "$ID" "$SESSION" "$VERB" "$ARG" "$WHY"
