#!/usr/bin/env bash
# fleet-worktrees [-s SOCKET]
#
# Inventory every git worktree of the current repo and tell a lead session which
# ones are FREE to reuse — so it stops spinning up a brand-new worktree when idle
# ones already exist. This is the "look before you spawn" view: fleet-spawn refers
# to the same free/occupied logic before it will create a new worktree.
#
# For each worktree it shows: branch · live fleet session (if any) · state ·
# git (clean/dirty + ahead/behind) · the task it was spun up for (from the
# manifest). A worktree is FREE = it exists, has NO live session on this fleet,
# and its working tree is clean (a dirty, sessionless worktree has unfinished
# work, so it's left alone, not offered for reuse).
#
# Socket defaults to $CLAUDE_FLEET_SOCK.
set -uo pipefail

SOCK="${CLAUDE_FLEET_SOCK:-}"
# Prefer $TMUX (the live server this session runs in) over the env var — it's
# drift-proof; a long-running --resume/--fork Claude can hold a stale
# CLAUDE_FLEET_SOCK. Only when it names a cf-* fleet server; -s still overrides.
_t="${TMUX:-}"; case "${_t##*/}" in cf-*) SOCK="${_t%%,*}"; SOCK="${SOCK##*/}" ;; esac
if [ "${1:-}" = "-s" ]; then SOCK="${2:-}"; shift 2; fi
[ -n "$SOCK" ] || { echo "fleet-worktrees: no socket (run inside a fleet session, or pass -s <socket>)" >&2; exit 1; }
command -v git  >/dev/null 2>&1 || { echo "fleet-worktrees: git required"  >&2; exit 1; }
command -v tmux >/dev/null 2>&1 || { echo "fleet-worktrees: tmux required" >&2; exit 1; }
git -C "$PWD" rev-parse --show-toplevel >/dev/null 2>&1 \
  || { echo "fleet-worktrees: not inside a git repo" >&2; exit 1; }

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"
MANIFEST="$FLEET_DIR/$SOCK.manifest.tsv"

# pane cwd -> session, once. `exec agent-here` keeps the pane cwd at the session
# checkout, so a worktree is "occupied" when some session's pane sits in it.
panes="$(tmux -L "$SOCK" list-panes -a -F '#{pane_current_path}	#{session_name}' 2>/dev/null)"

sess_for() {                       # first session whose pane cwd is at/under $1
  local wt="$1" p="" s=""
  while IFS=$'\t' read -r p s; do
    [ -n "$p" ] || continue
    # A TAB IS NOT AN OCCUPANT. fleet-tab's terminals/editors sit in the checkout they
    # were opened from, so a worktree with a terminal open on it read as "occupied by
    # _term-master" and dropped out of the free list — a shell holding a whole worktree
    # hostage. It is not work; it does not own the checkout.
    case "$s" in _term-*|_edit-*) continue ;; esac
    case "$p" in "$wt"|"$wt"/*) echo "$s"; return ;; esac
  done <<EOF
$panes
EOF
}
# Busy is per-AGENT: claude's spinner says "esc to interrupt", opencode's says "esc
# interrupt". Unlike the other call sites this one takes a session name per call, so
# the agent is resolved per session. Falls back to claude's literal pattern (verbatim
# from before the adapter) when fleet-agent isn't available, and treats an EMPTY
# pattern as "can't tell" rather than feeding grep a match-everything regex.
busy() {
  local re='(…|\.\.\.) ?\([0-9]+[ms]|↓ ?[0-9.,]+ ?[km]? ?tokens|esc to interrupt' a=""
  if command -v fleet-agent >/dev/null 2>&1; then
    a="$(fleet-agent of "$1" -s "$SOCK" 2>/dev/null)"
    [ -n "$a" ] && [ "$a" != claude ] && re="$(fleet-agent field "$a" busy_re 2>/dev/null)"
  fi
  [ -n "$re" ] || return 1
  tmux -L "$SOCK" capture-pane -p -t "$1" 2>/dev/null | grep -qE "$re"
}
is_parked() { [ -f "$FLEET_DIR/$SOCK.$1.parked" ]; }
# FINISHED means "its PR merged", which no git test can answer in a squash-merge repo:
# the squash lands one NEW commit, so the branch's own commits are never in main and
# every reachability check calls shipped work unlanded. fleet-merged asks GitHub and
# caches; it prints nothing when it cannot tell, so silence degrades to FREE, never to
# a confident DONE.
MERGED="$("$(dirname "$0")/fleet-merged" "$PWD" 2>/dev/null || true)"
is_merged() { [ -n "$MERGED" ] && printf '%s\n' "$MERGED" | grep -qxF -- "$1"; }
task_for()  { awk -F'\t' -v w="$1" '$1==w{print $4; exit}' "$MANIFEST" 2>/dev/null; }
git_state() {                      # "clean|dirty" (+ahead / -behind vs upstream)
  local wt="$1" d="" ab="" behind="" ahead="" extra=""
  [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ] && d=dirty || d=clean
  if ab="$(git -C "$wt" rev-list --count --left-right '@{u}...HEAD' 2>/dev/null)"; then
    behind="${ab%%	*}"; ahead="${ab##*	}"
    [ "${ahead:-0}" -gt 0 ] 2>/dev/null && extra="$extra +$ahead"
    [ "${behind:-0}" -gt 0 ] 2>/dev/null && extra="$extra -$behind"
  fi
  printf '%s%s' "$d" "$extra"
}

wts_of() {                         # path<TAB>branch for one repo; first line = its own root
  git -C "$1" worktree list --porcelain 2>/dev/null | awk '
    /^worktree /{ if (wt!="") print wt "\t" br; wt=substr($0,10); br="(detached)"; skip=0 }
    /^branch /  { b=$2; sub("refs/heads/","",b); br=b }
    /^detached$/{ br="(detached)" }
    /^bare$/    { skip=1 }
    /^$/        { if (wt!="" && !skip) { print wt "\t" br; wt=""; skip=0 } }
    END         { if (wt!="" && !skip) print wt "\t" br }'
}

# ONE PROJECT CAN BE SEVERAL CLONES, and a worktree belongs to exactly one of them.
#
# A project root is not always a repo. superkey registers ~/superkey, which holds four
# INDEPENDENT clones (superkey, superkey-1, superkey-3, superkey-xd), each with its own
# .git and therefore its own private set of worktrees. A lead standing in one of them saw
# 2 and was blind to the other 17 — so "reuse before you spawn", which is built on this
# list, could never fire, and every task made another one. Nineteen worktrees, fifteen
# of them idle.
#
# So the inventory spans every clone under the project root: the repo we're in, plus each
# immediate sibling that is a clone in its own right (git-dir == git-common-dir; that test
# is exact, and it is what keeps a WORKTREE of one clone from being walked a second time
# as if it were a clone itself). Single-repo projects find exactly one and are unchanged.
# --here restricts it to the current repo, which is the old behaviour.
HERE=0; FREE_ONLY=0; DONE_ONLY=0
# --free: just the reusable ones, "<abs path><TAB><branch>", for fleet-spawn's
# reuse-before-proliferate check. A machine mode rather than parsing the table below,
# so the two can never disagree about what "free" means — that agreement is the whole
# point of this file existing.
for a in "$@"; do
  case "$a" in --here) HERE=1 ;; --free) FREE_ONLY=1 ;; --done) DONE_ONLY=1 ;; esac
done
GITROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)"
PROOT="$(dirname "$GITROOT")"
is_clone() { [ "$(git -C "$1" rev-parse --git-dir 2>/dev/null)" = "$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" ]; }

repos="$GITROOT"
if [ "$HERE" != 1 ]; then
  # The project root is the parent — the same assumption fleet-spawn makes when it
  # places a sibling worktree.
  for d in "$PROOT"/*/; do
    d="${d%/}"
    [ -d "$d" ] || continue
    [ "$d" = "$GITROOT" ] && continue
    git -C "$d" rev-parse --show-toplevel >/dev/null 2>&1 || continue
    [ "$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" = "$d" ] || continue
    is_clone "$d" || continue                 # a worktree, not a clone: its owner lists it
    repos="$repos
$d"
  done
fi

wts=""
while IFS= read -r r; do
  [ -n "$r" ] || continue
  o="$(wts_of "$r")"
  [ -n "$o" ] || continue
  wts="${wts:+$wts
}$o"
done <<EOF
$repos
EOF

# SLOT is the dev-stack number (bin/fleet-slot): the repo derives its ports/database
# from it, so seeing it here is what makes "which stack is this?" answerable without
# digging. Blank when this checkout has none; 0 is the project's primary.
slot_for() { "$(dirname "$0")/fleet-slot" of "$1" 2>/dev/null || printf '-'; }
{ [ "$FREE_ONLY" = 1 ] || [ "$DONE_ONLY" = 1 ]; } || printf '%-38s %-22s %-14s %-7s %-5s %-14s %s\n' WORKTREE BRANCH SESSION STATE SLOT GIT TASK
# A LABEL YOU CAN PASTE BACK. Basenames repeat across clones once several of them keep a
# .worktrees/ each, so the old bare basename was ambiguous AND wrong to hand to --reuse.
# Relative to the project root it is unique, readable, and exactly what --reuse resolves.
rel_of() { case "$1" in "$PROOT"/*) printf '%s' "${1#"$PROOT"/}" ;; *) printf '%s' "$1" ;; esac; }
# Each clone's own root is a main checkout, not something to offer for reuse. With several
# clones there is more than one, so it cannot be "the first line" any more.
is_root() { case "$ROOTS" in *"|$1|"*) return 0 ;; esac; return 1; }
ROOTS="|"
while IFS= read -r r; do [ -n "$r" ] && ROOTS="$ROOTS$r|"; done <<EOF
$repos
EOF

free=""; done_list=""
while IFS=$'\t' read -r wt br; do
  [ -n "$wt" ] || continue
  # NOT OURS TO HAND OUT. Claude Code's own trees — the Agent tool's isolation:worktree,
  # and the ones EnterWorktree makes — are git worktrees like any other, so they arrive
  # here looking clean and sessionless, i.e. "free". Offering one for reuse points a
  # worker at a checkout Claude is managing. fleet-spawn already skipped these; now that
  # this file is the enumerator, the skip has to live here or the exclusion silently
  # stops applying.
  case "$wt" in */.claude/worktrees/*) continue ;; esac
  base="$(rel_of "$wt")"
  # a worktree dir that git still lists but no longer exists on disk (removed with
  # rm -rf instead of `git worktree remove`) — flag it; `git worktree prune` tidies it.
  if [ ! -d "$wt" ]; then
    { [ "$FREE_ONLY" = 1 ] || [ "$DONE_ONLY" = 1 ]; } || printf '%-38s %-22s %-14s %-7s %-5s %-14s %s\n' "${base:0:38}" "${br:0:22}" "-" "gone" "-" "-" "git worktree prune"
    continue
  fi
  sess="$(sess_for "$wt")"
  state=""; git=""; task="$(task_for "$wt")"; [ -n "$task" ] || task="-"
  git="$(git_state "$wt")"
  if is_root "$wt"; then                          # a clone's own checkout — a lead's home
    if [ "$sess" = master ]; then state=LEAD; elif [ -n "$sess" ]; then state="${sess:0:7}"; else state=main; sess="-"; fi
  elif [ -n "$sess" ]; then
    if is_parked "$sess"; then state=parked
    elif busy "$sess"; then state=busy
    else state=idle; fi
  else
    sess="-"; task="-"    # no live session -> the manifest task refers to a gone session; don't show it stale
    case "$git" in
      clean*) if is_merged "$br"; then state=DONE; done_list="$done_list $base"
              else state=FREE; fi
              free="$free $base" ;;      # DONE is reusable too — clean and sessionless
      *)      state=stale ;;
    esac
  fi
  if [ "$DONE_ONLY" = 1 ]; then
    [ "$state" = DONE ] && printf '%s\t%s\n' "$wt" "$br"
  elif [ "$FREE_ONLY" = 1 ]; then
    { [ "$state" = FREE ] || [ "$state" = DONE ]; } && printf '%s\t%s\n' "$wt" "$br"
  else
    printf '%-38s %-22s %-14s %-7s %-5s %-14s %s\n' \
      "${base:0:38}" "${br:0:22}" "${sess:0:14}" "$state" "$(slot_for "$wt")" "$git" "${task:0:60}"
  fi
done <<EOF
$wts
EOF

{ [ "$FREE_ONLY" = 1 ] || [ "$DONE_ONLY" = 1 ]; } && exit 0
echo
if [ -n "$done_list" ]; then
  n="$(printf '%s' "$done_list" | wc -w | tr -d ' ')"
  echo "Finished ($n) — PR merged, nothing to lose:"
  for f in $done_list; do echo "  $f"; done
  echo "  reclaim: fleet-clean --go"
  echo
fi
if [ -n "$free" ]; then
  # Sixteen of these on one line is a wall, not a list — and this is the line a lead is
  # meant to read BEFORE deciding to create another worktree.
  n="$(printf '%s' "$free" | wc -w | tr -d ' ')"
  if [ "${n:-0}" -gt 4 ]; then
    echo "Free to reuse ($n)   →  fleet-spawn <name> --reuse <worktree>"
    for f in $free; do echo "  $f"; done
  else
    echo "Free to reuse:$free   →  fleet-spawn <name> --reuse <worktree>"
  fi
else
  echo "No free worktrees (all in use, or dirty). Create one: fleet-spawn <name> --new"
fi
