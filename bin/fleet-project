#!/usr/bin/env bash
# fleet-project add <path> [--name N] [--profile P] [--agent A] [--start]
# fleet-project agent <name> [<agent>|--none] [--session S]
# fleet-project list
# fleet-project rm <name>
# fleet-project set <name | -s SOCK> <workers-merge|agents-approve> <on|off|inherit> [--session S]
# fleet-project get <name | -s SOCK> [--session S]
#
# Register a PROJECT (a new fleet) from the command line — the thing the Projects
# screen's "+ add project" does. Without this a lead had no way to create one, so
# work on a brand-new repo got spawned as a worker inside whatever fleet the lead
# happened to be in, on the wrong socket and under the wrong project.
#
#   add     append <path> to this profile's projects list (idempotent). --start also
#           boots its master right away, so the new fleet is usable immediately
#           without opening the TUI.
#   list    name · profile · fleet socket · path
#   agent   set the project's agent (the 4th column) AND move its RUNNING master onto it —
#           at once when idle, after the current turn when not; switching back resumes the
#           conversation that agent had (lib/agent-switch.sh). --session S switches that
#           one session instead and leaves the column alone. Running workers keep theirs.
#   rm      drop the list entry only — sessions, worktrees and history are untouched
#   set     one of the two BOUNDARY settings (lib/boundary.sh), both OFF by default:
#             workers-merge   a worker in a linked worktree may merge a PR
#             agents-approve  an agent may approve another session's permission dialog
#           for the whole project, or with --session for ONE session — the sub-master of
#           its task, while its siblings stay blocked. `inherit` (session only) drops the
#           override. The grid's settings page calls this for the project-wide form.
#   get     what those resolve to, for the project or one session
#
# <path> is the project ROOT: the repo itself, or a folder holding its checkouts /
# worktrees (same rule the TUI uses).
set -uo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do t="$(readlink "$src")"; case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac; done
BIN_DIR="$(cd "$(dirname "$src")" && pwd)"
CONF="$BIN_DIR/../tmux/cf.tmux.conf"

CFG_HOME="$HOME/.config/ghostfleet"
profile_dir() { case "$1" in work|default|"") echo "$HOME/.claude" ;; *) echo "$HOME/.claude-$1" ;; esac; }
cfg_for()     { case "$1" in work|default|"") echo "$CFG_HOME/projects" ;; *) echo "$CFG_HOME/projects.$1" ;; esac; }
sock_for()    { case "$2" in work|default|"") echo "cf-$1" ;; *) echo "cf-$2-$1" ;; esac; }

cmd="${1:-}"; shift 2>/dev/null || true

case "$cmd" in
  list)
    printf '%-18s %-10s %-10s %-26s %s\n' PROJECT PROFILE AGENT FLEET PATH
    for f in "$CFG_HOME"/projects "$CFG_HOME"/projects.*; do
      [ -f "$f" ] || continue
# only real profile lists: a suffix like ".bak.1785" is a backup, not a profile — but
# guard ONLY the suffixed ones. On the primary `projects` there is nothing to strip, so
# ## leaves the whole path, whose own '/' and '.' trip the guard: the main list was
# skipped, so `list` showed the personal profiles and hid every work project.
      case "${f##*/}" in
        projects) ;;
        *) case "${f##*/projects.}" in *[!A-Za-z0-9_-]*) continue ;; esac ;;
      esac
      # NAMING EVERY COLUMN WAS HALF THE FIX. The other half is the separator: tab is
      # IFS-WHITESPACE, so `IFS=$'\t' read` collapses a RUN of tabs into one and an EMPTY
      # column 3 shifts every later field left. A project with no profile and an agent set
      # — `name<TAB>path<TAB><TAB>opencode` — came back as profile=opencode, agent=claude,
      # and therefore FLEET=cf-opencode-name: a socket that belongs to no fleet, printed
      # with confidence. Exactly CLAUDE.md's first entry, and it was reachable the moment
      # anything could set column 4 on a project whose column 3 was blank.
      #   awk with -F'\t' does NOT collapse (it is a field separator, not a whitespace
      # class), so it re-emits the row on \x1f, which is not IFS-whitespace either. Every
      # other reader of this file already went through awk; this was the one that did not.
      while IFS=$'\x1f' read -r n p prof agent; do
        case "$n" in ''|\#*) continue ;; esac
        [ -n "$p" ] || continue
        prof="${prof:-work}"
        printf '%-18s %-10s %-10s %-26s %s\n' "$n" "$prof" "${agent:-claude}" "$(sock_for "$n" "$prof")" "${p/#\~/$HOME}"
      #   OFS IS BUILT FROM A BYTE, NOT WRITTEN AS AN ESCAPE. `awk -v OFS='\x1f'` is a
      # gawk-ism: BSD awk (which is /usr/bin/awk on macOS, where this is developed) does
      # not decode \x, so OFS became the literal text and `IFS=$'\x1f' read` — bash DOES
      # decode it — found no separator, put the whole row in $n, and `[ -n "$p" ]` skipped
      # every project. An empty `fleet-project list`, from a fix for a field-shift bug.
      # sprintf("%c",31) is the same byte in every awk there is.
      done < <(awk -F'\t' 'BEGIN{ OFS = sprintf("%c", 31) } { print $1, $2, $3, $4 }' "$f")
    done
    ;;

  add)
    PATH_IN=""; NAME=""; PROFILE="work"; AGENT=""; START=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --name)    NAME="${2:?}";    shift 2 ;;
        --profile) PROFILE="${2:?}"; shift 2 ;;
        --agent)   AGENT="${2:?}";   shift 2 ;;
        --start)   START=1;          shift ;;
        -*) echo "fleet-project: unknown option $1" >&2; exit 1 ;;
        *)  [ -z "$PATH_IN" ] && { PATH_IN="$1"; shift; } || { echo "fleet-project: unexpected arg $1" >&2; exit 1; } ;;
      esac
    done
    [ -n "$PATH_IN" ] || { echo "fleet-project: usage: fleet-project add <path> [--name N] [--profile P] [--agent A] [--start]" >&2; exit 1; }
    # Reject an unknown agent HERE rather than writing it and letting every session in
    # the project quietly fall back to claude. A default that never applies is worse
    # than an error, because nothing ever reports that it didn't.
    if [ -n "$AGENT" ]; then
      if command -v fleet-agent >/dev/null 2>&1; then
        # A HERE-STRING, NOT A PIPE (CLAUDE.md, pipefail). Piped, `grep -q` quits on the
        # match and `fleet-agent list` can take SIGPIPE writing the agents after it, which
        # pipefail turns into "unknown agent 'opencode'": measured 15 of 400 on macOS.
        grep -qx -- "$AGENT" <<< "$(fleet-agent list 2>/dev/null)" \
          || { echo "fleet-project: unknown agent '$AGENT' (known: $(fleet-agent list | tr '\n' ' '))" >&2; exit 1; }
      else
        case "$AGENT" in *[!a-z0-9_-]*) echo "fleet-project: bad agent '$AGENT'" >&2; exit 1 ;; esac
      fi
    fi
    ROOT="$(cd "${PATH_IN/#\~/$HOME}" 2>/dev/null && pwd)" \
      || { echo "fleet-project: no such directory: $PATH_IN" >&2; exit 1; }
    [ -n "$NAME" ] || NAME="${ROOT##*/}"
    case "$NAME" in *[!A-Za-z0-9._-]*) echo "fleet-project: bad name '$NAME' (use A-Za-z0-9._-)" >&2; exit 1 ;; esac

    CFG="$(cfg_for "$PROFILE")"; mkdir -p "$CFG_HOME" 2>/dev/null
    if [ -f "$CFG" ] && awk -F'\t' -v n="$NAME" '$1==n{f=1} END{exit !f}' "$CFG"; then
      echo "fleet-project: '$NAME' is already a project in profile '$PROFILE'"
    else
      # Only write the 4th column when there IS one. A plain add keeps producing the
      # three-column line every existing reader already handles.
      if [ -n "$AGENT" ]; then
        printf '%s\t%s\t%s\t%s\n' "$NAME" "$ROOT" "$PROFILE" "$AGENT" >> "$CFG"
      else
        printf '%s\t%s\t%s\n' "$NAME" "$ROOT" "$PROFILE" >> "$CFG"
      fi
      echo "fleet-project: added '$NAME' ($PROFILE${AGENT:+, agent $AGENT}) -> $ROOT"
    fi

    SOCK="$(sock_for "$NAME" "$PROFILE")"; CDIR="$(profile_dir "$PROFILE")"
    echo "fleet-project: fleet $SOCK · open it with:  ghostfleet   (then pick $NAME)"

    if [ "$START" = 1 ]; then
      # same main-checkout rule as the TUI: <root>/<name>, else a git dir at depth 1,
      # else the root itself
      main="$ROOT/$NAME"
      [ -d "$main/.git" ] || main="$(find "$ROOT" -maxdepth 1 -type d -exec test -e '{}/.git' ';' -print 2>/dev/null | head -1)"
      [ -n "$main" ] && [ -d "$main" ] || main="$ROOT"
      mkdir -p "$CDIR/fleet" 2>/dev/null
      if tmux -L "$SOCK" has-session -t master 2>/dev/null; then
        echo "fleet-project: master already running on $SOCK"
      else
        tmux -L "$SOCK" -f "$CONF" new-session -d -s master -c "$main" \
          -e "CLAUDE_CONFIG_DIR=$CDIR" -e "CLAUDE_FLEET_SOCK=$SOCK" "exec agent-here master" \
          && echo "fleet-project: started master in $main" \
          || { echo "fleet-project: could not start master" >&2; exit 1; }
      fi
      echo "fleet-project: dispatch to it with:  fleet-send -s $SOCK master \"<brief>\""
    fi
    ;;

  # SET OR CLEAR the 4th column on a project that already exists. Everything downstream
  # of the projects file could already read an agent and nothing could write one after
  # `add`, so a project created before this — which is all of Pablo's — had no way to
  # change it short of editing the file by hand.
  #
  # `--none` CLEARS IT BACK TO AN EMPTY COLUMN, and the empty column is load-bearing: the
  # phone's card prints "profile · agent" only when the agent is truthy, so writing the
  # literal word `claude` would make every default project start displaying "· claude".
  # Absent means claude; that is the contract set_project() already implements.
  agent)
    NAME=""; WANT=""; HAVE_WANT=0; SESS=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --session) SESS="${2:?}"; shift 2 ;;
        --none)    WANT=""; HAVE_WANT=1; shift ;;
        -*) echo "fleet-project: unknown option $1" >&2; exit 1 ;;
        *) if [ -z "$NAME" ]; then NAME="$1"; else WANT="$1"; HAVE_WANT=1; fi; shift ;;
      esac
    done
    [ -n "$NAME" ] || { echo "fleet-project: usage: fleet-project agent <name> [<agent>|--none] [--session S]" >&2; exit 1; }
    case "$WANT" in
      none|'') WANT="" ;;
      *) if command -v fleet-agent >/dev/null 2>&1; then
           grep -qx -- "$WANT" <<< "$(fleet-agent list 2>/dev/null)" \
             || { echo "fleet-project: unknown agent '$WANT' (known: $(fleet-agent list | tr '\n' ' '))" >&2; exit 1; }
         else
           case "$WANT" in *[!a-z0-9_-]*) echo "fleet-project: bad agent '$WANT'" >&2; exit 1 ;; esac
         fi ;;
    esac
    found=0; PROF=""
    for f in "$CFG_HOME"/projects "$CFG_HOME"/projects.*; do
      [ -f "$f" ] || continue
      case "${f##*/}" in
        projects) ;;
        *) case "${f##*/projects.}" in *[!A-Za-z0-9_-]*) continue ;; esac ;;
      esac
      awk -F'\t' -v n="$NAME" '$1==n{f=1} END{exit !f}' "$f" || continue
      PROF="$(awk -F'\t' -v n="$NAME" '$1==n{print $3; exit}' "$f")"; PROF="${PROF:-work}"
      # --session NEVER TOUCHES THE PROJECTS FILE: the setting for one session is its own
      # agent marker, which the switch below writes once the session is really running it.
      if [ -n "$SESS" ]; then found=1; break; fi
      tmp="$f.$$.tmp"
      # REWRITTEN WITH awk, AND THE COMMENTS SURVIVE. `$1==n` never matches a comment line,
      # so they and the blanks pass through untouched — the header this file ships with is
      # the only documentation of the format and losing it to an edit would be silent.
      #   NF is forced to 4 ONLY on the row being changed, and only when an agent is being
      # set: a plain three-column line elsewhere in the file stays three columns, which is
      # what keeps `add` and every existing reader looking at the format they were written
      # for. Clearing drops back to 3 for the same reason.
      awk -F'\t' -v OFS='\t' -v n="$NAME" -v a="$WANT" '
        $1 != n { print; next }
        # ASSIGNING $4 IS WHAT MAKES COLUMN 3, and that is awk doing it, not this code:
        # setting a field past NF extends the record and fills the gap with empty
        # strings. A hand-rolled loop to create column 3 was here and could not be made
        # to fail — dead defence reads exactly like live defence, so it is gone.
        { if (a == "") { NF = (NF > 3 ? 3 : NF) }
          else         { $4 = a; NF = 4 }
          print }
      ' "$f" > "$tmp" 2>/dev/null && mv -f "$tmp" "$f" && found=1
      rm -f "$tmp" 2>/dev/null
    done
    [ "$found" = 1 ] || { echo "fleet-project: no project '$NAME'" >&2; exit 1; }
    [ -n "$SESS" ] && [ "$HAVE_WANT" = 0 ] && { echo "fleet-project: --session needs an agent (or --none)" >&2; exit 1; }
    # The switch engine calls back in here to put the setting right after a failed switch;
    # that call must write the column and nothing else, or it would request a switch of
    # its own.
    [ "${CLAUDE_FLEET_SWITCH_SETTING_ONLY:-0}" = 1 ] && exit 0
    if [ -z "$SESS" ]; then
      if [ -n "$WANT" ]; then
        echo "fleet-project: '$NAME' will start its master as $WANT"
        cav="$(fleet-agent caveat "$WANT" 2>/dev/null || true)"
        [ -n "$cav" ] && echo "fleet-project: heads up — $cav"
      else
        echo "fleet-project: '$NAME' is back to the default agent (claude)"
      fi
    fi
    # ── AND THE RUNNING ONE SWITCHES TOO ─────────────────────────────────────────
    # This used to stop at the setting, with a line saying the running master keeps the
    # agent it started with — CLAUDE_FLEET_AGENT is read once, when the tmux session is
    # created. The owner set a project to codex and its master went on answering as claude,
    # which is a setting that reads as broken however clearly the line said so. Now the
    # running session is moved onto the new agent by lib/agent-switch.sh: at once when idle,
    # after its current turn when not, with both conversations kept (its header has the
    # rules). Workers are NOT touched — a running worker keeps its agent, a new one inherits
    # the column.
    SLOT="${SESS:-master}"; SOCK="$(sock_for "$NAME" "$PROF")"; DIR="$(profile_dir "$PROF")/fleet"
    TO="${WANT:-claude}"
    res="$(bash "$BIN_DIR/../lib/agent-switch.sh" request "$DIR" "$SOCK" "$SLOT" "$TO" "$([ -z "$SESS" ] && printf '%s' "$NAME")" 2>&1)"
    # codex keeps no conversation through a pane kill, so "back to codex" is a NEW one. Said
    # here, at the moment of choosing, and only when there was a codex conversation to lose.
    fresh_note=""
    if [ "$(fleet-agent field "$TO" resume 2>/dev/null)" != yes ] \
       && jq -e --arg a "$TO" 'has($a)' "$DIR/$SOCK.$SLOT.convs.json" >/dev/null 2>&1; then
      fresh_note=" — $TO can't resume, it starts fresh"
    fi
    case "$res" in
      not-running*)  echo "fleet-project: '$SLOT' is not running — it starts as $TO next time" ;;
      already*)      echo "fleet-project: '$SLOT' already runs $TO" ;;
      cancelled*)    echo "fleet-project: '$SLOT' already runs $TO — the pending switch is cancelled" ;;
      missing*)      set -- $res
                     echo "fleet-project: cannot switch the running '$SLOT' — $2 is not installed ('$3' is not on PATH), so it stays on $4" >&2
                     [ -z "$SESS" ] && echo "fleet-project: '$NAME' is back on $4, so the next master does not start into a missing binary" >&2
                     exit 1 ;;
      pending-busy*) echo "fleet-project: switching '$SLOT' from ${res#pending-busy } to $TO when its current turn ends$fresh_note" ;;
      pending*)      echo "fleet-project: switching '$SLOT' from ${res#pending } to $TO now$fresh_note" ;;
      *)             echo "fleet-project: could not switch the running '$SLOT': $res" >&2 ;;
    esac
    ;;

  set|get)
    . "$BIN_DIR/../lib/boundary.sh"
    NAME=""; BSOCK=""; SESS=""; POS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        -s)        BSOCK="${2:?}"; shift 2 ;;
        --session) SESS="${2:?}";  shift 2 ;;
        -*) echo "fleet-project: unknown option $1" >&2; exit 1 ;;
        *)  POS+=("$1"); shift ;;
      esac
    done
    [ -n "$BSOCK" ] || { NAME="${POS[0]:-}"; POS=("${POS[@]:1}"); }
    # Find the project's profile — it decides both the socket and the fleet dir the markers
    # live in. By name, or by socket (what a refusal knows), across every profile's list.
    PROF=""; found=0
    for f in "$CFG_HOME"/projects "$CFG_HOME"/projects.*; do
      [ -f "$f" ] || continue
      case "${f##*/}" in projects) ;; *) case "${f##*/projects.}" in *[!A-Za-z0-9_-]*) continue ;; esac ;; esac
      while IFS=$'\x1f' read -r n _p prof _a; do
        case "$n" in ''|\#*) continue ;; esac
        prof="${prof:-work}"
        if { [ -n "$NAME" ] && [ "$n" = "$NAME" ]; } || { [ -n "$BSOCK" ] && [ "$(sock_for "$n" "$prof")" = "$BSOCK" ]; }; then
          NAME="$n"; PROF="$prof"; found=1; break 2
        fi
      done < <(awk -F'\t' 'BEGIN{ OFS = sprintf("%c", 31) } { print $1, $2, $3, $4 }' "$f")
    done
    [ "$found" = 1 ] || { echo "fleet-project: no project '${NAME:-$BSOCK}'" >&2; exit 1; }
    SOCK="$(sock_for "$NAME" "$PROF")"; DIR="$(profile_dir "$PROF")/fleet"
    if [ "$cmd" = get ]; then
      for b in $BOUNDARY_SETTINGS; do
        boundary_on "$b" "$DIR" "$SOCK" "$SESS" && v=on || v=off
        printf '%-15s %-4s  (%s)\n' "$b" "$v" "$(boundary_label "$b")"
      done
      exit 0
    fi
    B="${POS[0]:-}"; V="${POS[1]:-}"
    case " $BOUNDARY_SETTINGS " in *" $B "*) ;; *)
      echo "fleet-project: usage: fleet-project set <name|-s sock> <workers-merge|agents-approve> <on|off|inherit> [--session S]" >&2; exit 1 ;; esac
    mkdir -p "$DIR" 2>/dev/null
    if [ -n "$SESS" ]; then
      m="$DIR/$SOCK.$SESS.$B"
      case "$V" in
        on)      : > "$m";       rm -f "$m-off" ;;
        off)     : > "$m-off";   rm -f "$m" ;;
        inherit) rm -f "$m" "$m-off" ;;
        *) echo "fleet-project: set --session takes on, off or inherit" >&2; exit 1 ;;
      esac
      boundary_on "$B" "$DIR" "$SOCK" "$SESS" && v=on || v=off
      echo "fleet-project: '$(boundary_label "$B")' for session '$SESS' in '$NAME': $V (resolves to $v)"
    else
      case "$V" in
        on)  : > "$DIR/$SOCK.$B" ;;
        off) rm -f "$DIR/$SOCK.$B" ;;
        *) echo "fleet-project: set takes on or off for a project (inherit is for --session)" >&2; exit 1 ;;
      esac
      echo "fleet-project: '$(boundary_label "$B")' for project '$NAME': $V"
    fi
    ;;

  rm|remove)
    NAME="${1:-}"; [ -n "$NAME" ] || { echo "fleet-project: usage: fleet-project rm <name>" >&2; exit 1; }
    found=0
    for f in "$CFG_HOME"/projects "$CFG_HOME"/projects.*; do
      [ -f "$f" ] || continue
# same guard as `list`: the primary `projects` has no suffix to strip, and skipping it
# here made `rm` silently find nothing for any work project (found=0, exit 1).
      case "${f##*/}" in
        projects) ;;
        *) case "${f##*/projects.}" in *[!A-Za-z0-9_-]*) continue ;; esac ;;
      esac
      if awk -F'\t' -v n="$NAME" '$1==n{f=1} END{exit !f}' "$f"; then
        tmp="$f.$$.tmp"
        awk -F'\t' -v n="$NAME" '$1!=n' "$f" > "$tmp" 2>/dev/null && mv -f "$tmp" "$f" && found=1
      fi
    done
    [ "$found" = 1 ] && echo "fleet-project: removed '$NAME' from the list (its sessions + history are untouched)" \
                     || { echo "fleet-project: no project '$NAME'" >&2; exit 1; }
    ;;

  *)
    echo "fleet-project: usage:" >&2
    echo "  fleet-project add <path> [--name N] [--profile P] [--agent A] [--start]" >&2
    echo "  fleet-project agent <name> [<agent>|--none] [--session S]" >&2
    echo "  fleet-project list" >&2
    echo "  fleet-project rm <name>" >&2
    echo "  fleet-project set <name|-s sock> <workers-merge|agents-approve> <on|off|inherit> [--session S]" >&2
    echo "  fleet-project get <name|-s sock> [--session S]" >&2
    exit 1 ;;
esac
