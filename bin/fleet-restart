#!/usr/bin/env bash
# fleet-restart — relaunch fleet sessions onto the CURRENT agent binary, each one
# resuming ITS OWN conversation.
#
#   fleet-restart --all                every fleet on this machine
#   fleet-restart -s <socket>          one fleet
#   fleet-restart --project <name>     one fleet, by project name (cf-<name>)
#   fleet-restart --dry-run            print the plan and change nothing
#   fleet-restart --yes                skip the confirmation
#   fleet-restart --reopen <session>   bring back a session you typed `exit` in
#   fleet-restart -s <socket> --session <name> [--no-continue | --continue <prompt>]
#                                      one session only; --no-continue never prompts it,
#                                      --continue always does, with that prompt
#   fleet-restart --self-test          the built-in checks (test/run.sh runs these)
#
# Exits non-zero when anything under Failed: did not come back, with the command that does it.
#   CLAUDE_FLEET_RESTART_WAIT       seconds to outwait the old process, then TERM it (120; 0: neither)
#   CLAUDE_FLEET_RESTART_TERM_WAIT  seconds to give it after that TERM (10)
#   CLAUDE_FLEET_RESTART_CONFIRM    seconds for the new agent to show its conversation (60)
#
# ── WHY THIS EXISTS ───────────────────────────────────────────────────────────
# bin/agent-here already says it: a fleet turns the binary-swap race into a routine
# one, so "fleet sessions do not auto-update; you update deliberately, with the
# fleet idle". That left no way to ACT on a deliberate update — the owner updated
# Claude Code with dozens of sessions live and had no path onto the new version
# that did not lose them.
#
# ── WHY BY RECORDED ID AND NEVER BY --continue ────────────────────────────────
# `--continue` reopens the most recent conversation IN THAT FOLDER. Measured on
# this machine, from ~/.claude/fleet: one checkout holds FOURTEEN sessions —
#
#     /Users/…/scratch  -> 14 sessions, all "scratch · main"
#
# so --continue can reach exactly one of them and the other thirteen are
# unreachable by any path in the code. That is the whole of "i use parallel
# session and if i type exit the session is completely remove it and i cant reopen
# it easily". Every session here is relaunched with CLAUDE_FLEET_RESUME=<its own
# recorded session_id>, which the <agent>-here launchers turn into `claude
# --resume <id>` / `opencode --session <id>` — and claude-here already refuses to
# fall back to "newest in this cwd" when given an explicit id, which is exactly the
# property this needs.
#
# ── SNAPSHOT BEFORE MUTATING ──────────────────────────────────────────────────
# A fleet-wide operation that dies halfway is the worst case: some sessions gone
# and no record of which of them were working. So the plan is written to disk
# BEFORE the first kill, and the path is printed. If this dies, that file says what
# every session was and what it was going to get.
set -uo pipefail

FLEET_DIR="${CLAUDE_FLEET_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/fleet}"
# The CALLER's account, kept only to be named in a refusal and to hold the snapshot of a
# multi-fleet run. A fleet's own account comes from use_fleet below, never from here.
CALLER_CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; CALLER_FLEET_DIR="$FLEET_DIR"
SOCK_DIR="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
US=$'\x1f'

MODE=""; ONE=""; PROJECT_ARG=""; DRY=0; YES=0; SELFTEST=0; REOPEN=""; ONLY_SLOT=""; NO_CONTINUE=0; FORCE_CONT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all)      MODE=all ;;
    -s)         MODE=one; ONE="${2:-}"; shift ;;
    --project)  MODE=one; PROJECT_ARG="${2:-}"; shift ;;
    --dry-run)  DRY=1 ;;
    --yes|-y)   YES=1 ;;
    --reopen)   MODE=reopen; REOPEN="${2:-}"; shift ;;
    --session)  ONLY_SLOT="${2:-}"; shift ;;
    --no-continue) NO_CONTINUE=1 ;;
    --continue) FORCE_CONT="${2:-}"; shift ;;
    --self-test) SELFTEST=1 ;;
    -h|--help)  sed -n '2,19p' "$0"; exit 0 ;;
    *) echo "fleet-restart: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done

# ── the caller, which must be restarted LAST ──────────────────────────────────
# Whoever runs this is usually a lead, and killing your own pane mid-command ends
# the turn that is running it — the fleet is then half-restarted with nobody
# holding the report. Detected from $TMUX (drift-proof; a long-running --resume
# session can hold a stale CLAUDE_FLEET_SOCK, which is why fleet-list prefers it
# too) plus the slot the launcher exported.
SELF_SOCK=""; _t="${TMUX:-}"
case "${_t##*/}" in cf-*) SELF_SOCK="${_t%%,*}"; SELF_SOCK="${SELF_SOCK##*/}" ;; esac
SELF_SLOT="${CLAUDE_FLEET_SLOT:-}"

# ── the newest recorded conversation for THIS (sock, slot) ────────────────────
# Scoped by sock AND slot, because every fleet has a session called `master` and
# matching on slot alone reports another project's conversation. Same shape as
# fleet-list's lookup, including the legacy no-sock fallback, which is never used
# for the ambiguous `master`.
# ── EVERY RECORD, READ ONCE ───────────────────────────────────────────────────
# The obvious shape is a jq per file per lookup, and it is what this had: ~90
# records x 3 lookups x every session, which on the real fleet is tens of thousands
# of jq processes and a --dry-run that had not finished a fifth of the fleet in two
# minutes. One jq over all of them, into one table, and the lookups become awk over
# a string. Measured on this machine: 88 records, 20 fleets.
RECORDS=""
load_records() {
  command -v jq >/dev/null 2>&1 || return 0
  RECORDS="$(jq -r '[(.sock // ""), (.slot // ""), (.ts // 0), (.session_id // ""), (.status // "")] | @tsv' \
    "$FLEET_DIR"/*.json 2>/dev/null)"
}

# ── the newest recorded conversation for THIS (sock, slot) ────────────────────
# Scoped by sock AND slot, because every fleet has a session called `master` and
# matching on slot alone reports another project's conversation. Same shape as
# fleet-list's lookup, including the legacy no-sock fallback, which is never used
# for the ambiguous `master`.
#   TWO RECORDS FOR ONE SLOT ARE NOT SETTLED BY RECENCY. A conversation resumed into the
# wrong pane gets that pane's name in its record, and is then the newest claimant of a slot
# it was never born in — so "newest" handed a lead's card back to the intruder. Asked of
# lib/slot-claim.mjs, which reads each claimant's name history and says loudly which it took.
sid_for() {
  local sock="$1" slot="$2" out="" agent
  if [ -f "$LIB/slot-claim.mjs" ] && command -v node >/dev/null 2>&1; then
    agent="$(agent_for "$sock" "$slot")"
    out="$(node "$LIB/slot-claim.mjs" pick --keep-live --dir "$FLEET_DIR" --sock "$sock" --slot "$slot" \
           --agent "$([ "$agent" = codex ] && echo codex || echo claude)")"
    out="${out%%"$US"*}"
  fi
  [ -n "$out" ] || out="$(printf '%s\n' "$RECORDS" | awk -F'\t' -v s="$slot" -v k="$sock" \
         '$2==s && $1==k && $4!="" {print $3"\t"$4}' | sort -rn | head -1 | cut -f2)"
  if [ -z "$out" ] && [ "$slot" != master ]; then
    out="$(printf '%s\n' "$RECORDS" | awk -F'\t' -v s="$slot" \
           '$2==s && $1=="" && $4!="" {print $3"\t"$4}' | sort -rn | head -1 | cut -f2)"
  fi
  printf '%s' "$out"
}

status_for() {
  local sock="$1" slot="$2" st=""
  [ -f "$FLEET_DIR/$sock.$slot.parked" ] && { printf 'parked'; return; }
  [ -f "$FLEET_DIR/$slot.parked" ] && { printf 'parked'; return; }
  st="$(printf '%s\n' "$RECORDS" | awk -F'\t' -v s="$slot" -v k="$sock" \
        '$2==s && $1==k {print $3"\t"$5}' | sort -rn | head -1 | cut -f2)"
  printf '%s' "${st:-unknown}"
}

agent_for() {
  local sock="$1" slot="$2" a=""
  [ -f "$FLEET_DIR/$sock.$slot.agent" ] && a="$(cat "$FLEET_DIR/$sock.$slot.agent" 2>/dev/null)"
  printf '%s' "${a:-claude}"
}

cwd_for() {
  local sock="$1" slot="$2"
  tmux -u -L "$sock" display-message -t "$slot" -p '#{pane_current_path}' 2>/dev/null
}

# ── what a restarted session is told, and only when it was MID-TURN ───────────
# A session that was working had a turn killed under it. Resuming restores the
# conversation but not the turn, so without this it comes back holding the work
# and doing nothing about it. A session that was READY is not prompted: starting
# work nobody asked for is the one outcome worse than a stale binary.
CONTINUE_PROMPT='Your session was restarted to pick up a new agent version. The conversation is intact; the turn that was running was interrupted. Continue what you were working on.'

sockets() {
  case "$MODE" in
    one) [ -S "$SOCK_DIR/$ONE" ] && printf '%s\n' "$ONE" ;;
    *)   for s in "$SOCK_DIR"/cf-*; do [ -S "$s" ] && printf '%s\n' "${s##*/}"; done ;;
  esac
}

# ── THE PLAN, BUILT BEFORE ANYTHING IS TOUCHED ────────────────────────────────
# One row per session, \x1f-separated: sock, slot, agent, status, action, id, cwd, why.
# NOT A TAB: a skipped row has no id, tab is IFS-whitespace, and the empty field
# collapsed — the reason slid into the cwd column and every skip printed "— " with
# nothing after it, which is the one line the report exists to say.
# ACTION is decided here and nowhere else, so the table that gets written to disk
# is the same table that gets executed — a snapshot that described a different
# plan than the one that ran would be worse than no snapshot.

# ── THE DECISION, LIFTED OUT SO IT CAN BE ASKED WITHOUT A FLEET ───────────────
# classify <agent> <status> <id> <is_self>  ->  sets ACT and WHY.
#
# plan_rows calls this and so does --self-test. A rule that is tested against a
# COPY of itself is a rule with two spellings, which is the drift this repo keeps
# writing down; one function, one answer, asked the same way by both.
classify() {
  local agent="$1" st="$2" id="$3" is_self="$4" noid="${5:-no recorded conversation id}"
  ACT=""; WHY=""
  if [ -z "$id" ]; then
    # NEVER GUESS WITH --continue. In a folder holding more than one conversation
    # it reopens somebody else's, and this machine has a checkout holding
    # fourteen. A session with no conversation to resume is reported and left
    # alone — the reason says which kind of "no" it was.
    ACT=skip; WHY="$noid"
  elif [ "$(fleet-agent field "$agent" resume 2>/dev/null)" != yes ]; then
    # An agent whose conversation does not survive a pane kill (codex before 0.160.1
    # was one; fleet-agent's resume field says which). Restarting it would open a
    # BLANK conversation wearing the old card's name, which is worse than a stale
    # binary because it looks like it worked.
    ACT=skip; WHY="$agent has no resume path that survives a pane kill"
  elif [ "$is_self" = 1 ]; then
    ACT=self; WHY="the session running this command"
  else
    case "$st" in
      working|limit|interrupted) ACT=resume-continue ;;
      # RESUMED AND LEFT IDLE, NOT CONTINUED, and this is the one judgement call in
      # the table. A need-you session is blocked on a dialog drawn in its PANE, and
      # a pane dialog is not in the transcript at all — so resuming restores the
      # conversation and not the question. Telling it to continue would have it
      # answer, by inference, a question the human never saw. It is listed by name
      # instead, which costs one glance and cannot invent an answer.
      #   (A permission prompt WOULD re-fire on the next tool call; a question the
      # agent ASKED would not, because that turn already ended. In a fleet running
      # with permissions bypassed, a need-you is more often the second kind — it is
      # the case that got through the bypass.)
      need-you) ACT=resume-idle; WHY="was waiting on you — re-ask it yourself" ;;
      *) ACT=resume-idle ;;
    esac
  fi
}

# ── THE ID COMES FROM THE PROCESS, NOT FROM THE RECORD ────────────────────────
# The recorded id is a claim and it goes stale. Measured on a live fleet: a lead's
# record named a conversation with NO transcript anywhere — the session had been
# reopened into a fresh conversation that never took a turn — so `--resume` of it
# failed, the agent exited, and the pane closed and took the card with it. The
# restart had killed a working session to replace it with nothing.
#   fleet-hibernate already answers "which conversation is this process writing"
# (live_sid, and the record correction beside it), so it is ASKED, not copied: a
# second spelling of that rule is the drift this repo keeps writing down.
#   Claude through fleet-hibernate, codex through the rollout its process holds open
# (lib/codex-rollout.mjs). Any other agent whose resume survives a pane kill keeps its
# recorded id, as before.
#   STRICT, on purpose, and the same line hibernation holds. A resolvable process
# whose conversation has no transcript has nothing to resume; a process that cannot
# say which conversation it is in might be in any of them, and a recorded id with a
# transcript is exactly how the wrong conversation comes back looking right. Either
# way the session is refused with the reason and LEFT RUNNING — the old binary is a
# smaller loss than the card.
# Sets RID (the id to resume, or empty) and RWHY (why it is empty).
HIB="$(dirname "$0")/fleet-hibernate"; [ -x "$HIB" ] || HIB=fleet-hibernate
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do _t="$(readlink "$_src")"; case "$_t" in /*) _src="$_t" ;; *) _src="$(dirname "$_src")/$_t" ;; esac; done
LIB="$(cd "$(dirname "$_src")/../lib" 2>/dev/null && pwd)"
CONF="$(cd "$(dirname "$_src")/../tmux" 2>/dev/null && pwd)/cf.tmux.conf"

# ── WHOSE FLEET IS THIS: the socket's own account, never the caller's ─────────
# Every fleet session exports CLAUDE_FLEET_DIR for ITS OWN profile, and this used to take
# the account from that. Run from a pane on the default profile against a fleet on another
# one, a reopen relaunched that fleet's session under the default account: it stopped at a
# "trust this folder?" that account had never been asked, and one whose conversation lived
# only under its own account said "no conversation found" and exited. Prefixing the right
# CLAUDE_CONFIG_DIR did not help, because CLAUDE_FLEET_DIR outranked it.
#   So the socket is resolved to its project through lib/projects.mjs — the reader the MCP
# tools and the phone already use, from the same projects files bin/ghostfleet reads — and
# that project's config dir and fleet dir are used for everything: the records read, the
# helpers asked (exported, so fleet-hibernate and fleet-send agree), the session launched.
#   A socket no project owns is REFUSED, not run under the caller's account: that fallback
# is exactly the bug, and there is no third place to learn the answer from.
# Sets FLEET_DIR and RCFG RPROF RNAME RROOT; 1 when the socket is nobody's.
RCFG=""; RPROF=""; RNAME=""; RROOT=""
use_fleet() {
  local out=""
  RCFG=""; RPROF=""; RNAME=""; RROOT=""
  command -v node >/dev/null 2>&1 && [ -f "$LIB/projects.mjs" ] || return 1
  out="$(node "$LIB/projects.mjs" sock "$1" 2>/dev/null)" && [ -n "$out" ] || return 1
  IFS="$US" read -r RNAME RPROF RCFG RROOT _ <<< "$out"
  [ -n "$RCFG" ] || return 1
  FLEET_DIR="$RCFG/fleet"
  export CLAUDE_CONFIG_DIR="$RCFG" CLAUDE_FLEET_DIR="$FLEET_DIR" CLAUDE_FLEET_PROFILE="$RPROF"
}
# --project <name> is a socket only once its profile is known: cf-<name> on the default
# profile, cf-<profile>-<name> on any other. Spelling it cf-<name> unconditionally named a
# fleet that does not exist for every project off the default profile.
if [ -n "$PROJECT_ARG" ]; then
  _p="$(node "$LIB/projects.mjs" name "$PROJECT_ARG" 2>/dev/null)"; _rc=$?
  case "$_rc" in
    0) ONE="${_p##*"$US"}" ;;
    3) echo "fleet-restart: two profiles each have a project called '$PROJECT_ARG' — pass -s <socket>" >&2; exit 2 ;;
    *) echo "fleet-restart: no registered project called '$PROJECT_ARG'" >&2; exit 1 ;;
  esac
fi
unowned() {
  printf 'no registered project owns %s, so the account it runs under is unknown — not relaunching it under yours (%s)' "$1" "$CALLER_CFG"
}
live_id() {
  local sock="$1" slot="$2" agent="$3" rec="$4" out lid ltr
  RID="$rec"; RWHY=""
  # codex: the rollout its process holds open (lib/codex-rollout.mjs). Unlike claude's, an
  # unresolved codex keeps its recorded id — a codex that has not taken a turn since it was
  # (re)opened holds nothing open yet, and its record is the one the watcher wrote for it.
  if [ "$agent" = codex ]; then
    local ppid_; ppid_="$(tmux -u -L "$sock" display-message -p -t "$slot" '#{pane_pid}' 2>/dev/null)"
    [ -n "$ppid_" ] && out="$(node "$LIB/codex-rollout.mjs" resolve --pid "$ppid_" 2>/dev/null)" \
      && [ -n "$out" ] && RID="${out%%"$US"*}"
    return 0
  fi
  [ "$agent" = claude ] || return 0
  if out="$("$HIB" --resolve "$sock" "$slot" 2>/dev/null)" && [ -n "$out" ]; then
    IFS="$US" read -r lid ltr _ <<< "$out"
    if [ -n "$ltr" ] && [ -f "$ltr" ]; then RID="$lid"; return 0; fi
    RID=""; RWHY="its live conversation ${lid%%-*} has no transcript — it never took a turn, so there is nothing to resume"
    return 0
  fi
  RID=""; RWHY="its live conversation could not be established — the recorded id${rec:+ ${rec%%-*}} may be stale, and this will not guess"
}

PLAN=""
plan_rows() {
  local sock slot agent st id cwd act why
  while IFS= read -r sock; do
    [ -n "$sock" ] || continue
    # EACH FLEET UNDER ITS OWN ACCOUNT. --all walks every fleet on the machine, and they are
    # not all on the caller's profile; one whose owner cannot be named is listed, not touched.
    if ! use_fleet "$sock"; then
      while IFS= read -r slot; do
        case "$slot" in _*|'') continue ;; esac
        [ -z "$ONLY_SLOT" ] || [ "$slot" = "$ONLY_SLOT" ] || continue
        PLAN="$PLAN$sock$US$slot$US-${US}unknown${US}skip$US$US$(cwd_for "$sock" "$slot")$US$(unowned "$sock")
"
      done < <(tmux -u -L "$sock" list-sessions -F '#{session_name}' 2>/dev/null)
      continue
    fi
    load_records
    while IFS= read -r slot; do
      [ -n "$slot" ] || continue
      # A LEADING UNDERSCORE IS A TAB, NOT AN AGENT. CLAUDE.md: tab sessions are
      # prefixed `_` precisely so a bare tmux target cannot be read as an
      # expression. They are editor and terminal panes — there is no conversation
      # under them to resume, and on the real fleet they were two thirds of
      # everything this listed, every one of them reported as "no recorded
      # conversation id". Measured: 20 of 30 sessions on one socket.
      case "$slot" in _*) continue ;; esac
      [ -z "$ONLY_SLOT" ] || [ "$slot" = "$ONLY_SLOT" ] || continue
      agent="$(agent_for "$sock" "$slot")"
      st="$(status_for "$sock" "$slot")"
      id="$(sid_for "$sock" "$slot")"
      cwd="$(cwd_for "$sock" "$slot")"
      live_id "$sock" "$slot" "$agent" "$id"; id="$RID"
      classify "$agent" "$st" "$id" "$([ "$sock" = "$SELF_SOCK" ] && [ "$slot" = "$SELF_SLOT" ] && echo 1 || echo 0)" "$RWHY"
      act="$ACT"; why="$WHY"
      # --no-continue: the caller restarts an IDLE session for its own reason (fleet-mod
      # reload, onto a Claude that can run the mod). A record can still say `working` from a
      # turn whose Stop never came, and telling that session to "continue" would start a turn
      # nobody asked for. Decided here, so the table and the snapshot say what will happen.
      [ "$NO_CONTINUE" = 1 ] && [ "$act" = resume-continue ] && act=resume-idle
      # --continue: the caller KNOWS this session's turn was cut short and why — a worker
      # parked mid-task, say. Its record says whatever the park left (interrupted, ready), and
      # only the caller can say "continue".
      [ -n "$FORCE_CONT" ] && [ "$act" = resume-idle ] && act=resume-continue
      PLAN="$PLAN$sock$US$slot$US$agent$US$st$US$act$US$id$US$cwd$US$why
"
    done < <(tmux -u -L "$sock" list-sessions -F '#{session_name}' 2>/dev/null)
  done < <(sockets)
}

# ── WRITTEN TO DISK BEFORE THE FIRST KILL ─────────────────────────────────────
# A fleet-wide operation that dies halfway is the worst case here: some sessions
# gone, and no record of which of them were working. This file is that record, and
# its path is printed before anything is touched so it can be read even if this
# process does not survive to print it again.
SNAP=""
write_snapshot() {
  local d="${SNAP_DIR:-$FLEET_DIR}"
  mkdir -p "$d" 2>/dev/null
  SNAP="$d/restart-$(date +%Y%m%d-%H%M%S).tsv"
  # Fleets restarted one after another land in the same second, and --reopen reads these.
  [ -e "$SNAP" ] && SNAP="${SNAP%.tsv}-$$.tsv"
  {
    printf '# fleet-restart snapshot %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf '# sock\tslot\tagent\tstatus\taction\tsession_id\tcwd\tnote\n'
    printf '%s' "$PLAN" | tr '\037' '\t'
  } > "$SNAP"
  echo "fleet-restart: snapshot written to $SNAP"
}

# ── OUTLAST THE OLD PROCESS ───────────────────────────────────────────────────
# 22 of 42 sessions vanished in one restart. kill-session does not end an agent: it hangs up the
# pane, and a process with a large transcript on a swapping machine then writes its exit record
# 20-60 s later. The new launcher, started in the same breath, gives a live holder 3 s, refuses,
# and exits, and its pane and card go with it. So the old process is outlasted first, and the
# launcher's few seconds are only for a process this could not name.
#   THE PID IS CAPTURED BEFORE THE KILL AND IS THE ONLY THING EVER SIGNALLED, and its start time
# travels with it, because a number can be reused during a two-minute wait. TERM at the bound and
# nothing stronger: a process that survives TERM is still writing, and the owner decides. A holder
# outside this pane is another session's business, so it is neither waited for nor signalled; the
# launcher refuses, and that is what gets reported.
#   A bad value in these must not read as 0, which takes the wait out and is the old race.
_secs() { case "${1:-}" in ''|*[!0-9]*) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac; }
RESTART_WAIT="$(_secs "${CLAUDE_FLEET_RESTART_WAIT:-}" 120)"
RESTART_TERM_WAIT="$(_secs "${CLAUDE_FLEET_RESTART_TERM_WAIT:-}" 10)"
RESTART_CONFIRM="$(_secs "${CLAUDE_FLEET_RESTART_CONFIRM:-}" 60)"
RESTART_SETTLE="$(_secs "${CLAUDE_FLEET_RESTART_SETTLE:-}" 5)"

# Exactly this session's panes. list-panes -a and a compare, not a target: bare -t falls through
# to a prefix once the name is gone, and display-message with `=` answers empty (CLAUDE.md).
pane_pids() {
  tmux -u -L "$1" list-panes -a -F "#{session_name}"$'\t'"#{pane_pid}" 2>/dev/null \
    | awk -F'\t' -v s="$2" '$1==s {print $2}' | tr '\n' ' '
}
# Separate -o flags, and a zombie is not alive: `kill -0` says yes to one, and a process whose
# parent never reaps it would hold this for the whole bound over nothing.
proc_line() { LC_ALL=C TZ=UTC ps -o stat= -o lstart= -p "$1" 2>/dev/null; }
proc_alive() {
  local st rest
  read -r st rest <<< "$(proc_line "$1")"
  [ -n "$st" ] || return 1
  case "$st" in Z*) return 1 ;; esac
  [ "$rest" = "$2" ]
}
OLD_PID=""; OLD_START=""
capture_old() {
  local sock="$1" slot="$2" id="$3" agent="${4:-claude}" roots out st
  OLD_PID=""; OLD_START=""
  roots="$(pane_pids "$sock" "$slot")"
  [ -n "$roots" ] || return 0
  out="$(node "$LIB/slot-claim.mjs" old-agent --id "$id" --agent "$agent" --roots "$roots" 2>/dev/null)"
  OLD_PID="${out%%"$US"*}"
  case "$OLD_PID" in ''|*[!0-9]*) OLD_PID="${roots%% *}" ;; esac
  read -r st OLD_START <<< "$(proc_line "$OLD_PID")"
  [ -n "$st" ] || OLD_PID=""
}
outlast_old() {
  local slot="$1" pid="$OLD_PID" start="$OLD_START" t0=$SECONDS gap=0.05 said=0
  [ -n "$pid" ] && [ "$RESTART_WAIT" -gt 0 ] || return 0
  while proc_alive "$pid" "$start"; do
    if [ $((SECONDS - t0)) -ge "$RESTART_WAIT" ]; then
      echo "fleet-restart: $slot: old process $pid is still alive after ${RESTART_WAIT}s — sending TERM to that pid" >&2
      kill -TERM "$pid" 2>/dev/null
      t0=$SECONDS
      while proc_alive "$pid" "$start" && [ $((SECONDS - t0)) -lt "$RESTART_TERM_WAIT" ]; do sleep 0.25; done
      proc_alive "$pid" "$start" \
        && echo "fleet-restart: $slot: old process $pid survived TERM; nothing stronger is sent, and the launcher will refuse" >&2
      return 0
    fi
    if [ "$said" = 0 ] && [ $((SECONDS - t0)) -ge 5 ]; then
      echo "fleet-restart: $slot: waiting for old process $pid to exit (up to ${RESTART_WAIT}s)" >&2
      said=1
    fi
    sleep "$gap"
    case "$gap" in 0.05) gap=0.1 ;; 0.1) gap=0.25 ;; esac
  done
}

# ── DID IT COME BACK ──────────────────────────────────────────────────────────
# new-session returning says a pane opened. The launcher decides seconds later whether anything
# runs in it, so a count taken here reported every one of those 22 lost sessions as relaunched,
# and exited 0. What counts is an agent in this session's panes showing this conversation. Its
# note is proof at once, since an agent writes that when it is up. An argv is proof of a start,
# and a resume with nothing to resume exits moments later, so that has to stay up for the settle.
# Sets CONFIRM_WHY when it did not come back.
CONFIRM_WHY=""
failed_row() {   # sock slot since -> the newest failed row's text. A sub-lead has an inbox of its own.
  local f
  for f in "$FLEET_DIR/$1.inbox" "$FLEET_DIR/$1".*.inbox; do
    [ -f "$f" ] || continue
    awk -F'\t' -v s="$2" -v t="$3" '$2==s && $3=="failed" && $1+0>=t+0 {print $1"\t"$4}' "$f" 2>/dev/null
  done | sort -n | tail -n 1 | cut -f2-
}
why_not_back() {  # sock slot id since what-happened last-on-screen
  local row
  row="$(failed_row "$1" "$2" "$4")"
  if [ -n "$row" ]; then printf '%s' "${row%% — once that process*}"; return; fi
  if [ -n "$OLD_PID" ] && proc_alive "$OLD_PID" "$OLD_START"; then
    printf '%s while old process %s still held conversation %s' "$5" "$OLD_PID" "$3"; return
  fi
  printf '%s before showing conversation %s%s' "$5" "$3" "${6:+; last on screen: $6}"
}
confirm_resumed() {
  local sock="$1" slot="$2" id="$3" agent="${4:-claude}" since="$5"
  local until=$((SECONDS + RESTART_CONFIRM)) seen="" seen_at=0 roots out pid how last="" line
  CONFIRM_WHY=""
  while :; do
    if ! tmux -L "$sock" has-session -t "=$slot" 2>/dev/null; then
      CONFIRM_WHY="$(why_not_back "$sock" "$slot" "$id" "$since" "its pane closed" "$last")"; return 1
    fi
    if [ -f "$FLEET_DIR/$sock.$slot.exited" ]; then
      CONFIRM_WHY="$(why_not_back "$sock" "$slot" "$id" "$since" "its agent exited and the pane is holding" "$last")"; return 1
    fi
    roots="$(pane_pids "$sock" "$slot")"; out=""
    [ -n "$roots" ] && out="$(node "$LIB/slot-claim.mjs" witness --id "$id" --agent "$agent" --roots "$roots" 2>/dev/null)"
    if [ -n "$out" ]; then
      IFS="$US" read -r pid how <<< "$out"
      [ "$how" = note ] && return 0
      if [ "$pid" != "$seen" ]; then seen="$pid"; seen_at=$SECONDS
      elif [ $((SECONDS - seen_at)) -ge "$RESTART_SETTLE" ]; then return 0
      fi
    else
      seen=""
    fi
    line="$(tmux -L "$sock" capture-pane -p -t "=$slot:" 2>/dev/null | sed '/^[[:space:]]*$/d' | tail -n 1 | tr '\t' ' ' | cut -c1-160)"
    [ -n "$line" ] && last="$line"
    if [ "$SECONDS" -ge "$until" ]; then
      [ -n "$seen" ] && return 0
      CONFIRM_WHY="still up after ${RESTART_CONFIRM}s, but nothing in its pane shows conversation $id${last:+; last on screen: $last}"
      return 1
    fi
    sleep 0.25
  done
}

# ── THE WAY BACK, PRINTED ─────────────────────────────────────────────────────
# One word, as bash and zsh both read it back. printf %q is not enough: it leaves a leading `=`
# bare, which zsh expands as a command lookup, so `-t =name` fails there before tmux ever runs.
_shq() {
  case "$1" in
    =*|''|*[!A-Za-z0-9_./=:@%+,-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf '%s' "$1" ;;
  esac
}
# --reopen when it would resume this very id, the explicit form when it would not, since it is
# free to settle a slot on another conversation. A name still taken has to be cleared either way.
way_back() {
  local sock="$1" slot="$2" id="$3" cwd="$4" agent="${5:-}" cmd="" w
  load_records
  if resolve_reopen "$sock" "$slot" 2>/dev/null && [ "$RO_ID" = "$id" ]; then
    cmd="fleet-restart -s $(_shq "$sock") --reopen $(_shq "$slot")"
  else
    relaunch_cmd "$sock" "$slot" "$id" "${cwd:-$HOME}" "$agent"
    for w in "${RL_CMD[@]}"; do cmd="$cmd${cmd:+ }$(_shq "$w")"; done
  fi
  tmux -L "$sock" has-session -t "=$slot" 2>/dev/null \
    && cmd="tmux -L $(_shq "$sock") kill-session -t $(_shq "=$slot") && $cmd"
  printf '%s' "$cmd"
}

# ── RELAUNCH ONE SESSION, BY ITS OWN TMUX TARGET ──────────────────────────────
# `-t "$slot"` on that fleet's own socket, never a pattern. A pattern that matches
# a session here also matches the same-named session in every other project (every
# fleet has a `master`) and, on this machine, the owner's live tailnet daemon.
#
# THE NAME IS REUSED ON PURPOSE. Card identity — name, number, label, order,
# worktree, fleet socket — is all derived from the session name and the recorded
# markers beside it, so relaunching under the same name replaces the agent process
# and nothing else. agent-here recovers the AGENT from its own marker, so a
# non-claude session comes back as itself rather than reverting to claude.
#
# `=` ON THE KILL. A bare -t falls through to a prefix when the exact name is gone, and a reopen
# comes through here with the name gone by definition: reopening a lost `api` killed a live
# `api-2`, and reported the reopen as a success.
#
# Everything that can refuse comes before the kill: a session this cannot relaunch stays up.
relaunch() {
  local sock="$1" slot="$2" id="$3" cwd="$4" agent="${5:-}"
  [ -n "$cwd" ] || cwd="$HOME"
  [ -n "$RCFG" ] || return 1
  capture_old "$sock" "$slot" "$id" "$agent"
  tmux -L "$sock" kill-session -t "=$slot" 2>/dev/null
  outlast_old "$slot"
  # a stale park marker would boot the fresh session "parked" (same guard fleet-open
  # and fleet-spawn use). A session killed while its pane held on an exit keeps its .exited
  # marker until the new agent-here gets as far as removing it, and confirm_resumed reads it.
  rm -f "$FLEET_DIR/$sock.$slot.parked" "$FLEET_DIR/$slot.parked" "$FLEET_DIR/$sock.$slot.exited" 2>/dev/null
  relaunch_cmd "$sock" "$slot" "$id" "$cwd" "$agent"
  "${RL_CMD[@]}" 2>/dev/null || return 1
  # A server that was already up kept whatever global env its first client had; the -e above
  # fixes this session, and this fixes the server and names any session still on the wrong
  # fleet dir — the one this restart is often run to cure is now right, the rest are listed.
  [ -f "$LIB/fleet-env.mjs" ] && node "$LIB/fleet-env.mjs" heal "$sock" 2>/dev/null | sed 's/^/fleet-restart: /' >&2
  return 0
}

# The one command that starts a session, in RL_CMD, so what a Failed: row prints is what ran.
RL_CMD=()
relaunch_cmd() {
  local sock="$1" slot="$2" id="$3" cwd="$4" agent="${5:-}"
  # CLAUDE_FLEET_FRESH=0, EXPLICITLY. A tmux server's global environment is whatever its
  # FIRST client exported, and a fleet started from inside a session spawned as a parallel
  # one carries CLAUDE_FLEET_FRESH=1 there (found on a live fleet). Every <agent>-here takes
  # the fresh branch before it looks at CLAUDE_FLEET_RESUME, so the relaunch opened a BLANK
  # conversation under the old card's name. That looks like success and is the one outcome
  # this command exists to prevent. A per-session -e outranks the global value.
  #
  # AFTER A CRASH THERE IS NO SERVER, and this new-session STARTS one. Started bare it would
  # load ~/.tmux.conf instead of the fleet's, and take its global environment from whoever
  # ran this — the wrong profile, when a reopen is run from a pane on another profile. So the
  # fleet's config (it only applies when the server starts) goes with every relaunch, and the
  # FLEET's account (use_fleet) goes both ways: per session with -e, which outranks a server's
  # global value, and into the environment of the tmux client itself, which a server it starts
  # takes as its global one — so the next session anybody opens on it inherits the right
  # account too, not the caller's.
  local -a conf=() prof=() penv=()
  [ -f "$CONF" ] && conf=(-f "$CONF")
  prof=(-e "CLAUDE_CONFIG_DIR=$RCFG" -e "CLAUDE_FLEET_DIR=$RCFG/fleet" -e "CLAUDE_FLEET_PROFILE=$RPROF"
        -e "CLAUDE_FLEET_SCOPE=$RNAME" -e "CLAUDE_FLEET_ROOT=$RROOT")
  penv=(CLAUDE_CONFIG_DIR="$RCFG" CLAUDE_FLEET_DIR="$RCFG/fleet" CLAUDE_FLEET_PROFILE="$RPROF"
        CLAUDE_FLEET_SCOPE="$RNAME" CLAUDE_FLEET_ROOT="$RROOT" CLAUDE_FLEET_SOCK="$sock")
  # THE AGENT, SAID OUT LOUD. agent-here reads CLAUDE_FLEET_AGENT before the marker, and a
  # server this starts takes its global environment from the caller — a claude master
  # running a reopen exports CLAUDE_FLEET_AGENT=claude, and a codex session it brought
  # back would have come back as claude, `--resume`ing a codex id.
  [ -n "$agent" ] && prof+=(-e "CLAUDE_FLEET_AGENT=$agent")
  RL_CMD=(env "${penv[@]}" tmux -L "$sock" ${conf[@]+"${conf[@]}"} new-session -d -s "$slot" -c "$cwd"
    ${prof[@]+"${prof[@]}"}
    -e "CLAUDE_FLEET_SOCK=$sock"
    -e "CLAUDE_FLEET_RESUME=$id"
    -e "CLAUDE_FLEET_FRESH=0"
    "exec agent-here \"$slot\"")
}

# ── THE WALK ──────────────────────────────────────────────────────────────────
# Skips first so the report reads in the order a person cares about, then the
# restarts, then the caller's own instruction last. Counters are printed at the
# end rather than a line per session, because a fleet-wide run is dozens of lines
# and the useful summary is which ones did NOT come back.
run_plan() {
  local sock slot agent st act id cwd why
  local n_ok=0 n_cont=0 n_skip=0 n_idle=0 n_fail=0 since
  local skipped="" needyou="" failed="" selfrow="" RSOCK=""

  while IFS="$US" read -r sock slot agent st act id cwd why; do
    [ -n "$sock" ] || continue
    case "$act" in
      skip) n_skip=$((n_skip+1)); skipped="$skipped  $sock/$slot ($agent, $st) — $why
" ;;
      self) selfrow="$sock$US$slot$US$id$US$cwd" ;;
      resume-continue|resume-idle)
        # the plan spans fleets under --all; each relaunch is under its own fleet's account
        [ "$sock" = "$RSOCK" ] || { use_fleet "$sock"; RSOCK="$sock"; }
        since="$(date +%s)"
        if ! relaunch "$sock" "$slot" "$id" "$cwd" "$agent"; then
          n_fail=$((n_fail+1))
          failed="$failed  $sock/$slot — relaunch failed (conversation $id)
    → $(way_back "$sock" "$slot" "$id" "$cwd" "$agent")
"
        elif ! confirm_resumed "$sock" "$slot" "$id" "$agent" "$since"; then
          n_fail=$((n_fail+1))
          failed="$failed  $sock/$slot — $CONFIRM_WHY
    → $(way_back "$sock" "$slot" "$id" "$cwd" "$agent")
"
        else
          n_ok=$((n_ok+1))
          if [ "$act" = resume-continue ]; then
            # The agent needs a moment to be listening before a prompt is typed into
            # it; fleet-send types into the pane, so an early send lands nowhere.
            sleep 2
            if fleet-send -s "$sock" "$slot" "${FORCE_CONT:-$CONTINUE_PROMPT}" >/dev/null 2>&1; then
              n_cont=$((n_cont+1))
            else
              n_fail=$((n_fail+1))
              failed="$failed  $sock/$slot — relaunched, but the continue prompt did not send
    → fleet-send -s $(_shq "$sock") $(_shq "$slot") $(_shq "${FORCE_CONT:-$CONTINUE_PROMPT}")
"
            fi
          else
            n_idle=$((n_idle+1))
            [ "$st" = need-you ] && needyou="$needyou  $sock/$slot — $why
"
          fi
        fi ;;
    esac
  done <<EOF_PLAN
$PLAN
EOF_PLAN

  echo
  echo "fleet-restart: $n_ok relaunched ($n_cont continued, $n_idle left idle), $n_skip skipped${failed:+, $n_fail failed}"
  [ -n "$skipped" ] && { echo; echo "NOT restarted — still on the old binary:"; printf '%s' "$skipped"; }
  [ -n "$needyou" ] && { echo; echo "Was waiting on you, and has NOT been told to continue:"; printf '%s' "$needyou"; }
  [ -n "$failed" ]  && { echo; echo "Failed:"; printf '%s' "$failed"; }

  # ── THE CALLER GOES LAST, AND NOT FROM HERE ─────────────────────────────────
  # Restarting the session that is running this command kills the turn running it,
  # so the fleet ends up half-restarted with nobody holding the report. The command
  # is printed instead, to be run from anywhere else — or from this pane once the
  # report above has been read.
  if [ -n "$selfrow" ]; then
    local s_sock s_slot s_id s_cwd
    IFS="$US" read -r s_sock s_slot s_id s_cwd <<EOF_SELF
$selfrow
EOF_SELF
    echo
    echo "You are $s_sock/$s_slot, so this did not restart you — that would kill the turn"
    echo "running this command. When you are ready, from any other pane:"
    echo
    echo "    tmux -L $s_sock kill-session -t $s_slot \\"
    echo "      && tmux -L $s_sock new-session -d -s $s_slot -c $s_cwd \\"
    echo "           -e CLAUDE_FLEET_SOCK=$s_sock -e CLAUDE_FLEET_RESUME=$s_id \\"
    echo "           'exec agent-here \"$s_slot\"'"
  fi
  [ -z "$failed" ]
}

# ── THE BUILT-IN CHECKS ───────────────────────────────────────────────────────
# `fleet-restart --self-test` prints "name <US> want <US> got" rows, which is the
# shape every helper in test/run.sh already speaks, so the suite consumes it with
# the same while-read loop it uses for the others.
#
# IT NEEDS NO TMUX AND NO LIVE FLEET, which is the point: the thing being proved
# is the LOOKUP and the DECISION, and both are pure functions of the records on
# disk. A test that had to stand up fourteen real sessions would be a test nobody
# runs.
self_test() {
  local tmp rc=0
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  FLEET_DIR="$tmp/fleet"; mkdir -p "$FLEET_DIR"
  # the lookups read a table, so the table has to exist; rebuilt after each write below

  local is_ct=0
  is() {
    local name="$1" want="$2" got="$3"
    is_ct=$((is_ct+1))
    printf '%s%s%s%s%s\n' "$name" "$US" "$want" "$US" "$got"
    [ "$want" = "$got" ] || rc=1
  }

  # ── THE OWNER'S ACTUAL CASE, AND THE ONE THAT PROVES THE FIX ────────────────
  # Fourteen sessions in ONE checkout, which is what ~/.claude/fleet really holds
  # for scratch. `--continue` in that folder can reach exactly one of them, so
  # thirteen are unreachable — that is the bug, and the assertion is that each
  # slot resolves to ITS OWN session id, by id and not by status.
  local SOCK=cf-selftest CWD=/tmp/one-checkout i sid got
  for i in $(seq 1 14); do
    sid="$(printf 'aaaaaaaa-0000-0000-0000-%012d' "$i")"
    printf '{"session_id":"%s","sock":"%s","slot":"w%02d","cwd":"%s","status":"ready","ts":%d}\n' \
      "$sid" "$SOCK" "$i" "$CWD" "$((1700000000 + i))" > "$FLEET_DIR/$sid.json"
  done
  load_records
  local wrong=0 checked=0
  for i in $(seq 1 14); do
    sid="$(printf 'aaaaaaaa-0000-0000-0000-%012d' "$i")"
    got="$(sid_for "$SOCK" "$(printf 'w%02d' "$i")")"
    checked=$((checked+1))
    [ "$got" = "$sid" ] || wrong=$((wrong+1))
  done
  is "14 sessions in one cwd were set up" 14 "$checked"
  is "...and each resolves to ITS OWN conversation id" 0 "$wrong"
  # ...AND THE PROBE CAN BE WRONG. Every row above reports an absence of
  # mismatches, and an absence is what a broken lookup reports too — if sid_for
  # returned the empty string fourteen times, `wrong` would be 14, but if it
  # returned the SAME id every time (which is exactly what --continue does) this
  # must catch it. So: ask for a slot that does not exist and require nothing back.
  is "...and a slot with no record resolves to nothing" "" "$(sid_for "$SOCK" w99)"
  # ...and the fourteen ids really are distinct, so "each resolves to its own" is
  # not satisfied by them all being equal.
  is "...and the fourteen ids are distinct" 14 \
     "$(for i in $(seq 1 14); do sid_for "$SOCK" "$(printf 'w%02d' "$i")"; echo; done | sort -u | grep -c .)"

  # ── SCOPING: the same slot name in two fleets is two conversations ──────────
  # Every fleet has a `master`, so a lookup by slot alone reports another
  # project's conversation. fleet-list documents this and so does claude-here.
  printf '{"session_id":"%s","sock":"cf-alpha","slot":"master","cwd":"/tmp/a","status":"ready","ts":10}\n' \
    "bbbbbbbb-0000-0000-0000-00000000000a" > "$FLEET_DIR/b-alpha.json"
  printf '{"session_id":"%s","sock":"cf-beta","slot":"master","cwd":"/tmp/b","status":"ready","ts":20}\n' \
    "bbbbbbbb-0000-0000-0000-00000000000b" > "$FLEET_DIR/b-beta.json"
  load_records
  is "master on one fleet is not master on another" "bbbbbbbb-0000-0000-0000-00000000000a" \
     "$(sid_for cf-alpha master)"
  is "...and the newer record does not win across fleets" "bbbbbbbb-0000-0000-0000-00000000000b" \
     "$(sid_for cf-beta master)"

  # ── THE ROUTING, asked of the SAME function the walk asks ───────────────────
  classify claude working   id123 0; is "a working session is resumed AND continued" "resume-continue" "$ACT"
  classify claude ready     id123 0; is "...a ready one is resumed and left idle"    "resume-idle"     "$ACT"
  classify claude idle      id123 0; is "...so is an idle one"                       "resume-idle"     "$ACT"
  classify claude parked    id123 0; is "...and a parked one"                        "resume-idle"     "$ACT"
  classify claude limit     id123 0; is "...at-limit counts as mid-turn"             "resume-continue" "$ACT"
  classify claude interrupted id123 0; is "...and so does interrupted"               "resume-continue" "$ACT"
  # The judgement call, asserted so that changing it is a visible decision.
  classify claude need-you  id123 0; is "a need-you session is NOT told to continue" "resume-idle"     "$ACT"
  is "...and it says why, so it can be re-asked by hand" "was waiting on you — re-ask it yourself" "$WHY"
  # Never guess in a shared folder.
  classify claude working   ""    0; is "no recorded id is skipped, never --continue" "skip"           "$ACT"
  is "...and says so" "no recorded conversation id" "$WHY"
  # The caller.
  classify claude working   id123 1; is "the calling session is left for last"        "self"           "$ACT"

  # codex resumes by its recorded id since 0.160.1 (fleet-agent's codex resume field has
  # the measurement), so it is restarted like claude rather than skipped.
  if command -v fleet-agent >/dev/null 2>&1; then
    classify codex working id123 0
    is "codex is restarted on its own conversation" "resume-continue" "$ACT"
    classify codex working "" 0
    is "...but never without a recorded id" "skip" "$ACT"
  fi

  # ── THE SNAPSHOT REALLY IS WRITTEN, AND CARRIES THE PLAN ───────────────────
  # The point of the snapshot is that a run which dies halfway leaves a record of
  # what every session WAS and what it was about to get. Asserted against a plan
  # this test constructs, because the behavioural version — "--dry-run leaves no
  # file" — cannot fail inside the suite: run.sh gives itself a private
  # TMUX_TMPDIR, so --all finds no sockets and exits before the snapshot is ever
  # reached. Constructing the condition is the difference between a check and a
  # coincidence.
  PLAN="cf-x${US}w1${US}claude${US}working${US}resume-continue${US}id-aaa${US}/tmp/x${US}
cf-x${US}w2${US}claude${US}ready${US}resume-idle${US}id-bbb${US}/tmp/x${US}
"
  write_snapshot >/dev/null 2>&1
  is "the snapshot is written before anything is touched" "yes" "$([ -f "$SNAP" ] && echo yes || echo no)"
  is "...and it carries every planned session" 2 "$(grep -c '^cf-x' "$SNAP" 2>/dev/null || echo 0)"
  is "...and what each one was about to get" 1 "$(grep -c 'resume-continue' "$SNAP" 2>/dev/null || echo 0)"
  is "...and the status it had before the restart" 1 "$(grep -cE '\bworking\b' "$SNAP" 2>/dev/null || echo 0)"

  printf 'self-test rows%s%s%s%s\n' "$US" "$is_ct" "$US" "$is_ct"
  return $rc
}

if [ "$SELFTEST" = 1 ]; then self_test; exit $?; fi

# ── `exit` STOPS BEING DESTRUCTIVE ────────────────────────────────────────────
# "i use parallel session and if i type exit the session is completely remove it
# and i cant reopen it easily." Typing `exit` ends the agent, tmux takes the
# session down with it (remain-on-exit off, set globally in tmux/cf.tmux.conf),
# and the card goes with the session — so the conversation is still on disk and
# there is no way back to it that does not go through `--continue`, which in a
# folder with twelve of them opens the wrong one.
#
# The RECORD outlives the session. So this reopens by name: same card name, same
# fleet, same checkout, resuming that session's own conversation id.
#
# WHAT THIS IS NOT, and it is the half deliberately left for its own change: the
# card is not kept VISIBLE between the exit and the reopen. That needs
# remain-on-exit flipped (it is global, in two tmux configs, with a comment at
# fleet-spawn:728 saying why it is off), a marker written by whatever wraps the
# agent at all SEVEN places a session is created, and a renderer change on both
# the desk and the phone. This makes exit RECOVERABLE in one command, which is the
# part that was actually lost.
#
# WHERE THE ID COMES FROM, IN ORDER, AND THE ORDER IS THE WHOLE RULE. The slot's records first.
# When they name nothing, or name an id with no transcript, the restart's own snapshot: recovering
# from a restart that lost sessions, three refused here while the snapshot written before its
# first kill held the right id for each, with the transcripts there. A snapshot row is this
# socket's and this slot's own history, so reading it is not a guess. "The newest conversation in
# this folder" is, and stays refused.
#   --all keeps its snapshot with the caller rather than the fleet, so every profile's dir is
# walked, newest first by name, which is by time.
snapshot_files() {
  local d f
  for d in "$FLEET_DIR" "$CALLER_FLEET_DIR" "$HOME/.claude/fleet" "$HOME"/.claude-*/fleet; do
    for f in "$d"/restart-*.tsv; do [ -f "$f" ] && printf '%s\t%s\n' "${f##*/}" "$f"; done
  done | sort -r | cut -f2- | awk '!seen[$0]++'
}
# Which file a conversation has to be in, under the account it is about to run as. Empty when
# the agent keeps none this can name.
conversation_file() {
  local agent="$1" id="$2" cwd="$3" tr="${4:-}" want=""
  if [ "$agent" = claude ]; then
    want="$RCFG/projects/$(printf '%s' "$cwd" | sed 's/[^A-Za-z0-9]/-/g')/$id.jsonl"
    [ -f "$want" ] || case "$tr" in "$RCFG"/*) [ -f "$tr" ] && want="$tr" ;; esac
  elif [ -n "$tr" ]; then
    want="$tr"
  fi
  printf '%s' "$want"
}
# Sets RO_ID RO_CWD RO_TR RO_AGENT and RO_SRC (where the id came from), or RO_WHY and returns 1.
RO_ID=""; RO_CWD=""; RO_TR=""; RO_AGENT=""; RO_SRC=""; RO_WHY=""
resolve_reopen() {
  local sock="$1" name="$2" id cwd="" tr="" ragent="" agent want rec f row sid scwd sagent str unusable=""
  RO_ID=""; RO_CWD=""; RO_TR=""; RO_AGENT=""; RO_SRC=""; RO_WHY=""
  id="$(sid_for "$sock" "$name")"
  if [ -n "$id" ]; then
    IFS="$US" read -r cwd tr ragent < <(jq -r --arg i "$id" 'select(.session_id==$i) | [(.cwd // ""), (.transcript // ""), (.agent // "")] | join("\u001f")' "$FLEET_DIR"/*.json 2>/dev/null | head -1)
    # The record knows its agent when the agent wrote it (codex's does); the marker otherwise.
    agent="${ragent:-$(agent_for "$sock" "$name")}"
    if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then RO_WHY="the conversation's checkout ($cwd) is gone"; return 1; fi
    # THE CONVERSATION HAS TO BE THERE, UNDER THE ACCOUNT IT IS ABOUT TO RUN AS. A resume of an
    # id that account has no transcript for is a pane that prints "no conversation found" and
    # exits — the card comes back for a second and goes, and the reason is gone with the pane.
    # Claude keeps a conversation in <config dir>/projects/<cwd, every non-alphanumeric a '-'>;
    # the record's own path is taken too when it is under that account. Another agent keeps it
    # where its record says, so that is the file asked about.
    want="$(conversation_file "$agent" "$id" "$cwd" "$tr")"
    if [ -z "$want" ] || [ -f "$want" ]; then
      RO_ID="$id"; RO_CWD="$cwd"; RO_TR="$tr"; RO_AGENT="$agent"; RO_SRC="the slot's record"
      return 0
    fi
    rec="the slot's record names $id, which has no transcript"
    RO_WHY="'$name''s conversation $id has no transcript under $RCFG (looked for $want) — resuming it would open a pane that exits, so it is not reopened"
  else
    rec="no record names this slot"
    RO_WHY="no recorded conversation for '$name' on $sock — nothing to resume by id, and this will not guess with --continue"
  fi
  while IFS= read -r f; do
    row="$(awk -F'\t' -v k="$sock" -v s="$name" '$1==k && $2==s && $6!="" {print $3 "\037" $6 "\037" $7; exit}' "$f" 2>/dev/null)"
    [ -n "$row" ] || continue
    IFS="$US" read -r sagent sid scwd <<< "$row"
    case "$sagent" in ''|-) sagent="$(agent_for "$sock" "$name")" ;; esac
    str=""
    [ "$sagent" = codex ] && str="$(node "$LIB/slot-claim.mjs" rollout --id "$sid" 2>/dev/null)"
    want="$(conversation_file "$sagent" "$sid" "$scwd" "$str")"
    if [ -z "$scwd" ] || [ ! -d "$scwd" ] || { [ "$sagent" = codex ] && [ -z "$str" ]; } || { [ -n "$want" ] && [ ! -f "$want" ]; }; then
      [ -n "$unusable" ] || unusable="$f names $sid, with no checkout or transcript here"
      continue
    fi
    RO_ID="$sid"; RO_CWD="$scwd"; RO_TR="$str"; RO_AGENT="$sagent"; RO_SRC="$f ($rec)"; RO_WHY=""
    return 0
  done < <(snapshot_files)
  [ -z "$unusable" ] || RO_WHY="$RO_WHY (the snapshot $unusable)"
  return 1
}

reopen_one() {
  local name="$1" sock="$ONE" id cwd
  if [ -z "$sock" ]; then
    # Which fleet? The caller's own, unless -s said otherwise. A bare name is
    # ambiguous across fleets — every one has a `master` — so refuse rather than
    # guess, for the same reason sid_for scopes by sock.
    sock="$SELF_SOCK"
    [ -n "$sock" ] || { echo "fleet-restart: --reopen needs a fleet: run it inside one, or pass -s <socket>" >&2; return 1; }
  fi
  if tmux -L "$sock" has-session -t "=$name" 2>/dev/null; then
    echo "fleet-restart: '$name' is already running on $sock — nothing to reopen" >&2
    return 1
  fi
  use_fleet "$sock" || { echo "fleet-restart: $(unowned "$sock")" >&2; return 1; }
  load_records
  resolve_reopen "$sock" "$name" || { echo "fleet-restart: $RO_WHY" >&2; return 1; }
  local tr="$RO_TR" agent="$RO_AGENT"
  id="$RO_ID"; cwd="$RO_CWD"
  # ONE CONVERSATION, ONE PANE. A codex process holds its rollout open, so "somebody has it
  # open" is "it is live in some pane already" — under another name, on another fleet, or
  # in a terminal outside any fleet. Resuming it again would put two writers on one file.
  if [ -n "$tr" ] && [ -f "$tr" ] && [ "$agent" = codex ] \
     && node "$LIB/codex-rollout.mjs" open "$tr" 2>/dev/null; then
    echo "fleet-restart: '$name''s conversation ${id%%-*} is already open in another pane — not resuming it twice" >&2
    return 1
  fi
  # A claude conversation holds no file open; it is held by a process whose note or argv
  # names it (lib/slot-claim.mjs). Same refusal, so the two agents keep one rule.
  local holder
  if [ "$agent" = claude ] && [ -f "$LIB/slot-claim.mjs" ] \
     && holder="$(node "$LIB/slot-claim.mjs" held --grace 0 --id "$id" 2>/dev/null)"; then
    echo "fleet-restart: '$name''s conversation ${id%%-*} is already open in live process $holder — not resuming it twice" >&2
    return 1
  fi
  # --dry-run is a promise to touch nothing, and it used to be read only by the --all/-s walk:
  # beside --reopen it printed "reopened" and created the session. Asked here, after every
  # refusal above has had its say, so a dry run reports the same outcome the real one would.
  if [ "$DRY" = 1 ]; then
    echo "fleet-restart: would reopen '$name' on $sock, resuming $id in $cwd as $RCFG, id from $RO_SRC — --dry-run, nothing was touched"
    return 0
  fi
  if relaunch "$sock" "$name" "$id" "$cwd" "$agent"; then
    echo "fleet-restart: reopened '$name' on $sock, resuming ${id%%-*} in $cwd, id from $RO_SRC"
  else
    echo "fleet-restart: failed to reopen '$name'" >&2; return 1
  fi
}

if [ "$MODE" = reopen ]; then
  [ -n "$REOPEN" ] || { echo "fleet-restart: --reopen needs a session name" >&2; exit 2; }
  command -v jq >/dev/null 2>&1 || { echo "fleet-restart: jq is required to read the fleet records" >&2; exit 1; }
  reopen_one "$REOPEN"
  exit $?
fi

# ── MAIN ──────────────────────────────────────────────────────────────────────
[ -n "$MODE" ] || { echo "fleet-restart: pass --all, -s <socket> or --project <name> (--help for more)" >&2; exit 2; }
# A name is only a session inside one fleet: every fleet has a `master`.
[ -z "$ONLY_SLOT" ] || [ "$MODE" = one ] || { echo "fleet-restart: --session needs -s <socket> or --project <name>" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "fleet-restart: jq is required to read the fleet records" >&2; exit 1; }

# One fleet: refused up front when nobody owns it, and its snapshot goes in its own fleet dir.
# Every fleet: each is resolved in plan_rows, and the snapshot stays with the caller.
if [ "$MODE" = one ]; then
  use_fleet "$ONE" || { echo "fleet-restart: $(unowned "$ONE")" >&2; exit 1; }
  SNAP_DIR="$FLEET_DIR"
else
  SNAP_DIR="$CALLER_FLEET_DIR"
fi
plan_rows
[ -n "$PLAN" ] || { echo "fleet-restart: no sessions found"; exit 0; }

printf '%-18s %-16s %-9s %-9s %s\n' SOCKET SESSION AGENT STATUS ACTION
while IFS="$US" read -r sock slot agent st act id cwd why; do
  [ -n "$sock" ] || continue
  printf '%-18s %-16s %-9s %-9s %s%s\n' "$sock" "$slot" "$agent" "$st" "$act" "${why:+  ($why)}"
done <<EOF_SHOW
$PLAN
EOF_SHOW

if [ "$DRY" = 1 ]; then echo; echo "fleet-restart: --dry-run, nothing was touched"; exit 0; fi

# ── NO TERMINAL, NO CONFIRMATION — SAY SO, AND FAIL ───────────────────────────
# Run from an agent's prompt there is no controlling terminal, so `</dev/tty` fails
# as a REDIRECTION — before the `2>/dev/null` beside it applies — and the shell's own
# "Device not configured" reached the caller, followed by "nothing done". Right
# outcome, useless message, and exit 0 read as success. Asked before the snapshot,
# because a snapshot of a plan that is never going to run is a file that lies.
if [ "$YES" != 1 ] && ! { : </dev/tty; } 2>/dev/null; then
  echo "fleet-restart: no terminal to confirm on — re-run with --yes" >&2
  exit 1
fi

# THE SNAPSHOT GOES DOWN BEFORE THE FIRST KILL, not after the last one.
write_snapshot

if [ "$YES" != 1 ]; then
  printf '\nRestart these? Every listed session is killed and relaunched on its own conversation. [y/N] '
  read -r ans </dev/tty 2>/dev/null || ans=n
  case "$ans" in y|Y) ;; *) echo "fleet-restart: nothing done (the snapshot above still describes the plan)"; exit 0 ;; esac
fi

run_plan
